{
  "_note": "Hand-curated first 50 JA words for the /learn/first-50 page. Ordered for pedagogy, not raw frequency: starts with high-yield content (the words that *mean* things in a creation story), then function words and grammar markers, then demonstratives/pronouns, then verbs, then named characters. Each entry's `key` matches the normalized form used by the corpus index — the build script joins on this. `note` is optional learner color (etymology, false-friend warning, Hebrew echo).",
  "entries": [
    {"key": "לה",      "lemma_ja": "אללה",       "arabic": "اللَّه",      "en": "God",                    "he_echo": "אלהים / ה'",          "group": "essentials", "note": "Saadia's standard rendering of אלהים. The article אל- is integral; do not strip."},
    {"key": "ארץ",     "lemma_ja": "אלארץ'",     "arabic": "الأرض",       "en": "the earth, the land",    "he_echo": "ארץ — same root",     "group": "essentials", "note": "Almost always with the article. ארץ' (with apostrophe) marks ض."},
    {"key": "סמא",     "lemma_ja": "אלסמא",      "arabic": "السَّماء",    "en": "the sky, the heavens",   "he_echo": "שמים",                "group": "essentials", "note": "Cognate with שמים but singular in Arabic."},
    {"key": "מא",      "lemma_ja": "אלמא",       "arabic": "الماء",       "en": "the water",              "he_echo": "מים",                 "group": "essentials", "note": "Distinct from the relative/negative particle מא (مَا) — see entry below."},
    {"key": "יום",     "lemma_ja": "אליום",      "arabic": "اليوم",       "en": "the day, today",         "he_echo": "יום",                 "group": "essentials"},
    {"key": "ליל",     "lemma_ja": "אלליל",      "arabic": "اللَّيل",     "en": "the night",              "he_echo": "לילה",                "group": "essentials"},
    {"key": "נהאר",    "lemma_ja": "אלנהאר",     "arabic": "النَّهار",    "en": "the day, daytime",       "he_echo": "—",                   "group": "essentials", "note": "Pairs with אלליל — 'night and day'."},
    {"key": "נור",     "lemma_ja": "נור",        "arabic": "نور",         "en": "light",                  "he_echo": "נר ('lamp')",         "group": "essentials"},
    {"key": "צ'לאם",   "lemma_ja": "צ'לאם",      "arabic": "ظَلام",       "en": "darkness",               "he_echo": "צלמות",               "group": "essentials", "note": "ظ rendered as צ' (apostrophe). Hebrew צלמות = 'shadow of death' shares the root."},
    {"key": "אדם",     "lemma_ja": "אדם",        "arabic": "آدم",         "en": "Adam, human",            "he_echo": "אדם",                 "group": "essentials"},

    {"key": "מן",      "lemma_ja": "מן",         "arabic": "مِن",         "en": "from",                   "he_echo": "מן / מ־",             "group": "function"},
    {"key": "פי",      "lemma_ja": "פי",         "arabic": "في",          "en": "in",                     "he_echo": "ב־",                  "group": "function"},
    {"key": "עלי",     "lemma_ja": "עלי",        "arabic": "على",         "en": "on, upon",               "he_echo": "על",                  "group": "function"},
    {"key": "אלי",     "lemma_ja": "אלי",        "arabic": "إلى",         "en": "to, toward",             "he_echo": "אל / אלי",            "group": "function"},
    {"key": "בין",     "lemma_ja": "בין",        "arabic": "بين",         "en": "between",                "he_echo": "בין",                 "group": "function", "note": "Same word, same meaning. The Hebrew–Arabic overlap couldn't be cleaner."},
    {"key": "מע",      "lemma_ja": "מע",         "arabic": "مع",          "en": "with",                   "he_echo": "עם",                  "group": "function"},
    {"key": "כמא",     "lemma_ja": "כמא",        "arabic": "كَما",        "en": "just as, like",          "he_echo": "כמו",                 "group": "function"},
    {"key": "מא",      "lemma_ja": "מא",         "arabic": "ما",          "en": "what; that which; not",  "he_echo": "מה / אשר",            "group": "function", "note": "Three jobs: question word ('what?'), relative ('that which'), and negation. Context decides."},
    {"key": "אן",      "lemma_ja": "אן",         "arabic": "أنّ / إن",    "en": "that; if",               "he_echo": "אשר / אם",            "group": "function", "note": "Same spelling, different vowel: أنّ ('that') vs إن ('if'). Saadia uses both; context decides."},
    {"key": "או",      "lemma_ja": "או",         "arabic": "أو",          "en": "or",                     "he_echo": "או",                  "group": "function"},
    {"key": "לא",      "lemma_ja": "לא",         "arabic": "لا",          "en": "no, not",                "he_echo": "לא",                  "group": "function"},
    {"key": "לם",      "lemma_ja": "לם",         "arabic": "لم",          "en": "did not (past)",         "he_echo": "לא ה־",               "group": "function", "note": "Past-tense negation. Followed by jussive verb form."},
    {"key": "כל",      "lemma_ja": "כל",         "arabic": "كل",          "en": "all, every",             "he_echo": "כל",                  "group": "function"},
    {"key": "גמיע",    "lemma_ja": "גמיע",       "arabic": "جميع",        "en": "all, the whole of",      "he_echo": "כל",                  "group": "function", "note": "Saadia's preferred word for 'all' in many contexts; pairs with כל."},
    {"key": "ת'ם",     "lemma_ja": "ת'ם",        "arabic": "ثم",          "en": "then, afterwards",       "he_echo": "אחר־כך",              "group": "function"},
    {"key": "למא",     "lemma_ja": "למא",        "arabic": "لمَّا",       "en": "when, after",            "he_echo": "כאשר",                "group": "function", "note": "Often opens a clause: 'when X happened, Y…'"},
    {"key": "קד",      "lemma_ja": "קד",         "arabic": "قد",          "en": "already; indeed",        "he_echo": "כבר",                 "group": "function", "note": "Marks a completed action — 'has already done X'."},
    {"key": "איצ'א",   "lemma_ja": "איצ'א",      "arabic": "أيضاً",       "en": "also, too",              "he_echo": "גם",                  "group": "function"},

    {"key": "הד'א",    "lemma_ja": "הד'א",       "arabic": "هذا",         "en": "this (m.)",              "he_echo": "זה",                  "group": "pronouns"},
    {"key": "הד'ה",    "lemma_ja": "הד'ה",       "arabic": "هذه",         "en": "this (f.)",              "he_echo": "זאת",                 "group": "pronouns"},
    {"key": "ד'אלך",   "lemma_ja": "ד'אלך",      "arabic": "ذلك",         "en": "that (m.)",              "he_echo": "ההוא",                "group": "pronouns"},
    {"key": "ד'י",     "lemma_ja": "אלד'י",      "arabic": "الذي",        "en": "the one who/which (m.)", "he_echo": "אשר",                 "group": "pronouns", "note": "The relative pronoun — 'the man who…', 'the thing that…'."},
    {"key": "תי",      "lemma_ja": "אלתי",       "arabic": "التي",        "en": "the one who/which (f.)", "he_echo": "אשר",                 "group": "pronouns"},
    {"key": "הו",      "lemma_ja": "הו",         "arabic": "هو",          "en": "he, it (m.)",            "he_echo": "הוא",                 "group": "pronouns", "note": "Look-alike to Hebrew הוא. Same word, near-same sound."},
    {"key": "אנא",     "lemma_ja": "אנא",        "arabic": "أنا",         "en": "I",                      "he_echo": "אני",                 "group": "pronouns"},
    {"key": "אנת",     "lemma_ja": "אנת",        "arabic": "أنتَ",        "en": "you (m.)",               "he_echo": "אתה",                 "group": "pronouns"},
    {"key": "הם",      "lemma_ja": "הם",         "arabic": "هم",          "en": "they (m.)",              "he_echo": "הם",                  "group": "pronouns"},
    {"key": "הא",      "lemma_ja": "הא",         "arabic": "ها",          "en": "behold; (pronoun) her",  "he_echo": "הנה / ־ה",            "group": "pronouns", "note": "Two uses: presentative 'here is…' and feminine suffix '־her/it' (e.g., כתאבהא = 'her book')."},

    {"key": "קאל",     "lemma_ja": "קאל",        "arabic": "قال",         "en": "said (he)",              "he_echo": "אמר",                 "group": "verbs",    "note": "Saadia's go-to verb for ויאמר. With prefix פ־ becomes פקאל = 'and he said'."},
    {"key": "כאן",     "lemma_ja": "כאן",        "arabic": "كان",         "en": "was, used to be",        "he_echo": "היה",                 "group": "verbs"},
    {"key": "יכון",    "lemma_ja": "יכון",       "arabic": "يكون",        "en": "will be, becomes",       "he_echo": "יהיה",                "group": "verbs"},
    {"key": "כ'לק",    "lemma_ja": "כ'לק",       "arabic": "خَلَق",       "en": "created",                "he_echo": "ברא",                 "group": "verbs",    "note": "Saadia's rendering of ברא. Root خ-ل-ق. The first content verb of the Tafsir."},
    {"key": "ראי",     "lemma_ja": "ראי",        "arabic": "رأى",         "en": "saw",                    "he_echo": "ראה",                 "group": "verbs",    "note": "Direct cognate of ראה — same root, same sense."},
    {"key": "עלם",     "lemma_ja": "עלם",        "arabic": "عَلِم",       "en": "knew",                   "he_echo": "—",                   "group": "verbs",    "note": "Saadia often uses 'God knew' (עלם אללה) where the Hebrew says 'God saw'."},
    {"key": "צאר",     "lemma_ja": "צאר",        "arabic": "صار",         "en": "became",                 "he_echo": "היה ל־",              "group": "verbs"},
    {"key": "אעטי",    "lemma_ja": "אעטי",       "arabic": "أعطى",        "en": "gave",                   "he_echo": "נתן",                 "group": "verbs"},
    {"key": "אכ'ד",    "lemma_ja": "אכ'ד'",      "arabic": "أخَذ",        "en": "took",                   "he_echo": "לקח",                 "group": "verbs",    "note": "Root أ-خ-ذ. Both خ and ذ get apostrophes in JA: כ' and ד'. (Trailing apostrophe is stripped by the index normalizer.)"},

    {"key": "אסראיל",  "lemma_ja": "אסראיל",     "arabic": "إسرائيل",     "en": "Israel",                 "he_echo": "ישראל",               "group": "names",    "note": "Note the elision: י־ש־ר־א־ל → א־ס־ר־א־י־ל. The Hebrew yod moves."},
    {"key": "מוסי",    "lemma_ja": "מוסי",       "arabic": "موسى",        "en": "Moses (Mūsā)",           "he_echo": "משה",                 "group": "names",    "note": "Same name, Arabic vowel pattern. Mūsā ends in alif-maqsūra (י)."},
    {"key": "פרעון",   "lemma_ja": "פרעון",      "arabic": "فِرعَون",     "en": "Pharaoh",                "he_echo": "פרעה",                "group": "names",    "note": "Both languages preserve the Egyptian name. Arabic adds the final ن."}
  ]
}
