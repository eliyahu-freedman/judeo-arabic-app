        "he": "וַיֵּצֵא סִיחֹן"
      },
      {
        "ja": "תלקאנא",
        "en": "to meet us",
        "he": "לִקְרָאתֵנוּ"
      },
      {
        "ja": "הו",
        "en": "he",
        "he": "הוּא"
      },
      {
        "ja": "וגמיע קומה",
        "en": "and all his people",
        "he": "וְכָל-עַמּוֹ"
      },
      {
        "ja": "לאלחרב",
        "en": "for battle",
        "he": "לַמִּלְחָמָה"
      },
      {
        "ja": "אלי' י'הץ",
        "en": "at Yahaz",
        "he": "יָהְצָה"
      }
    ],
    "33": [
      {
        "ja": "פאסלמה",
        "en": "delivered him",
        "he": "וַיִּתְּנֵהוּ"
      },
      {
        "ja": "אללה",
        "en": "God",
        "he": "יְהוָה"
      },
      {
        "ja": "רבנא",
        "en": "our Lord",
        "he": "אֱלֹהֵינוּ"
      },
      {
        "ja": "פי ידנא",
        "en": "into our hand",
        "he": "לְפָנֵינוּ"
      },
      {
        "ja": "פקתלנאה",
        "en": "and we struck him",
        "he": "וַנַּךְ אֹתוֹ"
      },
      {
        "ja": "ובניה",
        "en": "and his sons",
        "he": "וְאֶת-בָּנָו"
      },
      {
        "ja": "וסאיר קומה",
        "en": "and the rest of his people",
        "he": "וְאֶת-כָּל-עַמּוֹ"
      }
    ],
    "34": [
      {
        "ja": "ופתחנא",
        "en": "And we captured",
        "he": "וַנִּלְכֹּד"
      },
      {
        "ja": "גמיע קראה",
        "en": "all his towns",
        "he": "אֶת-כָּל-עָרָיו"
      },
      {
        "ja": "פי ד'אלך אלוקת",
        "en": "at that time",
        "he": "בָּעֵת הַהִוא"
      },
      {
        "ja": "ואתלפנא",
        "en": "and we destroyed",
        "he": "וַנַּחֲרֵם"
      },
      {
        "ja": "מן כל קריה",
        "en": "from every town",
        "he": "אֶת-כָּל-עִיר"
      },
      {
        "ja": "אלרהט",
        "en": "the men",
        "he": "מְתִם"
      },
      {
        "ja": "ואלנסא",
        "en": "the women",
        "he": "וְהַנָּשִׁים"
      },
      {
        "ja": "ואלאטפאל",
        "en": "and the children",
        "he": "וְהַטָּף"
      },
      {
        "ja": "לם נבק שרידא",
        "en": "we left not a single survivor",
        "he": "לֹא הִשְׁאַרְנוּ שָׂרִיד"
      }
    ],
    "35": [
      {
        "ja": "ו",
        "en": "Only",
        "he": "רַק"
      },
      {
        "ja": "כל בהימה",
        "en": "all the livestock",
        "he": "הַבְּהֵמָה"
      },
      {
        "ja": "ג'נמנא",
        "en": "we took as spoil",
        "he": "בָּזַזְנוּ לָנוּ"
      },
      {
        "ja": "וסלב",
        "en": "and the plunder of",
        "he": "וּשְׁלַל"
      },
      {
        "ja": "אלקרא",
        "en": "the towns",
        "he": "הֶעָרִים"
      },
      {
        "ja": "אלד'י פתחנאהא",
        "en": "which we had captured",
        "he": "אֲשֶׁר לָכָדְנוּ"
      }
    ],
    "36": [
      {
        "ja": "מן ערוער",
        "en": "From Aroer",
        "he": "מֵעֲרֹעֵר"
      },
      {
        "ja": "אלד'י עלי' שאט ואד ארנון",
        "en": "which is upon the bank of the wadi Arnon",
        "he": "אֲשֶׁר עַל-שְׂפַת-נַחַל אַרְנֹן"
      },
      {
        "ja": "ואלקריה אלד'י פי אלואד",
        "en": "and the town which is in the valley",
        "he": "וְהָעִיר אֲשֶׁר בַּנַּחַל"
      },
      {
        "ja": "ואלי' גרש",
        "en": "and as far as Jerash",
        "he": "וְעַד-הַגִּלְעָד"
      },
      {
        "ja": "לם תבק קריה",
        "en": "not a town remained",
        "he": "לֹא הָיְתָה קִרְיָה"
      },
      {
        "ja": "מנעת מנא",
        "en": "that was withheld from us",
        "he": "אֲשֶׁר שָׂגְבָה מִמֶּנּוּ"
      },
      {
        "ja": "בל",
        "en": "rather"
      },
      {
        "ja": "אלכל",
        "en": "all of it",
        "he": "אֶת-הַכֹּל"
      },
      {
        "ja": "אסלמה אללה רבנא פי אידינא",
        "en": "God our Lord delivered into our hands",
        "he": "נָתַן יְהוָה אֱלֹהֵינוּ לְפָנֵינוּ"
      }
    ],
    "37": [
      {
        "ja": "עדא",
        "en": "Except",
        "he": "רַק"
      },
      {
        "ja": "אלי' בלד בני עמון",
        "en": "the land of the sons of Ammon",
        "he": "אֶל-אֶרֶץ בְּנֵי-עַמּוֹן"
      },
      {
        "ja": "פאנך לם תקרבה",
        "en": "you did not approach it",
        "he": "לֹא קָרָבְתָּ"
      },
      {
        "ja": "פגמיע שאט ואד יבק",
        "en": "namely the whole bank of the wadi Jabbok",
        "he": "כָּל-יַד נַחַל יַבֹּק"
      },
      {
        "ja": "וקרא אלגבל",
        "en": "and the towns of the hill country",
        "he": "וְעָרֵי הָהָר"
      },
      {
        "ja": "וסאיר מא נהאנא ענה אללה רבנא",
        "en": "and all else that God our Lord had forbidden us",
        "he": "וְכֹל אֲשֶׁר-צִוָּה יְהוָה אֱלֹהֵינוּ"
      }
    ]
  }
}