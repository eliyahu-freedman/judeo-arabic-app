        "he": "וְאֶת-אֹתֹתַי"
      },
      {
        "ja": "אלתי צנעתהא",
        "en": "which I performed",
        "he": "אֲשֶׁר-עָשִׂיתִי"
      },
      {
        "ja": "פי מצר",
