    "20": [
      {
        "ja": "קאל אללה",
        "en": "And God said:",
        "he": "וַיֹּאמֶר יְהוָה"
      },
      {
        "ja": "קד צפחת ענהם",
        "en": "'I have pardoned them",
        "he": "סָלַחְתִּי"
      },
      {
        "ja": "אלמעאגלה",
        "en": "from immediate punishment,"
      },
      {
        "ja": "כמא קלת",
        "en": "as you have said.'",
        "he": "כִּדְבָרֶךָ"
      }
    ],
    "21": [
      {
        "ja": "ולכן",
        "en": "'Yet —",
        "he": "וְאוּלָם"
      },
      {
        "ja": "ובקאי אלדאים",
        "en": "by My eternal existence,",
        "he": "חַי-אָנִי"
      },
      {
        "ja": "ונורי",
        "en": "and by My light",
        "he": "וְיִמָּלֵא"
      },
      {
        "ja": "אלד'י ימלא",
        "en": "which fills",
        "he": "כְבוֹד-יְהוָה"
      },
      {
        "ja": "גמיע אלעאלם",
