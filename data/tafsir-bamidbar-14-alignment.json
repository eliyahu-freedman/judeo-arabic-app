        "he": "אֲשֶׁר הֵמָּה מַלִּינִים עָלָי"
      },
      {
        "ja": "לקד סמעת",
        "en": "I have indeed heard",
        "he": "שָׁמָעְתִּי"
      },
      {
        "ja": "תד'מר",
        "en": "the grumbling of",
        "he": "אֶת-תְּלֻנּוֹת"
      },
      {
        "ja": "בני אסראיל",
        "en": "the sons of Israel,",
        "he": "בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "אלד'י תד'מרו עליי",
        "en": "who grumbled against Me.'",
        "he": "אֲשֶׁר הֵמָּה מַלִּינִים עָלַי"
      }
    ],
    "28": [
      {
        "ja": "אלא קל",
        "en": "'Say to them:",
        "he": "אֱמֹר"
      },
      {
        "ja": "להם",
        "en": "By My eternal existence —",
        "he": "אֲלֵהֶם"
      },
      {
        "ja": "ובקאי אלדאים",
        "en": "says God —",
        "he": "חַי-אָנִי"
      },
      {
        "ja": "יקול אללה",
