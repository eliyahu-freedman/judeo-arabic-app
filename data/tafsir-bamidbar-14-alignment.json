        "en": "to Moses",
        "he": "יְהוָה"
      },
      {
        "ja": "מוסי'",
        "en": "and Aaron,",
        "he": "אֶל-מֹשֶׁה"
      },
      {
        "ja": "והרון",
        "en": "saying:",
        "he": "וְאֶל-אַהֲרֹן"
      },
      {
        "ja": "תכלימא",
        "en": "",
        "he": "לֵאמֹר"
      }
    ],
    "27": [
      {
        "ja": "אלי' כם",
        "en": "'How long",
        "he": "עַד-מָתַי"
      },
      {
        "ja": "אבקי",
        "en": "shall I leave"
      },
      {
        "ja": "הד'ה אלגמאעה אלרדייה",
        "en": "this wicked congregation,",
        "he": "לָעֵדָה הָרָעָה הַזֹּאת"
      },
      {
        "ja": "אלד'י ד'מרת אלאמה עליי",
