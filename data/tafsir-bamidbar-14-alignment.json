        "he": "אִם-לֹא"
      },
      {
        "ja": "אצנע בכם. כמא קלתם",
        "en": "in My presence!'",
        "he": "כַּאֲשֶׁר דִּבַּרְתֶּם"
      },
      {
        "ja": "בחצ'רתי",
        "en": "",
        "he": "בְּאָזְנָי"
      }
    ],
    "29": [
      {
        "ja": "ופי הד'א אלבר",
        "en": "'In this wilderness shall your bodies fall —",
        "he": "בַּמִּדְבָּר הַזֶּה"
      },
      {
        "ja": "תקע",
        "en": "from every one counted",
        "he": "יִפְּלוּ"
      },
      {
        "ja": "אגסאדכם",
        "en": "and numbered among you,",
        "he": "פִגְרֵיכֶם"
      },
      {
        "ja": "מן כל מעדוד",
        "en": "from twenty years of age",
        "he": "וְכָל-פְּקֻדֵיכֶם"
      },
      {
        "ja": "ומחצא מנכם",
        "en": "and upward —",
        "he": "לְכָל-מִסְפַּרְכֶם"
      },
      {
        "ja": "מן אבן עשרין סנה",
        "en": "even as you grumbled against Me.'",
        "he": "מִבֶּן עֶשְׂרִים שָׁנָה"
      },
      {
        "ja": "פצאעדא",
        "en": "",
        "he": "וָמָעְלָה"
      },
      {
        "ja": "כמא תד'מרתם עליי",
        "en": "",
        "he": "אֲשֶׁר הֲלִינֹתֶם עָלָי"
      }
    ],
    "30": [
      {
        "ja": "אן אנתם דכ'לתם",
        "en": "'You shall not enter",
        "he": "אִם-אַתֶּם תָּבֹאוּ"
      },
      {
        "ja": "אלבלד",
        "en": "the land",
        "he": "אֶל-הָאָרֶץ"
      },
      {
        "ja": "אלד'י אקסמת",
        "en": "concerning which I swore",
        "he": "אֲשֶׁר נָשָׂאתִי"
      },
      {
