        "he": "אִם-יִרְאוּ"
      },
      {
        "ja": "אלבלד",
        "en": "the land",
        "he": "אֶת-הָאָרֶץ"
      },
      {
        "ja": "אלד'י אקסמת",
        "en": "which I swore",
        "he": "אֲשֶׁר נִשְׁבַּעְתִּי"
      },
      {
        "ja": "לאבאיהם",
        "en": "to their fathers;",
        "he": "לַאֲבֹתָם"
