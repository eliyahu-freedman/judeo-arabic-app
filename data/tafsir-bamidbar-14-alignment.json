        "en": "except Caleb",
        "he": "כִּי אִם-כָּלֵב"
      },
      {
        "ja": "אבן יפנה",
        "en": "son of Jephunneh",
        "he": "בֶּן-יְפֻנֶּה"
      },
      {
        "ja": "ויהושע",
        "en": "and Joshua",
        "he": "וִיהוֹשֻׁעַ"
      },
      {
        "ja": "אבן נון",
        "en": "son of Nun.'",
        "he": "בִּן-נוּן"
      }
    ],
    "31": [
      {
        "ja": "ואטפאלכם",
        "en": "'And your children,",
        "he": "וְטַפְּכֶם"
      },
      {
        "ja": "אלד'י קלתם",
        "en": "whom you said",
        "he": "אֲשֶׁר אֲמַרְתֶּם"
      },
      {
        "ja": "אנהם יצירו ג'נימה",
        "en": "would become spoil —",
        "he": "לָבַז יִהְיֶה"
      },
      {
        "ja": "פאני אדכ'להם",
        "en": "them I will bring in,",
        "he": "וְהֵבֵיאתִי אֹתָם"
      },
      {
        "ja": "חתא יערפון",
        "en": "so that they may know",
        "he": "וְיָדְעוּ"
      },
      {
        "ja": "פצ'ילה' אלבלד",
        "en": "the excellence of the land",
        "he": "אֶת-הָאָרֶץ"
      },
      {
        "ja": "אלד'י זהדתם פיה",
        "en": "which you have despised.'",
        "he": "אֲשֶׁר מְאַסְתֶּם בָּהּ"
      }
    ],
    "32": [
      {
        "ja": "אמא אגסאדכם",
        "en": "'But your bodies —",
        "he": "וּפִגְרֵיכֶם"
      },
      {
        "ja": "אנתם",
        "en": "you yourselves —",
        "he": "אַתֶּם"
      },
      {
        "ja": "פתקע",
        "en": "shall fall",
        "he": "יִפְּלוּ"
      },
      {
        "ja": "פי הד'א אלבר",
        "en": "in this wilderness.'",
        "he": "בַּמִּדְבָּר הַזֶּה"
      }
    ],
    "33": [
      {
        "ja": "ובניכם",
        "en": "'And your sons",
        "he": "וּבְנֵיכֶם"
      },
      {
        "ja": "יקימון תאיהין",
        "en": "shall remain wandering",
        "he": "יִהְיוּ רֹעִים"
      },
      {
        "ja": "פי אלבר",
        "en": "in the wilderness",
        "he": "בַּמִּדְבָּר"
      },
      {
        "ja": "ארבעין סנה",
        "en": "forty years,",
        "he": "אַרְבָּעִים שָׁנָה"
      },
      {
        "ja": "ויחמלון",
        "en": "and shall bear",
        "he": "וְנָשְׂאוּ"
      },
      {
        "ja": "טג'יאנכם",
        "en": "the burden of your rebellion —",
        "he": "אֶת-זְנוּתֵיכֶם"
      },
      {
        "ja": "אלי'' פנא",
        "en": "until the perishing of",
        "he": "עַד-תֹּם"
      },
      {
        "ja": "אגסאדכם פיה",
        "en": "your bodies therein.'",
        "he": "פִּגְרֵיכֶם בַּמִּדְבָּר"
      }
    ],
    "34": [
      {
        "ja": "באחצא אלאייאם",
        "en": "'By the count of the days",
        "he": "בְּמִסְפַּר הַיָּמִים"
      },
      {
        "ja": "אלד'י רמתם",
        "en": "in which you sought out",
        "he": "אֲשֶׁר-תַּרְתֶּם"
      },
      {
        "ja": "אלבלד פיהא",
        "en": "the land —",
        "he": "אֶת-הָאָרֶץ"
      },
      {
        "ja": "ארבעין יומא",
        "en": "forty days,",
        "he": "אַרְבָּעִים יוֹם"
      },
      {
        "ja": "לכל יום סנה",
        "en": "a year for each day —",
        "he": "יוֹם לַשָּׁנָה"
      },
      {
        "ja": "תחמלון אוזארכם",
        "en": "you shall bear your burdens",
        "he": "תִּשְׂאוּ אֶת-עֲו‍ֹנֹתֵיכֶם"
      },
      {
        "ja": "אלי' תמאם ארבעין סנה",
        "en": "for a full forty years,",
        "he": "אַרְבָּעִים שָׁנָה"
      },
      {
        "ja": "פתערפון",
        "en": "and you shall come to know",
        "he": "וִידַעְתֶּם"
      },
      {
        "ja": "מוצ'ע אענאתי",
        "en": "the consequence of My displeasure.'",
        "he": "אֶת-תְּנוּאָתִי"
      }
    ],
    "35": [
      {
        "ja": "אנא אללה",
        "en": "'I, God,",
        "he": "אֲנִי יְהוָה"
      },
      {
        "ja": "קלת ד'אלך",
        "en": "have spoken this",
        "he": "דִּבַּרְתִּי"
      },
      {
        "ja": "ואצנעה",
        "en": "and I will do it —",
        "he": "אִם-לֹא זֹאת אֶעֱשֶׂה"
      },
      {
        "ja": "בגמיע הד'ה אלגמאעה אלרדייה",
        "en": "against all this wicked congregation,",
        "he": "לְכָל-הָעֵדָה הָרָעָה הַזֹּאת"
      },
      {
        "ja": "אלמגתמעה עליי",
        "en": "gathered against Me:",
        "he": "הַנּוֹעָדִים עָלָי"
      },
      {
        "ja": "פי הד'א אלבר",
        "en": "in this wilderness",
        "he": "בַּמִּדְבָּר הַזֶּה"
      },
      {
        "ja": "יפנון",
        "en": "they shall perish",
        "he": "יִתַּמּוּ"
      },
      {
        "ja": "באלמות",
        "en": "by death.'",
        "he": "וְשָׁם יָמֻתוּ"
      }
    ],
    "36": [
      {
        "ja": "ואלרגאל",
        "en": "And the men",
        "he": "וְהָאֲנָשִׁים"
      },
      {
        "ja": "אלד'י בעת' בהם מוסי'",
        "en": "whom Moses had sent",
        "he": "אֲשֶׁר-שָׁלַח מֹשֶׁה"
      },
      {
        "ja": "לירומו אלבלד",
        "en": "to seek out the land —",
        "he": "לָתוּר אֶת-הָאָרֶץ"
      },
      {
        "ja": "פרגעו",
        "en": "who returned",
        "he": "וַיָּשֻׁבוּ"
      },
      {
        "ja": "וד'מרו עליה",
        "en": "and incited the congregation against him,",
        "he": "וילונו (וַיַּלִּינוּ) עָלָיו"
      },
      {
        "ja": "אלגמאעה",
        "en": "and spread a reproach",
        "he": "אֶת-כָּל-הָעֵדָה"
      },
      {
        "ja": "ואכ'רגו שנאעה",
        "en": "upon the land —",
        "he": "לְהוֹצִיא דִבָּה"
      },
      {
        "ja": "עלי' אלבלד",
        "en": "",
        "he": "עַל-הָאָרֶץ"
      }
    ],
    "37": [
      {
        "ja": "פמאת",
        "en": "those men died",
        "he": "וַיָּמֻתוּ"
      },
      {
        "ja": "אולאיך אלרגאל",
        "en": "by a blow",
        "he": "הָאֲנָשִׁים מוֹצִאֵי דִבַּת-הָאָרֶץ רָעָה"
      },
      {
        "ja": "באלצדאם",
        "en": "before God.",
        "he": "בַּמַּגֵּפָה"
      },
      {
        "ja": "בין ידי אללה",
        "en": "",
        "he": "לִפְנֵי יְהוָה"
      }
    ],
    "38": [
      {
        "ja": "ויהושע",
        "en": "But Joshua",
        "he": "וִיהוֹשֻׁעַ"
      },
      {
        "ja": "אבן נון",
        "en": "son of Nun",
        "he": "בִּן-נוּן"
      },
      {
        "ja": "וכלב",
        "en": "and Caleb",
        "he": "וְכָלֵב"
      },
      {
        "ja": "אבן יפונה",
        "en": "son of Jephunneh",
        "he": "בֶּן-יְפֻנֶּה"
      },
      {
        "ja": "עאשו",
        "en": "lived,",
        "he": "חָיוּ"
      },
      {
        "ja": "מן ג'מלה' אלרגאל",
        "en": "from among the men",
        "he": "מִן-הָאֲנָשִׁים הָהֵם"
      },
      {
        "ja": "אלד'י מצ'ו לירומו",
        "en": "who had gone to seek out",
        "he": "הַהֹלְכִים לָתוּר"
      },
      {
        "ja": "אלבלד",
        "en": "the land.",
        "he": "אֶת-הָאָרֶץ"
      }
    ],
    "39": [
      {
        "ja": "ולמא כלם",
        "en": "And when Moses spoke",
        "he": "וַיְדַבֵּר"
      },
      {
        "ja": "מוסי''",
        "en": "these words",
        "he": "מֹשֶׁה"
      },
      {
        "ja": "בהד'א אלכלאם",
        "en": "to the congregation of",
        "he": "אֶת-הַדְּבָרִים הָאֵלֶּה"
      },
      {
        "ja": "גמאעה' בני אסראיל",
        "en": "the sons of Israel,",
        "he": "אֶל-כָּל-בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "פחזן אלקום",
        "en": "the people grieved",
        "he": "וַיִּתְאַבְּלוּ הָעָם"
      },
      {
        "ja": "גדא",
        "en": "greatly.",
        "he": "מְאֹד"
      }
    ],
    "40": [
      {
        "ja": "ואדלגו",
        "en": "And they rose early",
        "he": "וַיַּשְׁכִּמוּ"
      },
      {
        "ja": "באלג'דאה",
        "en": "in the morning",
        "he": "בַבֹּקֶר"
      },
      {
        "ja": "וצעדו",
        "en": "and went up",
        "he": "וַיַּעֲלוּ"
      },
      {
        "ja": "אלי' ראס אלגבל",
        "en": "to the top of the mountain,",
        "he": "אֶל-רֹאשׁ-הָהָר"
      },
      {
        "ja": "וקאלו",
        "en": "and said:",
        "he": "לֵאמֹר"
      },
      {
        "ja": "הא נחן",
        "en": "'Here we are,",
        "he": "הִנֶּנּוּ"
      },
      {
        "ja": "צאעדין",
        "en": "and we will go up",
        "he": "וְעָלִינוּ"
      },
      {
        "ja": "אלי' אלמוצ'ע",
        "en": "to the place",
        "he": "אֶל-הַמָּקוֹם"
      },
      {
        "ja": "אלד'י אמרנא אללה",
        "en": "which God commanded us —",
        "he": "אֲשֶׁר-אָמַר יְהוָה"
      },
      {
        "ja": "פקד אכ'טאנא",
        "en": "for we have indeed sinned.'",
        "he": "כִּי חָטָאנוּ"
      }
    ],
    "41": [
      {
        "ja": "קאל להם מוסי'",
        "en": "Moses said to them:",
        "he": "וַיֹּאמֶר מֹשֶׁה"
      },
      {
        "ja": "יא קום",
        "en": "'O people,"
      },
      {
        "ja": "לא תתגאוזו",
        "en": "do not transgress",
        "he": "לָמָּה זֶּה אַתֶּם עֹבְרִים"
      },
      {
        "ja": "אמר אללה",
        "en": "the command of God —",
        "he": "אֶת-פִּי יְהוָה"
      },
      {
        "ja": "פאנהא לא תנגח",
        "en": "for it will not succeed.'",
        "he": "וְהִוא לֹא תִצְלָח"
      }
    ],
    "42": [
      {
        "ja": "לא תצעדו",
        "en": "'Do not go up —",
        "he": "אַל-תַּעֲלוּ"
      },
      {
        "ja": "אן נור אללה",
        "en": "for the light of God",
        "he": "כִּי אֵין יְהוָה"
      },
      {
        "ja": "ליס הו מעכם",
        "en": "is not with you —",
        "he": "בְּקִרְבְּכֶם"
      },
      {
        "ja": "ולא תנצדמו",
        "en": "lest you be struck down",
        "he": "וְלֹא תִּנָּגְפוּ"
      },
      {
        "ja": "בין ידי אעדאיכם",
        "en": "before your enemies.'",
        "he": "לִפְנֵי אֹיְבֵיכֶם"
      }
    ],
    "43": [
      {
        "ja": "פאן אלעמאלקה",
        "en": "'For the Amalekites",
        "he": "כִּי הָעֲמָלֵקִי"
      },
      {
        "ja": "ואלכנעאניין",
        "en": "and the Canaanites",
        "he": "וְהַכְּנַעֲנִי"
      },
      {
        "ja": "ת'ם בין אידיכם",
        "en": "are there before you,",
        "he": "שָׁם לִפְנֵיכֶם"
      },
      {
        "ja": "פתקעון",
        "en": "and you will fall",
        "he": "וּנְפַלְתֶּם"
      },
      {
        "ja": "באלסיף",
        "en": "by the sword —",
        "he": "בֶּחָרֶב"
      },
      {
        "ja": "לאנכם רגעתם",
        "en": "because you have turned back",
        "he": "כִּי-עַל-כֵּן שַׁבְתֶּם"
      },
      {
        "ja": "ען טאעה' אללה",
        "en": "from obedience to God,",
        "he": "מֵאַחֲרֵי יְהוָה"
      },
      {
        "ja": "פלא יכון אללה",
        "en": "and God will not be",
        "he": "וְלֹא-יִהְיֶה יְהוָה"
      },
      {
        "ja": "מעכם",
        "en": "with you.'",
        "he": "עִמָּכֶם"
      }
    ],
    "44": [
      {
        "ja": "פאעתדו",
        "en": "Yet they acted presumptuously",
        "he": "וַיַּעְפִּלוּ"
      },
      {
        "ja": "וצעדו",
        "en": "and went up",
        "he": "לַעֲלוֹת"
      },
      {
        "ja": "אלי' ראס אלגבל",
        "en": "to the top of the mountain;",
        "he": "אֶל-רֹאשׁ הָהָר"
      },
      {
        "ja": "וצנדוק עהד אללה",
        "en": "but the ark of the covenant of God",
        "he": "וַאֲרוֹן בְּרִית-יְהוָה"
      },
      {
        "ja": "ומוסי",
        "en": "and Moses",
        "he": "וּמֹשֶׁה"
      },
      {
        "ja": "לם יזולא",
        "en": "did not stir",
        "he": "לֹא-מָשׁוּ"
      },
      {
        "ja": "מן וסט אלעסכר",
        "en": "from the midst of the camp.",
        "he": "מִקֶּרֶב הַמַּחֲנֶה"
      }
    ],
    "45": [
      {
        "ja": "פנזל אלעמלאקיין",
        "en": "And the Amalekites and the Canaanites",
        "he": "וַיֵּרֶד הָעֲמָלֵקִי"
      },
      {
        "ja": "ואלכנעאניין",
        "en": "who dwelt in that mountain came down,",
        "he": "וְהַכְּנַעֲנִי"
      },
      {
        "ja": "אלמקימין פי ד'אלך אלגבל",
        "en": "and struck them",
        "he": "הַיֹּשֵׁב בָּהָר הַהוּא"
      },
      {
        "ja": "פצ'רבוהם",
        "en": "and shattered them",
        "he": "וַיַּכּוּם"
      },
      {
        "ja": "וחטמוהם",
        "en": "as far as Hormah.",
        "he": "וַיַּכְּתוּם"
      },
      {
        "ja": "אלי' חרמה",
        "en": "",
        "he": "עַד-הַחָרְמָה"
      }
    ]
  }
}