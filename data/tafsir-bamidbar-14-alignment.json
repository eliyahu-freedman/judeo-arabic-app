        "he": "אֲשֶׁר-שָׁמְעוּ"
      },
      {
        "ja": "אכ'ברך הד'ה",
        "en": "",
        "he": "אֶת-שִׁמְעֲךָ"
      },
      {
        "ja": "קאילין",
        "en": "",
        "he": "לֵאמֹר"
      }
    ],
    "16": [
      {
        "ja": "ממא לם יטיק",
        "en": "'It was because the Lord was unable",
        "he": "מִבִּלְתִּי יְכֹלֶת"
      },
      {
        "ja": "אלרב",
        "en": "to bring",
        "he": "יְהוָה"
      },
      {
        "ja": "אן ידכ'ל",
        "en": "these people",
        "he": "לְהָבִיא"
      },
      {
        "ja": "הולאי אלקום",
        "en": "into the land",
        "he": "אֶת-הָעָם הַזֶּה"
      },
      {
        "ja": "אלי' אלבלד",
        "en": "which He had promised them —",
        "he": "אֶל-הָאָרֶץ"
      },
      {
        "ja": "אלד'י ועדהם בה",
        "en": "so He slew them",
        "he": "אֲשֶׁר-נִשְׁבַּע לָהֶם"
      },
      {
        "ja": "פקתלהם",
        "en": "in the wilderness.'",
        "he": "וַיִּשְׁחָטֵם"
      },
      {
        "ja": "פי אלבר",
        "en": "",
        "he": "בַּמִּדְבָּר"
      }
    ],
    "17": [
      {
        "ja": "ואלאן",
        "en": "'And now,",
        "he": "וְעַתָּה"
      },
      {
        "ja": "יתביין",
        "en": "let the greatness of Your power be made manifest,",
        "he": "יִגְדַּל-נָא"
      },
      {
        "ja": "עצ'ם קדרתך",
        "en": "O Lord,",
        "he": "כֹּחַ אֲדֹנָי"
      },
      {
        "ja": "יא רב",
        "en": "as You spoke to me.'"
      },
      {
        "ja": "כמא קלת",
        "en": "",
        "he": "כַּאֲשֶׁר דִּבַּרְתָּ"
      },
      {
        "ja": "לי",
        "en": "",
        "he": "לֵאמֹר"
      }
    ],
    "18": [
      {
        "ja": "אנך אללה",
        "en": "'That You are God —",
        "he": "יְהוָה"
      },
      {
        "ja": "טויל אלמהל",
        "en": "long in forbearance,",
        "he": "אֶרֶךְ אַפַּיִם"
      },
      {
        "ja": "כת'יר אלפצ'ל",
        "en": "abounding in grace,",
        "he": "וְרַב-חֶסֶד"
      },
      {
        "ja": "ג'אפר אלד'נב",
        "en": "forgiving iniquity",
        "he": "נֹשֵׂא עָו‍ֹן"
      },
      {
        "ja": "ואלגרם",
        "en": "together with transgression —",
        "he": "וָפָשַׁע"
      },
      {
        "ja": "ויברי",
        "en": "and acquits,",
        "he": "וְנַקֵּה"
      },
      {
        "ja": "ולא יברי",
        "en": "yet does not wholly acquit —",
        "he": "לֹא יְנַקֶּה"
      },
      {
        "ja": "מטאלב בד'נוב אלאבא",
        "en": "visiting the iniquities of the fathers",
        "he": "פֹּקֵד עֲו‍ֹן אָבוֹת"
      },
      {
        "ja": "מע אלבנין",
        "en": "upon the sons,",
        "he": "עַל-בָּנִים"
      },
      {
        "ja": "ואלת'ואלת'",
        "en": "and upon the third",
        "he": "עַל-שִׁלֵּשִׁים"
      },
      {
        "ja": "ואלרואבע",
        "en": "and upon the fourth generation.'",
        "he": "וְעַל-רִבֵּעִים"
      }
    ],
    "19": [
      {
        "ja": "אצפח",
        "en": "'Pardon",
        "he": "סְלַח-נָא"
      },
      {
        "ja": "ד'נב",
        "en": "the iniquity of",
        "he": "לַעֲו‍ֹן"
      },
      {
        "ja": "הולאי אלקום",
        "en": "these people",
        "he": "הָעָם הַזֶּה"
      },
      {
        "ja": "בכת'רה' פצ'לך",
        "en": "according to the abundance of Your grace,",
        "he": "כְּגֹדֶל חַסְדֶּךָ"
      },
      {
        "ja": "וכמא אחתמלת",
        "en": "and as You have borne",
        "he": "וְכַאֲשֶׁר נָשָׂאתָה"
      },
      {
        "ja": "להם",
        "en": "with them",
        "he": "לָעָם הַזֶּה"
      },
      {
        "ja": "מן מצר",
        "en": "from Egypt",
        "he": "מִמִּצְרַיִם"
      },
      {
        "ja": "ואלי' אלאן",
        "en": "until now.'",
        "he": "וְעַד-הֵנָּה"
      }
