        "he": "וַהֲבִיאֹתִיו"
      },
      {
        "ja": "אלי' אלבלד",
        "en": "into the land",
        "he": "אֶל-הָאָרֶץ"
      },
      {
        "ja": "אלד'י צאר אליה",
        "en": "which he reached,",
        "he": "אֲשֶׁר-בָּא שָׁמָּה"
      },
      {
