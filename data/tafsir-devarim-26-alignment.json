        "he": "לֹא-עָבַרְתִּי מִמִּצְו‍ֹתֶיךָ"
      },
      {
        "ja": "ולם אנס ד'אלך",
        "en": "nor have I forgotten that",
        "he": "וְלֹא שָׁכָחְתִּי"
      }
    ],
    "14": [
      {
        "ja": "ואלעשר אלד'י הו לי לם אכל מנה פי חזני",
        "en": "And the tithe which is mine — I did not eat of it in my grief",
        "he": "לֹא-אָכַלְתִּי בְאֹנִי מִמֶּנּוּ"
      },
      {
        "ja": "ולם אצרף מנה אלי' נגס",
        "en": "nor did I divert any of it to anything impure",
        "he": "וְלֹא-בִעַרְתִּי מִמֶּנּוּ בְּטָמֵא"
      },
      {
        "ja": "ולא פי חואיג מיית",
        "en": "nor for the needs of a dead person",
        "he": "וְלֹא-נָתַתִּי מִמֶּנּוּ לְמֵת"
      },
      {
        "ja": "בל קבלת אמר אללה רבי",
        "en": "rather, I accepted the command of God my Lord",
        "he": "שָׁמַעְתִּי בְּקוֹל יְהוָה אֱלֹהָי"
      },
      {
        "ja": "וצנעת כגמיע מא אמרתני",
        "en": "and I acted according to all that You commanded me",
        "he": "עָשִׂיתִי כְּכֹל אֲשֶׁר צִוִּיתָנִי"
      }
    ],
    "15": [
      {
        "ja": "אטלע",
        "en": "Look out",
        "he": "הַשְׁקִיפָה"
      },
      {
        "ja": "מן מוטן קדסך",
        "en": "from the abode of Your holiness",
        "he": "מִמְּעוֹן קָדְשְׁךָ"
      },
      {
        "ja": "מן אלסמא",
        "en": "from the heavens",
        "he": "מִן-הַשָּׁמַיִם"
      },
      {
        "ja": "ובארך",
        "en": "and bestow Your blessing",
        "he": "וּבָרֵךְ"
      },
      {
        "ja": "פי שעבך",
        "en": "upon Your people",
        "he": "אֶת-עַמְּךָ"
      },
      {
        "ja": "אל אסראיל",
        "en": "the house of Israel",
        "he": "אֶת-יִשְׂרָאֵל"
      },
      {
        "ja": "ופי אלארץ'",
        "en": "and upon the land",
        "he": "וְאֵת הָאֲדָמָה"
      },
      {
        "ja": "אלד'י אעטיתנא",
        "en": "which You gave us",
        "he": "אֲשֶׁר נָתַתָּה לָנוּ"
      },
      {
        "ja": "כמא קסמת לאבאינא",
        "en": "as You swore to our fathers",
        "he": "כַּאֲשֶׁר נִשְׁבַּעְתָּ לַאֲבֹתֵינוּ"
      },
      {
        "ja": "אן תכון ארצ'א תפיץ' לבנא",
        "en": "that it be a land flowing with milk",
        "he": "אֶרֶץ זָבַת חָלָב"
      },
      {
        "ja": "ועסלא",
        "en": "and honey",
        "he": "וּדְבָשׁ"
      }
    ],
    "16": [
      {
        "ja": "ואעלם",
        "en": "And know"
      },
      {
        "ja": "הד'א אליום",
        "en": "this day",
        "he": "הַיּוֹם הַזֶּה"
      },
      {
        "ja": "אללה רבך",
        "en": "that God your Lord",
        "he": "יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "יאמרך",
        "en": "commands you",
        "he": "מְצַוְּךָ"
      },
      {
        "ja": "באן תצנע",
        "en": "to perform",
        "he": "לַעֲשׂוֹת"
      },
      {
        "ja": "הד'ה אלרסום",
        "en": "these statutes",
        "he": "אֶת-הַחֻקִּים הָאֵלֶּה"
      },
      {
        "ja": "ואלאחכאם",
        "en": "and ordinances",
        "he": "וְאֶת-הַמִּשְׁפָּטִים"
      },
      {
        "ja": "פאחפצ'הא",
        "en": "so keep them",
        "he": "וְשָׁמַרְתָּ"
      },
      {
        "ja": "ואעמל בהא",
        "en": "and act by them",
        "he": "וְעָשִׂיתָ אוֹתָם"
      },
      {
        "ja": "בכל קלבך",
        "en": "with all your heart",
        "he": "בְּכָל-לְבָבְךָ"
      },
      {
        "ja": "ונפסך",
        "en": "and your soul",
        "he": "וּבְכָל-נַפְשֶׁךָ"
      }
    ],
    "17": [
      {
        "ja": "ואנת כמא ומרת אללה רבך",
        "en": "And you, even as you have made God your Lord sovereign over you",
        "he": "אֶת-יְהוָה הֶאֱמַרְתָּ הַיּוֹם"
      },
      {
        "ja": "אן יכון לך אלאהא",
        "en": "that He be your God",
        "he": "לִהְיוֹת לְךָ לֵאלֹהִים"
      },
      {
        "ja": "ואן תסיר פי טרקה",
        "en": "and that you walk in His ways",
        "he": "וְלָלֶכֶת בִּדְרָכָיו"
      },
      {
        "ja": "ותחפץ' רסומה",
        "en": "and keep His statutes",
        "he": "וְלִשְׁמֹר חֻקָּיו"
      },
      {
        "ja": "ווצאיאה",
        "en": "and His commandments",
        "he": "וּמִצְו‍ֹתָיו"
      },
      {
        "ja": "ואחכאמה",
        "en": "and His ordinances",
        "he": "וּמִשְׁפָּטָיו"
      },
      {
        "ja": "ותקבל אמרה",
        "en": "and accept His command",
        "he": "וְלִשְׁמֹעַ בְּקֹלוֹ"
      }
    ],
    "18": [
      {
        "ja": "פכד'אך ומרך אללה",
        "en": "so likewise has God made you sovereign",
        "he": "וַיהוָה הֶאֱמִירְךָ הַיּוֹם"
      },
      {
        "ja": "לתכון לה אמה כ'אצה",
        "en": "to be for Him a particular nation",
        "he": "לִהְיוֹת לוֹ לְעַם סְגֻלָּה"
      },
      {
        "ja": "כמא ועדך",
        "en": "as He promised you",
        "he": "כַּאֲשֶׁר דִּבֶּר-לָךְ"
      },
      {
        "ja": "ותחפץ' גמיע וצאיאה",
        "en": "and that you keep all His commandments",
        "he": "וְלִשְׁמֹר כָּל-מִצְו‍ֹתָיו"
      }
    ],
    "19": [
      {
        "ja": "ואן יגעלך עאליא",
        "en": "and that He set you high",
        "he": "וּלְתִתְּךָ עֶלְיוֹן"
      },
      {
        "ja": "עלי' סאיר אלאמם",
        "en": "above the rest of the nations",
        "he": "עַל כָּל-הַגּוֹיִם"
      },
      {
        "ja": "אלד'י כ'לקהם",
        "en": "whom He created",
        "he": "אֲשֶׁר עָשָׂה"
      },
      {
        "ja": "מדחא",
        "en": "in praise",
        "he": "לִתְהִלָּה"
      },
      {
        "ja": "ואסמא",
        "en": "and in renown",
        "he": "וּלְשֵׁם"
      },
      {
        "ja": "ופכ'רא",
        "en": "and in glory",
        "he": "וּלְתִפְאָרֶת"
      },
      {
        "ja": "ואן תכון שעב מקדס",
        "en": "and that you be a holy people",
        "he": "וְלִהְיֹתְךָ עַם-קָדֹשׁ"
      },
      {
        "ja": "ללה רבך",
        "en": "to God your Lord",
        "he": "לַיהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "כמא ועדך",
        "en": "as He promised you",
        "he": "כַּאֲשֶׁר דִּבֵּר"
      }
    ]
  }
}