        "he": "וּבָנִים לֹא-יוּמְתוּ עַל-אָבוֹת"
      },
      {
        "ja": "בל יקתל כל אמר בכ'טייתה",
        "en": "rather, every person shall be put to death for his own transgression",
        "he": "אִישׁ בְּחֶטְאוֹ יוּמָתוּ"
      }
    ],
    "17": [
      {
        "ja": "ולא תמייל",
        "en": "And do not pervert",
        "he": "לֹא תַטֶּה"
      },
      {
        "ja": "חכם ג'ריב",
        "en": "the judgement of a stranger",
        "he": "מִשְׁפַּט גֵּר"
      },
      {
        "ja": "או יתים",
        "en": "or an orphan",
        "he": "יָתוֹם"
      },
      {
        "ja": "ולא תסתרהן",
        "en": "and do not take",
        "he": "וְלֹא תַחֲבֹל"
      },
      {
        "ja": "ת'וב אלארמלה",
        "en": "the garment of a widow as pledge",
        "he": "בֶּגֶד אַלְמָנָה"
      }
    ],
    "18": [
      {
        "ja": "ואד'כר",
        "en": "And remember",
        "he": "וְזָכַרְתָּ"
      },
      {
        "ja": "אנך כנת עבדא",
        "en": "that you were a slave",
        "he": "כִּי עֶבֶד הָיִיתָ"
      },
      {
        "ja": "במצר",
        "en": "in Egypt",
        "he": "בְּמִצְרַיִם"
      },
      {
        "ja": "אללה",
        "en": "God",
        "he": "יְהוָה"
      },
      {
        "ja": "רבך",
        "en": "your Lord",
        "he": "אֱלֹהֶיךָ"
      },
      {
        "ja": "ופכך",
        "en": "redeemed you",
        "he": "וַיִּפְדְּךָ"
      },
      {
        "ja": "מן ת'ם",
        "en": "from there",
        "he": "מִשָּׁם"
      },
      {
        "ja": "ולדאלך",
        "en": "and therefore",
        "he": "עַל-כֵּן"
      },
      {
        "ja": "אנא אמרך",
        "en": "I command you",
        "he": "אָנֹכִי מְצַוְּךָ"
      },
      {
        "ja": "באן תצנע",
        "en": "to do",
        "he": "לַעֲשׂוֹת"
      },
      {
        "ja": "הד'ה אלאמור",
        "en": "these things",
        "he": "אֶת-הַדָּבָר הַזֶּה"
      }
    ],
    "19": [
      {
        "ja": "ואד'א חצדת",
        "en": "And when you reap",
        "he": "כִּי תִקְצֹר"
      },
      {
        "ja": "חצאדך",
        "en": "your harvest",
        "he": "קְצִירְךָ"
      },
      {
        "ja": "פי צ'יעתך",
        "en": "in your field",
        "he": "בְשָׂדֶךָ"
      },
      {
        "ja": "ונסית",
        "en": "and you forget",
        "he": "וְשָׁכַחְתָּ"
      },
      {
        "ja": "כפה",
        "en": "a sheaf",
        "he": "עֹמֶר"
      },
      {
        "ja": "פי אלצחרא",
        "en": "in the open country",
        "he": "בַּשָּׂדֶה"
      },
      {
        "ja": "פלא תרגע פתאכ'ד'הא",
        "en": "do not go back to take it",
        "he": "לֹא תָשׁוּב לְקַחְתּוֹ"
      },
      {
        "ja": "בל יכון לאלג'ריב",
        "en": "rather, let it be for the stranger",
        "he": "לַגֵּר"
      },
      {
        "ja": "ואליתים",
        "en": "and the orphan",
        "he": "לַיָּתוֹם"
      },
      {
        "ja": "ואלארמלה",
        "en": "and the widow",
        "he": "וְלָאַלְמָנָה יִהְיֶה"
      },
      {
        "ja": "לכי יבארך לך אללה רבך",
        "en": "so that God your Lord may bless you",
        "he": "לְמַעַן יְבָרֶכְךָ יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "פי גמיע עמל ידך",
        "en": "in all the work of your hands",
        "he": "בְּכֹל מַעֲשֵׂה יָדֶיךָ"
      }
    ],
    "20": [
      {
        "ja": "ואד'א כ'רטת זיתונך",
        "en": "And when you beat your olive trees",
        "he": "כִּי תַחְבֹּט זֵיתְךָ"
      },
      {
        "ja": "פלא תסתקצה בעד ד'אלך",
