        "ja": "ואצלחת מוצ'ע לאלגמאל",
        "en": "prepared a place for the camels"
      }
    ],
    "32": [
      {
        "ja": "ודכ'ל אלרגל",
        "en": "the man came"
      },
      {
        "ja": "אלי' אלבית",
        "en": "into the house"
      },
      {
        "ja": "וחל ען אלגמאל",
        "en": "he unloaded the camels"
      },
      {
        "ja": "ואעטא תבנא וקתא",
        "en": "he gave straw and feed"
      },
      {
        "ja": "לאלגמאל",
        "en": "to the camels"
      },
      {
        "ja": "ומאא",
        "en": "and water"
      },
      {
        "ja": "יג'סל רגליה",
        "en": "to wash his feet"
      },
      {
        "ja": "וארגל אלקום",
        "en": "and the feet of the men"
      },
      {
        "ja": "אלד'י מעה",
        "en": "who were with him"
      }
    ],
    "33": [
      {
        "ja": "ת'ם צייר בין ידיה",
        "en": "Then [food] was set before him"
      },
      {
        "ja": "ליאכל",
        "en": "to eat"
      },
      {
        "ja": "פקאל",
        "en": "But he said"
      },
      {
        "ja": "לא אכל",
        "en": "I will not eat"
      },
      {
        "ja": "חתי' אקול כלאמי",
        "en": "until I have said my words"
      },
      {
        "ja": "קאל",
        "en": "He said"
      },
      {
        "ja": "תכלם",
        "en": "Speak"
      }
    ],
    "34": [
      {
        "ja": "קאל",
        "en": "He said"
      },
      {
        "ja": "אנא עבד אברהים",
        "en": "I am the servant of Abraham"
      }
    ],
    "35": [
      {
        "ja": "ואללה בארך למולאי",
        "en": "God has greatly blessed my master"
      },
      {
        "ja": "גדא פכת'ר",
        "en": "he has grown great"
      },
      {
        "ja": "ואעטאה",
        "en": "He has given him"
      },
      {
        "ja": "ג'נמא ובקרא",
        "en": "sheep and cattle"
      },
      {
        "ja": "ופצ'ה וד'הב",
        "en": "and silver and gold"
      },
      {
        "ja": "ועביד ואמא",
        "en": "and male and female slaves"
      },
      {
        "ja": "וגמאל וחמיר",
        "en": "and camels and donkeys"
      }
    ],
    "36": [
      {
        "ja": "פולדת שרה",
        "en": "Sarah"
      },
      {
        "ja": "זוגה' מולאי",
        "en": "my master's wife"
      },
      {
        "ja": "אבנא לה",
        "en": "bore him a son"
      },
      {
        "ja": "פי שיכ'וכ'תהא",
        "en": "in her old age"
      },
      {
        "ja": "פאעטאה גמיע מאלה",
        "en": "he gave to him all that he has"
      }
    ],
    "37": [
      {
        "ja": "פחלפני מולאי",
        "en": "my master made me swear"
      },
      {
        "ja": "קאילא",
        "en": "saying"
      },
      {
        "ja": "לא תאכ'ד' זוגה לאבני",
        "en": "You shall not take a wife for my son"
      },
      {
        "ja": "מן בנאת אלכנעאניין",
        "en": "from the daughters of the Canaanites"
      },
      {
        "ja": "אלד'י אנא מקים פי מא בינהם",
        "en": "in whose land I dwell"
      }
    ],
    "38": [
      {
        "ja": "אלא אלי' בית אבי",
        "en": "rather to my father's house"
      },
      {
        "ja": "תמצ'י",
        "en": "you shall go"
      },
      {
        "ja": "ואלי' עשירתי",
        "en": "and to my kindred"
      },
      {
        "ja": "ותאכ'ד' זוגה לאבני",
        "en": "and you shall take a wife for my son"
      }
    ],
    "39": [
      {
        "ja": "פקלת למולאי",
        "en": "I said to my master"
      },
      {
        "ja": "לעל לא תתבעני",
        "en": "Perhaps"
      },
      {
        "ja": "אלאמראה",
        "en": "the woman will not follow me"
      }
    ],
    "40": [
      {
        "ja": "פקאל לי",
        "en": "he said to me"
      },
      {
        "ja": "אללה",
        "en": "God"
      },
      {
        "ja": "אלד'י סלכת פי טאעתה",
        "en": "in whose obedience I have walked"
      },
      {
        "ja": "יבעת' במלכה",
        "en": "shall send His angel"
      },
      {
        "ja": "בין ידיך",
        "en": "before you"
      },
      {
        "ja": "וינגח טריקך",
        "en": "and grant your way success"
      },
      {
        "ja": "חתי תאכ'ד' זוגה לאבני",
        "en": "and you shall take a wife for my son"
      },
      {
        "ja": "מן עשירתי",
        "en": "from my kindred"
      },
      {
        "ja": "ומן בית אבי",
        "en": "and from my father's house"
      }
    ],
    "41": [
      {
        "ja": "חיניד'",
        "en": "Then"
      },
      {
        "ja": "תברו מן חרגי",
        "en": "shall you be free from this my charge"
      },
      {
        "ja": "אד'א צרת אלי' עשירתי",
        "en": "when you have come to my kindred"
      },
      {
        "ja": "ואן לם יעטוך",
        "en": "And if they shall not give her to you"
      },
      {
        "ja": "כנת ברייא מן חרגי",
        "en": "you shall be free from my charge"
      }
    ],
    "42": [
      {
        "ja": "פגית אליום",
        "en": "I came today"
      },
      {
        "ja": "אלי' אלעין",
        "en": "to the spring"
      },
      {
        "ja": "וקלת",
        "en": "I said"
      },
      {
        "ja": "אללהם",
        "en": "O God"
      },
      {
        "ja": "יא אלאה מולאי אברהים",
        "en": "God of my master Abraham"
      },
      {
        "ja": "אן כנת מנגח טריקי",
        "en": "if You are making my way prosper"
      },
      {
        "ja": "אלד'י אנא סאיר פיה",
        "en": "on which I am going"
      }
    ],
    "43": [
      {
        "ja": "הוד'י אנא ואקף",
        "en": "behold, I am standing"
      },
      {
        "ja": "עלי' עין אלמא",
        "en": "by the spring of water"
      },
      {
        "ja": "פאייה'",
        "en": "let it be that"
      },
      {
        "ja": "גאריה תכ'רג תסתקי",
        "en": "the maiden who comes forth to draw"
      },
      {
        "ja": "פאקול להא",
        "en": "to whom I say"
      },
      {
        "ja": "אסקיני",
        "en": "Let me drink"
      },
      {
        "ja": "קליל מא",
        "en": "a little water"
      },
      {
        "ja": "מן גרתך",
        "en": "from your jar"
      }
    ],
    "44": [
      {
        "ja": "ותקול לי",
        "en": "and she says to me"
      },
      {
        "ja": "אשרב",
        "en": "Drink"
      },
      {
        "ja": "ואיצ'א גמאלך אסקי",
        "en": "and I shall also water your camels"
      },
      {
        "ja": "הי אלאמראה",
        "en": "she is the woman"
      },
      {
        "ja": "אלד'י ופקהא אללה",
        "en": "whom God has destined"
      },
      {
        "ja": "לאבן מולאי",
        "en": "for the son of my master"
      }
    ],
    "45": [
      {
        "ja": "אנא קבל אן אפרג'",
        "en": "before I had finished"
      },
      {
        "ja": "מן אלכלאם",
        "en": "my speech"
      },
      {
        "ja": "פי נפסי",
        "en": "in my heart"
      },
      {
        "ja": "פאד'א ברבקה כ'ארגה",
        "en": "behold, Rebekah came forth"
      },
      {
        "ja": "וגרתהא עלי' כתפהא",
        "en": "her jar upon her shoulder"
      },
      {
        "ja": "פאנחדרת אלי' אלעין",
        "en": "she went down to the spring"
      },
      {
        "ja": "ואסתקת",
        "en": "and drew"
      },
      {
        "ja": "וקלת להא",
        "en": "I said to her"
      },
      {
        "ja": "אסקיני אלאן",
        "en": "Let me drink, now"
      }
    ],
    "46": [
      {
        "ja": "פאסרעת",
        "en": "she hastened"
      },
      {
        "ja": "ואנזלת גרתהא ענהא",
        "en": "let down her jar from her"
      },
      {
        "ja": "וקאלת",
        "en": "said"
      },
      {
        "ja": "אשרב",
        "en": "Drink"
      },
      {
        "ja": "ואיצ'א גמאלך אסקי",
        "en": "I shall also water your camels"
      },
      {
        "ja": "פשרבת",
        "en": "I drank"
      },
      {
        "ja": "ואסקת אלגמאל",
        "en": "she watered the camels"
      }
    ],
    "47": [
      {
        "ja": "פסאלתהא",
        "en": "I asked her"
      },
      {
        "ja": "וקלת להא",
        "en": "said to her"
      },
      {
        "ja": "אכ'בריני",
        "en": "Whose"
      },
      {
        "ja": "אבנה' מן אנת",
        "en": "daughter are you"
      },
      {
        "ja": "קאלת",
        "en": "She said"
      },
      {
        "ja": "אבנה' בתואל",
        "en": "The daughter of Bethuel"
      },
      {
        "ja": "אבן נחור",
        "en": "the son of Nahor"
      },
      {
        "ja": "אלד'י ולדת לה מלכה",
        "en": "whom Milkah bore to him"
      },
      {
        "ja": "פציירת אלשנף",
        "en": "I set the nose-ring"
      },
      {
        "ja": "עלי' אנפהא",
        "en": "upon her nose"
      },
      {
        "ja": "ואלסוארין",
        "en": "and the bracelets"
      },
      {
        "ja": "עלי' ידיהא",
        "en": "upon her hands"
      }
    ],
    "48": [
      {
        "ja": "פכ'רית",
        "en": "I bowed down"
      },
      {
        "ja": "וסגדת בין ידי אללה",
        "en": "prostrated myself before God"
      },
      {
        "ja": "ובארכת אללה",
        "en": "I blessed God"
      },
      {
        "ja": "אלאה מולאי אברהים",
        "en": "the God of my master Abraham"
      },
      {
        "ja": "אלד'י סיירני",
        "en": "who had led me"
      },
      {
        "ja": "פי טריק מסתקים",
        "en": "on a straight path"
      },
      {
        "ja": "לאכ'ד' אבנה' אכ'י מולאי",
        "en": "to take the daughter of my master's brother"
      },
      {
        "ja": "לאבנה",
        "en": "for his son"
      }
    ],
    "49": [
      {
        "ja": "ואלאן",
        "en": "And now"
      },
      {
        "ja": "אן כנתם צאנעין",
        "en": "if you are doing"
      },
      {
        "ja": "פצ'ל ואחסאן",
        "en": "kindness and grace"
      },
      {
        "ja": "מע מולאי",
        "en": "with my master"
      },
      {
        "ja": "אכ'ברוני",
        "en": "tell me"
      },
      {
        "ja": "ואלא אכ'ברוני",
        "en": "and if not — tell me"
      },
      {
        "ja": "חתי' אולי",
        "en": "that I may turn"
      },
      {
        "ja": "ימנה או יסרה",
        "en": "to the right or to the left"
      }
    ],
    "50": [
      {
        "ja": "פאגאבה לבן ובתואל",
        "en": "Laban and Bethuel answered"
      },
      {
        "ja": "וקאלו",
        "en": "and said"
      },
      {
        "ja": "מן ענד אללה",
        "en": "From before God"
      },
      {
        "ja": "כ'רג הד'א אלאמר",
        "en": "has this matter come forth"
      },
      {
        "ja": "לא נטיק נכלמך",
        "en": "we cannot speak to you"
      },
      {
        "ja": "בשר ולא בכ'יר",
        "en": "of evil or of good"
      }
    ],
    "51": [
      {
        "ja": "הוד'א רבקה",
        "en": "Behold, Rebekah"
      },
      {
        "ja": "בין ידיך",
        "en": "is before you"
      },
      {
        "ja": "כ'ד' ואמץ'",
        "en": "Take her and go"
      },
      {
        "ja": "ותכון זוגה",
        "en": "let her be a wife"
      },
      {
        "ja": "לאבן מולאך",
        "en": "for the son of your master"
      },
      {
        "ja": "כמא ופק אללה",
        "en": "as God has destined"
      }
    ],
    "52": [
      {
        "ja": "פלמא סמע עבד אברהים",
        "en": "when Abraham's servant heard"
      },
      {
        "ja": "כלאמהם",
        "en": "their words"
      },
      {
        "ja": "סגד עלי' אלארץ'",
        "en": "he bowed down upon the earth"
      },
      {
        "ja": "ללה",
        "en": "before God"
      }
    ],
    "53": [
      {
        "ja": "ואכ'רג אלעבד",
        "en": "the servant brought out"
      },
      {
        "ja": "אניה' פצ'ה",
        "en": "vessels of silver"
      },
      {
        "ja": "ואניה' ד'הב",
        "en": "and vessels of gold"
      },
      {
        "ja": "ותיאבא",
        "en": "and garments"
      },
      {
        "ja": "ואעטא רבקה",
        "en": "gave them to Rebekah"
      },
      {
        "ja": "ופואכהא",
        "en": "her fruits"
      },
      {
        "ja": "אעטא אכ'אהא ואמהא",
        "en": "he gave to her brother and her mother"
      }
    ],
    "54": [
      {
        "ja": "ואכלו ושרבו",
        "en": "they ate and drank"
      },
      {
        "ja": "הו ואלקום אלד'ין מעה",
        "en": "he and the men who were with him"
      },
      {
        "ja": "ובאתו",
        "en": "they lodged"
      },
      {
        "ja": "פלמא קאמו באלג'דאה",
        "en": "when they rose in the morning"
      },
      {
        "ja": "קאל",
        "en": "he said"
      },
      {
        "ja": "אטלקוני אלי' מולאי",
        "en": "Send me away to my master"
      }
    ],
    "55": [
      {
        "ja": "פקאל אכ'יהא ואמהא",
        "en": "Her brother and her mother said"
      },
      {
        "ja": "תקים אלגאריה מענא",
        "en": "Let the maiden stay with us"
      },
      {
        "ja": "חולא או עשרא",
        "en": "a year or ten [days]"
      },
      {
        "ja": "ובעד ד'אלך",
        "en": "after that"
      },
      {
        "ja": "תמצ'י",
        "en": "she may go"
      }
    ],
    "56": [
      {
        "ja": "קאל להם",
        "en": "He said to them"
      },
      {
        "ja": "לא תוכ'רוני",
        "en": "Delay me not"
      },
      {
        "ja": "ואללה קד אנגח טריקי",
        "en": "for God has made my way prosper"
      },
      {
        "ja": "אטלקוני",
        "en": "Send me away"
      },
      {
        "ja": "ואמצ'י אלי' מולאי",
        "en": "that I may go to my master"
      }
    ],
    "57": [
      {
        "ja": "קאלו",
        "en": "They said"
      },
      {
        "ja": "נדעו באלגאריה",
        "en": "Let us call the maiden"
      },
      {
        "ja": "ונסאלהא",
        "en": "and inquire"
      },
      {
        "ja": "ען קולהא",
        "en": "of her own words"
      }
    ],
    "58": [
      {
        "ja": "פדעו ברבקה",
        "en": "they called Rebekah"
      },
      {
        "ja": "וקאלו להא",
        "en": "and said to her"
      },
      {
        "ja": "אתמצ'ין",
        "en": "Will you go"
      },
      {
        "ja": "מע הד'א אלרגל",
        "en": "with this man"
      },
      {
        "ja": "קאלת",
        "en": "she said"
      },
      {
        "ja": "נעם",
        "en": "Yes"
      }
    ],
    "59": [
      {
        "ja": "פאטלקו רבקה אכ'תהם",
        "en": "they sent away Rebekah their sister"
      },
      {
        "ja": "ודאיתהא",
        "en": "and her nurse"
      },
      {
        "ja": "ועבד אברהים",
        "en": "and Abraham's servant"
      },
      {
        "ja": "ורגאלה",
        "en": "and his men"
      }
    ],
    "60": [
      {
        "ja": "ודעו לרבקה",
        "en": "they blessed Rebekah"
      },
      {
        "ja": "וקאלו להא",
        "en": "and said to her"
      },
      {
        "ja": "יא אכ'תנא",
        "en": "O our sister"
      },
      {
        "ja": "יכון מנך",
        "en": "May there come from you"
      },
      {
        "ja": "אלוף ורבואת",
        "en": "thousands and tens of thousands"
      },
      {
        "ja": "ויחוז נסלך",
        "en": "may your offspring possess"
      },
      {
        "ja": "קרי' שאניהם",
        "en": "the towns of those who hate them"
      }
    ],
    "61": [
      {
        "ja": "פקאמת רבקה",
        "en": "Rebekah"
      },
      {
        "ja": "וגוארהא",
        "en": "and her maidens arose"
      },
      {
        "ja": "ורכבאעלי' אלגמאל",
        "en": "rode upon the camels"
      },
      {
        "ja": "ומצ'תא מע אלרגל",
        "en": "went with the man"
      },
      {
        "ja": "ואכ'ד' אלעבד",
        "en": "the servant took"
      },
      {
        "ja": "רבקה",
        "en": "Rebekah"
      },
      {
        "ja": "ומצ'י",
        "en": "went"
      }
    ],
    "62": [
      {
        "ja": "וכאן יצחק קד גא",
        "en": "Isaac had come"
      },
      {
        "ja": "פי מגייה",
        "en": "on his way"
      },
      {
        "ja": "מן אלביר",
        "en": "from the Well"
      },
      {
        "ja": "אלתי לאלחי אלנאצ'ר",
        "en": "of the Living One who Sees"
      },
      {
        "ja": "והו מקים",
        "en": "he was dwelling"
      },
      {
        "ja": "פי בלד אלקבלה",
        "en": "in the land of the qibla"
      }
    ],
    "63": [
      {
        "ja": "פכ'רג יצחק",
        "en": "Isaac went out"
      },
      {
        "ja": "ליצלי",
        "en": "to pray"
      },
      {
        "ja": "פי אלצחרא",
        "en": "in the wilderness"
      },
      {
        "ja": "ענד תולי' אלליל",
        "en": "toward the turning of evening"
      },
      {
        "ja": "פרפע עיניה",
        "en": "he lifted up his eyes"
      },
      {
        "ja": "ונצ'ר",
        "en": "and looked"
      },
      {
        "ja": "פאד'א בגמאל מקבלה",
        "en": "behold, camels approaching"
      }
    ],
    "64": [
      {
        "ja": "ולמא רפעת רבקה עינאהא",
        "en": "when Rebekah lifted up her eyes"
      },
      {
        "ja": "וראת יצחק",
        "en": "saw Isaac"
      },
      {
        "ja": "כאדת אן תסקט",
        "en": "she nearly fell"
      },
      {
        "ja": "ען אלגמל",
        "en": "from the camel"
      }
    ],
    "65": [
      {
        "ja": "פקאלת ללעבד",
        "en": "she said to the servant"
      },
      {
        "ja": "מן הד'א אלרגל",
        "en": "Who is this man"
      },
      {
        "ja": "אלסאיר פי אלצחרא",
        "en": "going in the wilderness"
      },
      {
        "ja": "תלקאנא",
        "en": "to meet us"
      },
      {
        "ja": "קאל אלעבד",
        "en": "The servant said"
      },
      {
        "ja": "הו מולאי",
        "en": "He is my master"
      },
      {
        "ja": "פאכ'ד'ת אלקנאע",
        "en": "she took the veil"
      },
      {
        "ja": "ותג'טת בה",
        "en": "covered herself with it"
      }
    ],
    "66": [
      {
        "ja": "פקץ אלעבד",
        "en": "the servant told"
      },
      {
        "ja": "עלי' יצחק",
        "en": "Isaac"
      },
      {
        "ja": "גמיע אלאמור",
        "en": "all the things"
      },
      {
        "ja": "אלתי צנעהא",
        "en": "which he had done"
      }
    ],
    "67": [
      {
        "ja": "פאדכ'להא יצחק",
        "en": "Isaac brought her"
      },
      {
        "ja": "אלי' כ'בא",
        "en": "into the tent"
      },
      {
        "ja": "שרה אמה",
        "en": "of Sarah his mother"
      },
      {
        "ja": "ואכ'ד' רבקה",
        "en": "he took Rebekah"
      },
      {
        "ja": "פצארת לה זוגה",
        "en": "she became his wife"
      },
      {
        "ja": "פאחבהא",
        "en": "he loved her"
      },
      {
        "ja": "ותעאזא יצחק",
        "en": "Isaac was comforted"
      },
      {
        "ja": "עלי' אמה",
        "en": "concerning his mother"
      }
    ]
  }
}