        "ja": "אלאה אבאיכם",
        "en": "the God of your fathers",
        "he": "אֱלֹהֵי אֲבֹתֵיכֶם"
      },
      {
        "ja": "אלאה אברהים",
        "en": "the God of Abraham",
        "he": "אֱלֹהֵי אַבְרָהָם"
      },
      {
        "ja": "אלאה יצחק",
        "en": "the God of Isaac",
        "he": "אֱלֹהֵי יִצְחָק"
      },
      {
        "ja": "ואלאה יעקב",
        "en": "and the God of Jacob",
        "he": "וֵאלֹהֵי יַעֲקֹב"
      },
      {
        "ja": "בעת'ני אליכם",
        "en": "has sent me to you",
        "he": "שְׁלָחַנִי אֲלֵיכֶם"
      },
      {
        "ja": "הד'א אסמי אלי' אלדהר",
        "en": "This is My name forever",
        "he": "זֶה-שְּׁמִי לְעֹלָם"
      },
      {
        "ja": "והד'א ד'כרי",
        "en": "and this is My memorial",
        "he": "וְזֶה זִכְרִי"
      },
      {
        "ja": "אלי' גיל ואגיאל",
        "en": "unto generation upon generation",
        "he": "לְדֹר דֹּר"
      }
    ],
    "16": [
      {
        "ja": "אמץ'",
        "en": "Go",
        "he": "לֵךְ"
      },
      {
        "ja": "ואגמע שיוך' בני אסראיל",
        "en": "and gather the elders of the sons of Israel",
        "he": "וְאָסַפְתָּ אֶת-זִקְנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "וקל להם",
        "en": "and say to them",
        "he": "וְאָמַרְתָּ אֲלֵהֶם"
      },
      {
        "ja": "אללה",
        "en": "The Lord",
        "he": "יְהוָה"
      },
      {
        "ja": "אלאה אבאיכם",
        "en": "the God of your fathers",
        "he": "אֱלֹהֵי אֲבֹתֵיכֶם"
      },
      {
        "ja": "תגלא לי",
        "en": "has appeared to me",
        "he": "נִרְאָה אֵלַי"
      },
      {
        "ja": "אלאה אברהים",
        "en": "the God of Abraham",
        "he": "אֱלֹהֵי אַבְרָהָם"
      },
      {
        "ja": "יצחק",
        "en": "Isaac",
        "he": "יִצְחָק"
      },
      {
        "ja": "ויעקוב",
        "en": "and Jacob",
        "he": "וְיַעֲקֹב"
      },
      {
        "ja": "קאילא",
        "en": "saying",
        "he": "לֵאמֹר"
      },
      {
        "ja": "קד ד'כרתכם",
        "en": "I have remembered you",
        "he": "פָּקֹד פָּקַדְתִּי אֶתְכֶם"
      },
      {
        "ja": "ומא צנע בכם במצר",
        "en": "and what has been done to you in Egypt",
        "he": "וְאֶת-הֶעָשׂוּי לָכֶם בְּמִצְרָיִם"
      }
    ],
    "17": [
      {
        "ja": "פקלת",
        "en": "And I have said",
        "he": "וָאֹמַר"
      },
      {
        "ja": "אצעדכם",
        "en": "I shall bring you up",
        "he": "אַעֲלֶה אֶתְכֶם"
      },
      {
        "ja": "מן עד'אב אלמצריון",
        "en": "from the torment of the Egyptians",
        "he": "מֵעֳנִי מִצְרַיִם"
      },
      {
        "ja": "אלי' מוצ'ע",
        "en": "to the place",
        "he": "אֶל-אֶרֶץ"
      },
      {
        "ja": "אלכנעאניין",
        "en": "of the Canaanites",
        "he": "הַכְּנַעֲנִי"
      },
      {
        "ja": "ואלחתיין",
        "en": "and the Hittites",
        "he": "וְהַחִתִּי"
      },
      {
        "ja": "ואלאמוריין",
        "en": "and the Amorites",
        "he": "וְהָאֱמֹרִי"
      },
      {
        "ja": "ואלפרזיין",
        "en": "and the Perizzites",
        "he": "וְהַפְּרִזִּי"
      },
      {
        "ja": "ואלחויין",
        "en": "and the Hivites",
        "he": "וְהַחִוִּי"
      },
      {
        "ja": "ואליבוסיין",
        "en": "and the Jebusites",
        "he": "וְהַיְבוּסִי"
      },
      {
        "ja": "אלי' בלד יפיץ' לבנא ועסלא",
        "en": "to a land flowing with milk and honey",
        "he": "אֶל-אֶרֶץ זָבַת חָלָב וּדְבָשׁ"
      }
    ],
    "18": [
      {
        "ja": "פאד'א קבלו מנך",
        "en": "And when they accept from you",
        "he": "וְשָׁמְעוּ לְקֹלֶךָ"
      },
      {
        "ja": "אדכל",
        "en": "you shall enter",
        "he": "וּבָאתָ"
      },
      {
        "ja": "אנת",
        "en": "you",
        "he": "אַתָּה"
      },
      {
        "ja": "ושיוך' בני אסראיל",
        "en": "and the elders of the sons of Israel",
        "he": "וְזִקְנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "אלי' מלך מצר",
        "en": "to the king of Egypt",
        "he": "אֶל-מֶלֶךְ מִצְרַיִם"
      },
      {
        "ja": "וקולו לה",
        "en": "and you shall say to him",
        "he": "וַאֲמַרְתֶּם אֵלָיו"
      },
      {
        "ja": "אללה",
        "en": "The Lord",
        "he": "יְהוָה"
      },
      {
        "ja": "אלאה אלעבראניין",
        "en": "the God of the Hebrews",
        "he": "אֱלֹהֵי הָעִבְרִיִּים"
      },
      {
        "ja": "ואפאנא אמרה",
        "en": "has caused His decree to come upon us",
        "he": "נִקְרָה עָלֵינוּ"
      },
      {
        "ja": "פאלאן",
        "en": "So now",
        "he": "וְעַתָּה"
      },
      {
        "ja": "נסיר מסאפה' ת'לאתה' איאם",
        "en": "let us journey a distance of three days",
        "he": "נֵלְכָה-נָּא דֶּרֶךְ שְׁלֹשֶׁת יָמִים"
      },
      {
        "ja": "פי אלבר",
        "en": "into the wilderness",
        "he": "בַּמִּדְבָּר"
      },
      {
        "ja": "ונד'בח ללה רבנא",
        "en": "and let us offer sacrifice to the Lord our God",
        "he": "וְנִזְבְּחָה לַיהוָה אֱלֹהֵינוּ"
      }
    ],
    "19": [
      {
        "ja": "ואנא אעלם",
        "en": "But I know",
        "he": "וַאֲנִי יָדַעְתִּי"
      },
      {
        "ja": "אן מלך מצר לא ידעכם",
        "en": "that the king of Egypt will not let you",
        "he": "כִּי לֹא-יִתֵּן אֶתְכֶם מֶלֶךְ מִצְרַיִם"
      },
      {
        "ja": "אן תמצ'ו",
        "en": "go",
        "he": "לַהֲלֹךְ"
      },
      {
        "ja": "ולא ביד ואחדה שדידה",
        "en": "and not [even] under a single strong hand",
        "he": "וְלֹא בְּיָד חֲזָקָה"
      }
    ],
    "20": [
      {
        "ja": "פאבעת' בגמיע אפאתי",
        "en": "So I shall send forth all my plagues",
        "he": "וְשָׁלַחְתִּי אֶת-יָדִי"
      },
      {
        "ja": "ואצר'ב אלמצריון",
        "en": "and shall strike the Egyptians",
        "he": "וְהִכֵּיתִי אֶת-מִצְרַיִם"
      },
      {
        "ja": "באעגובאתי",
        "en": "with my wonders",
        "he": "בְּכֹל נִפְלְאֹתַי"
      },
      {
        "ja": "אלד'י אצנעהא פי מא בינהם",
        "en": "which I shall do among them",
        "he": "אֲשֶׁר אֶעֱשֶׂה בְּקִרְבּוֹ"
      },
      {
        "ja": "ובעד ד'אלך",
        "en": "and after that",
        "he": "וְאַחֲרֵי-כֵן"
      },
      {
        "ja": "יטלקכם",
        "en": "he shall let you go",
        "he": "יְשַׁלַּח אֶתְכֶם"
      }
    ],
    "21": [
      {
        "ja": "ואעטי",
        "en": "And I shall give",
        "he": "וְנָתַתִּי"
      },
      {
        "ja": "אלקום חצ'אא",
        "en": "this people favor",
        "he": "אֶת-חֵן הָעָם-הַזֶּה"
      },
      {
        "ja": "ענד אלמצריון",
        "en": "in the eyes of the Egyptians",
        "he": "בְּעֵינֵי מִצְרָיִם"
      },
      {
        "ja": "פאד'א מצ'יתם",
        "en": "so it shall be, when you go",
        "he": "וְהָיָה כִּי תֵלֵכוּן"
      },
      {
        "ja": "לא תמצ'ון פרג'א",
        "en": "you shall not go empty-handed",
        "he": "לֹא תֵלְכוּ רֵיקָם"
      }
    ],
    "22": [
      {
        "ja": "בל תסתוהב אלאמראה",
        "en": "Rather, each woman shall ask as a gift",
        "he": "וְשָׁאֲלָה אִשָּׁה"
      },
      {
        "ja": "מן מסאכנתהא",
        "en": "from her [woman-]neighbor",
        "he": "מִשְּׁכֶנְתָּהּ"
      },
      {
        "ja": "ומן גארתהא",
        "en": "and from the dweller in her house",
        "he": "וּמִגָּרַת בֵּיתָהּ"
      },
      {
        "ja": "אניה' פצ'ה",
        "en": "vessels of silver",
        "he": "כְּלֵי-כֶסֶף"
      },
      {
        "ja": "ואניה' ד'הב",
        "en": "and vessels of gold",
        "he": "וּכְלֵי זָהָב"
      },
      {
        "ja": "ות'יאבא",
        "en": "and garments",
        "he": "וּשְׂמָלֹת"
      },
      {
        "ja": "ותציירוהא",
        "en": "and you shall set them",
        "he": "וְשַׂמְתֶּם"
      },
      {
        "ja": "עלי' בניכם",
        "en": "upon your sons",
        "he": "עַל-בְּנֵיכֶם"
      },
      {
        "ja": "ובנאתכם",
        "en": "and upon your daughters",
        "he": "וְעַל-בְּנֹתֵיכֶם"
      },
      {
        "ja": "ותנתספו אלמצריון",
        "en": "and you shall divest the Egyptians",
        "he": "וְנִצַּלְתֶּם אֶת-מִצְרָיִם"
      }
    ]
  }
}