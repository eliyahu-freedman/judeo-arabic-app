      },
      {
        "ja": "ונצף סבט מנשה",
        "en": "Manasseh son of Joseph",
        "he": "וְלַחֲצִי שֵׁבֶט מְנַשֶּׁה"
      },
      {
        "ja": "אבן יוסף",
        "en": "the land of the kingdom of",
