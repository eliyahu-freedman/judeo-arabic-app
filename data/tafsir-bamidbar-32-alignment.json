        "en": "and Ataroth,",
        "he": "וְאֶת-עֲטָרֹת"
      },
      {
        "ja": "וערוער",
        "en": "and Aroer,",
        "he": "וְאֵת עֲרֹעֵר"
      }
    ],
    "35": [
      {
        "ja": "ועטרות שופן",
