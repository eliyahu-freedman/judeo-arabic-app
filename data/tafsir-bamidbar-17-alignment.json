        "he": "מֵאֵת כָּל-נְשִׂיאֵהֶם"
      },
      {
        "ja": "לביות אבאיהם",
        "en": "for the houses of their fathers —",
        "he": "לְבֵית אֲבֹתָם"
      },
      {
        "ja": "את'ני עשר עצא",
        "en": "twelve staves;",
        "he": "שְׁנֵים עָשָׂר מַטּוֹת"
      },
      {
        "ja": "ואכתב אסם כל רגל",
        "en": "and write the name of each man",
        "he": "אִישׁ אֶת-שְׁמוֹ תִּכְתֹּב"
      },
      {
        "ja": "עלי' עצאה",
        "en": "upon his staff.",
        "he": "עַל-מַטֵּהוּ"
      }
    ],
    "18": [
      {
        "ja": "ואסם הרון",
        "en": "And Aaron's name —",
        "he": "וְאֵת שֵׁם אַהֲרֹן"
      },
      {
        "ja": "אכתב",
        "en": "write it",
        "he": "תִּכְתֹּב"
      },
      {
        "ja": "עלי' עצא לוי",
        "en": "upon the staff of Levi;",
        "he": "עַל-מַטֵּה לֵוִי"
      },
      {
        "ja": "אנך",
        "en": "for",
        "he": "כִּי"
      },
      {
        "ja": "אנמא תאכ'ד' עצא ואחד",
        "en": "you are to take but one staff",
        "he": "מַטֶּה אֶחָד"
      },
      {
        "ja": "לגמלה' ביות אבאיהם",
        "en": "for the whole body of the houses of their fathers.'",
        "he": "לְרֹאשׁ בֵּית אֲבוֹתָם"
      }
    ],
    "19": [
      {
        "ja": "וצ'עהא",
        "en": "'And place them",
        "he": "וְהִנַּחְתָּם"
      },
      {
        "ja": "פי כ'בא אלמחצ'ר",
        "en": "in the tent of the assembly,",
        "he": "בְּאֹהֶל מוֹעֵד"
      },
      {
        "ja": "בין ידי אלשהאדה",
        "en": "before the testimony,",
        "he": "לִפְנֵי הָעֵדוּת"
      },
      {
        "ja": "אלד'י אחצ'רך",
        "en": "where I shall meet you",
        "he": "אֲשֶׁר אִוָּעֵד לָכֶם"
      },
      {
        "ja": "הנאך",
        "en": "there.'",
        "he": "שָׁמָּה"
      }
    ],
    "20": [
      {
        "ja": "פאלרג'ל",
        "en": "'And the man",
        "he": "וְהָיָה הָאִישׁ"
      },
      {
        "ja": "אלד'י אכ'תארה",
        "en": "whom I shall choose —",
        "he": "אֲשֶׁר אֶבְחַר-בּוֹ"
      },
      {
        "ja": "תפרע עצאה",
        "en": "his staff shall put forth branches,",
        "he": "מַטֵּהוּ יִפְרָח"
      },
      {
        "ja": "חתא אהדי עני",
        "en": "so that I may quiet away from Me",
        "he": "וַהֲשִׁכֹּתִי מֵעָלַי"
      },
      {
        "ja": "תדמר",
        "en": "the complaining of",
        "he": "אֶת-תְּלֻנּוֹת"
      },
      {
        "ja": "בני אסראיל",
        "en": "the sons of Israel,",
        "he": "בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "אלד'י הם מתד'מרין",
        "en": "which they are complaining",
        "he": "אֲשֶׁר הֵם מַלִּינִם"
      },
      {
        "ja": "עליכם",
        "en": "against you.'",
        "he": "עֲלֵיכֶם"
      }
    ],
    "21": [
      {
        "ja": "פכלם מוסי'",
        "en": "And Moses spoke",
        "he": "וַיְדַבֵּר מֹשֶׁה"
      },
      {
        "ja": "בדאלך",
        "en": "this"
      },
      {
        "ja": "בני אסראיל",
        "en": "to the sons of Israel,",
        "he": "אֶל-בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "פדפע אליה כל אשראפהם",
        "en": "and all their nobles gave to him",
        "he": "וַיִּתְּנוּ אֵלָיו כָּל-נְשִׂיאֵיהֶם"
      },
      {
        "ja": "עצא מן כל שריף",
        "en": "a staff, one staff for each noble,",
        "he": "מַטֶּה לְנָשִׂיא אֶחָד"
      },
      {
        "ja": "לביות אבאיהם",
        "en": "for the houses of their fathers —",
        "he": "לְבֵית אֲבֹתָם"
      },
      {
        "ja": "את'ני עשר עצא",
        "en": "twelve staves;",
        "he": "שְׁנֵים עָשָׂר מַטּוֹת"
      },
      {
        "ja": "ועצא הרון",
        "en": "and Aaron's staff",
        "he": "וּמַטֵּה אַהֲרֹן"
      },
      {
        "ja": "פי מא בין עציהם",
        "en": "was among their staves.",
        "he": "בְּתוֹךְ מַטּוֹתָם"
      }
    ],
    "22": [
      {
        "ja": "פוצ'עהא מוסי'",
        "en": "And Moses placed them",
        "he": "וַיַּנַּח מֹשֶׁה"
      },
      {
        "ja": "בין ידי אללה",
        "en": "before God,",
        "he": "לִפְנֵי יְהוָה"
      },
      {
        "ja": "פי כ'בא אלשהאדה",
        "en": "in the tent of the testimony.",
        "he": "בְּאֹהֶל הָעֵדֻת"
      }
    ],
    "23": [
      {
        "ja": "ולמא כאן מן ג'ד",
        "en": "And when the next day came,",
        "he": "וַיְהִי מִמָּחֳרָת"
      },
      {
        "ja": "דכ'ל מוסי",
        "en": "Moses entered",
        "he": "וַיָּבֹא מֹשֶׁה"
      },
      {
        "ja": "אלי' כ'בא אלשהאדה",
        "en": "the tent of the testimony —",
        "he": "אֶל-אֹהֶל הָעֵדוּת"
      },
      {
        "ja": "פאד'א קד פרעת עצא הרון",
        "en": "and behold, the staff of Aaron",
        "he": "וְהִנֵּה פָּרַח מַטֵּה-אַהֲרֹן"
      },
      {
        "ja": "אלתי הי לבית לוי",
        "en": "which was for the house of Levi, had put forth branches:",
        "he": "לְבֵית לֵוִי"
      },
      {
        "ja": "פאכ'רגת פרועא",
        "en": "it had brought out branches,",
        "he": "וַיֹּצֵא פֶרַח"
      },
      {
        "ja": "ונוורת נוארא",
        "en": "and had burst into blossom,",
        "he": "וַיָּצֵץ צִיץ"
      },
      {
        "ja": "ועקדת לוזא",
        "en": "and had formed almonds.",
        "he": "וַיִּגְמֹל שְׁקֵדִים"
      }
    ],
    "24": [
      {
        "ja": "פאכ'רג מוסי",
        "en": "And Moses brought out",
        "he": "וַיֹּצֵא מֹשֶׁה"
      },
      {
        "ja": "גמיע אלעצי",
        "en": "all the staves",
        "he": "אֶת-כָּל-הַמַּטֹּת"
      },
      {
        "ja": "מן בין ידי אללה",
