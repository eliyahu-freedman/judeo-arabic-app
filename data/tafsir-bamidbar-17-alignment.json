        "he": "מִלִּפְנֵי יְהוָה"
      },
      {
        "ja": "אלי' גמיע בני אסראיל",
        "en": "to all the sons of Israel,",
        "he": "אֶל-כָּל-בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "פנצ'ר כל ואחד",
