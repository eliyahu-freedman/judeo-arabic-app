        "he": "וַיִּרְאוּ"
      },
      {
        "ja": "אלי' עצאה פאכ'ד'הא",
        "en": "at his own staff and took it.",
        "he": "וַיִּקְחוּ אִישׁ מַטֵּהוּ"
      }
    ],
    "25": [
      {
        "ja": "ת'ם",
        "en": "Then"
      },
      {
        "ja": "קאל אללה",
        "en": "God said",
        "he": "וַיֹּאמֶר יְהוָה"
      },
      {
        "ja": "למוסי'",
        "en": "to Moses:",
        "he": "אֶל-מֹשֶׁה"
      },
      {
        "ja": "רד עצא הרון",
        "en": "'Return Aaron's staff",
        "he": "הָשֵׁב אֶת-מַטֵּה אַהֲרֹן"
      },
      {
        "ja": "בין ידי אלשהאדה",
        "en": "before the testimony,",
        "he": "לִפְנֵי הָעֵדוּת"
      },
      {
        "ja": "תכון חפץ'",
        "en": "to be kept",
        "he": "לְמִשְׁמֶרֶת"
      },
      {
        "ja": "עלאמה",
        "en": "as a sign",
        "he": "לְאוֹת"
      },
      {
        "ja": "לד'וי אלכ'לף",
        "en": "for those who are rebellious,",
        "he": "לִבְנֵי-מֶרִי"
      },
      {
        "ja": "פיפנא תד'מרהם עליי",
        "en": "that their complaining against Me may be brought to an end,",
        "he": "וּתְכַל תְּלוּנֹּתָם מֵעָלַי"
      },
      {
        "ja": "ולא יהלכון",
        "en": "and they shall not perish.'",
        "he": "וְלֹא יָמֻתוּ"
      }
    ],
    "26": [
      {
        "ja": "פצנע מוסי'",
        "en": "And Moses did",
        "he": "וַיַּעַשׂ מֹשֶׁה"
      },
      {
        "ja": "כמא אמרה אללה",
        "en": "as God had commanded him",
        "he": "כַּאֲשֶׁר צִוָּה יְהוָה"
      },
      {
        "ja": "מן ד'אלך",
        "en": "in this.",
        "he": "אֹתוֹ כֵּן עָשָׂה"
      }
    ],
    "27": [
      {
        "ja": "ת'ם",
        "en": "Then"
      },
      {
        "ja": "קאל בני אסראיל",
        "en": "the sons of Israel said",
        "he": "וַיֹּאמְרוּ בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "למוסי'",
        "en": "to Moses:",
        "he": "אֶל-מֹשֶׁה"
      },
      {
        "ja": "הוד'א קד תופא מנא",
        "en": "'Behold, some of us have died",
        "he": "הֵן גָּוַעְנוּ"
      },
      {
        "ja": "ובאד מנא",
        "en": "and some of us have perished —",
        "he": "אָבַדְנוּ"
      },
      {
        "ja": "פכלנא האלכין",
        "en": "so we are all doomed.'",
        "he": "כֻּלָּנוּ אָבָדְנוּ"
      }
    ],
    "28": [
      {
        "ja": "ואד'א כאן כל מתקדם",
        "en": "And if every one who draws near",
        "he": "כֹּל הַקָּרֵב הַקָּרֵב"
      },
      {
        "ja": "אלי' מסכן אללה",
        "en": "to the dwelling of God",
        "he": "אֶל-מִשְׁכַּן יְהוָה"
      },
      {
        "ja": "יהלך",
        "en": "is destroyed,",
        "he": "יָמוּת"
      },
      {
        "ja": "פהוד'א נחן",
        "en": "then behold — we",
        "he": "הַאִם תַּמְנוּ"
      },
      {
        "ja": "פאנון מתופון",
        "en": "are perishing, we are dying.'",
        "he": "לִגְו‍ֹעַ"
      }
    ]
  }
