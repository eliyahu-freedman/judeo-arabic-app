        "he": "אֲשֶׁר עָלֶיךָ"
      },
      {
        "ja": "ואגעלה עליהם",
        "en": "and set it upon them;",
        "he": "וְשַׂמְתִּי עֲלֵיהֶם"
      },
      {
        "ja": "פי'עאונונך",
        "en": "so they shall assist you",
        "he": "וְנָשְׂאוּ אִתְּךָ"
      },
      {
        "ja": "פי סיאסה' אלקום",
        "en": "in the governance of the people,",
        "he": "בְּמַשָּׂא הָעָם"
      },
      {
        "ja": "ולא תסוסהם אנת וחדך",
        "en": "and you shall not govern them alone.'",
        "he": "וְלֹא-תִשָּׂא אַתָּה לְבַדֶּךָ"
      }
    ],
    "18": [
      {
        "ja": "וקל לאלקום",
        "en": "'And say to the people:",
        "he": "וְאֶל-הָעָם תֹּאמַר"
      },
      {
        "ja": "אסתעדו",
        "en": "Prepare yourselves",
        "he": "הִתְקַדְּשׁוּ"
      },
      {
        "ja": "אלי' ג'ד",
        "en": "until tomorrow,",
        "he": "לְמָחָר"
      },
      {
        "ja": "חתא תאכלון לחמא",
        "en": "that you may eat meat —",
        "he": "וַאֲכַלְתֶּם בָּשָׂר"
      },
      {
        "ja": "לאגל מא בכיתם",
        "en": "because you have wept",
        "he": "כִּי בְּכִיתֶם"
      },
      {
        "ja": "בין ידי אללה",
        "en": "before God",
        "he": "בְּאָזְנֵי יְהוָה"
      },
      {
        "ja": "וקלתם",
        "en": "and said:",
        "he": "לֵאמֹר"
      },
      {
        "ja": "מן יטעמנא לחמא",
        "en": "Who shall feed us meat?",
        "he": "מִי יַאֲכִלֵנוּ בָּשָׂר"
      },
      {
        "ja": "וכאן אלאצלח לנא במצר",
        "en": "For it was better for us in Egypt.",
        "he": "כִּי-טוֹב לָנוּ בְּמִצְרָיִם"
      },
      {
        "ja": "פיעטיכם אללה",
        "en": "So God shall give you",
        "he": "וְנָתַן יְהוָה לָכֶם"
      },
      {
        "ja": "לחמא תאכלונה",
        "en": "meat that you shall eat.'",
        "he": "בָּשָׂר וַאֲכַלְתֶּם"
      }
    ],
    "19": [
      {
        "ja": "לא יום ואחד",
        "en": "'Not one day",
        "he": "לֹא יוֹם אֶחָד"
      },
      {
        "ja": "תאכלונה",
        "en": "shall you eat it,",
        "he": "תֹּאכְלוּן"
      },
      {
        "ja": "ולא יומין",
        "en": "and not two days,",
        "he": "וְלֹא יוֹמָיִם"
      },
      {
        "ja": "ולא כ'מסה",
        "en": "and not five,",
        "he": "וְלֹא חֲמִשָּׁה יָמִים"
      },
      {
        "ja": "ולא עשרה",
        "en": "and not ten,",
        "he": "וְלֹא עֲשָׂרָה יָמִים"
      },
      {
        "ja": "ולא עשרין",
        "en": "and not twenty —'",
        "he": "וְלֹא עֶשְׂרִים יוֹם"
      }
    ],
    "20": [
      {
        "ja": "אלא אלי' אייאם שהר",
        "en": "'but for the days of a month,",
        "he": "עַד חֹדֶשׁ יָמִים"
      },
      {
        "ja": "אלי' אן יכ'רג",
        "en": "until it comes out",
        "he": "עַד אֲשֶׁר-יֵצֵא"
      },
      {
        "ja": "מן אנאפכם",
        "en": "of your nostrils",
        "he": "מֵאַפְּכֶם"
      },
      {
        "ja": "מת'לא",
        "en": "as a byword,"
      },
      {
        "ja": "ויציר לכם הזאלא",
        "en": "and becomes a disgrace to you —",
        "he": "וְהָיָה לָכֶם לְזָרָא"
      },
      {
        "ja": "לאגל מא זהדתם",
        "en": "because you have shown contempt",
        "he": "יַעַן כִּי-מְאַסְתֶּם"
      },
      {
        "ja": "פי נור אללה",
        "en": "for the light of God",
        "he": "אֶת-יְהוָה"
      },
      {
        "ja": "אלד'י פי מא בינכם",
        "en": "which is among you,",
        "he": "אֲשֶׁר בְּקִרְבְּכֶם"
      },
      {
        "ja": "ובכיתם בין ידיה",
        "en": "and you wept before Him",
        "he": "וַתִּבְכּוּ לְפָנָיו"
      },
      {
        "ja": "וקלתם",
        "en": "and said:",
        "he": "לֵאמֹר"
      },
      {
        "ja": "לם כ'רגנא מן מצר",
        "en": "Why did we ever leave Egypt?'",
        "he": "לָמָּה זֶּה יָצָאנוּ מִמִּצְרָיִם"
      }
    ],
    "21": [
      {
        "ja": "קאל מוסי'",
        "en": "Moses said:",
        "he": "וַיֹּאמֶר מֹשֶׁה"
      },
      {
        "ja": "סת מאיה' אלף",
        "en": "'Six hundred thousand",
        "he": "שֵׁשׁ-מֵאוֹת אֶלֶף"
      },
      {
        "ja": "רגל ראגל",
        "en": "men on foot",
        "he": "רַגְלִי"
      },
      {
        "ja": "אלקום",
        "en": "are the people",
        "he": "הָעָם"
      },
      {
        "ja": "אלד'י אנא פי מא בינהם",
        "en": "among whom I am —",
        "he": "אֲשֶׁר אָנֹכִי בְּקִרְבּוֹ"
      },
      {
        "ja": "ואנת קלת",
        "en": "and You said:",
        "he": "וְאַתָּה אָמַרְתָּ"
      },
      {
        "ja": "אעטיהם לחמא",
        "en": "I shall give them meat",
        "he": "בָּשָׂר אֶתֵּן לָהֶם"
      },
      {
        "ja": "יאכלונה שהרא",
        "en": "that they shall eat for a month!'",
        "he": "וְאָכְלוּ חֹדֶשׁ יָמִים"
      }
    ],
    "22": [
      {
        "ja": "פמן אענאתהם",
        "en": "'Then for their relief —"
      },
      {
        "ja": "אג'נם",
        "en": "shall flocks",
        "he": "הֲצֹאן"
      },
      {
        "ja": "ובקר",
        "en": "and herds",
        "he": "וּבָקָר"
      },
      {
        "ja": "תד'בח להם",
        "en": "be slaughtered for them",
        "he": "יִשָּׁחֵט לָהֶם"
      },
      {
        "ja": "פתכפיהם",
        "en": "so as to suffice them?",
        "he": "וּמָצָא לָהֶם"
      },
      {
        "ja": "או גמיע סמך אלבחר",
        "en": "Or shall all the fish of the sea",
        "he": "אִם אֶת-כָּל-דְּגֵי הַיָּם"
      },
      {
        "ja": "יחאש להם",
        "en": "be netted for them",
        "he": "יֵאָסֵף לָהֶם"
      },
      {
        "ja": "פיקנעהם",
        "en": "so as to satisfy them?'"
      }
    ],
    "23": [
      {
        "ja": "פקאל אללה",
        "en": "And God said",
        "he": "וַיֹּאמֶר יְהוָה"
      },
      {
        "ja": "למוסי'",
        "en": "to Moses:",
        "he": "אֶל-מֹשֶׁה"
      },
      {
        "ja": "הל קדרה' אללה תקצר",
        "en": "'Is the power of God too short?",
        "he": "הֲיַד יְהוָה תִּקְצָר"
      },
      {
        "ja": "אלאן תנצ'ר",
        "en": "Now you shall see",
        "he": "עַתָּה תִרְאֶה"
      },
      {
        "ja": "איואפיכם כלאמי",
        "en": "whether My word comes to you",
        "he": "הֲיִקְרְךָ דְבָרִי"
      },
      {
        "ja": "אם לא",
        "en": "or not.'",
        "he": "אִם-לֹא"
      }
    ],
    "24": [
      {
        "ja": "פכ'רג מוסי'",
        "en": "And Moses went out",
        "he": "וַיֵּצֵא מֹשֶׁה"
      },
      {
        "ja": "ואכ'בר אלקום",
        "en": "and informed the people",
        "he": "וַיְדַבֵּר אֶל-הָעָם"
      },
      {
        "ja": "בכלאם אללה",
        "en": "of the word of God;",
        "he": "אֵת דִּבְרֵי יְהוָה"
      },
      {
        "ja": "וגמע",
        "en": "and he gathered",
        "he": "וַיֶּאֱסֹף"
      },
      {
        "ja": "סבעין רגלא",
        "en": "seventy men",
        "he": "שִׁבְעִים אִישׁ"
      },
      {
        "ja": "מן שיוכ'הם",
        "en": "from their elders,",
        "he": "מִזִּקְנֵי הָעָם"
      },
      {
        "ja": "ואוקפהם",
        "en": "and stationed them",
        "he": "וַיַּעֲמֵד אֹתָם"
      },
      {
        "ja": "חואלי אלכ'בא",
        "en": "around the tent.",
        "he": "סְבִיבֹת הָאֹהֶל"
      }
    ],
    "25": [
      {
        "ja": "פתגלא אללה",
        "en": "And God appeared",
        "he": "וַיֵּרֶד יְהוָה"
      },
      {
        "ja": "פי אלג'מאם",
        "en": "in the cloud",
        "he": "בֶּעָנָן"
      },
      {
        "ja": "וכ'אטבה",
        "en": "and spoke with him;",
        "he": "וַיְדַבֵּר אֵלָיו"
      },
      {
        "ja": "ואפאד",
        "en": "and He imparted",
        "he": "וַיָּאצֶל"
      },
      {
        "ja": "מן אלנור אלד'י עליה",
        "en": "of the light which was upon him,",
        "he": "מִן-הָרוּחַ אֲשֶׁר עָלָיו"
      },
      {
        "ja": "וכסא אלסבעין אלרגל אלשיוך'",
        "en": "and covered the seventy elder men with it;",
        "he": "וַיִּתֵּן עַל-שִׁבְעִים אִישׁ הַזְּקֵנִים"
      },
      {
        "ja": "פלמא אסתקר עליהם ד'אלך אלנור",
        "en": "and when that light settled upon them,",
        "he": "וַיְהִי כְּנוֹחַ עֲלֵיהֶם הָרוּחַ"
      },
      {
        "ja": "תנבו",
        "en": "they prophesied —",
        "he": "וַיִּתְנַבְּאוּ"
      },
      {
        "ja": "ולם יחתאגו אלי' עודה",
        "en": "and they had no need to return to it.",
        "he": "וְלֹא יָסָפוּ"
      }
    ],
    "26": [
      {
        "ja": "ובקי רגלאן",
        "en": "And two men remained",
        "he": "וַיִּשָּׁאֲרוּ שְׁנֵי-אֲנָשִׁים"
      },
      {
        "ja": "פי אלעסכר",
        "en": "in the camp —",
        "he": "בַּמַּחֲנֶה"
      },
      {
        "ja": "אסם אחדהמא אלדד",
        "en": "the name of one of them was Eldad,",
        "he": "שֵׁם הָאֶחָד אֶלְדָּד"
      },
      {
        "ja": "ואלת'אני מידד",
        "en": "and the second Medad —",
        "he": "וְשֵׁם הַשֵּׁנִי מֵידָד"
      },
      {
        "ja": "ואסתקרת עליהם אלנבווה",
        "en": "and the prophecy settled upon them;",
        "he": "וַתָּנַח עֲלֵהֶם הָרוּחַ"
      },
      {
        "ja": "והמא מן אלמכתובין",
        "en": "and they were among those who were registered,",
        "he": "וְהֵמָּה בַּכְּתֻבִים"
      },
      {
        "ja": "ולם יכ'רגו אלי' אלכ'בא",
        "en": "but they had not gone out to the tent;",
        "he": "וְלֹא יָצְאוּ הָאֹהֱלָה"
      },
      {
        "ja": "בל תנבו פי אלעסכר",
        "en": "rather, they prophesied in the camp.",
        "he": "וַיִּתְנַבְּאוּ בַּמַּחֲנֶה"
      }
    ],
    "27": [
      {
        "ja": "פחאצ'ר אלג'לאם",
        "en": "And the youth came hurrying",
        "he": "וַיָּרָץ הַנַּעַר"
      },
      {
        "ja": "ואכ'בר מוסי'",
        "en": "and informed Moses,",
        "he": "וַיַּגֵּד לְמֹשֶׁה"
      },
      {
        "ja": "וקאל",
        "en": "and said:",
        "he": "וַיֹּאמַר"
      },
      {
        "ja": "אלדד ומידד",
        "en": "'Eldad and Medad",
        "he": "אֶלְדָּד וּמֵידָד"
      },
      {
        "ja": "מתנביין",
        "en": "are prophesying",
        "he": "מִתְנַבְּאִים"
      },
      {
        "ja": "פי אלעסכר",
        "en": "in the camp.'",
        "he": "בַּמַּחֲנֶה"
      }
    ],
    "28": [
      {
        "ja": "פאגאבה יהושע אבן נון",
        "en": "And Joshua son of Nun,",
        "he": "וַיַּעַן יְהוֹשֻׁעַ בִּן-נוּן"
      },
      {
        "ja": "כ'אדם מוסי'",
        "en": "Moses' attendant,",
        "he": "מְשָׁרֵת מֹשֶׁה"
      },
      {
        "ja": "מן תלאמידה",
        "en": "one of his disciples,",
        "he": "מִבְּחֻרָיו"
      },
      {
        "ja": "וקאל",
        "en": "answered and said:",
        "he": "וַיֹּאמַר"
      },
      {
        "ja": "יא סיידי יא מוסי'",
        "en": "'My lord, O Moses —"
      },
      {
        "ja": "אחבסהמא",
        "en": "restrain them!'",
        "he": "כְּלָאֵם"
      }
    ],
    "29": [
      {
        "ja": "קאל לה מוסי'",
        "en": "And Moses said to him:",
        "he": "וַיֹּאמֶר לוֹ מֹשֶׁה"
      },
      {
        "ja": "הל תג'אר לי",
        "en": "'Are you jealous on my behalf?",
        "he": "הַמְקַנֵּא אַתָּה לִי"
      },
      {
        "ja": "לית",
        "en": "Would that"
      },
      {
        "ja": "צאר גמיע אמה' אללה",
        "en": "all the nation of God",
        "he": "וּמִי יִתֵּן כָּל-עַם יְהוָה"
      },
      {
        "ja": "אנביא",
        "en": "might become prophets —",
        "he": "נְבִיאִים"
      },
      {
        "ja": "באן יגעל מן נורה ונבוותה",
        "en": "that He might set of His light and His prophecy",
        "he": "כִּי-יִתֵּן יְהוָה אֶת-רוּחוֹ"
      },
      {
        "ja": "עליהם",
        "en": "upon them!'",
        "he": "עֲלֵיהֶם"
      }
    ],
    "30": [
      {
        "ja": "פלמא אנצ'ם מוסי'",
        "en": "And when Moses rejoined",
        "he": "וַיֵּאָסֵף מֹשֶׁה"
      },
      {
        "ja": "אלי' אלעסכר",
        "en": "the camp —",
        "he": "אֶל-הַמַּחֲנֶה"
      },
      {
        "ja": "הו",
        "en": "he"
      },
      {
        "ja": "ושיוך בני אסראיל",
        "en": "and the elders of the sons of Israel —",
        "he": "וְזִקְנֵי יִשְׂרָאֵל"
      }
    ],
    "31": [
      {
        "ja": "והבת ריח",
        "en": "a wind blew",
        "he": "וְרוּחַ נָסַע"
      },
      {
        "ja": "מן ענד אללה",
        "en": "from God,",
        "he": "מֵאֵת יְהוָה"
      },
      {
        "ja": "וקטעת סלוי",
        "en": "and it drove quail in",
        "he": "וַיָּגָז שַׂלְוִים"
      },
      {
        "ja": "מן אלבחר",
        "en": "from the sea",
        "he": "מִן-הַיָּם"
      },
      {
        "ja": "ואלקתה עלי' אלעסכר",
        "en": "and cast them upon the camp,",
        "he": "וַיִּטֹּשׁ עַל-הַמַּחֲנֶה"
      },
      {
        "ja": "שביה כמסיר יום",
        "en": "like a day's journey",
        "he": "כְּדֶרֶךְ יוֹם כֹּה"
      },
      {
        "ja": "ימנה ויסרה",
        "en": "to the right and to the left",
        "he": "וּכְדֶרֶךְ יוֹם כֹּה"
      },
      {
        "ja": "חואלי אלעסכר",
        "en": "around the camp;",
        "he": "סְבִיבוֹת הַמַּחֲנֶה"
      },
      {
        "ja": "וארתפאעה מן אלארץ' ד'ראעין",
        "en": "and their height from the ground was two cubits.",
        "he": "וּכְאַמָּתַיִם עַל-פְּנֵי הָאָרֶץ"
      }
    ],
    "32": [
      {
        "ja": "פקאם אלקום",
        "en": "And the people rose —",
        "he": "וַיָּקָם הָעָם"
      },
      {
        "ja": "באקי יומהם ולילתהם",
        "en": "the remainder of their day and their night",
        "he": "כָּל-הַיּוֹם הַהוּא וְכָל-הַלַּיְלָה"
      },
      {
        "ja": "וטול נהאר ג'דהם",
        "en": "and the length of the next day —",
        "he": "וְכֹל יוֹם הַמָּחֳרָת"
      },
      {
        "ja": "פגמעו אלסלוי",
        "en": "and gathered the quail;",
        "he": "וַיַּאַסְפוּ אֶת-הַשְּׂלָו"
      },
      {
        "ja": "אקלהם",
        "en": "the least among them",
        "he": "הַמַּמְעִיט"
      },
      {
        "ja": "גמע עשרה אנאביר",
        "en": "gathered ten heaps;",
        "he": "אָסַף עֲשָׂרָה חֳמָרִים"
      },
      {
        "ja": "פסטחוה להם סטוחא",
        "en": "and they spread them out as layers",
        "he": "וַיִּשְׁטְחוּ לָהֶם שָׁטוֹחַ"
      },
      {
        "ja": "חואלי אלעסכר",
        "en": "around the camp.",
        "he": "סְבִיבוֹת הַמַּחֲנֶה"
      }
    ],
    "33": [
      {
        "ja": "ואלחם בעד",
        "en": "While the meat was still",
        "he": "הַבָּשָׂר עוֹדֶנּוּ"
      },
      {
        "ja": "בין אסנאנהם",
        "en": "between their teeth,",
        "he": "בֵּין שִׁנֵּיהֶם"
      },
      {
        "ja": "קבל אן ימצ'ג'וה",
        "en": "before they had chewed it,",
        "he": "טֶרֶם יִכָּרֵת"
      },
      {
        "ja": "אד' אשתד ג'צ'ב אללה עליהם",
        "en": "God's anger grew fierce against them,",
        "he": "וְאַף יְהוָה חָרָה בָעָם"
      },
      {
        "ja": "פצ'רבהם",
        "en": "and He struck them",
        "he": "וַיַּךְ יְהוָה בָּעָם"
      },
      {
        "ja": "צ'רבה ]עט'ימה] ]עט'ימה] עצ'ימה גדא",
        "en": "with a very great blow.",
        "he": "מַכָּה רַבָּה מְאֹד"
      }
    ],
    "34": [
      {
        "ja": "וסמא ד'אלך אלמוצ'ע",
        "en": "And he called that place",
        "he": "וַיִּקְרָא אֶת-שֵׁם-הַמָּקוֹם הַהוּא"
      },
      {
        "ja": "קבור אלשהוה",
        "en": "'the Graves of Craving,'",
        "he": "קִבְרוֹת הַתַּאֲוָה"
      },
      {
        "ja": "לאנהם דפנו הנאך",
        "en": "because there they buried",
        "he": "כִּי-שָׁם קָבְרוּ"
      },
      {
        "ja": "אלקום",
        "en": "the people",
        "he": "אֶת-הָעָם"
      },
      {
        "ja": "אלמתשהיין",
        "en": "who had craved.",
        "he": "הַמִּתְאַוִּים"
      }
    ],
    "35": [
      {
        "ja": "ורחלו מנה",
        "en": "And they journeyed from there",
        "he": "מִקִּבְרוֹת הַתַּאֲוָה"
      },
      {
        "ja": "אלי' חצרות",
        "en": "to Hazeroth;",
        "he": "נָסְעוּ הָעָם חֲצֵרוֹת"
      },
      {
        "ja": "פלמא אקאמו בהא",
        "en": "and when they settled there.",
        "he": "וַיִּהְיוּ בַּחֲצֵרוֹת"
      }
    ]
  }
}