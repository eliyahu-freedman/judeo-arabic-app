        "he": "כַּאֲשֶׁר עָשִׂיתָ"
      },
      {
        "ja": "בסיחון",
        "en": "to Sihon",
        "he": "לְסִיחֹן"
      },
      {
        "ja": "מלך אלאמוריין",
        "en": "king of the Amorites",
        "he": "מֶלֶךְ הָאֱמֹרִי"
      },
      {
        "ja": "אלמקים פי חשבון",
        "en": "who dwelt in Heshbon.'",
        "he": "אֲשֶׁר יוֹשֵׁב בְּחֶשְׁבּוֹן"
      }
    ],
    "35": [
      {
        "ja": "פקתלוה",
        "en": "And they slew him",
