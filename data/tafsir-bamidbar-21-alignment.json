        "he": "בְּנֹתֶיהָ"
      },
      {
        "ja": "וקרצ'ו אלאמורי",
        "en": "and drove out the Amorites",
        "he": "ויירש (וַיּוֹרֶשׁ) אֶת-הָאֱמֹרִי"
      },
      {
        "ja": "אלד'י פיהא",
        "en": "who were in them.",
        "he": "אֲשֶׁר-שָׁם"
      }
    ],
    "33": [
      {
        "ja": "ת'ם",
        "en": "Then"
      },
      {
        "ja": "ולו",
        "en": "they turned",
        "he": "וַיִּפְנוּ"
      },
      {
