        "he": "אֶל-מֹשֶׁה"
      },
      {
        "ja": "לא תכ'אפה",
        "en": "'Do not fear him,",
        "he": "אַל-תִּירָא אֹתוֹ"
      },
      {
        "ja": "פאני מסלמה פי ידך",
        "en": "for I am delivering him into your hand —",
        "he": "כִּי בְיָדְךָ נָתַתִּי אֹתוֹ"
      },
      {
        "ja": "וגמיע קומה",
        "en": "and all his people",
        "he": "וְאֶת-כָּל-עַמּוֹ"
      },
      {
        "ja": "ובלדה",
        "en": "and his land.",
        "he": "וְאֶת-אַרְצוֹ"
      },
      {
        "ja": "פאצנע בה",
        "en": "Do to him",
        "he": "וְעָשִׂיתָ לּוֹ"
      },
      {
        "ja": "כמא צנעת",
