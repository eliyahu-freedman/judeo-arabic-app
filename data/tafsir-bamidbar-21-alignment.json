      {
        "ja": "לאלחרב",
        "en": "to battle,",
        "he": "לַמִּלְחָמָה"
      },
      {
        "ja": "אלי' אד'ראעאת",
        "en": "at Edrei.",
        "he": "אֶדְרֶעִי"
      }
    ],
    "34": [
      {
        "ja": "פקאל אללה",
        "en": "And God said",
        "he": "וַיֹּאמֶר יְהוָה"
      },
      {
        "ja": "למוסי'",
