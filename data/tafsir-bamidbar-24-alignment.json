        "en": "and beholder of the visions of the All-Sufficient,",
        "he": "מַחֲזֵה שַׁדַּי יֶחֱזֶה"
      },
      {
        "ja": "והו נאים",
        "en": "who sleeps",
        "he": "נֹפֵל"
      },
      {
        "ja": "והו מפתוח אלעין",
        "en": "with open eyes!'",
        "he": "וּגְלוּי עֵינָיִם"
      }
    ],
    "17": [
      {
        "ja": "אמר אראה",
        "en": "'A matter I see,",
        "he": "אֶרְאֶנּוּ"
      },
      {
        "ja": "וליס הו אלאן",
        "en": "though it is not now;",
        "he": "וְלֹא עַתָּה"
      },
      {
        "ja": "ואלמחה",
        "en": "and I perceive it,",
        "he": "אֲשׁוּרֶנּוּ"
      },
      {
        "ja": "והו ג'יר קריב",
        "en": "though it is not near —",
        "he": "וְלֹא קָרוֹב"
      },
      {
        "ja": "אן יטלע כוכב",
        "en": "that a star shall rise",
        "he": "דָּרַךְ כּוֹכָב"
      },
      {
        "ja": "מן אל יעקוב",
        "en": "from the house of Jacob,",
        "he": "מִיַּעֲקֹב"
      },
      {
        "ja": "ויקום קצ'יב",
        "en": "and a scepter-bearer shall arise",
        "he": "וְקָם שֵׁבֶט"
      },
      {
        "ja": "מן אל אסראיל",
        "en": "from the house of Israel,",
        "he": "מִיִּשְׂרָאֵל"
      },
      {
        "ja": "פיוהן גהאת מואב",
        "en": "and shall weaken the sides of Moab,",
        "he": "וּמָחַץ פַּאֲתֵי מוֹאָב"
      },
      {
        "ja": "ויזלזל סאיר בני שת",
        "en": "and shall shake the rest of the sons of Shet.'",
        "he": "וְקַרְקַר כָּל-בְּנֵי-שֵׁת"
      }
    ],
    "18": [
      {
        "ja": "וסיכון אדום מנקרצ'א",
        "en": "'And Edom shall be utterly destroyed,",
        "he": "וְהָיָה אֱדוֹם יְרֵשָׁה"
      },
      {
        "ja": "וכד'אלך שעיר",
        "en": "and likewise Seir",
        "he": "וְהָיָה יְרֵשָׁה שֵׂעִיר"
      },
      {
        "ja": "וסאיר אעדאיה",
        "en": "and the rest of his enemies;",
        "he": "אֹיְבָיו"
      },
      {
        "ja": "ואסראיל",
        "en": "and Israel",
        "he": "וְיִשְׂרָאֵל"
      },
      {
        "ja": "יזתאד תאיידא",
        "en": "shall grow in strength ever more.'",
        "he": "עֹשֶׂה חָיִל"
      }
    ],
    "19": [
      {
        "ja": "ואלד'י יסתולי",
        "en": "'And he who rules",
        "he": "וְיֵרְדְּ"
      },
      {
        "ja": "מן אל יעקוב",
        "en": "from the house of Jacob",
        "he": "מִיַּעֲקֹב"
      },
      {
        "ja": "יביד",
        "en": "shall destroy",
        "he": "וְהֶאֱבִיד"
      },
      {
        "ja": "אלשריד",
        "en": "the remnant",
        "he": "שָׂרִיד"
      },
      {
        "ja": "מן אלקרא",
        "en": "from the towns.'",
        "he": "מֵעִיר"
      }
    ],
    "20": [
      {
        "ja": "ת'ם",
        "en": "Then"
      },
      {
        "ja": "ראא",
        "en": "he saw",
        "he": "וַיַּרְא"
      },
      {
        "ja": "אלעמלקיין",
        "en": "the Amalekites,",
        "he": "אֶת-עֲמָלֵק"
      },
      {
        "ja": "פצ'רב מת'לה",
        "en": "and uttered his parable",
        "he": "וַיִּשָּׂא מְשָׁלוֹ"
      },
      {
        "ja": "וקאל",
        "en": "and said:",
        "he": "וַיֹּאמַר"
      },
      {
        "ja": "אוול חרב אלאמם",
        "en": "'The first to make war among the nations",
        "he": "רֵאשִׁית גּוֹיִם"
      },
      {
        "ja": "עמלק",
        "en": "was Amalek,",
        "he": "עֲמָלֵק"
      },
      {
        "ja": "ואכ'רתה",
        "en": "and its end is",
        "he": "וְאַחֲרִיתוֹ"
      },
      {
        "ja": "אלי' אלאבאדה",
        "en": "unto destruction.'",
        "he": "עֲדֵי אֹבֵד"
      }
    ],
    "21": [
      {
        "ja": "ת'ם",
        "en": "Then"
      },
      {
        "ja": "ראא",
        "en": "he saw",
        "he": "וַיַּרְא"
      },
      {
        "ja": "אלקיניין",
        "en": "the Kenites,",
        "he": "אֶת-הַקֵּינִי"
      },
      {
        "ja": "פצ'רב מת'לה",
        "en": "and uttered his parable",
        "he": "וַיִּשָּׂא מְשָׁלוֹ"
      },
      {
        "ja": "וקאל",
        "en": "and said:",
        "he": "וַיֹּאמַר"
      },
      {
        "ja": "סיכון מגלסך צלבא",
        "en": "'Your seat shall be firm and strong,",
        "he": "אֵיתָן מוֹשָׁבֶךָ"
      },
      {
        "ja": "ותצייר פי אלצכ'ר",
        "en": "and you shall set your nest",
        "he": "וְשִׂים בַּסֶּלַע"
      },
      {
        "ja": "וכרך",
        "en": "in the rock.'",
        "he": "קִנֶּךָ"
      }
    ],
    "22": [
      {
        "ja": "ואד'א",
        "en": "'Yet"
      },
      {
        "ja": "יכון",
        "en": "there shall come",
        "he": "כִּי אִם-יִהְיֶה"
      },
      {
        "ja": "וקת",
        "en": "a time"
      },
      {
        "ja": "לנפי אלקיניין",
        "en": "for the exile of the Kenites —",
        "he": "לְבָעֵר קָיִן"
      },
      {
        "ja": "פכם",
        "en": "how many of them",
        "he": "עַד-מָה"
      },
      {
        "ja": "יסבי מנהם אלמוצליין",
        "en": "shall the people of Mosul (Asshur) take captive!'",
        "he": "אַשּׁוּר תִּשְׁבֶּךָּ"
      }
    ],
    "23": [
      {
        "ja": "פצ'רב מת'לה",
        "en": "And he uttered his parable",
        "he": "וַיִּשָּׂא מְשָׁלוֹ"
      },
      {
        "ja": "וקאל",
        "en": "and said:",
        "he": "וַיֹּאמַר"
      },
      {
        "ja": "אלויל",
        "en": "'Woe",
        "he": "אוֹי"
      },
      {
        "ja": "למן יחיא",
        "en": "to him who shall be alive",
        "he": "מִי יִחְיֶה"
      },
      {
        "ja": "אד'א ציירה אלטאיק",
        "en": "when the All-Powerful has brought this upon him!'",
        "he": "מִשֻּׂמוֹ אֵל"
      }
    ],
    "24": [
      {
        "ja": "ואלדראמיין",
        "en": "'And the Dramians",
        "he": "וְצִים"
      },
      {
        "ja": "מן פרצ'ה' קברס",
        "en": "from the harbor of Cyprus",
        "he": "מִיַּד כִּתִּים"
      },
      {
        "ja": "לתעד'ב אלמוצליין",
        "en": "shall afflict the people of Mosul",
        "he": "וְעִנּוּ אַשּׁוּר"
      },
      {
        "ja": "ואלעבריין",
        "en": "and the Hebrews —",
        "he": "וְעִנּוּ-עֵבֶר"
      },
      {
        "ja": "והם איצ'א",
        "en": "and they too",
        "he": "וְגַם-הוּא"
      },
      {
        "ja": "אלי' אבאדה",
        "en": "shall come to destruction.'",
        "he": "עֲדֵי אֹבֵד"
      }
    ],
    "25": [
      {
        "ja": "ת'ם",
        "en": "Then"
      },
      {
        "ja": "קאם",
        "en": "arose",
        "he": "וַיָּקָם"
      },
      {
        "ja": "בלעם",
        "en": "Balaam",
        "he": "בִּלְעָם"
      },
      {
        "ja": "ומצ'א",
        "en": "and departed",
        "he": "וַיֵּלֶךְ"
      },
      {
        "ja": "ורגע",
        "en": "and returned",
        "he": "וַיָּשָׁב"
      },
      {
        "ja": "אלי' מוצ'עה",
        "en": "to his place;",
        "he": "לִמְקֹמוֹ"
      },
      {
        "ja": "ובלק איצ'א",
        "en": "and Balak too",
        "he": "וְגַם-בָּלָק"
      },
      {
        "ja": "מצ'א אלי' סבילה",
        "en": "went on his way.",
        "he": "הָלַךְ לְדַרְכּוֹ"
      }
    ]
  }
}