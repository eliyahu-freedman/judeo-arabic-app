    "17": [
      {
        "ja": "פכ'ד אלמיסאם",
        "en": "then take the branding-iron",
        "he": "וְלָקַחְתָּ אֶת-הַמַּרְצֵעַ"
      },
      {
        "ja": "וצ'עה פי אד'נה",
        "en": "and put it in his ear",
        "he": "וְנָתַתָּה בְאָזְנוֹ"
      },
      {
        "ja": "ענד באבך",
        "en": "at your door",
        "he": "וּבַדֶּלֶת"
      },
      {
        "ja": "ויכון לך עבדא אלי' אלדהר",
        "en": "and he shall be your slave forever",
        "he": "וְהָיָה לְךָ עֶבֶד עוֹלָם"
      },
      {
        "ja": "ואמתך איצ'א",
        "en": "And your maidservant likewise",
        "he": "וְאַף לַאֲמָתְךָ"
      },
      {
        "ja": "פצלהא כד'אך",
        "en": "do the same for her",
        "he": "תַּעֲשֶׂה-כֵּן"
      }
    ],
    "18": [
      {
        "ja": "ולא יצעב עליך",
        "en": "And do not let it be hard for you",
        "he": "לֹא-יִקְשֶׁה בְעֵינֶךָ"
      },
      {
        "ja": "אטלאקך לה חרא מן ענדך",
        "en": "to release him free from your presence",
        "he": "בְּשַׁלֵּחֲךָ אֹתוֹ חָפְשִׁי מֵעִמָּךְ"
      },
      {
        "ja": "פאנה יגוז אן יכון קד כ'דמך",
        "en": "for it may well be that he has served you",
        "he": "כִּי מִשְׁנֶה שְׂכַר שָׂכִיר עֲבָדְךָ שֵׁשׁ שָׁנִים"
      },
      {
        "ja": "צ'עף מא יסאוי אגרה' אלאגיר",
        "en": "double the worth of a hired laborer's wage"
      },
      {
        "ja": "ויבארך לך אללה רבך",
        "en": "and God your Lord will bless you",
        "he": "וּבֵרַכְךָ יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "פי גמיע מא תצנעה",
        "en": "in all that you do",
        "he": "בְּכֹל אֲשֶׁר תַּעֲשֶׂה"
      }
    ],
    "19": [
      {
        "ja": "וכל בכר",
        "en": "Every firstborn",
        "he": "כָּל-הַבְּכוֹר"
      },
      {
        "ja": "יולד לך",
        "en": "that is born to you",
        "he": "אֲשֶׁר יִוָּלֵד"
      },
      {
        "ja": "מן ג'נמך ובקרך",
        "en": "from your flock and your cattle",
        "he": "בִּבְקָרְךָ"
      },
      {
        "ja": "אלדכור",
        "en": "the male",
        "he": "הַזָּכָר"
      },
      {
        "ja": "פאלזמה אלתקדיס ללה רבך",
        "en": "bind upon it the consecration due to God your Lord",
        "he": "תַּקְדִּישׁ לַיהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "לא תפלח באלבכר מן בקרך",
        "en": "You shall not work the firstborn of your cattle",
        "he": "לֹא תַעֲבֹד בִּבְכֹר שׁוֹרֶךָ"
      },
      {
        "ja": "ולא תגז אלבכר מן ג'נמך",
        "en": "nor shear the firstborn of your flock",
        "he": "וְלֹא תָגֹז בְּכוֹר צֹאנֶךָ"
      }
    ],
    "20": [
      {
        "ja": "בל כלה בין ידי אללה רבך",
        "en": "Rather, eat it before God your Lord",
        "he": "לִפְנֵי יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "סנה בסנה",
        "en": "year by year",
        "he": "שָׁנָה בְשָׁנָה"
      },
      {
        "ja": "פי אלמוצ'ע",
        "en": "in the place",
        "he": "בַּמָּקוֹם"
      },
      {
        "ja": "אלד'י יכ'תארה אללה",
        "en": "which God shall choose",
        "he": "אֲשֶׁר-יִבְחַר יְהוָה"
      },
      {
        "ja": "אנת",
        "en": "you",
        "he": "אַתָּה"
      },
      {
        "ja": "ואלך",
        "en": "and your household",
        "he": "וּבֵיתֶךָ"
      }
    ],
    "21": [
      {
        "ja": "ואן כאן פיה עיב",
        "en": "But if there be a blemish in it",
        "he": "וְכִי-יִהְיֶה בוֹ מוּם"
      },
      {
        "ja": "מן אזמן",
        "en": "lameness",
        "he": "פִּסֵּחַ"
      },
      {
        "ja": "או אעמא",
        "en": "or blindness",
        "he": "אוֹ עִוֵּר"
      },
      {
        "ja": "וסאיר אלעיוב אלפאסדה",
        "en": "or any of the disqualifying blemishes",
        "he": "כֹּל מוּם רָע"
      },
      {
        "ja": "לא תדבחה ללה רבך",
        "en": "you shall not slaughter it for God your Lord",
        "he": "לֹא תִזְבָּחֶנּוּ לַיהוָה אֱלֹהֶיךָ"
      }
    ],
    "22": [
      {
        "ja": "וגאיז אן תאכלה פי מחאלך",
        "en": "It is permitted that you eat it in your localities",
        "he": "בִּשְׁעָרֶיךָ תֹּאכְלֶנּוּ"
      },
      {
        "ja": "ואן יאכלה איצ'א אלנגס ואלטאהר",
        "en": "and that the impure and the pure alike eat it",
        "he": "הַטָּמֵא וְהַטָּהוֹר"
      },
      {
        "ja": "כמא יוכלאן",
        "en": "just as",
        "he": "יַחְדָּו"
      },
      {
        "ja": "לחם י אלצ'בי",
        "en": "the meat of the gazelle",
        "he": "כַּצְּבִי"
      },
      {
        "ja": "ואלאיל",
        "en": "and the deer is eaten",
        "he": "וְכָאַיָּל"
      }
    ],
    "23": [
      {
        "ja": "מא כ'לא דמה",
        "en": "Except its blood",
        "he": "רַק אֶת-דָּמוֹ"
      },
      {
        "ja": "פלא תאכלה",
        "en": "do not eat it",
        "he": "לֹא תֹאכֵל"
      },
      {
        "ja": "בל צבה עלי' אלארץ'",
        "en": "rather, pour it out upon the ground",
        "he": "עַל-הָאָרֶץ תִּשְׁפְּכֶנּוּ"
      },
      {
        "ja": "כאלמא",
        "en": "like water",
        "he": "כַּמָּיִם"
      }
    ]
  }
}