        "he": "וְיִסְּרוּ אֹתוֹ"
      }
    ],
    "19": [
      {
        "ja": "ויג'רמוה",
        "en": "And they shall fine him",
        "he": "וְעָנְשׁוּ אֹתוֹ"
      },
      {
        "ja": "מאיה' דרהם",
        "en": "a hundred dirhams",
        "he": "מֵאָה כֶסֶף"
      },
      {
        "ja": "וידפעוהא",
        "en": "and pay them",
        "he": "וְנָתְנוּ"
      },
      {
        "ja": "לאבו אלגאריה",
        "en": "to the girl's father",
        "he": "לַאֲבִי הַנַּעֲרָה"
      },
      {
        "ja": "למא אכ'רג אסמא רדייא",
        "en": "because he put out an evil name",
        "he": "כִּי הוֹצִיא שֵׁם רָע"
      },
      {
        "ja": "עלי' בכר מן אל אסראיל",
        "en": "against a virgin of the house of Israel",
        "he": "עַל בְּתוּלַת יִשְׂרָאֵל"
      },
      {
        "ja": "ותכון לה זוגה",
        "en": "and she shall be his wife",
        "he": "וְלוֹ-תִהְיֶה לְאִשָּׁה"
      },
      {
        "ja": "ולא יגוז לה טלאקהא",
        "en": "and it is not permitted for him to divorce her",
        "he": "לֹא-יוּכַל לְשַׁלְּחָהּ"
      },
      {
        "ja": "טול עמרה",
        "en": "all his days",
        "he": "כָּל-יָמָיו"
      }
    ],
    "20": [
      {
        "ja": "ואן כאן אלאמר חקא",
        "en": "But if the matter is true",
        "he": "וְאִם-אֱמֶת הָיָה הַדָּבָר הַזֶּה"
      },
      {
        "ja": "ולם תוגד לאלגאריה בראה",
        "en": "and no proof of innocence is found for the girl",
        "he": "לֹא-נִמְצְאוּ בְתוּלִים לַנַּעֲרָ"
      }
    ],
    "21": [
      {
        "ja": "פאלתכ'רג",
        "en": "then let her be brought out",
        "he": "וְהוֹצִיאוּ אֶת-הַנַּעֲרָ"
      },
      {
        "ja": "אלי' באב בית אביהא",
        "en": "to the door of her father's house",
        "he": "אֶל-פֶּתַח בֵּית-אָבִיהָ"
      },
      {
        "ja": "וירגמוהא",
        "en": "shall stone her",
        "he": "וּסְקָלוּהָ"
      },
      {
        "ja": "גמיע אהל קריתהא",
        "en": "all the people of her town",
        "he": "אַנְשֵׁי עִירָהּ"
      },
      {
        "ja": "באלחגארה",
        "en": "with stones",
        "he": "בָּאֲבָנִים"
      },
      {
        "ja": "אלי' אן תמות",
        "en": "until she dies",
        "he": "וָמֵתָה"
      },
      {
        "ja": "למא צנעת כ'סאסה פי אל אסראיל",
        "en": "because she committed a vile act among the house of Israel",
        "he": "כִּי-עָשְׂתָה נְבָלָה בְּיִשְׂרָאֵל"
      },
      {
        "ja": "פפגרת מחצנה פי בית אביהא",
        "en": "fornicating while under the protection of her father's house",
        "he": "לִזְנוֹת בֵּית אָבִיהָ"
      },
      {
        "ja": "ואנף אהל אלשר מן בינכם",
        "en": "And purge those who do evil from among you",
        "he": "וּבִעַרְתָּ הָרָע מִקִּרְבֶּךָ"
      }
    ],
    "22": [
      {
        "ja": "ואן וגד רגל",
        "en": "And if a man is found",
        "he": "כִּי-יִמָּצֵא אִישׁ"
      },
      {
        "ja": "מצ'אגע אמראה",
        "en": "lying with a woman",
        "he": "שֹׁכֵב עִם-אִשָּׁה"
      },
      {
        "ja": "ד'את בעל",
        "en": "who has a husband",
        "he": "בְעֻלַת-בַּעַל"
      },
      {
        "ja": "פליקתלא גמיעא",
        "en": "then both of them shall be put to death",
        "he": "וּמֵתוּ גַּם-שְׁנֵיהֶם"
      },
      {
        "ja": "אלרגל אלמצ'אגעהא",
        "en": "the man who lay with her",
        "he": "הָאִישׁ הַשֹּׁכֵב עִם-הָאִשָּׁה"
      },
      {
        "ja": "והי",
        "en": "and she",
        "he": "וְהָאִשָּׁה"
      },
      {
        "ja": "ואנף אהל אלשר מן אל אסראיל",
        "en": "And purge those who do evil from the house of Israel",
        "he": "וּבִעַרְתָּ הָרָע מִיִּשְׂרָאֵל"
      }
    ],
    "23": [
      {
        "ja": "ואד'א כאנת' גאריה בכר",
        "en": "And if there is a young virgin girl",
        "he": "כִּי יִהְיֶה נַעֲרָ בְתוּלָה"
      },
      {
        "ja": "ממלכה לרגל",
        "en": "who has been betrothed to a man",
        "he": "מְאֹרָשָׂה לְאִישׁ"
      },
      {
        "ja": "פוגדהא רגל אכ'ר",
        "en": "and another man finds her",
        "he": "וּמְצָאָהּ אִישׁ"
      },
      {
        "ja": "פי אלקריה",
        "en": "in the town",
        "he": "בָּעִיר"
      },
      {
        "ja": "וצ'אגעהא",
        "en": "and lies with her",
        "he": "וְשָׁכַב עִמָּהּ"
      }
    ],
    "24": [
      {
        "ja": "פאכ'רגוהמא גמיעא",
        "en": "then bring the two of them out",
        "he": "וְהוֹצֵאתֶם אֶת-שְׁנֵיהֶם"
      },
      {
        "ja": "אלי' באב תלך אלקריה",
        "en": "to the gate of that town",
        "he": "אֶל-שַׁעַר הָעִיר הַהִוא"
      },
      {
        "ja": "ותרגמוהמא באלחגארה",
        "en": "and stone them both with stones",
        "he": "וּסְקַלְתֶּם אֹתָם בָּאֲבָנִים"
      },
      {
        "ja": "אלי' אן ימותא",
        "en": "until they die",
        "he": "וָמֵתוּ"
      },
      {
        "ja": "אמא אלגאריה",
        "en": "as for the girl",
        "he": "אֶת-הַנַּעֲרָ"
      },
      {
        "ja": "פבסבב מא לם תצרך' והי פי אלקריה",
        "en": "because she did not cry out while she was in the town",
        "he": "עַל-דְּבַר אֲשֶׁר לֹא-צָעֲקָה בָעִיר"
      },
      {
        "ja": "ואמא אלרגל",
        "en": "and as for the man",
        "he": "וְאֶת-הָאִישׁ"
      },
      {
        "ja": "בסבב מא אתא זוגה' צאחבה",
        "en": "because he came upon the wife of his fellow",
        "he": "עַל-דְּבַר אֲשֶׁר-עִנָּה אֶת-אֵשֶׁת רֵעֵהוּ"
      },
      {
        "ja": "ואנף אהל אלשר מן בינכם",
        "en": "And purge those who do evil from among you",
        "he": "וּבִעַרְתָּ הָרָע מִקִּרְבֶּךָ"
      }
    ],
    "25": [
      {
        "ja": "ואן וגד אלרגל",
        "en": "But if the man finds",
        "he": "וְאִם-בַּשָּׂדֶה יִמְצָא הָאִישׁ"
      },
      {
        "ja": "אלגאריה אלממלכה",
        "en": "the betrothed girl",
        "he": "אֶת-הַנַּעֲרָ הַמְאֹרָשָׂה"
      },
      {
        "ja": "פי אלצחרא",
        "en": "in the wilderness"
      },
      {
        "ja": "ואמסכהא",
        "en": "and seizes her",
        "he": "וְהֶחֱזִיק-בָּהּ הָאִישׁ"
      },
      {
        "ja": "וצ'אגעהא",
        "en": "and lies with her",
        "he": "וְשָׁכַב עִמָּהּ"
      },
      {
        "ja": "פליקתל ד'אלך אלרגל אלמצ'אגעהא",
        "en": "then that man who lay with her",
        "he": "וּמֵת הָאִישׁ אֲשֶׁר-שָׁכַב עִמָּהּ"
      },
      {
        "ja": "וחדה",
        "en": "alone shall be put to death",
        "he": "לְבַדּוֹ"
      }
    ],
    "26": [
      {
        "ja": "ואמא אלגאריה פלא תצנע בהא שייא",
        "en": "But as for the girl, do nothing to her",
        "he": "וְלַנַּעֲרָ לֹא-תַעֲשֶׂה דָבָר"
      },
      {
        "ja": "אד' ליס להא כ'טייה תוגב אלקתל",
        "en": "for she has no sin warranting death",
        "he": "אֵין לַנַּעֲרָ חֵטְא מָוֶת"
      },
      {
        "ja": "ואנמא",
        "en": "For"
      },
      {
        "ja": "מת'ל אמרהא הד'א",
        "en": "this matter",
        "he": "כֵּן הַדָּבָר הַזֶּה"
      },
      {
        "ja": "כמן יקום עלי' צאחבה",
        "en": "is like one who rises up against his fellow",
        "he": "כִּי כַּאֲשֶׁר יָקוּם אִישׁ עַל-רֵעֵהוּ"
      },
      {
        "ja": "פיקתלה",
        "en": "and kills him",
        "he": "וּרְצָחוֹ נֶפֶשׁ"
      },
      {
        "ja": "ויפיתה נפסה",
        "en": "thereby taking his life from him"
      }
    ],
    "27": [
      {
        "ja": "ואן וגדהא פי אלצחרא",
        "en": "For he found her in the wilderness",
        "he": "כִּי בַשָּׂדֶה מְצָאָהּ"
      },
      {
        "ja": "פימכן אן יכון קד צרכת",
        "en": "it is possible that she cried out",
        "he": "צָעֲקָה הַנַּעֲרָ הַמְאֹרָשָׂה"
      },
      {
        "ja": "ולם יכון להא מג'ית'",
        "en": "but there was no rescuer for her",
        "he": "וְאֵין מוֹשִׁיעַ לָהּ"
      }
    ],
    "28": [
      {
        "ja": "ואן וגד רגל",
        "en": "And if a man finds",
        "he": "כִּי-יִמְצָא אִישׁ"
      },
      {
        "ja": "גאריה בכר",
        "en": "a young virgin girl",
        "he": "נַעֲרָ בְתוּלָה"
      },
      {
        "ja": "מא לם תמלך",
        "en": "who has not been betrothed",
        "he": "אֲשֶׁר לֹא-אֹרָשָׂה"
      },
      {
        "ja": "פצ'בטהא",
        "en": "and he seizes her",
        "he": "וּתְפָשָׂהּ"
      },
      {
        "ja": "וצ'אגעהא",
        "en": "and lies with her",
        "he": "וְשָׁכַב עִמָּהּ"
      },
      {
        "ja": "ווגדא",
        "en": "and they are found",
        "he": "וְנִמְצָאוּ"
      }
    ],
    "29": [
      {
        "ja": "פליעט ד'אלך אלרגל",
        "en": "then that man shall give",
        "he": "וְנָתַן הָאִישׁ הַשֹּׁכֵב עִמָּהּ"
      },
      {
        "ja": "לאביהא",
        "en": "to her father",
        "he": "לַאֲבִי הַנַּעֲרָ"
      },
      {
        "ja": "כ'מסין דרהם",
        "en": "fifty dirhams",
        "he": "חֲמִשִּׁים כָּסֶף"
      },
      {
        "ja": "ותכון לה זוגה",
        "en": "and she shall be his wife",
        "he": "וְלוֹ-תִהְיֶה לְאִשָּׁה"
      },
      {
        "ja": "בדל מא אתאהא",
        "en": "in recompense for what he did to her",
        "he": "תַּחַת אֲשֶׁר עִנָּהּ"
      },
      {
        "ja": "לא יגוז לה טלאקהא",
        "en": "it is not permitted for him to divorce her",
        "he": "לֹא-יוּכַל שַׁלְּחָהּ"
      },
      {
        "ja": "טול עמרה",
        "en": "all his days",
        "he": "כָּל-יָמָיו"
      }
    ]
  }
}