      },
      {
        "ja": "וחמא פי צ'אן לבן",
        "en": "and every brown one in Laban's flock"
      },
      {
        "ja": "וגעל לה קטועא וחדהא",
        "en": "and he set for himself flocks alone"
      },
      {
        "ja": "ולם יצ'יפהא אלי' ג'נם לבן",
        "en": "and did not put them together with Laban's flock"
      }
    ],
    "41": [
      {
        "ja": "וכאן יעקוב. פי כל וקת וחאם אלג'נם אלרביעייה",
        "en": "And in every time when the early-spring flocks were in heat, Jacob would"
      },
      {
        "ja": "יצייר אלעציי חד'אהא",
        "en": "set the rods opposite them"
      },
      {
        "ja": "פי אלחיאץ'",
        "en": "in the troughs"
      },
      {
        "ja": "לתתוחם בהא",
        "en": "that they should conceive by them"
      }
    ],
    "42": [
      {
        "ja": "ואד'א כ'רפת",
        "en": "And when the autumn ones came"
      },
      {
        "ja": "לם יצייר ד'אלך",
        "en": "he would not set them"
      },
      {
        "ja": "פתציר אלכ'ריפייה ללבן",
        "en": "and the autumn-born became Laban's"
      },
      {
        "ja": "ואלרביעייה ליעקוב",
        "en": "and the spring-born Jacob's"
      }
    ],
    "43": [
      {
        "ja": "פאיסר אלרגל גדא גדא",
        "en": "And the man grew exceedingly rich"
      },
      {
        "ja": "וצאר לה ג'נם כת'יר",
        "en": "and he had many sheep"
      },
      {
        "ja": "ואמא ועביד",
        "en": "and maidservants and slaves"
      },
      {
        "ja": "וגמאל וחמיר",
        "en": "and camels and donkeys"
      }
    ]
  }
}