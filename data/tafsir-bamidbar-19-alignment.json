      {
        "ja": "וכל מן דנא",
        "en": "And every one who approaches",
        "he": "וְכֹל אֲשֶׁר-יִגַּע"
      },
      {
        "ja": "עלי' וגה אלצחרא",
        "en": "upon the face of the wilderness —",
        "he": "עַל-פְּנֵי הַשָּׂדֶה"
      },
      {
        "ja": "בקתיל סיף",
        "en": "one slain by the sword,",
        "he": "בַּחֲלַל-חֶרֶב"
      },
      {
        "ja": "או מיית",
        "en": "or a dead person,",
        "he": "אוֹ בְמֵת"
      },
      {
        "ja": "או עצ'ם אנסאן",
        "en": "or a human bone,",
        "he": "אוֹ-בְעֶצֶם אָדָם"
      },
      {
        "ja": "או קבר",
        "en": "or a grave —",
        "he": "אוֹ בְקָבֶר"
      },
      {
        "ja": "ינגס",
        "en": "shall be impure",
        "he": "יִטְמָא"
      },
      {
        "ja": "סבעה' אייאם",
        "en": "for seven days.",
        "he": "שִׁבְעַת יָמִים"
      }
    ],
    "17": [
      {
        "ja": "וליוכ'ד'",
        "en": "And there shall be taken",
        "he": "וְלָקְחוּ"
      },
      {
        "ja": "לה",
        "en": "for him",
        "he": "לַטָּמֵא"
      },
      {
        "ja": "מן רמאד",
        "en": "some of the ashes of",
        "he": "מֵעֲפַר"
      },
      {
        "ja": "חריק אלבקרה",
        "en": "the burning of the cow,",
        "he": "שְׂרֵפַת הַחַטָּאת"
      },
      {
        "ja": "ויצב עלי'ה",
        "en": "and spring water shall be poured over it",
        "he": "וְנָתַן עָלָיו"
      },
      {
        "ja": "מא נביע",
        "en": "into",
        "he": "מַיִם חַיִּים"
      },
      {
        "ja": "פי אנא",
        "en": "a vessel.",
        "he": "אֶל-כֶּלִי"
      }
    ],
    "18": [
      {
        "ja": "ואליאכ'ד' רגל טאהר שייא מן צעתר",
        "en": "And a ritually pure man shall take some hyssop,",
        "he": "וְלָקַח אֵזוֹב"
      },
      {
        "ja": "ויג'מסה פי ד'אלך אלמא",
        "en": "and dip it in that water,",
        "he": "וְטָבַל בַּמַּיִם"
      },
      {
        "ja": "וינצ'ח",
        "en": "and shall sprinkle",
        "he": "אִישׁ טָהוֹר"
      },
      {
        "ja": "עלי' אלכ'בא",
        "en": "upon the tent,",
        "he": "וְהִזָּה עַל-הָאֹהֶל"
      },
      {
        "ja": "ועלי' גמיע אלאניה",
        "en": "and upon all the vessels,",
        "he": "וְעַל-כָּל-הַכֵּלִים"
      },
      {
        "ja": "ועלי' אלנפוס אלד'י כאנת ת'ם",
        "en": "and upon the persons who were there,",
        "he": "וְעַל-הַנְּפָשׁוֹת אֲשֶׁר הָיוּ-שָׁם"
      },
      {
        "ja": "ועלי' אלדאני",
        "en": "and upon the one who drew near",
        "he": "וְעַל-הַנֹּגֵעַ"
      },
      {
        "ja": "באל עצ'ם",
        "en": "to a bone,",
        "he": "בַּעֶצֶם"
      },
      {
        "ja": "או באלקתיל",
        "en": "or to the slain,",
        "he": "אוֹ בֶחָלָל"
      },
      {
        "ja": "או אלמיית",
        "en": "or to the dead,",
        "he": "אוֹ בַמֵּת"
      },
      {
        "ja": "או אלקבר",
        "en": "or to the grave.",
        "he": "אוֹ בַקָּבֶר"
      }
    ],
    "19": [
      {
        "ja": "כדאך",
        "en": "So"
      },
      {
        "ja": "ינצ'ח אלטאהר",
        "en": "the pure man shall sprinkle",
        "he": "וְהִזָּה הַטָּהֹר"
      },
      {
        "ja": "עלי' אלנגס",
        "en": "upon the impure",
        "he": "עַל-הַטָּמֵא"
      },
      {
        "ja": "פי אליום אלת'לאת'",
        "en": "on the third day",
        "he": "בַּיּוֹם הַשְּׁלִישִׁי"
      },
      {
        "ja": "ואלסאבע",
        "en": "and the seventh day;",
        "he": "וּבַיּוֹם הַשְּׁבִיעִי"
      },
      {
        "ja": "פאד'א ד'כאה פי אליום אלסאבע",
        "en": "and when he has purified him on the seventh day,",
        "he": "וְחִטְּאוֹ בַּיּוֹם הַשְּׁבִיעִי"
      },
      {
        "ja": "ג'סל ת'יאבה",
        "en": "he shall wash his garments",
        "he": "וְכִבֶּס בְּגָדָיו"
      },
      {
        "ja": "ורחץ' באלמא",
        "en": "and rinse himself with water,",
        "he": "וְרָחַץ בַּמַּיִם"
      },
      {
        "ja": "וטהר באלעשי",
        "en": "and shall be pure at evening.",
        "he": "וְטָהֵר בָּעָרֶב"
      }
    ],
    "20": [
      {
        "ja": "ואי רגל",
        "en": "But any man",
        "he": "וְאִישׁ"
      },
      {
        "ja": "תנגס בד'אלך",
        "en": "who has become impure by this",
        "he": "אֲשֶׁר-יִטְמָא"
      },
      {
        "ja": "ולם יתד'כא",
        "en": "and has not purified himself —",
        "he": "וְלֹא יִתְחַטָּא"
      },
      {
        "ja": "פינקטע ד'אלך אלאנסאן",
        "en": "that person shall be cut off",
        "he": "וְנִכְרְתָה הַנֶּפֶשׁ הַהִוא"
      },
      {
        "ja": "מן בין אלגוק",
        "en": "from among the assembly,",
        "he": "מִתּוֹךְ הַקָּהָל"
      },
      {
        "ja": "למא",
        "en": "since",
        "he": "כִּי"
      },
      {
        "ja": "נגס מקדס אללה אד' דכ'לה",
        "en": "he has defiled the sanctuary of God when he entered it,",
        "he": "אֶת-מִקְדַּשׁ יְהוָה טִמֵּא"
      },
      {
        "ja": "ולם ינצ'ח עלי'ה מן מא אלנצ'ח",
        "en": "and the water of sprinkling was not sprinkled upon him;",
        "he": "מֵי נִדָּה"
      },
      {
        "ja": "פהו נגס",
        "en": "he is impure.",
        "he": "לֹא-זֹרַק עָלָיו"
      }
    ],
    "21": [
      {
        "ja": "ויכון להם",
        "en": "And this shall be for them",
        "he": "וְהָיְתָה לָהֶם"
      },
      {
        "ja": "דא'לך רסם אלדהר",
        "en": "a perpetual statute forever.",
        "he": "לְחֻקַּת עוֹלָם"
      },
      {
        "ja": "ונאצ'ח",
        "en": "And the one who sprinkles",
        "he": "וּמַזֵּה"
      },
      {
        "ja": "מא אלנצ'ח",
        "en": "the water of sprinkling",
        "he": "מֵי-הַנִּדָּה"
      },
      {
        "ja": "יג'סל ת'יאבה",
        "en": "shall wash his garments;",
        "he": "יְכַבֵּס בְּגָדָיו"
      },
      {
        "ja": "ומן לאמס",
        "en": "and whoever touches",
        "he": "וְהַנֹּגֵעַ"
      },
      {
        "ja": "מא אלנצ'ח",
        "en": "the water of sprinkling",
        "he": "בְּמֵי הַנִּדָּה"
      },
      {
        "ja": "ינגס",
        "en": "shall be impure",
        "he": "יִטְמָא"
      },
      {
        "ja": "אלי' אלליל",
        "en": "until the evening.",
        "he": "עַד-הָעָרֶב"
      }
    ],
    "22": [
      {
        "ja": "וכל מא לאמסה",
        "en": "And whatever",
        "he": "וְכֹל אֲשֶׁר-יִגַּע-בּוֹ"
      },
      {
        "ja": "אלנגס",
        "en": "the impure person touches",
        "he": "הַטָּמֵא"
      },
      {
        "ja": "ינגס",
        "en": "shall become impure;",
        "he": "יִטְמָא"
      },
      {
        "ja": "פאן כאן אנסאן דנא בה",
        "en": "and if a person approached it,",
        "he": "וְהַנֶּפֶשׁ הַנֹּגַעַת"
      },
      {
        "ja": "ינגס",
        "en": "he shall be impure",
        "he": "תִּטְמָא"
      },
      {
        "ja": "אלי' אלליל",
        "en": "until the evening.",
        "he": "עַד-הָעָרֶב"
      }
    ]
  }
}