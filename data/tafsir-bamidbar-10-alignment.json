        "he": "כִּי עַל-כֵּן יָדַעְתָּ"
      },
      {
        "ja": "אן פי טול מקאמנא",
        "en": "that throughout the length of our sojourn",
        "he": "חֲנֹתֵנוּ"
      },
      {
        "ja": "פי אלבר",
        "en": "in the open country,",
        "he": "בַּמִּדְבָּר"
      },
      {
        "ja": "כנת",
        "en": "you have been",
        "he": "וְהָיִיתָ"
      },
      {
        "ja": "לנא",
        "en": "for us",
        "he": "לָּנוּ"
      },
      {
        "ja": "כאבצארנא",
        "en": "as our eyesight.'",
        "he": "לְעֵינָיִם"
      }
    ],
    "32": [
      {
        "ja": "פאן סרת",
        "en": "'And if you journey",
        "he": "וְהָיָה כִּי-תֵלֵךְ"
      },
      {
        "ja": "מענא",
        "en": "with us,",
        "he": "עִמָּנוּ"
      },
      {
        "ja": "פאי כ'יר",
        "en": "then whatever good",
        "he": "וְהָיָה הַטּוֹב הַהוּא"
      },
      {
        "ja": "יחסן אללה",
        "en": "God shall deal well",
        "he": "אֲשֶׁר יֵיטִיב יְהוָה"
      },
      {
        "ja": "בה אלינא",
        "en": "to us with,",
        "he": "עִמָּנוּ"
