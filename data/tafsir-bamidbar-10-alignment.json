        "he": "לָתוּר לָהֶם"
      },
      {
        "ja": "מסתקרא",
        "en": "a resting-place for them.",
        "he": "מְנוּחָה"
      }
    ],
    "34": [
      {
        "ja": "וג'מאם",
        "en": "And the cloud",
        "he": "וַעֲנַן"
      },
      {
        "ja": "אללה",
        "en": "of God",
        "he": "יְהוָה"
      },
      {
        "ja": "עליהם",
        "en": "was over them",
        "he": "עֲלֵיהֶם"
      },
      {
        "ja": "נהארא",
        "en": "by day,",
        "he": "יוֹמָם"
      },
      {
        "ja": "אד' רחלו",
        "en": "when they set out",
        "he": "בְּנָסְעָם"
      },
      {
        "ja": "מן אלעסכר",
        "en": "from the camp.",
        "he": "מִן-הַמַּחֲנֶה"
      }
    ],
    "36": [
      {
        "ja": "וענד נזולה",
        "en": "And at its coming to rest,",
        "he": "וּבְנֻחֹה"
      },
      {
        "ja": "אן יקול",
        "en": "he would say:",
        "he": "יֹאמַר"
      },
      {
        "ja": "רד",
        "en": "'Return,",
        "he": "שׁוּבָה"
      },
      {
        "ja": "יא רב",
        "en": "O Lord,",
        "he": "יְהוָה"
      },
      {
        "ja": "נורך",
        "en": "Your light,"
      },
      {
        "ja": "אלי' רבוואת",
        "en": "to the ten-thousands",
        "he": "רִבְבוֹת"
      },
      {
        "ja": "אלוף אל אסראיל",
        "en": "of the thousands of the house of Israel.'",
        "he": "אַלְפֵי יִשְׂרָאֵל"
      }
    ]
