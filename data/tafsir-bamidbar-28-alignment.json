        "he": "לַיהוָה"
      },
      {
        "ja": "רת'ין מן אלבקר",
        "en": "two bulls from the cattle,",
        "he": "פָּרִים בְּנֵי-בָקָר שְׁנַיִם"
      },
      {
        "ja": "וכבשא",
        "en": "and a ram,",
        "he": "וְאַיִל אֶחָד"
      },
      {
        "ja": "וסבעה חמלאן",
        "en": "and seven yearling lambs;",
        "he": "וְשִׁבְעָה כְבָשִׂים"
      },
      {
        "ja": "בני סנה",
        "en": "they shall be",
        "he": "בְּנֵי שָׁנָה"
      },
      {
        "ja": "צחאחא יכונאן לכם",
        "en": "without blemish for you.",
        "he": "תְּמִימִם יִהְיוּ לָכֶם"
      }
    ],
