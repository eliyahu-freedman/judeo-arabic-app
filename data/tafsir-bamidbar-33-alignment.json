      },
      {
        "ja": "בני אסראיל",
        "en": "the sons of Israel",
        "he": "אֶל-בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "וקל",
        "en": "and say",
        "he": "וְאָמַרְתָּ"
      },
      {
        "ja": "להם",
        "en": "to them:",
        "he": "אֲלֵהֶם"
      },
      {
        "ja": "אנכם",
        "en": "You are",
        "he": "כִּי אַתֶּם"
      },
      {
        "ja": "גאיזין",
        "en": "crossing",
        "he": "עֹבְרִים"
      },
      {
        "ja": "אלארדן",
        "en": "the Jordan",
        "he": "אֶת-הַיַּרְדֵּן"
      },
      {
        "ja": "אלי' בלד כנעאן",
        "en": "into the land of Canaan.",
        "he": "אֶל-אֶרֶץ כְּנָעַן"
      }
    ],
    "52": [
      {
        "ja": "פאקרצ'ו",
        "en": "And drive out",
        "he": "וְהוֹרַשְׁתֶּם"
      },
      {
        "ja": "גמיע אהל אלבלד",
        "en": "all the inhabitants of the land",
        "he": "אֶת-כָּל-יֹשְׁבֵי הָאָרֶץ"
      },
      {
        "ja": "מן בין ידיכם",
        "en": "from before you,",
        "he": "מִפְּנֵיכֶם"
      },
      {
        "ja": "ואבידו",
        "en": "and destroy",
        "he": "וְאִבַּדְתֶּם"
      },
      {
        "ja": "גמיע מזכ'רפאתהם",
        "en": "all their ornaments",
        "he": "אֵת כָּל-מַשְׂכִּיֹּתָם"
      },
      {
        "ja": "ואצנאם מסבוכאתהם",
        "en": "and their graven idols;",
        "he": "וְאֵת כָּל-צַלְמֵי מַסֵּכֹתָם תְּאַבֵּדוּ"
      },
      {
        "ja": "וביעהם תנפד'ון",
        "en": "and their temples of worship you shall demolish.",
        "he": "וְאֵת כָּל-בָּמוֹתָם תַּשְׁמִידוּ"
      }
    ],
    "53": [
      {
        "ja": "פאד'א קרצ'תמוהם",
        "en": "And when you have driven them out,",
        "he": "וְהוֹרַשְׁתֶּם"
      },
      {
        "ja": "אסכנו אלבלד",
        "en": "settle the land —",
        "he": "וִישַׁבְתֶּם-בָּהּ"
      },
      {
        "ja": "פקד אעטיתכם",
        "en": "for I have given it to you",
        "he": "כִּי לָכֶם"
      },
      {
        "ja": "אייאה",
        "en": "that you may",
        "he": "נָתַתִּי אֶת-הָאָרֶץ"
      },
      {
        "ja": "לתחוזוהו",
        "en": "possess it.",
        "he": "לָרֶשֶׁת אֹתָהּ"
      }
    ],
    "54": [
      {
        "ja": "ותווזעוה",
        "en": "And you shall apportion it",
        "he": "וְהִתְנַחַלְתֶּם"
      },
      {
        "ja": "באסהם",
        "en": "by equal shares",
        "he": "בְּגוֹרָל"
      },
      {
        "ja": "לעשאירכם",
        "en": "among your clans:",
        "he": "לְמִשְׁפְּחֹתֵיכֶם"
      },
      {
        "ja": "לאלכת'יר כת'רו נחלתה",
        "en": "for the numerous enlarge his portion,",
        "he": "לָרַב תַּרְבּוּ אֶת-נַחֲלָתוֹ"
      },
      {
        "ja": "ולאלקליל קללוהא",
        "en": "and for the few reduce it.",
        "he": "וְלַמְעַט תַּמְעִיט אֶת-נַחֲלָתוֹ"
      },
      {
        "ja": "מן כ'רג לה אלסהם פי אי מוצ'ע כאן לה",
        "en": "To whomever his share falls, in whatever place it may be, that shall be his;",
        "he": "אֶל אֲשֶׁר-יֵצֵא לוֹ שָׁמָּה הַגּוֹרָל"
      },
      {
        "ja": "ועלי' אסבאט אבאיכם תתוזעונה",
        "en": "according to the tribes of your fathers you shall apportion it.",
        "he": "לְמַטּוֹת אֲבֹתֵיכֶם תִּתְנֶחָלוּ"
      }
    ],
    "55": [
      {
        "ja": "ואן לם תקרצ'ו",
        "en": "But if you do not drive out",
        "he": "וְאִם-לֹא תוֹרִישׁוּ"
      },
      {
        "ja": "אהל אלבלד",
        "en": "the inhabitants of the land",
        "he": "אֶת-יֹשְׁבֵי הָאָרֶץ"
      },
      {
        "ja": "מן בין ידיכם",
        "en": "from before you,",
        "he": "מִפְּנֵיכֶם"
      },
      {
        "ja": "פיציר מא תבקונה מנהם",
        "en": "then whatever you leave of them shall become",
        "he": "וְהָיָה אֲשֶׁר תּוֹתִירוּ מֵהֶם"
      },
      {
        "ja": "כאבר פי עיונכם",
        "en": "like fine needles in your eyes",
        "he": "לְשִׂכִּים בְּעֵינֵיכֶם"
      },
      {
        "ja": "וכמסאל פי גנובכם",
        "en": "and like thick thorns in your sides,",
        "he": "וְלִצְנִינִם בְּצִדֵּיכֶם"
      },
      {
        "ja": "ויצ'איקונכם",
        "en": "and they shall press hard upon you",
        "he": "וְצָרְרוּ אֶתְכֶם"
      },
      {
        "ja": "פי אלבלד. אלד'י אנתם מקימין פיה",
        "en": "in the land in which you are settled.",
        "he": "עַל-הָאָרֶץ אֲשֶׁר אַתֶּם יֹשְׁבִים בָּהּ"
      }
    ],
    "56": [
      {
        "ja": "פאכון",
        "en": "And it shall be:",
        "he": "וְהָיָה"
      },
      {
        "ja": "כמא קצדת",
        "en": "just as I intended",
        "he": "כַּאֲשֶׁר דִּמִּיתִי"
      },
      {
        "ja": "אן אצנע בהם",
        "en": "to do to them,",
        "he": "לַעֲשׂוֹת לָהֶם"
      },
      {
        "ja": "אצנע בכם",
        "en": "so shall I do to you.",
        "he": "אֶעֱשֶׂה לָכֶם"
      }
    ]
  }
}