        "he": "כָּל-הַפְּקֻדִים"
      },
      {
        "ja": "אלד'י עד מוסי' והרון",
        "en": "whom Moses and Aaron",
        "he": "אֲשֶׁר פָּקַד מֹשֶׁה וְאַהֲרֹן"
      },
      {
        "ja": "ואשראף בני אסראיל",
        "en": "and the nobles of the sons of Israel counted —",
        "he": "וּנְשִׂיאֵי יִשְׂרָאֵל"
      },
      {
        "ja": "אלליואניין",
        "en": "the Levites —",
        "he": "אֶת-הַלְוִיִּם"
      },
      {
        "ja": "לעשאירהם",
        "en": "by their clans",
        "he": "לְמִשְׁפְּחֹתָם"
      },
      {
        "ja": "וביות",
        "en": "and their fathers'",
        "he": "וּלְבֵית"
      },
      {
        "ja": "אבאיהם",
        "en": "houses,",
        "he": "אֲבֹתָם"
      }
    ],
    "47": [
      {
        "ja": "מן אבן",
        "en": "from",
        "he": "מִבֶּן"
      },
      {
        "ja": "ת'לאת'ין",
        "en": "thirty",
        "he": "שְׁלֹשִׁים"
      },
      {
        "ja": "סנה",
        "en": "years of age",
        "he": "שָׁנָה"
      },
      {
        "ja": "פצאעדא",
        "en": "and upward,",
        "he": "וָמַעְלָה"
      },
      {
        "ja": "אלי'",
        "en": "up to",
        "he": "וְעַד"
      },
      {
        "ja": "כ'מסין סנה",
        "en": "fifty years of age —",
        "he": "בֶּן-חֲמִשִּׁים שָׁנָה"
      },
      {
        "ja": "כל מן ידכ'ל",
        "en": "every one who enters",
        "he": "כָּל-הַבָּא"
      },
      {
        "ja": "ליכ'דם",
        "en": "to serve",
        "he": "לַעֲבֹד"
      },
      {
        "ja": "כדמה' עמל",
        "en": "the service of labor",
        "he": "עֲבֹדַת עֲבֹדָה"
      },
      {
        "ja": "וחמל",
        "en": "and the service of burden",
        "he": "וַעֲבֹדַת מַשָּׂא"
      },
      {
        "ja": "פי כ'בא אלמחצ'ר",
        "en": "in the tent of the assembly.",
        "he": "בְּאֹהֶל מוֹעֵד"
      }
    ],
    "48": [
      {
        "ja": "פכאן עדדהם",
        "en": "And their count was",
        "he": "וַיִּהְיוּ פְּקֻדֵיהֶם"
      },
      {
        "ja": "ת'מאניה' אלאף",
        "en": "eight thousand",
        "he": "שְׁמֹנַת אֲלָפִים"
      },
      {
        "ja": "וכ'מס מאיה",
        "en": "five hundred",
        "he": "וַחֲמֵשׁ מֵאוֹת"
      },
      {
        "ja": "ות'מאניין",
        "en": "and eighty.",
        "he": "וּשְׁמֹנִים"
      }
    ],
    "49": [
      {
        "ja": "עלי' קול אללה",
        "en": "By the command of God",
        "he": "עַל-פִּי יְהוָה"
      },
      {
        "ja": "עדהם",
        "en": "Moses counted them,",
        "he": "פָּקַד אוֹתָם"
      },
      {
        "ja": "מוסי'",
        "en": "each group",
        "he": "בְּיַד-מֹשֶׁה"
      },
      {
        "ja": "כל פריק",
        "en": "in its labor",
        "he": "אִישׁ אִישׁ"
      },
      {
        "ja": "פי עמלה",
        "en": "and its burden,",
        "he": "עַל-עֲבֹדָתוֹ"
      },
      {
        "ja": "וחמלה",
        "en": "and its number —",
        "he": "וְעַל-מַשָּׂאוֹ"
      },
      {
        "ja": "ועדדה. כמא אמר אללה מוסי'",
        "en": "as God commanded Moses.",
        "he": "וּפְקֻדָיו אֲשֶׁר-צִוָּה יְהוָה אֶת-מֹשֶׁה"
      }
    ]
  }
}