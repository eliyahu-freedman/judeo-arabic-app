        "en": "and the increase of your flock",
        "he": "וְעַשְׁתְּרֹת צֹאנֶךָ"
      },
      {
        "ja": "פי אלבלד",
        "en": "in the land",
        "he": "עַל הָאֲדָמָה"
      },
      {
        "ja": "אלד'י קסם לאבאיך",
        "en": "which He swore to your fathers",
        "he": "אֲשֶׁר-נִשְׁבַּע לַאֲבֹתֶיךָ"
      },
      {
        "ja": "אן יעטיכהא",
        "en": "to give you",
        "he": "לָתֶת לָךְ"
      }
    ],
    "14": [
      {
        "ja": "ותכון מבארך",
        "en": "And you shall be blessed",
        "he": "בָּרוּךְ תִּהְיֶה"
      },
      {
        "ja": "מן גמיע אלאמם",
        "en": "above all nations",
        "he": "מִכָּל-הָעַמִּים"
      },
      {
        "ja": "ולא יכון פיך עאקר",
        "en": "there shall remain among you neither barren man",
        "he": "לֹא-יִהְיֶה בְךָ עָקָר"
      },
      {
        "ja": "ולא עאקרה",
        "en": "nor barren woman",
        "he": "וַעֲקָרָה"
      },
      {
        "ja": "ולא פי בהאימך",
        "en": "nor among your beasts",
        "he": "וּבִבְהֶמְתֶּךָ"
      }
    ],
    "15": [
      {
        "ja": "ויזיל אללה",
        "en": "And God will remove",
        "he": "וְהֵסִיר יְהוָה"
      },
      {
        "ja": "מנך",
        "en": "from you",
        "he": "מִמְּךָ"
      },
      {
        "ja": "כל מרץ'",
        "en": "every illness",
        "he": "כָּל-חֹלִי"
      },
      {
        "ja": "וגמיע אדוי מצר אלרדייה",
        "en": "and all the evil afflictions of Egypt",
        "he": "וְכָל-מַדְוֵי מִצְרַיִם הָרָעִים"
      },
      {
        "ja": "אלתי תערפהא",
        "en": "which you know",
        "he": "אֲשֶׁר יָדַעְתָּ"
      },
      {
        "ja": "לא יחל בך שייא מנהא",
        "en": "He will not bring any of them upon you",
        "he": "לֹא יְשִׂימָם בָּךְ"
      },
      {
        "ja": "בל",
        "en": "but"
      },
      {
        "ja": "יחלהא בשאניך",
        "en": "will bring them upon those who hate you",
        "he": "וּנְתָנָם בְּכָל-שֹׂנְאֶיךָ"
      }
    ],
    "16": [
      {
        "ja": "פתפני",
        "en": "And you shall destroy",
        "he": "וְאָכַלְתָּ"
      },
      {
        "ja": "גמיע אלשעוב",
        "en": "all the peoples",
        "he": "אֶת-כָּל-הָעַמִּים"
      },
      {
        "ja": "אלד'י יעטיך אללה רבך",
        "en": "whom God your Lord gives you",
        "he": "אֲשֶׁר יְהוָה אֱלֹהֶיךָ נֹתֵן לָךְ"
      },
      {
        "ja": "לא תשפק עליהם",
        "en": "do not show compassion upon them",
        "he": "לֹא-תָחוֹס עֵינְךָ עֲלֵיהֶם"
      },
      {
        "ja": "ולא תעבד מעבודאתהם",
        "en": "and do not serve their objects of worship",
        "he": "וְלֹא תַעֲבֹד אֶת-אֱלֹהֵיהֶם"
      },
      {
        "ja": "פיכונו לך והקא",
        "en": "for they would become a noose for you",
        "he": "כִּי-מוֹקֵשׁ הוּא לָךְ"
      }
    ],
    "17": [
      {
        "ja": "פאן",
        "en": "If"
      },
      {
        "ja": "קלת",
        "en": "you say",
        "he": "כִּי תֹאמַר"
      },
      {
        "ja": "פי נפסך",
        "en": "to yourself",
        "he": "בִּלְבָבְךָ"
      },
      {
        "ja": "הולאי אלאמם אכת'ר",
        "en": "These nations are more numerous",
        "he": "רַבִּים הַגּוֹיִם הָאֵלֶּה"
      },
      {
        "ja": "מני",
        "en": "than I",
        "he": "מִמֶּנִּי"
      },
      {
        "ja": "פכיף אטיק",
        "en": "how can I manage",
        "he": "אֵיכָה אוּכַל"
      },
      {
        "ja": "אן אקרצ'הם",
        "en": "to gnaw them away",
        "he": "לְהוֹרִישָׁם"
      }
    ],
    "18": [
      {
        "ja": "לא תכ'אפהם",
        "en": "do not fear them",
        "he": "לֹא תִירָא"
      },
      {
        "ja": "בל",
        "en": "rather"
      },
      {
        "ja": "אד'כר",
        "en": "remember",
        "he": "זָכֹר תִּזְכֹּר"
      },
      {
        "ja": "מא צנע",
        "en": "what",
        "he": "אֵת אֲשֶׁר-עָשָׂה"
      },
      {
        "ja": "אללה רבך",
        "en": "God your Lord did",
        "he": "יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "לפרעון",
        "en": "to Pharaoh",
        "he": "לְפַרְעֹה"
      },
      {
        "ja": "וסאיר אלמצריון",
        "en": "and to the rest of the Egyptians",
        "he": "וּלְכָל-מִצְרָיִם"
      }
    ],
    "19": [
      {
        "ja": "אלאעלאם אלעצי'מה",
        "en": "the great signs",
        "he": "הַמַּסֹּת הַגְּדֹלֹת"
      },
      {
        "ja": "אלתי ראתהא עינאך",
        "en": "which your eyes saw",
        "he": "אֲשֶׁר-רָאוּ עֵינֶיךָ"
      },
      {
        "ja": "ואלאיאת",
        "en": "and the wonders",
        "he": "וְהָאֹתֹת"
      },
      {
        "ja": "ואלבראהין",
        "en": "and the proofs",
        "he": "וְהַמֹּפְתִים"
      },
      {
        "ja": "ואליד אלשדידה",
        "en": "and the mighty hand",
        "he": "וְהַיָּד הַחֲזָקָה"
      },
      {
        "ja": "ואלדראע אלממדודה",
        "en": "and the outstretched arm",
        "he": "וְהַזְּרֹעַ הַנְּטוּיָה"
      },
      {
        "ja": "כמא אכ'רגך",
        "en": "just as",
        "he": "אֲשֶׁר הוֹצִאֲךָ"
      },
      {
        "ja": "אללה רבך",
        "en": "God your Lord brought you out",
        "he": "יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "כד'אך יצנע",
        "en": "so He will do",
        "he": "כֵּן-יַעֲשֶׂה יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "בגמיע אלאמם",
        "en": "to all the nations",
        "he": "לְכָל-הָעַמִּים"
      },
      {
        "ja": "אלד'ין תכ'אפהם",
        "en": "whom you fear",
        "he": "אֲשֶׁר-אַתָּה יָרֵא מִפְּנֵיהֶם"
      }
    ],
    "20": [
      {
        "ja": "ויבעת' באלעאהה",
        "en": "And He will send the plague",
        "he": "וְגַם אֶת-הַצִּרְעָה"
      },
      {
        "ja": "פיהם",
        "en": "among them",
        "he": "יְשַׁלַּח יְהוָה אֱלֹהֶיךָ בָּם"
      },
      {
        "ja": "חתי' יביד אלבאקיון",
        "en": "until those remaining",
        "he": "עַד-אֲבֹד הַנִּשְׁאָרִים"
      },
      {
        "ja": "ואלמנסתרון",
        "en": "and those hidden",
        "he": "וְהַנִּסְתָּרִים"
      },
      {
        "ja": "מן בין ידיך",
        "en": "from before you are destroyed",
        "he": "מִפָּנֶיךָ"
      }
    ],
    "21": [
      {
        "ja": "לא תרהבהם",
        "en": "Do not be in dread of them",
        "he": "לֹא תַעֲרֹץ"
      },
      {
        "ja": "לאן נור אללה רבך",
        "en": "for the light of God your Lord",
        "he": "כִּי-יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "פי מא בינך",
        "en": "is in your midst",
        "he": "בְּקִרְבֶּךָ"
      },
      {
        "ja": "אלטאיק אל עצ'ים",
        "en": "the Capable, the great",
        "he": "אֵל גָּדוֹל"
      },
      {
        "ja": "אלמכ'יף",
        "en": "the awe-inspiring",
        "he": "וְנוֹרָא"
      }
    ],
    "22": [
      {
        "ja": "והו יטחטח",
        "en": "And He will shatter",
        "he": "וְנָשַׁל יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "אולאיך אלאמם",
        "en": "those nations",
        "he": "אֶת-הַגּוֹיִם הָאֵל"
      },
      {
        "ja": "מן בין ידיך",
        "en": "from before you",
        "he": "מִפָּנֶיךָ"
      },
      {
        "ja": "קלילא קלילא",
        "en": "little by little",
        "he": "מְעַט מְעָט"
      },
      {
        "ja": "אד' לא תטיק",
        "en": "since you cannot manage",
        "he": "לֹא תוּכַל"
      },
      {
        "ja": "אן תפניהם סריעא",
        "en": "to destroy them quickly",
        "he": "כַּלֹּתָם מַהֵר"
      },
      {
        "ja": "כלא יכת'ר עליך",
        "en": "lest",
        "he": "פֶּן-תִּרְבֶּה עָלֶיךָ"
      },
      {
        "ja": "וחש אלצחרא",
        "en": "the wild creatures of the wilderness multiply upon you",
        "he": "חַיַּת הַשָּׂדֶה"
      }
    ],
    "23": [
      {
        "ja": "פאד'א",
        "en": "But when"
      },
      {
        "ja": "אסלמהם אללה רבך פי ידך",
        "en": "God your Lord delivers them into your hand",
        "he": "וּנְתָנָם יְהוָה אֱלֹהֶיךָ לְפָנֶיךָ"
      },
      {
        "ja": "פאהאמהם",
        "en": "He will throw them",
        "he": "וְהָמָם"
      },
      {
        "ja": "אהאמה",
        "en": "into"
      },
      {
        "ja": "עצ'ימה",
        "en": "great confusion",
        "he": "מְהוּמָה גְדֹלָה"
      },
      {
        "ja": "אלי' אנפאד'הם",
        "en": "until they are destroyed",
        "he": "עַד הִשָּׁמְדָם"
      }
    ],
    "24": [
      {
        "ja": "ויסלם מלוכהם",
        "en": "And He will deliver their kings",
        "he": "וְנָתַן מַלְכֵיהֶם"
      },
      {
        "ja": "פי ידך",
        "en": "into your hand",
        "he": "בְּיָדֶךָ"
      },
      {
        "ja": "פאבד אסמאיהם",
        "en": "and you shall blot out their names",
        "he": "וְהַאֲבַדְתָּ אֶת-שְׁמָם"
      },
      {
        "ja": "מן תחת אלסמא",
        "en": "from under the sky",
        "he": "מִתַּחַת הַשָּׁמָיִם"
      },
      {
        "ja": "לא יקף אנסאן בין ידיך",
        "en": "no man shall stand before you",
        "he": "לֹא-יִתְיַצֵּב אִישׁ בְּפָנֶיךָ"
      },
      {
        "ja": "אלי' אן תנפד'הם",
        "en": "until you have destroyed them",
        "he": "עַד הִשְׁמִדְךָ אֹתָם"
      }
    ],
    "25": [
      {
        "ja": "ואחרקו פסול מעבודאתהם",
        "en": "And burn the carved idols of their objects of worship",
        "he": "פְּסִילֵי אֱלֹהֵיהֶם"
      },
      {
        "ja": "באלנאר",
        "en": "with fire",
        "he": "תִּשְׂרְפוּן בָּאֵשׁ"
      },
      {
        "ja": "ולא תתמן שייא",
        "en": "and do not covet any",
        "he": "לֹא-תַחְמֹד"
      },
      {
        "ja": "מן אלפצ'ה ואלד'הב",
        "en": "of the silver and gold",
        "he": "כֶּסֶף וְזָהָב"
      },
      {
        "ja": "אלד'י עליהם",
        "en": "that is upon them",
        "he": "עֲלֵיהֶם"
      },
      {
        "ja": "ותאכ'ד'ה לך",
        "en": "so as to take it for yourself",
        "he": "וְלָקַחְתָּ לָךְ"
      },
      {
        "ja": "כלא תוהק בה",
        "en": "lest you be ensnared by it",
        "he": "פֶּן תִּוָּקֵשׁ בּוֹ"
      },
      {
        "ja": "לאנה כריהה ללה רבך",
        "en": "for it is something abhorrent to God your Lord",
        "he": "כִּי תוֹעֲבַת יְהוָה אֱלֹהֶיךָ הוּא"
      }
    ],
    "26": [
      {
        "ja": "ולא תדכ'ל",
        "en": "And do not bring",
        "he": "וְלֹא-תָבִיא"
      },
      {
        "ja": "מא יכרהה אללה",
        "en": "what God abhors",
        "he": "תוֹעֵבָה"
      },
      {
        "ja": "אלי' ביתך",
        "en": "into your house",
        "he": "אֶל-בֵּיתֶךָ"
      },
      {
        "ja": "ותציר מתלופא מת'לה",
        "en": "lest you become doomed like it",
        "he": "וְהָיִיתָ חֵרֶם כָּמֹהוּ"
      },
      {
        "ja": "בל",
        "en": "rather"
      },
      {
        "ja": "רגסה תרגיסא",
        "en": "utterly abominate it",
        "he": "שַׁקֵּץ תְּשַׁקְּצֶנּוּ"
      },
      {
        "ja": "ואכרהה כריהה",
        "en": "and utterly abhor it",
        "he": "וְתַעֵב תְּתַעֲבֶנּוּ"
      },
      {
        "ja": "אד' הו מתלוף",
        "en": "for it is doomed",
        "he": "כִּי-חֵרֶם הוּא"
      }
    ]
  }
}