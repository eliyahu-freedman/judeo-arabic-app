        "en": "he was standing",
        "he": "נִצָּב"
      },
      {
        "ja": "ענד קרבאנה",
        "en": "by his offering,",
        "he": "עַל-עֹלָתוֹ"
      },
      {
        "ja": "ורויסא מואב",
        "en": "and the chiefs of Moab",
        "he": "וְשָׂרֵי מוֹאָב"
      },
      {
        "ja": "מעה",
        "en": "with him.",
        "he": "אִתּוֹ"
      },
      {
        "ja": "קאל לה",
        "en": "And he said to him:",
        "he": "וַיֹּאמֶר לוֹ בָּלָק"
      },
      {
        "ja": "מא ד'א קאל אללה",
        "en": "'What has God said?'",
        "he": "מַה-דִּבֶּר יְהוָה"
      }
    ],
    "18": [
      {
        "ja": "פצ'רב מת'לה",
        "en": "And he spoke his parable",
        "he": "וַיִּשָּׂא מְשָׁלוֹ"
      },
      {
        "ja": "וקאל",
        "en": "and said:",
        "he": "וַיֹּאמַר"
      },
      {
        "ja": "קום",
        "en": "'Arise,",
        "he": "קוּם"
      },
      {
        "ja": "יא בלק",
        "en": "O Balak,",
        "he": "בָּלָק"
      },
      {
        "ja": "ואסמע",
        "en": "and hear!",
        "he": "וּשְׁמָע"
      },
      {
        "ja": "ואנצת לקולי",
        "en": "Give ear to my words,",
        "he": "הַאֲזִינָה עָדַי"
      },
      {
        "ja": "יא אבן צפור",
        "en": "O son of Zippor!'",
        "he": "בְּנוֹ צִפֹּר"
      }
    ],
    "19": [
      {
        "ja": "ליס אלטאיק",
        "en": "'The All-Powerful is not",
        "he": "לֹא אִישׁ אֵל"
      },
      {
        "ja": "כאלנאס פיכד'ב",
        "en": "like men that He should lie,",
        "he": "וִיכַזֵּב"
      },
      {
        "ja": "ולא כבני אדם",
        "en": "nor like the sons of Adam",
        "he": "וּבֶן-אָדָם"
      },
      {
        "ja": "פינדם",
        "en": "that He should repent.",
        "he": "וְיִתְנֶחָם"
      },
      {
        "ja": "אתראה יקול",
        "en": "Do you think He would say",
        "he": "הַהוּא אָמַר"
      },
      {
        "ja": "ולא יפעל",
        "en": "and not act,",
        "he": "וְלֹא יַעֲשֶׂה"
      },
      {
        "ja": "או יתכלם",
        "en": "or speak",
        "he": "וְדִבֶּר"
      },
      {
        "ja": "ולא יקום בה",
        "en": "and not fulfill it?'",
        "he": "וְלֹא יְקִימֶנָּה"
      }
    ],
    "20": [
      {
        "ja": "אלא אן",
        "en": "'Indeed,",
        "he": "הִנֵּה"
      },
      {
        "ja": "ברכאת קבלתהא",
        "en": "blessings I have received —",
        "he": "בָרֵךְ לָקָחְתִּי"
      },
      {
        "ja": "פאבארך פיהם",
        "en": "and so I bless them,",
        "he": "וּבֵרֵךְ"
      },
      {
        "ja": "ולא ארדהא",
        "en": "and I shall not reverse it.'",
        "he": "וְלֹא אֲשִׁיבֶנָּה"
      }
    ],
    "21": [
      {
        "ja": "ממא לא יבצר ג'לא",
        "en": "'Whereby no iniquity is seen",
        "he": "לֹא-הִבִּיט אָוֶן"
      },
      {
        "ja": "פי אל יעקוב",
        "en": "in the house of Jacob,",
        "he": "בְּיַעֲקֹב"
      },
      {
        "ja": "ולא דג'לא",
        "en": "nor deceit",
        "he": "וְלֹא-רָאָה עָמָל"
      },
      {
        "ja": "פי אל אסראיל",
        "en": "in the house of Israel —",
        "he": "בְּיִשְׂרָאֵל"
      },
      {
        "ja": "פאללה רבהם",
        "en": "for God is their Lord",
        "he": "יְהוָה אֱלֹהָיו"
      },
      {
        "ja": "מעהם",
        "en": "with them,",
        "he": "עִמּוֹ"
      },
      {
        "ja": "וצחאבה' אלמלך",
        "en": "and the companionship of the King",
        "he": "וּתְרוּעַת מֶלֶךְ"
      },
      {
        "ja": "להם",
        "en": "is theirs.'",
        "he": "בּוֹ"
      }
    ],
    "22": [
      {
        "ja": "אלטאיק",
        "en": "'The All-Powerful",
        "he": "אֵל"
      },
      {
        "ja": "אלמכ'רגהם",
        "en": "who brought them out",
        "he": "מוֹצִיאָם"
      },
      {
        "ja": "מן מצר",
        "en": "of Egypt —",
        "he": "מִמִּצְרָיִם"
      },
      {
        "ja": "כארק",
        "en": "like the vigilance of",
        "he": "כְּתוֹעֲפֹת"
      },
      {
        "ja": "אלרים מאנע ענהם",
        "en": "the wild ox, prevailing over them.'",
        "he": "רְאֵם לוֹ"
      }
    ],
    "23": [
      {
        "ja": "ולא טיירה",
        "en": "'And no omen",
        "he": "כִּי לֹא-נַחַשׁ"
      },
      {
        "ja": "תחיך",
        "en": "can take hold"
      },
      {
        "ja": "פי אל יעקוב",
        "en": "in the house of Jacob,",
        "he": "בְּיַעֲקֹב"
      },
      {
        "ja": "ולא קאסומה",
        "en": "nor divination",
        "he": "וְלֹא-קֶסֶם"
      },
      {
        "ja": "ת'וות'ר",
        "en": "take effect"
      },
      {
        "ja": "פי אל אסראיל",
        "en": "in the house of Israel —",
        "he": "בְּיִשְׂרָאֵל"
      },
      {
        "ja": "ואנמא יקאל להם",
        "en": "rather, what",
        "he": "כָּעֵת יֵאָמֵר"
      },
      {
        "ja": "מא צנע",
        "en": "the All-Powerful has done",
        "he": "לְיַעֲקֹב וּלְיִשְׂרָאֵל"
      },
      {
        "ja": "אלטאיק פקט",
        "en": "alone is what is declared to them.'",
        "he": "מַה-פָּעַל אֵל"
      }
    ],
    "24": [
      {
        "ja": "והו שעב",
        "en": "'For it is a people",
        "he": "הֶן-עָם"
      },
      {
        "ja": "כלבו יקום",
        "en": "that rises like a lioness,",
        "he": "כְּלָבִיא יָקוּם"
      },
      {
        "ja": "וכאסד",
        "en": "and lifts itself up",
        "he": "וְכַאֲרִי"
      },
      {
        "ja": "ירתפע",
        "en": "like a lion —",
        "he": "יִתְנַשָּׂא"
      },
      {
        "ja": "אלד'י לא ינצ'גע",
        "en": "that does not lie down",
        "he": "לֹא יִשְׁכַּב"
      },
      {
        "ja": "אלי' אן יאכל",
        "en": "until it has eaten",
        "he": "עַד-יֹאכַל"
      },
      {
        "ja": "פריסה",
        "en": "its prey",
        "he": "טֶרֶף"
      },
      {
        "ja": "וישרב דם אלצרעא",
        "en": "and drunk the blood of the slain.'",
        "he": "וְדַם-חֲלָלִים יִשְׁתֶּה"
      }
    ],
    "25": [
      {
        "ja": "קאל לה בלק",
        "en": "Balak said to him:",
        "he": "וַיֹּאמֶר בָּלָק"
      },
      {
        "ja": "אד' לא תסבה",
        "en": "'Since you will not curse him",
        "he": "גַּם-קֹב"
      },
      {
        "ja": "סבא",
        "en": "with a curse,",
        "he": "לֹא תִקֳּבֶנּוּ"
      },
      {
        "ja": "פלא תבארכה ברכה",
        "en": "then do not bless him with a blessing either.'",
        "he": "גַּם-בָּרֵךְ לֹא תְבָרְכֶנּוּ"
      }
    ],
    "26": [
      {
        "ja": "פאגאבה",
        "en": "He answered him,",
        "he": "וַיַּעַן בִּלְעָם"
      },
      {
        "ja": "קאילא",
        "en": "saying:",
        "he": "וַיֹּאמֶר אֶל-בָּלָק"
      },
      {
        "ja": "אלם אקול לך",
        "en": "'Did I not already tell you",
        "he": "הֲלֹא דִּבַּרְתִּי אֵלֶיךָ"
      },
      {
        "ja": "אן כל מא יקולה",
        "en": "that whatever",
        "he": "לֵאמֹר כֹּל אֲשֶׁר-יְדַבֵּר"
      },
      {
        "ja": "אללה",
        "en": "God says —",
        "he": "יְהוָה"
      },
      {
        "ja": "אצנעה",
        "en": "that I shall do?'",
        "he": "אֹתוֹ אֶעֱשֶׂה"
      }
    ],
    "27": [
      {
        "ja": "קאל",
        "en": "He said:",
        "he": "וַיֹּאמֶר בָּלָק"
      },
      {
        "ja": "תעאל",
        "en": "'Come,",
        "he": "לְכָה-נָּא"
      },
      {
        "ja": "אכ'ד'ך",
        "en": "let me take you",
        "he": "אֶקָּחֲךָ"
      },
      {
        "ja": "אלי' מוצע אכ'ר",
        "en": "to another place —",
        "he": "אֶל-מָקוֹם אַחֵר"
      },
      {
        "ja": "פלעל אן",
        "en": "perhaps",
        "he": "אוּלַי"
      },
      {
        "ja": "יסהל",
        "en": "it may be easy",
        "he": "יִישַׁר"
      },
      {
        "ja": "ענד אללה",
        "en": "before God,",
        "he": "בְּעֵינֵי הָאֱלֹהִים"
      },
      {
        "ja": "פתסבה לי",
        "en": "and you shall curse him for me",
        "he": "וְקַבֹּתוֹ לִי"
      },
      {
        "ja": "מן הנאך",
        "en": "from there.'",
        "he": "מִשָּׁם"
      }
    ],
    "28": [
      {
        "ja": "פאכ'דה",
        "en": "And he took him",
        "he": "וַיִּקַּח בָּלָק"
      },
      {
        "ja": "אלי' ראס",
        "en": "to the top of",
        "he": "אֶת-בִּלְעָם"
      },
      {
        "ja": "אלראביה",
        "en": "Peor,",
        "he": "רֹאשׁ הַפְּעוֹר"
      },
      {
        "ja": "אלמטלעה",
        "en": "which overlooks",
        "he": "הַנִּשְׁקָף"
      },
      {
        "ja": "עלי' וגה",
        "en": "the face of",
        "he": "עַל-פְּנֵי"
      },
      {
        "ja": "אלסמאוא",
        "en": "the vast expanse.",
        "he": "הַיְשִׁימֹן"
      }
    ],
    "29": [
      {
        "ja": "קאל",
        "en": "He said:",
        "he": "וַיֹּאמֶר בִּלְעָם"
      },
      {
        "ja": "אבן לי",
        "en": "'Build me",
        "he": "בְּנֵה-לִי"
      },
      {
        "ja": "ההנא",
        "en": "here",
        "he": "בָזֶה"
      },
      {
        "ja": "סבעה מד'אבח",
        "en": "seven altars,",
        "he": "שִׁבְעָה מִזְבְּחֹת"
      },
      {
        "ja": "ואעד לי",
        "en": "and prepare for me",
        "he": "וְהָכֵן לִי"
      },
      {
        "ja": "ההנא",
        "en": "here"
      },
      {
        "ja": "סבעה רתות'",
        "en": "seven bulls",
        "he": "שִׁבְעָה פָרִים"
      },
      {
        "ja": "וסבעה כבאש",
        "en": "and seven rams.'",
        "he": "וְשִׁבְעָה אֵילִם"
      }
    ],
    "36": [
      {
        "ja": "פצנע",
        "en": "And he did",
        "he": "ַיַּעַשׂ בָּלָק"
      },
      {
        "ja": "כמא קאל לה בלעם",
        "en": "as Balaam had told him;",
        "he": "כַּאֲשֶׁר אָמַר בִּלְעָם"
      },
      {
        "ja": "וקרב",
        "en": "and he offered there",
        "he": "וַיַּעַל"
      },
      {
        "ja": "ת'ורא",
        "en": "a bull",
        "he": "פָּר"
      },
      {
        "ja": "וכבשא",
        "en": "and a ram",
        "he": "וָאַיִל"
      },
      {
        "ja": "עלי' כל מד'בחא",
        "en": "upon each altar.",
        "he": "בַּמִּזְבֵּחַ"
      }
    ]
  }
}