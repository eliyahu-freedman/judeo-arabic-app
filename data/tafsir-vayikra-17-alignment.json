        "he": "כָּל-אֹכְלָיו"
      },
      {
        "ja": "ינקטע",
        "en": "shall be cut off",
        "he": "יִכָּרֵת"
      }
    ],
    "15": [
      {
        "ja": "ואי אנסאן",
        "en": "And any person",
        "he": "וְכָל-נֶפֶשׁ"
      },
      {
        "ja": "אכל",
