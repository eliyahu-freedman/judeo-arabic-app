        "he": "לִבְנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "דם כל בשרי",
        "en": "the blood of every creature of flesh",
        "he": "דַּם כָּל-בָּשָׂר"
      },
      {
        "ja": "לא תאכלו.",
