        "en": "and place it",
        "he": "וְשַׂמְתֶּם אֹתוֹ"
      },
      {
        "ja": "אלי' גאנב צנדוק עהד אללה רבכם",
        "en": "beside the ark of the covenant of God your Lord",
        "he": "מִצַּד אֲרוֹן בְּרִית-יְהוָה אֱלֹהֵיכֶם"
      },
      {
        "ja": "יכון ת'ם",
        "en": "it shall be there",
        "he": "וְהָיָה-שָׁם"
      },
      {
        "ja": "עליך שאהדא",
        "en": "as a witness against you",
        "he": "בְּךָ לְעֵד"
      }
    ],
    "27": [
      {
        "ja": "לאני עאלם",
        "en": "For I know",
        "he": "כִּי אָנֹכִי יָדַעְתִּי"
      },
      {
        "ja": "בכ'לאפך",
        "en": "your contrariness",
        "he": "אֶת-מֶרְיְךָ"
      },
      {
        "ja": "וצעובה' רקבתך",
        "en": "and the stubbornness of your neck",
        "he": "וְאֶת-עָרְפְּךָ הַקָּשֶׁה"
      },
      {
        "ja": "הוד'א ואנא פי אלחיאה",
        "en": "Behold — while I am yet alive",
        "he": "הֵן בְּעוֹדֶנִּי חַי"
      },
      {
        "ja": "מעכם אליום",
        "en": "with you this day",
        "he": "עִמָּכֶם הַיּוֹם"
      },
      {
        "ja": "לם תזאלו מכ'אלפין",
        "en": "you have not ceased to be disobedient",
        "he": "מַמְרִים הֱיִתֶם"
      },
      {
        "ja": "ללה",
        "en": "to God",
        "he": "עִם-יְהוָה"
      },
      {
        "ja": "פכיף בעד מותי",
        "en": "how much more so after my death",
        "he": "וְאַף כִּי-אַחֲרֵי מוֹתִי"
      }
    ],
    "28": [
      {
        "ja": "גווקו אליי",
        "en": "Assemble to me",
        "he": "הַקְהִילוּ אֵלַי"
      },
      {
