        "en": "from the mouths of their offspring",
        "he": "מִפִּי זַרְעוֹ"
      },
      {
        "ja": "לאני עאלם בכ'אטרהם",
        "en": "since I know their thoughts",
        "he": "כִּי יָדַעְתִּי אֶת-יִצְרוֹ"
      },
      {
        "ja": "ובמא סיצנעוה מן אליום",
        "en": "and what they are about to do, from this very day",
        "he": "אֲשֶׁר הוּא עֹשֶׂה הַיּוֹם"
      },
      {
        "ja": "מן קבל אן אדכ'להם",
        "en": "before I bring them",
        "he": "בְּטֶרֶם אֲבִיאֶנּוּ"
      },
      {
        "ja": "אלי' אלבלד אלד'י קסמת",
        "en": "into the land which I have sworn",
        "he": "אֶל-הָאָרֶץ אֲשֶׁר נִשְׁבַּעְתִּי"
      }
    ],
    "22": [
      {
        "ja": "פכתב מוסי'",
        "en": "So Moses wrote",
        "he": "וַיִּכְתֹּב מֹשֶׁה"
      },
      {
        "ja": "הד'ה אלתסבחה",
        "en": "this song of praise",
        "he": "אֶת-הַשִּׁירָה הַזֹּאת"
      },
      {
        "ja": "פי ד'אלך אליום",
        "en": "on that day",
        "he": "בַּיּוֹם הַהוּא"
      },
      {
        "ja": "ועלמהא לבני אסראיל",
        "en": "and taught it to the sons of Israel",
        "he": "וַיְלַמְּדָהּ אֶת-בְּנֵי יִשְׂרָאֵל"
      }
    ],
    "23": [
      {
        "ja": "ת'ם",
        "en": "Then"
      },
      {
        "ja": "אסתכ'לף יהושע",
        "en": "He appointed Joshua",
        "he": "וַיְצַו אֶת-יְהוֹשֻׁעַ"
      },
      {
        "ja": "אבן נון",
        "en": "son of Nun",
        "he": "בִּן-נוּן"
      },
      {
        "ja": "וקאל לה",
        "en": "as successor, and said to him"
      },
      {
        "ja": "אשתד",
        "en": "Be strong",
        "he": "חֲזַק"
      },
      {
        "ja": "ותאייד",
        "en": "and firm",
        "he": "וֶאֱמָץ"
      },
      {
        "ja": "לאנך תד'כל",
        "en": "for you shall bring",
        "he": "כִּי אַתָּה תָּבִיא"
      },
      {
        "ja": "בני אסראיל",
        "en": "the sons of Israel",
        "he": "אֶת-בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "אלי' אלבלד",
        "en": "into the land",
        "he": "אֶל-הָאָרֶץ"
      },
      {
        "ja": "אלד'י קסמת להם",
        "en": "which I have sworn to them",
        "he": "אֲשֶׁר-נִשְׁבַּעְתִּי לָהֶם"
      },
      {
        "ja": "ואנא אכון מעך",
        "en": "and I shall be with you",
        "he": "וְאָנֹכִי אֶהְיֶה עִמָּךְ"
      }
    ],
    "24": [
      {
        "ja": "ת'ם",
        "en": "Then"
      },
      {
        "ja": "למא פרג' מוסי'",
        "en": "when Moses had finished",
        "he": "וַיְהִי כְּכַלּוֹת מֹשֶׁה"
      },
      {
        "ja": "מן כתב",
        "en": "writing",
        "he": "לִכְתֹּב"
      },
      {
        "ja": "גמיע כלאם הד'ה אלתורייה",
        "en": "all the words of this Torah",
        "he": "אֶת-דִּבְרֵי הַתּוֹרָה-הַזֹּאת"
      },
      {
