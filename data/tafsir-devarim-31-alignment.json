        "en": "in a scroll",
        "he": "עַל-סֵפֶר"
      },
      {
        "ja": "אלי' אן כמלת",
        "en": "until they were complete",
        "he": "עַד תֻּמָּם"
      }
    ],
    "25": [
      {
        "ja": "פאמר מוסי'",
        "en": "Moses commanded",
        "he": "וַיְצַו מֹשֶׁה"
      },
      {
        "ja": "אלליואניין",
        "en": "the Levites",
        "he": "אֶת-הַלְוִיִּם"
      },
      {
        "ja": "חאמלי צנדוק עהד אללה",
        "en": "the bearers of the ark of the covenant of God",
        "he": "נֹשְׂאֵי אֲרוֹן בְּרִית-יְהוָה"
      },
      {
        "ja": "וקאל להם",
        "en": "and said to them",
        "he": "לֵאמֹר"
      }
    ],
    "26": [
      {
        "ja": "כ'דו",
        "en": "Take",
        "he": "לָקֹחַ"
      },
      {
        "ja": "הד'א ספר אלתורייה",
        "en": "this scroll of the Torah",
        "he": "אֵת סֵפֶר הַתּוֹרָה הַזֶּה"
      },
      {
