      },
      {
        "ja": "חתי אסתכ'לפה",
        "en": "so that I may appoint him as successor",
        "he": "וַאֲצַוֶּנּוּ"
      },
      {
        "ja": "פמצ'א מוסי' ויהושע",
        "en": "And Moses and Joshua went",
        "he": "וַיֵּלֶךְ מֹשֶׁה וִיהוֹשֻׁעַ"
      },
      {
        "ja": "ווקפא פי כ'בא אלמחצ'ר",
        "en": "and stood in the tent of the assembly",
        "he": "וַיִּתְיַצְּבוּ בְּאֹהֶל מוֹעֵד"
      }
    ],
    "15": [
      {
        "ja": "פתגלא אללה",
        "en": "And God appeared",
        "he": "וַיֵּרָא יְהוָה"
      },
      {
        "ja": "פי אלכ'בא",
        "en": "in the tent",
        "he": "בָּאֹהֶל"
      },
      {
        "ja": "בעמוד מן ג'מאם",
        "en": "in a pillar of cloud",
        "he": "בְּעַמּוּד עָנָן"
      },
      {
        "ja": "ווקף",
        "en": "and it stood",
        "he": "וַיַּעֲמֹד עַמּוּד הֶעָנָן"
      },
      {
        "ja": "עלי' באבה",
        "en": "at its entrance",
        "he": "עַל-פֶּתַח הָאֹהֶל"
      }
    ],
    "16": [
      {
        "ja": "פקאל אללה אולא למוסי'",
        "en": "And God said first to Moses",
        "he": "וַיֹּאמֶר יְהוָה אֶל-מֹשֶׁה"
      },
      {
        "ja": "אנך סתנצ'גע מע אבאיך",
        "en": "You shall presently lie down with your fathers",
        "he": "הִנְּךָ שֹׁכֵב עִם-אֲבֹתֶיךָ"
      },
      {
        "ja": "וסיקום הד'א אלשעב",
        "en": "and this people shall arise",
        "he": "וְקָם הָעָם הַזֶּה"
      },
      {
        "ja": "ויטגי פי תבע",
        "en": "and go astray, following",
        "he": "וְזָנָה אַחֲרֵי"
      },
      {
        "ja": "מעבודאת אהל אלבלד",
        "en": "the objects of worship of the people of the land",
        "he": "אֱלֹהֵי נֵכַר-הָאָרֶץ"
      },
      {
        "ja": "אלד'י הו צאיר אלי' ת'ם",
        "en": "to which it is going",
        "he": "אֲשֶׁר הוּא בָא-שָׁמָּה"
      },
      {
        "ja": "פי מא בינהם",
        "en": "in their midst",
        "he": "בְּקִרְבּוֹ"
      },
      {
        "ja": "ויתרכני",
        "en": "and it shall forsake Me",
        "he": "וַעֲזָבַנִי"
      },
      {
        "ja": "ויפסך' עהדי",
        "en": "and break My covenant",
        "he": "וְהֵפֵר אֶת-בְּרִיתִי"
      },
      {
        "ja": "אלד'י עהדתה מעה",
        "en": "which I made with it",
        "he": "אֲשֶׁר כָּרַתִּי אִתּוֹ"
      }
    ],
    "17": [
      {
        "ja": "וישתד ג'צ'בי עליהם",
        "en": "And My anger shall intensify against them",
        "he": "וְחָרָה אַפִּי בוֹ"
      },
      {
        "ja": "פי ד'אלך אלזמאן",
        "en": "at that time"
      },
      {
        "ja": "פאתרכהם",
        "en": "and I shall leave them",
        "he": "וַעֲזַבְתִּים"
      },
      {
        "ja": "ואחגב רחמתי ענהם",
        "en": "and I shall withhold My mercy from them",
        "he": "וְהִסְתַּרְתִּי פָנַי מֵהֶם"
      },
      {
        "ja": "פיצירון מאכלא",
        "en": "so that they shall become prey",
        "he": "וְהָיָה לֶאֱכֹל"
      },
      {
        "ja": "ותציבהם",
        "en": "shall befall them",
        "he": "וּמְצָאֻהוּ"
      },
      {
        "ja": "שרור כת'ירה",
        "en": "many evils",
        "he": "רָעוֹת רַבּוֹת"
      },
      {
        "ja": "ושדאיד",
        "en": "and hardships",
        "he": "וְצָרוֹת"
      },
      {
        "ja": "פיקולון פי ד'אלך אלזמאן",
        "en": "And they shall say at that time",
        "he": "וְאָמַר בַּיּוֹם הַהוּא"
      },
      {
        "ja": "אלא אן ממא ליס",
        "en": "Is it not because",
        "he": "הֲלֹא עַל כִּי-אֵין"
      },
      {
        "ja": "ענאיה' רבי מעי",
        "en": "the providence of my Lord is not with me",
        "he": "אֱלֹהַי בְּקִרְבִּי"
      },
      {
        "ja": "אצאבתני הד'ה אלבלאיא",
        "en": "that these afflictions have befallen me",
        "he": "מְצָאוּנִי הָרָעוֹת הָאֵלֶּה"
      }
    ],
    "18": [
      {
        "ja": "ומע ד'אלך",
        "en": "And yet"
      },
      {
        "ja": "אנא מקים עלי' חגב רחמתי ענהם",
        "en": "I persist in withholding My mercy from them",
        "he": "וְאָנֹכִי הַסְתֵּר אַסְתִּיר פָּנַי"
      },
      {
        "ja": "פי ד'אלך אלזמאן",
        "en": "at that time",
        "he": "בַּיּוֹם הַהוּא"
      },
      {
        "ja": "בסבב אלשר אלד'י צנעוה",
        "en": "on account of the evil which they have done",
        "he": "עַל כָּל-הָרָעָה אֲשֶׁר עָשָׂה"
      },
      {
        "ja": "אד' ולא",
        "en": "since they have turned",
        "he": "כִּי פָנָה"
      },
      {
        "ja": "אלי' מעבודאת אכ'ר",
        "en": "to other objects of worship",
        "he": "אֶל-אֱלֹהִים אֲחֵרִים"
      }
    ],
    "19": [
      {
        "ja": "ואלאן",
        "en": "And now",
        "he": "וְעַתָּה"
      },
      {
        "ja": "פאכתבו לכם",
        "en": "write down for yourselves",
        "he": "כִּתְבוּ לָכֶם"
      },
      {
        "ja": "הד'ה אלתסבחה",
        "en": "this song of praise",
        "he": "אֶת-הַשִּׁירָה הַזֹּאת"
      },
      {
        "ja": "ולקנהא",
        "en": "and teach it",
        "he": "וְלַמְּדָהּ"
      },
      {
        "ja": "בני אסראיל",
        "en": "to the sons of Israel",
        "he": "אֶת-בְּנֵי-יִשְׂרָאֵל"
      },
      {
        "ja": "חתי תסתמלהא מן אפואהם",
        "en": "until you receive it in full from their mouths",
        "he": "שִׂימָהּ בְּפִיהֶם"
      },
      {
        "ja": "לכי תכון לי שאהדא עליהם",
        "en": "so that it may be a witness for Me against them",
        "he": "לְמַעַן תִּהְיֶה-לִּי הַשִּׁירָה הַזֹּאת לְעֵד"
      }
    ],
    "20": [
      {
        "ja": "אד' אדכ'להם",
        "en": "For when I bring them",
        "he": "כִּי-אֲבִיאֶנּוּ"
      },
      {
        "ja": "אלי' אלבלד",
        "en": "into the land",
        "he": "אֶל-הָאֲדָמָה"
      },
      {
        "ja": "אלד'י אקסמת לאבאיהם",
        "en": "which I swore to their fathers",
        "he": "אֲשֶׁר-נִשְׁבַּעְתִּי לַאֲבֹתָיו"
      },
      {
        "ja": "והו בלד יפיץ' לבנא",
        "en": "a land flowing with milk",
        "he": "זָבַת חָלָב"
      },
      {
        "ja": "ועסלא",
        "en": "and honey",
        "he": "וּדְבַשׁ"
      },
      {
        "ja": "פיאכל קומהם",
        "en": "their people shall eat",
        "he": "וְאָכַל"
      },
      {
        "ja": "וישבע",
        "en": "and be satisfied",
        "he": "וְשָׂבַע"
      },
      {
        "ja": "וידסם",
        "en": "and grow fat",
        "he": "וְדָשֵׁן"
      },
      {
        "ja": "ת'ם",
        "en": "then"
      },
      {
        "ja": "יולי' אלי' מעבודאת אכ'ר",
        "en": "they shall turn to other objects of worship",
        "he": "וּפָנָה אֶל-אֱלֹהִים אֲחֵרִים"
      },
      {
        "ja": "פיעבדהא",
        "en": "and serve them",
        "he": "וַעֲבָדוּם"
      },
      {
        "ja": "וירפצ'ני",
        "en": "and they shall reject Me",
        "he": "וְנִאֲצוּנִי"
      },
      {
        "ja": "ויפסך עהדי",
        "en": "and break My covenant",
        "he": "וְהֵפֵר אֶת-בְּרִיתִי"
      }
    ],
    "21": [
      {
        "ja": "פאדא אצאבתהם",
        "en": "And when",
        "he": "וְהָיָה כִּי-תִמְצֶאןָ אֹתוֹ"
      },
      {
        "ja": "בלאיא כת'ירה",
        "en": "many afflictions",
        "he": "רָעוֹת רַבּוֹת"
      },
      {
        "ja": "ושדאיד",
        "en": "and hardships befall them",
        "he": "וְצָרוֹת"
      },
      {
        "ja": "חצ'רת הד'ה אלתסבחה בין ידיי כשאהד עליהם",
        "en": "this song of praise shall be present before Me as a witness against them",
        "he": "וְעָנְתָה הַשִּׁירָה הַזֹּאת לְפָנָיו לְעֵד"
      },
      {
        "ja": "אד' יגב אן לא תנסא",
        "en": "for it must not be forgotten",
        "he": "כִּי לֹא תִשָּׁכַח"
      },
      {
