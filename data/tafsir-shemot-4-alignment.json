    "19": [
      {
        "ja": "ת'ם קאל אללה למוסי במדין",
        "en": "Then God said to Moses in Midian",
        "he": "וַיֹּאמֶר יְהוָה אֶל-מֹשֶׁה בְּמִדְיָן"
      },
      {
        "ja": "אמץ' ארגע אלי' מצר",
        "en": "Go, return to Egypt",
        "he": "לֵךְ שֻׁב מִצְרָיִם"
      },
      {
        "ja": "פאן קד מאת גמיע אלקום. אלטאלבין קתלך",
        "en": "for all the men who sought to kill you have died",
        "he": "כִּי-מֵתוּ כָּל-הָאֲנָשִׁים הַמְבַקְשִׁים אֶת-נַפְשֶׁךָ"
      }
    ],
    "20": [
      {
        "ja": "פאכ'ד' מ'וסי'",
        "en": "And Moses took",
        "he": "וַיִּקַּח מֹשֶׁה"
      },
      {
        "ja": "זוגתה",
        "en": "his wife",
        "he": "אֶת-אִשְׁתּוֹ"
      },
      {
        "ja": "וולדיה",
        "en": "and his sons",
        "he": "וְאֶת-בָּנָיו"
      },
      {
        "ja": "וארכבהם עלי' חמיר",
        "en": "and set them upon donkeys",
        "he": "וַיַּרְכִּבֵם עַל-הַחֲמֹר"
      },
      {
        "ja": "ובעת' בהם",
        "en": "and led them"
      },
      {
        "ja": "ורגע אלי' בלד מצר",
        "en": "and he returned to the land of Egypt",
        "he": "וַיָּשָׁב אַרְצָה מִצְרָיִם"
      },
      {
        "ja": "ואכ'ד' אלעצא אלתי אמרה אללה בהא",
        "en": "And he took the staff which God had commanded him with",
        "he": "וַיִּקַּח מֹשֶׁה אֶת-מַטֵּה הָאֱלֹהִים"
      },
      {
        "ja": "פי ידה",
        "en": "in his hand",
        "he": "בְּיָדוֹ"
      }
    ],
    "21": [
      {
        "ja": "ת'ם קאל אללה לה",
        "en": "Then God said to him",
        "he": "וַיֹּאמֶר יְהוָה אֶל-מֹשֶׁה"
      },
      {
        "ja": "פי מצ'ייך",
        "en": "In your going",
        "he": "בְּלֶכְתְּךָ"
      },
      {
        "ja": "לתרגע אלי' מצר",
        "en": "to return to Egypt",
        "he": "לָשׁוּב מִצְרַיְמָה"
      },
      {
        "ja": "אנצ'ר",
        "en": "see",
        "he": "רְאֵה"
      },
      {
        "ja": "גמיע אלבראהין",
        "en": "all the proofs",
        "he": "כָּל-הַמֹּפְתִים"
      },
      {
        "ja": "אלתי ציירתהא פי ידך",
        "en": "which I have set in your hand",
        "he": "אֲשֶׁר-שַׂמְתִּי בְיָדֶךָ"
      },
      {
        "ja": "אצנעהא בין ידי פרעון",
        "en": "perform them before Pharaoh",
        "he": "וַעֲשִׂיתָם לִפְנֵי פַרְעֹה"
      },
      {
        "ja": "ואנא אשדד קלבה",
        "en": "And I shall harden his heart",
        "he": "וַאֲנִי אֲחַזֵּק אֶת-לִבּוֹ"
      },
      {
        "ja": "ולא יטלק אלקום",
        "en": "and he shall not let the people go",
        "he": "וְלֹא יְשַׁלַּח אֶת-הָעָם"
      }
    ],
    "22": [
      {
        "ja": "וקל לה",
        "en": "And say to him",
        "he": "וְאָמַרְתָּ אֶל-פַּרְעֹה"
      },
      {
        "ja": "כד'א קאל אללה",
        "en": "Thus says God",
        "he": "כֹּה אָמַר יְהוָה"
      },
      {
        "ja": "משרפא",
        "en": "in honor"
      },
      {
        "ja": "אבני בכרי אסראיל",
        "en": "Israel is My son, My firstborn",
        "he": "בְּנִי בְכֹרִי יִשְׂרָאֵל"
      }
    ],
    "23": [
      {
        "ja": "פק'לת לך",
        "en": "And I have said to you",
        "he": "וָאֹמַר אֵלֶיךָ"
      },
      {
        "ja": "אטלק אבני",
        "en": "Let My son go",
        "he": "שַׁלַּח אֶת-בְּנִי"
      },
      {
        "ja": "יעבדני",
        "en": "that he may worship Me",
        "he": "וְיַעַבְדֵנִי"
      },
      {
        "ja": "פאן אבית אן תטלקה",
        "en": "And if you refuse to let him go",
        "he": "וַתְּמָאֵן לְשַׁלְּחוֹ"
      },
      {
        "ja": "האנא קאתל",
        "en": "behold, I am about to kill",
        "he": "הִנֵּה אָנֹכִי הֹרֵג"
      },
      {
        "ja": "אבנך בכרך",
        "en": "your son, your firstborn",
        "he": "אֶת-בִּנְךָ בְּכֹרֶךָ"
      }
    ],
    "24": [
      {
        "ja": "ולמא כאן באלטריק",
        "en": "And it was on the way",
        "he": "וַיְהִי בַדֶּרֶךְ"
      },
      {
        "ja": "פי אלמבית",
        "en": "at the lodging-place",
        "he": "בַּמָּלוֹן"
      },
      {
        "ja": "פאגא ולדה מלך אללה",
        "en": "the angel of God came suddenly upon his son",
        "he": "וַיִּפְגְּשֵׁהוּ יְהוָה"
      },
      {
        "ja": "פטלב קתלה",
        "en": "and sought to kill him",
        "he": "וַיְבַקֵּשׁ הֲמִיתוֹ"
      }
    ],
    "25": [
      {
        "ja": "פאכ'ד'ת צפורה צואנא",
        "en": "And Zipporah took a flint",
        "he": "וַתִּקַּח צִפֹּרָה צֹר"
      },
      {
        "ja": "וקטעת קלפה' אבנהא",
        "en": "and cut off the foreskin of her son",
        "he": "וַתִּכְרֹת אֶת-עָרְלַת בְּנָהּ"
      },
      {
        "ja": "וקדמתה בין ידי",
        "en": "and presented it before [him]",
        "he": "וַתַּגַּע לְרַגְלָיו"
      },
      {
        "ja": "וקאלת",
        "en": "and she said",
        "he": "וַתֹּאמֶר"
      },
      {
        "ja": "כאד אלערוס אן יכון מקתולא",
        "en": "The bridegroom was about to be killed",
        "he": "כִּי חֲתַן-דָּמִים אַתָּה לִי"
      }
    ],
    "26": [
      {
        "ja": "פכף ענה",
        "en": "And He desisted from him",
        "he": "וַיִּרֶף מִמֶּנּוּ"
      },
      {
        "ja": "חיניד' קאלת",
        "en": "At that time she said",
        "he": "אָז אָמְרָה"
      },
      {
        "ja": "צאר אלערוס אלמקתול מכ'תונא",
        "en": "The bridegroom marked for death has become circumcised",
        "he": "חֲתַן דָּמִים לַמּוּלֹת"
      }
    ],
    "27": [
      {
        "ja": "פקאל אללה להרון",
        "en": "And God said to Aaron",
        "he": "וַיֹּאמֶר יְהוָה אֶל-אַהֲרֹן"
      },
      {
        "ja": "אמץ' תלקא מוסי'",
        "en": "Go to meet Moses",
        "he": "לֵךְ לִקְרַאת מֹשֶׁה"
      },
      {
        "ja": "אלי' אלבר",
        "en": "into the wilderness",
        "he": "הַמִּדְבָּרָה"
      },
      {
        "ja": "פמצ'א",
        "en": "And he went",
        "he": "וַיֵּלֶךְ"
      },
      {
        "ja": "וואפאה",
        "en": "and met him",
        "he": "וַיִּפְגְּשֵׁהוּ"
      },
      {
        "ja": "פי גבל אללה",
        "en": "at the mountain of God",
        "he": "בְּהַר הָאֱלֹהִים"
      },
      {
        "ja": "וקבלה",
        "en": "and kissed him",
        "he": "וַיִּשַּׁק-לוֹ"
      }
    ],
    "28": [
      {
        "ja": "פאכ'ברה מוסי'",
        "en": "And Moses informed him",
        "he": "וַיַּגֵּד מֹשֶׁה לְאַהֲרֹן"
      },
      {
        "ja": "בגמיע כלאם אללה",
        "en": "of all the words of God",
        "he": "אֵת כָּל-דִּבְרֵי יְהוָה"
      },
      {
        "ja": "אלד'י בעת' בה",
        "en": "which He had sent him with",
        "he": "אֲשֶׁר שְׁלָחוֹ"
      },
      {
        "ja": "וגמיע אלאיאת",
        "en": "and all the signs",
        "he": "וְאֵת כָּל-הָאֹתֹת"
      },
      {
        "ja": "אלתי אמרה",
        "en": "which He had commanded him",
        "he": "אֲשֶׁר צִוָּהוּ"
      }
    ],
    "29": [
      {
        "ja": "פמצ'א מוסי' והרון",
        "en": "And Moses and Aaron went",
        "he": "וַיֵּלֶךְ מֹשֶׁה וְאַהֲרֹן"
      },
      {
        "ja": "וגמעא",
        "en": "and gathered",
        "he": "וַיַּאַסְפוּ"
      },
      {
        "ja": "גמיע שיוך' בני אסראיל",
        "en": "all the elders of the sons of Israel",
        "he": "אֶת-כָּל-זִקְנֵי בְּנֵי יִשְׂרָאֵל"
      }
    ],
    "30": [
      {
        "ja": "וכלמהם הרון",
        "en": "And Aaron spoke",
        "he": "וַיְדַבֵּר אַהֲרֹן"
      },
      {
        "ja": "בגמיע אלכלאם",
        "en": "all the words",
        "he": "אֵת כָּל-הַדְּבָרִים"
      },
      {
        "ja": "אלד'י כלם אללה מוסי'",
        "en": "which God had spoken to Moses",
        "he": "אֲשֶׁר-דִּבֶּר יְהוָה אֶל-מֹשֶׁה"
      },
      {
        "ja": "וצנע אלמעגזאת",
        "en": "and performed the wonders",
        "he": "וַיַּעַשׂ הָאֹתֹת"
      },
      {
        "ja": "בחצ'רה' אלקום",
        "en": "in the presence of the people",
        "he": "לְעֵינֵי הָעָם"
      }
    ],
    "31": [
      {
        "ja": "פאמן אלקום",
        "en": "And the people believed",
        "he": "וַיַּאֲמֵן הָעָם"
      },
      {
        "ja": "אד' סמעו",
        "en": "and when they heard",
        "he": "וַיִּשְׁמְעוּ"
      },
      {
        "ja": "אן קד ד'כר אללה בני אסראיל",
        "en": "that God had remembered the sons of Israel",
        "he": "כִּי-פָקַד יְהוָה אֶת-בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "ונצ'ר לצ'עפהם",
        "en": "and had looked upon their affliction",
        "he": "וְכִי רָאָה אֶת-עָנְיָם"
      },
      {
        "ja": "פכ'רו",
        "en": "they bowed down",
        "he": "וַיִּקְּדוּ"
      },
      {
        "ja": "וסגדו",
        "en": "and prostrated themselves",
        "he": "וַיִּשְׁתַּחֲווּ"
      }
    ]
  }
}