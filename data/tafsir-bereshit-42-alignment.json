        "ja": "פקאל לה ראובן",
        "en": "And Reuben said to him"
      },
      {
        "ja": "תת'כל אבני",
        "en": "You may put to death my two sons"
      },
      {
        "ja": "אן לם אגיבה אליך",
        "en": "if I do not return him to you"
      },
      {
        "ja": "אעטיניה",
        "en": "Give him into my hand"
      },
      {
        "ja": "ואנא ארדה אליך",
        "en": "and I shall return him to you"
      }
    ],
    "38": [
      {
        "ja": "קאל",
        "en": "He said"
      },
      {
        "ja": "לא ינחדר אבני מעכם",
        "en": "My son shall not go down with you"
      },
      {
        "ja": "לאן אכ'יה קד מאת",
        "en": "for his brother is dead"
      },
      {
        "ja": "ובקי הו וחדה",
        "en": "and he alone is left"
      },
      {
        "ja": "פאן ואפתה אלמנייה",
        "en": "If calamity should befall him"
      },
      {
        "ja": "פי אלטריק אלד'י תמצ'ון פיה",
        "en": "on the way which you go"
      },
      {
        "ja": "אנזלתם שיבתי",
        "en": "you would bring down my old age"
      },
      {
        "ja": "בחסרה",
        "en": "with sorrow"
      },
      {
        "ja": "אלי' אלת'רי",
        "en": "to the dust"
      }
    ]
  }
}