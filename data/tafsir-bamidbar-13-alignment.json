        "en": "But the men",
        "he": "וְהָאֲנָשִׁים"
      },
      {
        "ja": "אלד'ין מצ'ו",
        "en": "who had gone",
        "he": "אֲשֶׁר-עָלוּ"
      },
      {
        "ja": "מעה",
        "en": "with him",
        "he": "עִמּוֹ"
      },
      {
        "ja": "קאלו",
        "en": "said:",
        "he": "אָמְרוּ"
      },
      {
        "ja": "לא נטיק",
        "en": "'We are not able",
        "he": "לֹא נוּכַל"
      },
      {
        "ja": "אן נצעד",
        "en": "to go up",
        "he": "לַעֲלוֹת"
      },
      {
        "ja": "אלי' אלקום",
        "en": "to the people,",
        "he": "אֶל-הָעָם"
      },
      {
        "ja": "לאנהם אשד",
        "en": "for they are stronger",
        "he": "כִּי-חָזָק הוּא"
      },
      {
        "ja": "מנא",
        "en": "than us.'",
        "he": "מִמֶּנּוּ"
      }
    ],
    "32": [
      {
        "ja": "ואכ'רגו",
        "en": "And they spread",
        "he": "וַיֹּצִיאוּ"
