      },
      {
        "ja": "וקאלו",
        "en": "saying:",
        "he": "לֵאמֹר"
      },
      {
        "ja": "אלבלד",
        "en": "'The land",
        "he": "הָאָרֶץ"
      },
      {
        "ja": "אלד'י מררנא פיה",
        "en": "through which we passed",
        "he": "אֲשֶׁר עָבַרְנוּ בָהּ"
