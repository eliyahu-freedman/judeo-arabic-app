        "en": "the fruit of the land.",
        "he": "אֶת-פְּרִי הָאָרֶץ"
      }
    ],
    "27": [
      {
        "ja": "פקצו עליה",
        "en": "And they recounted to him,",
        "he": "וַיְסַפְּרוּ-לוֹ"
      },
      {
        "ja": "וקאלו",
        "en": "and said:",
        "he": "וַיֹּאמְרוּ"
      },
      {
        "ja": "צרנא",
        "en": "'We went",
        "he": "בָּאנוּ"
      },
      {
        "ja": "אלי' אלבלד",
        "en": "to the land",
        "he": "אֶל-הָאָרֶץ"
      },
      {
        "ja": "אלד'י בעת'ת בנא",
        "en": "to which you sent us,",
        "he": "אֲשֶׁר שְׁלַחְתָּנוּ"
      },
      {
        "ja": "וחקא",
        "en": "and indeed",
        "he": "וְגַם"
      },
      {
        "ja": "אנה יפיץ' אללבן",
