        "ja": "אוולי' אלי' אלדארום",
        "en": "first to the south,",
        "he": "בַנֶּגֶב"
      },
      {
        "ja": "וגאו",
        "en": "and came",
        "he": "וַיָּבֹא"
      },
      {
        "ja": "אלי' חברא",
        "en": "to Hebron;",
        "he": "עַד-חֶבְרוֹן"
      },
      {
        "ja": "ות'ם",
        "en": "and there were"
      },
      {
        "ja": "אחימן",
        "en": "Ahiman,",
        "he": "אֲחִימַן"
      },
      {
        "ja": "ששי",
        "en": "Sheshai,",
        "he": "שֵׁשַׁי"
      },
      {
        "ja": "ותלמי",
        "en": "and Talmai —",
        "he": "וְתַלְמַי"
      },
      {
        "ja": "בני אלגבאברה",
        "en": "the children of the giants.",
        "he": "יְלִידֵי הָעֲנָק"
      },
      {
        "ja": "וכאנת חברא",
        "en": "And Hebron",
        "he": "וְחֶבְרוֹן"
      },
      {
        "ja": "קד",
        "en": "had already been"
      },
      {
        "ja": "בנית",
        "en": "built",
        "he": "נִבְנְתָה"
      },
      {
        "ja": "קבל",
        "en": "before",
        "he": "לִפְנֵי"
      },
      {
        "ja": "צאן",
        "en": "Zoan,",
        "he": "צֹעַן"
      },
      {
        "ja": "מנבר מצר",
        "en": "the seat of Egypt,",
        "he": "מִצְרָיִם"
      },
      {
        "ja": "בסבע סנין",
        "en": "by seven years.",
        "he": "שֶׁבַע שָׁנִים"
      }
    ],
    "23": [
      {
        "ja": "וגאו",
        "en": "And they came",
        "he": "וַיָּבֹאוּ"
      },
      {
        "ja": "אלי' ואד",
        "en": "to the Valley of",
        "he": "עַד-נַחַל"
      },
      {
        "ja": "אלענקוד",
        "en": "the Cluster,",
        "he": "אֶשְׁכֹּל"
      },
      {
        "ja": "פקטעו",
        "en": "and cut",
        "he": "וַיִּכְרְתוּ"
      },
      {
        "ja": "מן ת'ם",
        "en": "from there",
        "he": "מִשָּׁם"
      },
      {
        "ja": "חבלה",
        "en": "a branch",
        "he": "זְמוֹרָה"
      },
      {
        "ja": "וענקוד ענב ואחד",
        "en": "and one cluster of grapes,",
        "he": "וְאֶשְׁכּוֹל עֲנָבִים אֶחָד"
      },
      {
        "ja": "וחמלוה",
        "en": "and carried it",
        "he": "וַיִּשָּׂאֻהוּ"
      },
      {
        "ja": "פי אלדהק",
        "en": "on a pole",
        "he": "בַמּוֹט"
      },
      {
        "ja": "פי מא בין את'נין",
        "en": "between two;",
        "he": "בִּשְׁנָיִם"
      },
      {
        "ja": "ומן אלרמאן",
        "en": "and also some of the pomegranates",
        "he": "וּמִן-הָרִמֹּנִים"
      },
      {
        "ja": "ומן אלתין",
        "en": "and of the figs.",
        "he": "וּמִן-הַתְּאֵנִים"
      }
    ],
    "24": [
      {
        "ja": "פלד'אלך",
        "en": "Therefore",
        "he": "לַמָּקוֹם הַהוּא"
      },
      {
        "ja": "סמי",
        "en": "that place was named",
        "he": "קָרָא"
      },
      {
        "ja": "אלמוצ'ע ואד אלענקוד",
        "en": "the Valley of the Cluster,",
        "he": "נַחַל אֶשְׁכּוֹל"
      },
      {
        "ja": "בסבב",
        "en": "on account of",
        "he": "עַל אֹדוֹת"
      },
      {
        "ja": "אלענקוד",
        "en": "the cluster",
        "he": "הָאֶשְׁכּוֹל"
      },
      {
        "ja": "אלד'י קטעו מנה",
        "en": "which the sons of Israel cut",
        "he": "אֲשֶׁר-כָּרְתוּ"
      },
      {
        "ja": "בני אסראיל",
        "en": "from there.",
        "he": "בְּנֵי יִשְׂרָאֵל"
      }
    ],
    "25": [
      {
        "ja": "פרגעו",
        "en": "And they returned",
        "he": "וַיָּשֻׁבוּ"
      },
      {
        "ja": "מן ריאם",
        "en": "from scouting",
        "he": "מִתּוּר"
      },
      {
        "ja": "אלבלד",
        "en": "the land,",
        "he": "הָאָרֶץ"
      },
      {
        "ja": "בעד",
        "en": "after",
        "he": "מִקֵּץ"
      },
      {
        "ja": "ארבעין יומא",
        "en": "forty days.",
        "he": "אַרְבָּעִים יוֹם"
      }
    ],
    "26": [
      {
        "ja": "פסארו",
        "en": "And they journeyed",
        "he": "וַיֵּלְכוּ"
      },
      {
        "ja": "חתא גאו",
        "en": "until they came",
        "he": "וַיָּבֹאוּ"
      },
      {
        "ja": "אלי' מוסי'",
        "en": "to Moses",
        "he": "אֶל-מֹשֶׁה"
      },
      {
        "ja": "והרון",
        "en": "and Aaron,",
        "he": "וְאֶל-אַהֲרֹן"
      },
      {
        "ja": "וסאיר גמאעה'",
        "en": "and the rest of the congregation of",
        "he": "וְאֶל-כָּל-עֲדַת"
      },
      {
        "ja": "בני אסראיל",
        "en": "the sons of Israel,",
        "he": "בְּנֵי-יִשְׂרָאֵל"
      },
      {
        "ja": "אלי' ברייה' פארן",
        "en": "to the wilderness of Paran,",
        "he": "אֶל-מִדְבַּר פָּארָן"
      },
      {
        "ja": "אלי' רקים",
        "en": "to Kadesh;",
        "he": "קָדֵשָׁה"
      },
      {
        "ja": "פאגאבוהם",
        "en": "and they answered them",
        "he": "וַיָּשִׁיבוּ אֹתָם"
      },
      {
        "ja": "באלכ'בר",
