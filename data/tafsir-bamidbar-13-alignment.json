      {
        "ja": "תם",
        "en": "there.'",
        "he": "שָׁם"
      }
    ],
    "29": [
      {
        "ja": "אלעמאלקה",
        "en": "'The Amalekites",
        "he": "עֲמָלֵק"
      },
      {
        "ja": "מקימין",
        "en": "dwell",
        "he": "יוֹשֵׁב"
      },
      {
