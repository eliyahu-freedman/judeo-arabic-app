        "he": "בְּאֶרֶץ הַנֶּגֶב"
      },
      {
        "ja": "ואלחתיין",
        "en": "and the Hittites",
        "he": "וְהַחִתִּי"
      },
      {
        "ja": "ואליבוסיין",
        "en": "and the Jebusites",
        "he": "וְהַיְבוּסִי"
      },
      {
        "ja": "ואלאמוריין",
        "en": "and the Amorites",
        "he": "וְהָאֱמֹרִי"
      },
      {
        "ja": "מקימין פי אלגבל",
        "en": "dwell in the mountain;",
        "he": "יוֹשֵׁב בָּהָר"
      },
      {
        "ja": "ואלכנאעניין",
        "en": "and the Canaanites",
        "he": "וְהַכְּנַעֲנִי"
      },
      {
        "ja": "מקימין עלי' אלבחר",
