        "he": "לָתוּר אֹתָהּ"
      },
      {
        "ja": "הו בלד יהלך אהלה",
        "en": "is a land that destroys its inhabitants;",
        "he": "אֶרֶץ אֹכֶלֶת יוֹשְׁבֶיהָ"
      },
      {
        "ja": "וגמיע אלקום",
        "en": "and all the people",
        "he": "וְכָל-הָעָם"
      },
      {
        "ja": "אלד'י ראינאהם פיה",
        "en": "whom we saw in it",
        "he": "אֲשֶׁר-רָאִינוּ בְתוֹכָהּ"
      },
      {
        "ja": "ד'וי מסאחה",
        "en": "are of great stature.'",
        "he": "אַנְשֵׁי מִדּוֹת"
      }
    ],
    "33": [
      {
        "ja": "וראינא ת'ם",
        "en": "'And we saw there",
        "he": "וְשָׁם רָאִינוּ"
      },
      {
        "ja": "אלעלוג",
        "en": "the brutes —",
        "he": "אֶת-הַנְּפִילִים"
      },
      {
        "ja": "בני אלגבאברה",
        "en": "children of the giants",
        "he": "בְּנֵי עֲנָק"
      },
      {
        "ja": "מן עלוגהם",
        "en": "from among their brutes —",
        "he": "מִן-הַנְּפִלִים"
      },
      {
        "ja": "וצרנא",
        "en": "and we were",
        "he": "וַנְּהִי"
      },
      {
        "ja": "פי עיוננא",
        "en": "in our own eyes",
        "he": "בְעֵינֵינוּ"
      },
      {
        "ja": "כאלגראד",
        "en": "as locusts;",
        "he": "כַּחֲגָבִים"
      },
      {
        "ja": "וכד'אך",
        "en": "and so",
        "he": "וְכֵן"
      },
      {
        "ja": "כנא",
        "en": "were we",
        "he": "הָיִינוּ"
      },
      {
        "ja": "פי עיונהם",
        "en": "in their eyes.'",
        "he": "בְּעֵינֵיהֶם"
      }
    ]
  }
