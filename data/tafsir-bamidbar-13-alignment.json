        "he": "וַיַּהַס"
      },
      {
        "ja": "כלב",
        "en": "silenced",
        "he": "כָּלֵב"
      },
      {
        "ja": "אלקום",
        "en": "the people",
        "he": "אֶת-הָעָם"
      },
      {
        "ja": "אלי' קול מוסי'",
        "en": "toward what Moses had said,",
        "he": "אֶל-מֹשֶׁה"
