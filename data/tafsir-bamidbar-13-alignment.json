      {
        "ja": "והד'א ת'מרה",
        "en": "and here is its fruit.'",
        "he": "וְזֶה-פִּרְיָהּ"
      }
    ],
    "28": [
      {
        "ja": "כלא אן אלקום אלמקימין פיה עזיזין",
        "en": "'However, the people who dwell in it are mighty,",
        "he": "אֶפֶס כִּי-עַז"
      },
      {
        "ja": "ואלקרא",
        "en": "and the towns",
        "he": "וְהֶעָרִים"
      },
      {
        "ja": "חצינה עצימה גדא",
        "en": "are very greatly fortified;",
        "he": "בְּצֻרוֹת גְּדֹלֹת מְאֹד"
      },
      {
        "ja": "ואיצ'א אולאד אלגבאברה",
        "en": "and moreover, the children of the giants —",
        "he": "וְגַם-יְלִדֵי הָעֲנָק"
