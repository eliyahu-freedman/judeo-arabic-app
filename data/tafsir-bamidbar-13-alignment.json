      },
      {
        "ja": "עלי' אלבלד אלד'י ראמוה",
        "en": "against the land which they had scouted,",
        "he": "אֲשֶׁר תָּרוּ אֹתָהּ"
      },
      {
        "ja": "לבני אסראיל",
        "en": "to the sons of Israel,",
