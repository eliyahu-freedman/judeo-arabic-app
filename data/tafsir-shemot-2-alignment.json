        "en": "and watered their flock",
        "he": "וַיַּשְׁקְ אֶת-צֹאנָם"
      }
    ],
    "18": [
      {
        "ja": "פלמא גאת אלי' רעואל אביהן",
        "en": "And when they came to Reuel their father",
        "he": "וַתָּבֹאנָה אֶל-רְעוּאֵל אֲבִיהֶן"
      },
      {
        "ja": "קאל",
        "en": "he said",
        "he": "וַיֹּאמֶר"
      },
      {
        "ja": "מא באלכן",
        "en": "What is your concern",
        "he": "מַדּוּעַ"
      },
      {
        "ja": "אסרעתן באלמגי אליום",
        "en": "that you have hurried to come today",
        "he": "מִהַרְתֶּן בֹּא הַיּוֹם"
      }
    ],
    "19": [
      {
        "ja": "פקאלא לה",
        "en": "And they said to him",
        "he": "וַתֹּאמַרְןָ"
      },
      {
        "ja": "רגל מצרי",
        "en": "An Egyptian man",
        "he": "אִישׁ מִצְרִי"
      },
      {
        "ja": "כ'לצנא",
        "en": "rescued us",
        "he": "הִצִּילָנוּ"
      },
      {
        "ja": "מן יד אלרעאה",
        "en": "from the hand of the shepherds",
        "he": "מִיַּד הָרֹעִים"
      },
      {
        "ja": "ואיצ'א דלא לנא מא",
        "en": "and he also drew water for us",
        "he": "וְגַם-דָּלֹה דָלָה לָנוּ"
      },
      {
        "ja": "וסקי' אלג'נם",
        "en": "and watered the flock",
        "he": "וַיַּשְׁקְ אֶת-הַצֹּאן"
      }
    ],
    "20": [
      {
        "ja": "קאל לה'ן",
        "en": "He said to his daughters",
        "he": "וַיֹּאמֶר אֶל-בְּנֹתָיו"
      },
      {
        "ja": "ואין הו",
        "en": "And where is he",
        "he": "וְאַיּוֹ"
      },
      {
        "ja": "לם תרכתן אלרגל",
        "en": "Why have you left the man",
        "he": "לָמָּה זֶּה עֲזַבְתֶּן אֶת-הָאִישׁ"
      },
      {
        "ja": "אדעוה",
        "en": "Call him",
        "he": "קִרְאֶן לוֹ"
      },
      {
        "ja": "יאכל טעאמא",
        "en": "that he may eat a meal",
        "he": "וְיֹאכַל לָחֶם"
      }
    ],
    "21": [
      {
        "ja": "פלמא אמען מוסי'",
        "en": "And Moses consented",
        "he": "וַיּוֹאֶל מֹשֶׁה"
      },
      {
        "ja": "פי אלמקאם",
        "en": "to dwell",
        "he": "לָשֶׁבֶת"
      },
      {
        "ja": "ענד אלרגל",
        "en": "with the man",
        "he": "אֶת-הָאִישׁ"
      },
      {
        "ja": "זווגה בצפורה אבנתה",
        "en": "and he gave him Zipporah his daughter [in marriage]",
        "he": "וַיִּתֵּן אֶת-צִפֹּרָה בִתּוֹ לְמֹשֶׁה"
      }
    ],
    "22": [
      {
        "ja": "פולדת אבנא",
        "en": "And she bore a son",
        "he": "וַתֵּלֶד בֵּן"
      },
      {
        "ja": "וסמאה גרשום",
        "en": "and he named him Gershom",
        "he": "וַיִּקְרָא אֶת-שְׁמוֹ גֵּרְשֹׁם"
      },
      {
        "ja": "לאנה קאל",
        "en": "for he said",
        "he": "כִּי אָמַר"
      },
      {
        "ja": "צרת ג'ריבא",
        "en": "I became a stranger",
        "he": "גֵּר הָיִיתִי"
      },
      {
        "ja": "פי בלד ג'רבה",
        "en": "in a strange land",
        "he": "בְּאֶרֶץ נָכְרִיָּה"
      }
    ],
    "23": [
      {
        "ja": "וכאן איצ'א פי תלך אלאיאם אלטוילה",
        "en": "And it was also in those long days",
        "he": "וַיְהִי בַיָּמִים הָרַבִּים הָהֵם"
      },
      {
        "ja": "אן מלך מצר מאת",
        "en": "that the king of Egypt died",
        "he": "וַיָּמָת מֶלֶךְ מִצְרַיִם"
      },
      {
        "ja": "פתנהד בני אסראיל",
        "en": "and the sons of Israel groaned",
        "he": "וַיֵּאָנְחוּ בְנֵי-יִשְׂרָאֵל"
      },
      {
        "ja": "מן כ'דמתהם אלצעבה",
        "en": "because of their hard service",
        "he": "מִן-הָעֲבֹדָה"
      },
      {
        "ja": "וצרכ'ו",
        "en": "and they cried out",
        "he": "וַיִּזְעָקוּ"
      },
      {
        "ja": "פצעד תג'וותהם",
        "en": "and their plea ascended",
        "he": "וַתַּעַל שַׁוְעָתָם"
      },
      {
        "ja": "אלי' אללה",
        "en": "to God",
        "he": "אֶל-הָאֱלֹהִים"
      },
      {
        "ja": "מן אלכ'דמה",
        "en": "from the [hard] service",
        "he": "מִן-הָעֲבֹדָה"
      }
    ],
    "24": [
      {
        "ja": "פסמע אללה",
        "en": "And God heard",
        "he": "וַיִּשְׁמַע אֱלֹהִים"
      },
      {
        "ja": "שהיקהם",
        "en": "their groaning",
        "he": "אֶת-נַאֲקָתָם"
      },
      {
        "ja": "וד'כר עהדה",
        "en": "and remembered His covenant",
        "he": "וַיִּזְכֹּר אֱלֹהִים אֶת-בְּרִיתוֹ"
      },
      {
        "ja": "אלד'י מע",
        "en": "which was with"
      },
      {
        "ja": "אברהים",
        "en": "Abraham",
        "he": "אֶת-אַבְרָהָם"
      },
      {
        "ja": "ויצחק",
        "en": "Isaac",
        "he": "אֶת-יִצְחָק"
      },
      {
        "ja": "ויעקוב",
        "en": "and Jacob",
        "he": "וְאֶת-יַעֲקֹב"
      }
    ],
    "25": [
      {
        "ja": "פנצ'ר אללה",
        "en": "And God beheld",
        "he": "וַיַּרְא אֱלֹהִים"
      },
      {
        "ja": "להם",
        "en": "them",
        "he": "אֶת-בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "ורחמהם",
        "en": "and had mercy on them",
        "he": "וַיֵּדַע אֱלֹהִים"
      }
    ]
  }
}