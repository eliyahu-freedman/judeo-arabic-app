      },
      {
        "ja": "אן גוקה' אלראסמין הנאך מכנוזה",
        "en": "that the congregation of those who traced it was stored there",
        "he": "כִּי-שָׁם חֶלְקַת מְחֹקֵק סָפוּן"
      },
      {
        "ja": "פאתא רויסא אלקום",
        "en": "so he came to the chiefs of the people",
        "he": "וַיֵּתֵא רָאשֵׁי עָם"
      },
      {
        "ja": "פתלמד'הם",
        "en": "and made them disciples"
      },
      {
        "ja": "וצנע בעדל אללה",
        "en": "and he acted according to the justice of God",
        "he": "צִדְקַת יְהוָה עָשָׂה"
      },
      {
        "ja": "ואחכאמה מע סאיר אל אסראיל",
        "en": "and His laws, together with the rest of the clan of Israel",
        "he": "וּמִשְׁפָּטָיו עִם-יִשְׂרָאֵל"
      }
    ],
    "22": [
      {
        "ja": "וקאל לדן",
        "en": "And he said for Dan",
        "he": "וּלְדָן אָמַר"
      },
      {
        "ja": "כון יא דן כשבל אלאסד",
        "en": "Be, O Dan, like the cub of a lion",
        "he": "דָּן גּוּר אַרְיֵה"
      },
      {
        "ja": "בקווה",
        "en": "in strength",
        "he": "יְזַנֵּק"
      },
      {
        "ja": "אד'א יערץ' מן אלבת'נייה",
        "en": "as it springs forth from the Bashan",
        "he": "מִן-הַבָּשָׁן"
      }
    ],
    "23": [
      {
        "ja": "וקאל לנפתלי",
        "en": "And he said for Naphtali",
        "he": "וּלְנַפְתָּלִי אָמַר"
      },
      {
        "ja": "יא נפתלי אסתכת'ר מן אלרצ'א",
        "en": "O Naphtali, gain much of favor",
        "he": "נַפְתָּלִי שְׂבַע רָצוֹן"
      },
      {
        "ja": "וכון ממלווא מן ברכאת אללה",
        "en": "and be filled with the blessings of God",
        "he": "וּמָלֵא בִּרְכַּת יְהוָה"
      },
      {
        "ja": "וחז מן אלארץ' ג'רבא וגנובא",
        "en": "and possess from the land westward and southward",
        "he": "יָם וְדָרוֹם יְרָשָׁה"
      }
    ],
    "24": [
      {
        "ja": "וקאל לאשר",
        "en": "And he said for Asher",
        "he": "וּלְאָשֵׁר אָמַר"
      },
      {
        "ja": "כן מבארכא מן אלאוליא יא אשר",
        "en": "Be blessed of the saints, O Asher",
        "he": "בָּרוּךְ מִבָּנִים אָשֵׁר"
      },
      {
        "ja": "אלד'י סיכון רצ'א אכ'ותה",
        "en": "who shall be the delight of his brothers",
        "he": "יְהִי רְצוּי אֶחָיו"
      },
      {
        "ja": "וג'אמסא פי אלדהן קדמה",
        "en": "and who dips his foot in oil",
        "he": "וְטֹבֵל בַּשֶּׁמֶן רַגְלוֹ"
      }
    ],
    "25": [
      {
        "ja": "מג'אלקך",
        "en": "Your bolts",
        "he": "מִנְעָלֶךָ"
      },
      {
        "ja": "תכון מן אלחדיד ואלנחאס",
        "en": "shall be of iron and bronze",
        "he": "בַּרְזֶל וּנְחֹשֶׁת"
      },
      {
        "ja": "ולתכון כאיאמך הד'ה שגאעתך",
        "en": "and as your days are, so shall your strength be",
        "he": "וּכְיָמֶיךָ דָּבְאֶךָ"
      }
    ],
    "26": [
      {
        "ja": "אלאה אסראיל אלד'י ליס כמת'לה",
        "en": "The God of Israel, who has no likeness",
        "he": "אֵין כָּאֵל יְשֻׁרוּן"
      },
      {
        "ja": "סאכן אלסמא",
        "en": "the Dweller of the heavens",
        "he": "רֹכֵב שָׁמַיִם"
      },
      {
        "ja": "ואלשואהק בקדרתה",
        "en": "and the heights, in His power",
        "he": "וּבְגַאֲוָתוֹ שְׁחָקִים"
      },
      {
        "ja": "פי עונך",
        "en": "is your help",
        "he": "בְּעֶזְרֶךָ"
      }
    ],
    "27": [
      {
        "ja": "והו אלוטן אלאלאה אלאזלי",
        "en": "And He is the abode — the God eternal",
        "he": "מְעֹנָה אֱלֹהֵי קֶדֶם"
      },
      {
        "ja": "ומן דונה מלוך אלעאלם",
        "en": "and beneath Him are the kings of the world",
        "he": "וּמִתַּחַת זְרֹעֹת עוֹלָם"
      },
      {
        "ja": "כמא טרד מן בין ידיך אלעדו",
        "en": "even as He drove out the enemy from before you",
        "he": "וַיְגָרֶשׁ מִפָּנֶיךָ אוֹיֵב"
      },
      {
        "ja": "וקאל לך אנפד'ה",
        "en": "and said to you: Destroy him",
        "he": "וַיֹּאמֶר הַשְׁמֵד"
      }
    ],
    "28": [
      {
        "ja": "חתי' סכן בעץ' אל אסראיל",
        "en": "Until some of the clan of Israel settled",
        "he": "וַיִּשְׁכֹּן יִשְׂרָאֵל"
      },
      {
        "ja": "ואת'קא מנפרדא",
        "en": "in confidence, each apart",
        "he": "בֶּטַח בָּדָד"
      },
      {
        "ja": "נצ'יר מא קאל להם יעקוב אביהם",
        "en": "in fulfilment of what Jacob their father told them"
      },
      {
        "ja": "פי בלד ד'י בר",
        "en": "in a land of grain",
        "he": "אֶל-אֶרֶץ דָּגָן"
      },
      {
        "ja": "ועציר",
        "en": "and wine-press",
        "he": "וְתִירוֹשׁ"
      },
      {
        "ja": "ואיצ'א סמאה תדר טלא",
        "en": "and moreover its sky pours down dew",
        "he": "אַף-שָׁמָיו יַעַרְפוּ טָל"
      }
    ],
    "29": [
      {
        "ja": "פטובאך יא אל אסראיל",
        "en": "So blessed are you, O clan of Israel",
        "he": "אַשְׁרֶיךָ יִשְׂרָאֵל"
      },
      {
        "ja": "מן מת'לך",
        "en": "who is like you",
        "he": "מִי כָמוֹךָ"
      },
      {
        "ja": "שעב מ'ג'את' באללה",
        "en": "A people succored by God",
        "he": "עַם נוֹשַׁע בַּיהוָה"
      },
      {
        "ja": "והו תרסך ועונך",
        "en": "and He is your shield and your help",
        "he": "מָגֵן עֶזְרֶךָ"
      },
      {
        "ja": "וסיפך ואקתדארך",
        "en": "and your sword and your might",
        "he": "וַאֲשֶׁר-חֶרֶב גַּאֲוָתֶךָ"
      },
      {
        "ja": "פיכ'צ'ע לך אעדאיך",
        "en": "So shall your enemies submit to you",
        "he": "וְיִכָּחֲשׁוּ אֹיְבֶיךָ לָךְ"
      },
      {
        "ja": "ואנת תטא עלי קמאקמהם",
        "en": "and you shall tread upon their heights",
        "he": "וְאַתָּה עַל-בָּמוֹתֵימוֹ תִדְרֹךְ"
      }
    ]
  }
}