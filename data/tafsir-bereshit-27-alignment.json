      },
      {
        "ja": "וגמיע אכ'ותה געלתהם לה עבידא",
        "en": "and all his brothers I have given him as servants"
      },
      {
        "ja": "ובאלבר ואלעציר אסנדתה",
        "en": "and with grain and grape-juice I have supported him"
      },
      {
        "ja": "ולך אלאן",
        "en": "And for you now"
      },
      {
        "ja": "מא אצנע",
        "en": "what shall I do"
      },
      {
        "ja": "יא אבני",
        "en": "my son?'"
      }
    ],
    "38": [
      {
        "ja": "פקאל עשו לאביה",
        "en": "And Esau said to his father"
      },
      {
        "ja": "אברכה ואחדה היא לך",
        "en": "'Is it one blessing only that is yours"
      },
      {
        "ja": "יא אבה",
        "en": "O my father?"
      },
      {
        "ja": "בארכני אנא איצ'א",
        "en": "Bless me — me also"
      },
      {
        "ja": "ורפע צותה",
        "en": "And he lifted up his voice"
      },
      {
        "ja": "ובכי'",
        "en": "and wept"
      }
    ],
    "39": [
      {
        "ja": "פאגאבה יצחק אביה וקאל",
        "en": "And Isaac his father answered, and said to him"
      },
      {
        "ja": "הוד'א מן דסם אלארץ' יכון מסכנך",
        "en": "'Behold — of the fat of the earth shall be your dwelling"
      },
      {
        "ja": "ומן טל אלסמא מן אלעלו",
        "en": "and of the dew of the sky from above"
      }
    ],
    "40": [
      {
        "ja": "ועלי' סיפך תחיא",
        "en": "And by your sword shall you live"
      },
      {
        "ja": "ואכ'יך תכ'דם",
        "en": "and your brother shall you serve"
      },
      {
        "ja": "ויכון אד'א אסתולית",
        "en": "and when you grow strong"
      },
      {
        "ja": "פככת אצרה ען ענקך",
        "en": "you shall break his bond from upon your neck"
      }
    ],
    "41": [
      {
        "ja": "פחקד עשו עלי' יעקב",
        "en": "And Esau harbored hatred against Jacob"
      },
      {
        "ja": "בסבב אלברכה",
        "en": "on account of the blessing"
      },
      {
        "ja": "אלד'י בארכה אביה",
        "en": "with which his father had blessed him"
      },
      {
        "ja": "וקאל פי נפסה",
        "en": "And Esau said in himself"
      },
      {
        "ja": "סתקרב איאם חזן אבי",
        "en": "'The days of mourning for my father shall draw near"
      },
      {
        "ja": "ואקתל יעקוב אכ'י",
        "en": "and I shall kill Jacob my brother"
      }
    ],
    "42": [
      {
        "ja": "פאכ'ברת רבקה",
        "en": "And Rebekah was told"
      },
      {
        "ja": "בכלאם עשו אבנהא אלאכבר",
        "en": "the words of Esau her elder son"
      },
      {
        "ja": "פבעת'ת",
        "en": "and she sent"
      },
      {
        "ja": "ודעת ביעקוב אבנהא אלאצג'ר",
        "en": "and called for Jacob her younger son"
      },
      {
        "ja": "וקאלת לה",
        "en": "and said to him"
      },
      {
        "ja": "הוד'א עשו אכ'יך",
        "en": "'Behold, Esau your brother"
      },
      {
        "ja": "מתואעדך ליקתלך",
        "en": "is threatening to kill you"
      }
    ],
    "43": [
      {
        "ja": "ואלאן יא אבני",
        "en": "Now, my son"
      },
      {
        "ja": "אקבל מני",
        "en": "accept from me"
      },
      {
        "ja": "וקם אמץ'",
        "en": "arise and flee"
      },
      {
        "ja": "אלי' לבן אכ'י",
        "en": "to Laban my brother"
      },
      {
        "ja": "אלי' חרן",
        "en": "to Haran"
      }
    ],
    "44": [
      {
        "ja": "וקם ענדה",
        "en": "And dwell with him"
      },
      {
        "ja": "איאמא יסירה",
        "en": "a few days"
      },
      {
        "ja": "אלי' אן תרגע חמייה' אכ'יך",
        "en": "until the wrath of your brother turns away"
      }
    ],
    "45": [
      {
        "ja": "אלי' אן ירגע ג'צ'בה ענך",
        "en": "until your brother's anger turns away from you"
      },
      {
        "ja": "וינסי' מא צנעת בה",
        "en": "and he forgets what you have done to him"
      },
      {
        "ja": "ואבעת' ואכ'ד'ך מן ת'ם",
        "en": "then I shall send and take you from there"
      },
      {
        "ja": "ללא את'כלכמא",
        "en": "Why should I lose the two of you"
      },
      {
        "ja": "פי יום ואחד",
        "en": "in one day?'"
      }
    ],
    "46": [
      {
        "ja": "קאלת רבקה ליצחק",
        "en": "And Rebekah said to Isaac"
      },
      {
        "ja": "קד צ'ג'רת פי חיותי",
        "en": "'I have grown weary in my life"
      },
      {
        "ja": "מן קבל בנאת חת",
        "en": "on account of the daughters of Heth"
      },
      {
        "ja": "אן תזוג יעקוב באמראה",
        "en": "If Jacob takes a wife"
      },
      {
        "ja": "מן בנאת חת",
        "en": "from the daughters of Heth"
      },
      {
        "ja": "או מן בנאת אהל אלבלד",
        "en": "or from the daughters of the dwellers of the land"
      },
      {
        "ja": "פלמא ד'א לי חיוה",
        "en": "what is life to me?'"
      }
    ]
  }
}