        "he": "לֹא-יָקוּם עֵד אֶחָד"
      },
      {
        "ja": "עלי' אנסאן",
        "en": "against a person",
        "he": "בְּאִישׁ"
      },
      {
        "ja": "פי שי מן אלד'נוב ואלכ'טאיא",
        "en": "in any matter of transgressions and sins",
        "he": "לְכָל-עָו‍ֹן וּלְכָל-חַטָּאת"
      },
      {
        "ja": "ואלגנאיאת אלד'י יגניהא",
        "en": "and the offenses which he commits",
        "he": "בְּכָל-חֵטְא אֲשֶׁר יֶחֱטָא"
      },
      {
        "ja": "בל עלי' קול שאהדין",
        "en": "but on the word of two witnesses",
        "he": "עַל-פִּי שְׁנֵי עֵדִים"
      },
      {
        "ja": "או ת'לאתה",
        "en": "or on the word of three",
        "he": "אוֹ עַל-פִּי שְׁלֹשָׁה-עֵדִים"
      },
      {
        "ja": "תקום אלאמור",
        "en": "shall matters be established",
        "he": "יָקוּם דָּבָר"
      }
    ],
    "16": [
      {
        "ja": "ואן קאם",
        "en": "And if",
        "he": "כִּי-יָקוּם"
      },
      {
        "ja": "שאהד צ'לם",
        "en": "a witness of wrongdoing",
        "he": "עֵד-חָמָס"
      },
      {
        "ja": "עלי' אנסאן",
        "en": "rises against a person",
        "he": "בְּאִישׁ"
      },
      {
        "ja": "לישהד עליה במחאל",
        "en": "to testify against him in an impossible matter",
        "he": "לַעֲנוֹת בּוֹ סָרָה"
      }
    ],
    "17": [
      {
        "ja": "פליקף",
        "en": "then",
        "he": "וְעָמְדוּ"
      },
      {
        "ja": "אלרגלאן",
        "en": "the two men",
        "he": "שְׁנֵי-הָאֲנָשִׁים"
      },
      {
        "ja": "אלד'ין אלכ'צומה להם",
        "en": "who have the dispute",
        "he": "אֲשֶׁר-לָהֶם הָרִיב"
      },
      {
        "ja": "בין ידי אללה",
        "en": "before God",
        "he": "לִפְנֵי יְהוָה"
      },
      {
        "ja": "בין ידי אלאיממה ואלחכאם",
        "en": "before the imāms and the judges",
        "he": "לִפְנֵי הַכֹּהֲנִים וְהַשֹּׁפְטִים"
      },
      {
        "ja": "אלד'י ילו פי ד'אלך אלזמאן",
        "en": "who serve in that time",
        "he": "אֲשֶׁר יִהְיוּ בַּיָּמִים הָהֵם"
      }
    ],
    "18": [
      {
        "ja": "פלילתמסו ד'אלך אלחכם",
        "en": "and they shall examine that judgment",
        "he": "וְדָרְשׁוּ הַשֹּׁפְטִים"
      },
      {
        "ja": "גיידא",
        "en": "thoroughly",
        "he": "הֵיטֵב"
      },
      {
        "ja": "פאן כאן אלשאהד שאהד זור",
        "en": "and if the witness is a false witness",
        "he": "וְהִנֵּה עֵד-שֶׁקֶר הָעֵד"
      },
      {
        "ja": "וקד שהד בבאטל עלי' אכ'יה",
        "en": "and has testified falsely against his brother",
        "he": "שֶׁקֶר עָנָה בְאָחִיו"
      }
    ],
    "19": [
      {
        "ja": "פאצנעו לה",
        "en": "then do to him",
        "he": "וַעֲשִׂיתֶם לוֹ"
      },
      {
        "ja": "מת'ל מא הם אן יצנע באכ'יה",
        "en": "as he intended to do to his brother",
        "he": "כַּאֲשֶׁר זָמַם לַעֲשׂוֹת לְאָחִיו"
      },
      {
        "ja": "ואנף אהל אלשר מן וסטך",
        "en": "and banish the doers of evil from your midst",
        "he": "וּבִעַרְתָּ הָרָע מִקִּרְבֶּךָ"
      }
    ],
    "20": [
      {
        "ja": "ואלבאקיון",
        "en": "And the remainder",
        "he": "וְהַנִּשְׁאָרִים"
      },
      {
        "ja": "יסמעון",
        "en": "shall hear",
        "he": "יִשְׁמְעוּ"
      },
      {
        "ja": "ויכ'אפון",
        "en": "and be afraid",
        "he": "וְיִרָאוּ"
      },
      {
        "ja": "ולא יעודו אן יצנעו",
        "en": "and shall not again do",
        "he": "וְלֹא-יֹסִפוּ לַעֲשׂוֹת"
      },
      {
        "ja": "מת'ל הד'א אלאמר אלרדי",
        "en": "the like of this vile matter",
        "he": "כַּדָּבָר הָרָע הַזֶּה"
      },
      {
        "ja": "פי מא בינכם",
        "en": "in your midst",
        "he": "בְּקִרְבֶּךָ"
      }
    ],
    "21": [
      {
        "ja": "ולא תשפק",
        "en": "And you shall not have compassion",
        "he": "וְלֹא תָחוֹס עֵינֶךָ"
      },
      {
        "ja": "פי אלקצאץ",
        "en": "in retribution"
      },
      {
        "ja": "נפס בנפס",
        "en": "life for life",
        "he": "נֶפֶשׁ בְּנֶפֶשׁ"
      },
      {
        "ja": "ודיה' עין בעין",
        "en": "and the compensation of eye for eye",
        "he": "עַיִן בְּעַיִן"
      },
      {
        "ja": "וסן בסן",
        "en": "and tooth for tooth",
        "he": "שֵׁן בְּשֵׁן"
      },
      {
        "ja": "ויד ביד",
        "en": "hand for hand",
        "he": "יָד בְּיָד"
      },
      {
        "ja": "ורגל ברגל",
        "en": "and foot for foot",
        "he": "רֶגֶל בְּרָגֶל"
      }
    ]
  }
}