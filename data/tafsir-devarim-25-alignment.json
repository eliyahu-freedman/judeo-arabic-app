        "he": "אֲשֶׁר יְהוָה-אֱלֹהֶיךָ נֹתֵן לְךָ"
      },
      {
        "ja": "מעטיך נחלה לתחוזה",
        "en": "is giving you as an inheritance to possess it",
        "he": "נַחֲלָה לְרִשְׁתָּהּ"
      },
      {
        "ja": "פאמח ד'כר עמלק",
        "en": "you shall blot out the memory of Amalek",
        "he": "תִּמְחֶה אֶת-זֵכֶר עֲמָלֵק"
      },
      {
        "ja": "מן תחת אלסמא",
        "en": "from beneath the sky",
        "he": "מִתַּחַת הַשָּׁמָיִם"
      },
      {
        "ja": "לא תנס ד'אלך",
        "en": "Do not forget that",
        "he": "לֹא תִּשְׁכָּח"
      }
    ]
  }
}