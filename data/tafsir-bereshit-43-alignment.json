        "ja": "עלי' אכ'יה",
        "en": "toward his brother"
      },
      {
        "ja": "פטלב אן יבכי",
        "en": "and he sought to weep"
      },
      {
        "ja": "פדכ'ל אלי' אלכ'דר",
        "en": "and he entered the chamber"
      },
      {
        "ja": "ובכא ת'ם",
        "en": "and wept there"
      }
    ],
    "31": [
      {
        "ja": "ת'ם ג'סל וגהה",
        "en": "Then he washed his face"
      },
      {
        "ja": "וכ'רג",
        "en": "and came out"
      },
      {
        "ja": "ותרפק",
        "en": "and restrained himself"
      },
      {
        "ja": "וקאל",
        "en": "and said"
      },
      {
        "ja": "קדמו אלטעאם",
        "en": "Set out the food"
      }
    ],
    "32": [
      {
        "ja": "פקדמו לה וחדה",
        "en": "And they set out for him alone"
      },
      {
        "ja": "ולהם וחדהם",
        "en": "and for them alone"
      },
      {
        "ja": "וללמצריון",
        "en": "and for the Egyptians"
      },
      {
        "ja": "אלד'י יאכלון מעה",
        "en": "who ate with him"
      },
      {
        "ja": "וחדהם",
        "en": "alone"
      },
      {
        "ja": "לאן אלמצריון",
        "en": "for the Egyptians"
      },
      {
        "ja": "לא יסתגיזון",
        "en": "cannot"
      },
      {
        "ja": "אן יאכלון מע אלעבראניין",
        "en": "eat with the Hebrews"
      },
      {
        "ja": "טעאמא",
        "en": "at the same food"
      },
      {
        "ja": "לאן טעאמהם מכרוה ענדהם",
        "en": "for it is an abomination to them"
      }
    ],
    "33": [
      {
        "ja": "פאגלסהם בין ידיה",
        "en": "And he seated them before him"
      },
      {
        "ja": "אלבכר פי מרתבתה",
        "en": "the firstborn according to his rank"
      },
      {
        "ja": "ואלצגיר פי מרתבתה",
        "en": "and the youngest according to his rank"
      },
      {
        "ja": "ואבהת אלקום",
        "en": "and the men marveled"
      },
      {
        "ja": "בעצ'הם אלי' בעץ'",
        "en": "each one with his neighbor"
      }
    ],
    "34": [
      {
        "ja": "וחמל זלאת",
        "en": "And portions were brought"
      },
      {
        "ja": "מן בין ידיה אליהם",
        "en": "from before him to them"
      },
      {
        "ja": "פכאנת זלאת בנימין",
        "en": "and Benjamin's portions"
      },
      {
        "ja": "אכת'ר מן זלאתהם כ'מסה אצ'עאף",
        "en": "were five times more than their portions"
      },
      {
        "ja": "ושרבו מעה",
        "en": "And they drank with him"
      },
      {
        "ja": "חתי' סכרו",
        "en": "until they were drunk"
      }
    ]
  }
}