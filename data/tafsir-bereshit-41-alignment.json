      }
    ],
    "37": [
      {
        "ja": "פחסן כלאמה",
        "en": "And the words were pleasing"
      },
      {
        "ja": "ענד פרעון",
        "en": "to Pharaoh"
      },
      {
        "ja": "וענד גמיע קואדה",
        "en": "and to all his officers"
      }
    ],
    "38": [
      {
        "ja": "ת'ם קאל פרעון לקואדה",
        "en": "Then Pharaoh said to his officers"
      },
      {
        "ja": "הל נגד מת'ל הד'א",
        "en": "Can we find one like this"
      },
      {
        "ja": "רגל פיה רוח אללה",
        "en": "a man in whom is the spirit of God"
      },
      {
        "ja": "עלמא",
        "en": "knowledge"
      }
    ],
    "39": [
      {
        "ja": "ת'ם קאל לה",
        "en": "Then he said to him"
      },
      {
        "ja": "בעד מא ערפך אללה",
        "en": "Inasmuch as God has made known to you"
      },
      {
        "ja": "כל הד'ה אלאמור",
        "en": "all these things"
      },
      {
        "ja": "ליס פאהם חכים מת'לך",
        "en": "there is none so understanding and wise as you"
      }
    ],
    "40": [
      {
        "ja": "אנת תכון עלי' ביתי",
        "en": "You shall be over my house"
      },
      {
        "ja": "ועלי' אמרך",
        "en": "and according to your order"
      },
      {
        "ja": "ינקאד גמיע קומי",
        "en": "shall all my people be guided"
      },
      {
        "ja": "לא אשרף עליך",
        "en": "only by the throne shall I be greater than you"
      }
    ],
    "41": [
      {
        "ja": "קאל לה פרעון",
        "en": "Pharaoh said to him"
      },
      {
        "ja": "אנצ'ר",
        "en": "Look"
      },
      {
        "ja": "קד וליתך",
        "en": "I have set you"
      },
      {
        "ja": "עלי' גמיע בלד מצר",
        "en": "over all the land of Egypt"
      }
    ],
    "42": [
      {
        "ja": "ת'ם נזע פרעון",
        "en": "Then Pharaoh removed"
      },
      {
        "ja": "כ'אתמה מן ידה",
        "en": "his signet ring from his hand"
      },
      {
        "ja": "וגעלהא עלי' יד יוסף",
        "en": "and set it upon Joseph's hand"
      },
      {
        "ja": "ואלבסה ת'יאב עשר",
        "en": "and he clothed him in garments of fine linen"
      },
      {
        "ja": "וצייר טוק מן ד'הב",
        "en": "and placed a chain of gold"
      },
      {
        "ja": "עלי' ענקה",
        "en": "upon his neck"
      }
    ],
    "43": [
      {
        "ja": "וארכבה גניבתה",
        "en": "And he made him ride in his chariot-of-state"
      },
      {
        "ja": "ונודי בין ידיה",
        "en": "and they cried out before him"
      },
      {
        "ja": "הד'א שריף אלמלך",
        "en": "this is the king's noble"
      },
      {
        "ja": "וולאה עלי' גמיע בלד מצר",
        "en": "And he set him over all the land of Egypt"
      }
    ],
    "44": [
      {
        "ja": "ת'ם קאל לה",
        "en": "Then he said to him"
      },
      {
        "ja": "אני פרעון",
        "en": "I am Pharaoh"
      },
      {
        "ja": "פמן ג'יר ראיך",
        "en": "and apart from your counsel"
      },
      {
        "ja": "לא ימד אנסאן ידה",
        "en": "no man shall lift his hand"
      },
      {
        "ja": "פי קלם",
        "en": "for a pen"
      },
      {
        "ja": "ולא רגלה פי רכאב",
        "en": "or his foot for a stirrup"
      },
      {
        "ja": "פי גמיע בלד מצר",
        "en": "in all the land of Egypt"
      }
    ],
    "45": [
      {
        "ja": "וסמאה מוצ'ח אלכ'פאיא",
        "en": "And he named him Revealer-of-Hidden-Things"
      },
      {
        "ja": "וזוגה באסנת",
        "en": "gave him as wife Asenath"
      },
      {
        "ja": "אבנה' פוטיפרע",
        "en": "daughter of Potiphera"
      },
      {
        "ja": "אמאם און",
        "en": "priest of On"
      },
      {
        "ja": "וכ'רג יוסף",
        "en": "And Joseph went out"
      },
      {
        "ja": "ואליא עלי' גמיע בלד מצר",
        "en": "as governor over all the land of Egypt"
      }
    ],
    "46": [
      {
        "ja": "וכאן יוסף",
        "en": "And Joseph was"
      },
      {
        "ja": "אבן ת'לאת'ין סנה",
        "en": "a son of thirty years"
      },
      {
        "ja": "חין וקף בין ידי פרעון",
        "en": "when he stood before Pharaoh"
      },
      {
        "ja": "מלך מצר",
        "en": "king of Egypt"
      },
      {
        "ja": "ולמא כ'רג מן בין ידיה",
        "en": "And when he went out from before him"
      },
      {
        "ja": "טאף גמיע בלד מצר",
        "en": "he traveled all the land of Egypt"
      }
    ],
    "47": [
      {
        "ja": "ואנבתת אלארץ'",
        "en": "And the land brought forth"
      },
      {
        "ja": "פי סבע סני אלשבע",
        "en": "in the seven years of plenty"
      },
      {
        "ja": "מל אלמכ'אזין",
        "en": "granaries full"
      }
    ],
    "48": [
      {
        "ja": "פגמע באקי טעאם",
        "en": "And he gathered all the food"
      },
      {
        "ja": "אלסבע אלסנין",
        "en": "of these seven years"
      },
      {
        "ja": "אלתי כאנת פי בלד מצר",
        "en": "which had been in the land of Egypt"
      },
      {
        "ja": "וגעלה פי קראהא",
        "en": "and placed it in its cities"
      },
      {
        "ja": "געל טעאם צ'יאע כל קריה",
        "en": "placing the food of the fields of each city"
      },
      {
        "ja": "אלתי חואליהא",
        "en": "around it"
      },
      {
        "ja": "פי וסטהא",
        "en": "in its midst"
      }
    ],
    "49": [
      {
        "ja": "פגמע יוסף מן אלבר",
        "en": "And Joseph gathered grain"
      },
      {
        "ja": "שביה כרמל אלבחר",
        "en": "like the sand of the sea"
      },
      {
        "ja": "חתי' אנתהי' מן אן יחציה",
        "en": "until he stopped counting"
      },
      {
        "ja": "ממא לא אחצא לה",
        "en": "for it was beyond counting"
      }
    ],
    "50": [
      {
        "ja": "וולד ליוסף אבנאן",
        "en": "And to Joseph were born two sons"
      },
      {
        "ja": "קבל אן תדכ'ל סנה' אלגוע",
        "en": "before the year of famine came"
      },
      {
        "ja": "אלדי' ולדתהמא לה אסנת",
        "en": "whom Asenath"
      },
      {
        "ja": "אבנה' פוטיפרע",
        "en": "daughter of Potiphera"
      },
      {
        "ja": "אמאם און",
        "en": "priest of On"
      }
    ],
    "51": [
      {
        "ja": "פסמי' אלבכר מנשה",
        "en": "And Joseph named the firstborn Manasseh"
      },
      {
        "ja": "קאל",
        "en": "saying"
      },
      {
        "ja": "אן אללה קד אנסאני",
        "en": "God has caused me to forget"
      },
      {
        "ja": "גמיע שקאי",
        "en": "all my misery"
      },
      {
        "ja": "ומא כאן מנה פי בית אבי",
        "en": "and all that was from my father's house"
      }
    ],
    "52": [
      {
        "ja": "וסמי אלת'אני אפרים",
        "en": "And he named the second Ephraim"
      },
      {
        "ja": "קאל",
        "en": "saying"
      },
      {
        "ja": "אן אללה אנמאני",
        "en": "God has made me grow"
      },
      {
        "ja": "פי בלד צ'עפי",
        "en": "in the land of my affliction"
      }
    ],
    "53": [
      {
        "ja": "ת'ם פנית",
        "en": "came to an end"
      }
    ],
    "54": [
      {
        "ja": "ובדאת סבע סני אלגוע",
        "en": "And the seven years of famine began"
      },
      {
        "ja": "אן תגי",
        "en": "to come"
      },
      {
        "ja": "כמא קאל יוסף",
        "en": "as Joseph had said"
      },
      {
        "ja": "פכאן גוע",
        "en": "and there was famine"
      },
      {
        "ja": "פי גמיע אלבלדאן",
        "en": "in all the lands"
      },
      {
        "ja": "ופי גמיע בלד מצר",
        "en": "but in all the land of Egypt"
      },
      {
        "ja": "כאן טעאם",
        "en": "there was food"
      }
    ],
    "55": [
      {
        "ja": "פלמא גאע אהל בלד מצר",
        "en": "And when the dwellers of the land of Egypt became hungry"
      },
      {
        "ja": "צרך' אלקום אלי' פרעון",
        "en": "the people cried out to Pharaoh"
      },
      {
        "ja": "בסבב אלטעאם",
        "en": "for food"
      },
      {
        "ja": "פקאל להם",
        "en": "and he said to them"
      },
      {
        "ja": "אמצ'ו אלי' יוסף",
        "en": "Go to Joseph"
      },
      {
        "ja": "מא קאל לכם אצנעוה",
        "en": "whatever he says to you, do"
      }
    ],
    "56": [
      {
        "ja": "ולמא אנבסט אלגוע",
        "en": "And when the famine spread"
      },
      {
        "ja": "עלי' וגה אלארץ'",
        "en": "upon the face of all the land"
      },
      {
        "ja": "פתח יוסף גמיע מא פיה",
        "en": "Joseph opened all that was in them"
      },
      {
        "ja": "ואמאר אלמצריון",
        "en": "and supplied the Egyptians"
      },
      {
        "ja": "ואשתד אלגוע",
        "en": "and the famine grew strong"
      },
      {
        "ja": "פי גמיע בלד מצר",
        "en": "in all the land of Egypt"
      }
    ],
    "57": [
      {
        "ja": "וכת'יר מן אהל אלבלדאן",
        "en": "And many from the lands"
      },
      {
        "ja": "גאו אלי' מצר",
        "en": "came to Egypt"
      },
      {
        "ja": "ימתארו מן יוסף",
        "en": "to buy grain from Joseph"
      },
      {
        "ja": "אד' אשתד אלגוע",
        "en": "for the famine was severe"
      },
      {
        "ja": "פי בלדאנהם",
        "en": "in their lands"
      }
    ]
  }
}