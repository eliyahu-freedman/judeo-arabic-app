        "he": "וְהִשְׁתַּחֲוִיתָ לָהֶם"
      },
      {
        "ja": "פקד ערפתכם",
        "en": "I make known to you",
        "he": "הַעִדֹתִי בָכֶם"
      },
      {
        "ja": "מן אליום",
        "en": "today",
        "he": "הַיּוֹם"
      },
      {
        "ja": "אנכם סתבידון",
        "en": "that you shall surely perish",
        "he": "כִּי אָבֹד תֹּאבֵדוּן"
