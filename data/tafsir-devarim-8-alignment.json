        "he": "לְהֵיטִבְךָ בְּאַחֲרִיתֶךָ"
      }
    ],
    "17": [
      {
        "ja": "פלא תקול",
        "en": "And you shall not say"
      },
      {
        "ja": "פי נפסך",
        "en": "within yourself",
        "he": "בִּלְבָבֶךָ"
      },
      {
        "ja": "אן קוותי",
        "en": "'My strength",
        "he": "כֹּחִי"
      },
      {
        "ja": "ועצם קדרתי",
        "en": "and the greatness of my power",
        "he": "וְעֹצֶם יָדִי"
      },
      {
        "ja": "אכתסבת לי",
