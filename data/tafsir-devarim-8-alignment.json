        "he": "אֶת-הַחַיִל הַזֶּה"
      }
    ],
    "18": [
      {
        "ja": "בל",
        "en": "But"
      },
      {
        "ja": "אדכר",
        "en": "remember",
        "he": "וְזָכַרְתָּ"
      },
      {
        "ja": "אללה",
        "en": "God",
        "he": "יְהוָה"
      },
      {
        "ja": "רבך",
        "en": "your Lord",
        "he": "אֱלֹהֶיךָ"
      },
      {
        "ja": "פאנה",
