        "he": "עֵקֶב לֹא תִשְׁמְעוּן"
      },
      {
        "ja": "אמר אללה",
        "en": "the command of God",
        "he": "בְּקוֹל יְהוָה"
      },
      {
        "ja": "רבכם",
        "en": "your Lord",
        "he": "אֱלֹהֵיכֶם"
      }
