      {
        "ja": "תכתסב בהא אליסאר",
        "en": "by which you gain prosperity",
        "he": "לַעֲשׂוֹת חָיִל"
      },
      {
        "ja": "לכי יאפי בעהדה",
        "en": "that He may fulfill His covenant",
        "he": "לְמַעַן הָקִים אֶת-בְּרִיתוֹ"
      },
      {
        "ja": "אלד'י קסם בה",
        "en": "which He swore",
        "he": "אֲשֶׁר-נִשְׁבַּע"
      },
      {
        "ja": "לאבאיך",
        "en": "to your fathers",
        "he": "לַאֲבֹתֶיךָ"
      },
      {
        "ja": "כיומנא הד'א",
        "en": "as on this day of ours",
        "he": "כַּיּוֹם הַזֶּה"
      }
    ],
    "19": [
      {
        "ja": "פאן",
        "en": "And if"
      },
      {
        "ja": "נסית",
        "en": "you forget",
