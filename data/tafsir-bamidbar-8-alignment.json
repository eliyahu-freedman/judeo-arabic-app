        "he": "כַּאֲשֶׁר צִוָּה"
      },
      {
        "ja": "אללה",
        "en": "God had commanded",
        "he": "יְהוָה"
      },
      {
        "ja": "מוסי'",
        "en": "Moses",
        "he": "אֶת-מֹשֶׁה"
      },
      {
        "ja": "בסבבהם",
        "en": "concerning them,",
        "he": "עַל-הַלְוִיִּם"
      },
      {
        "ja": "כד'אך צנעו להם",
        "en": "so they did for them.",
        "he": "כֵּן עָשׂוּ לָהֶם"
      }
    ],
    "23": [
      {
        "ja": "ת'ם",
