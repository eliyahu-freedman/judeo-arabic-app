        "he": "בְּאֶרֶץ מִצְרַיִם"
      },
      {
        "ja": "אקדסתהם לי",
        "en": "I consecrated them to Me.'",
        "he": "הִקְדַּשְׁתִּי אֹתָם לִי"
      }
    ],
    "18": [
      {
        "ja": "כד'אלך",
        "en": "'Thus"
      },
      {
        "ja": "אתכד'ת",
        "en": "I took",
        "he": "וָאֶקַּח"
      },
      {
        "ja": "אלליוניין",
        "en": "the Levites",
        "he": "אֶת-הַלְוִיִּם"
      },
      {
        "ja": "בדלהם",
        "en": "in their stead.'",
        "he": "תַּחַת כָּל-בְּכוֹר בִּבְנֵי יִשְׂרָאֵל"
      }
    ],
    "19": [
      {
        "ja": "וגעלתהם",
        "en": "'And I appointed them",
        "he": "וָאֶתְּנָה אֶת-הַלְוִיִּם"
      },
      {
        "ja": "להרון",
        "en": "for Aaron",
        "he": "לְאַהֲרֹן"
      },
      {
        "ja": "ובניה",
        "en": "and his sons,",
        "he": "וּלְבָנָיו"
      },
      {
        "ja": "מן בין",
        "en": "from among",
        "he": "מִתּוֹךְ"
      },
      {
        "ja": "בני אסראיל",
        "en": "the sons of Israel,",
        "he": "בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "ליכדמו כ'דמתהם",
        "en": "to perform their service",
        "he": "לַעֲבֹד אֶת-עֲבֹדַת בְּנֵי-יִשְׂרָאֵל"
      },
      {
        "ja": "פי כ'בא אלמחצ'ר",
        "en": "in the tent of meeting,",
        "he": "בְּאֹהֶל מוֹעֵד"
      },
      {
        "ja": "ויסתג'פרו ענהם",
        "en": "and to seek forgiveness for them —",
        "he": "וּלְכַפֵּר עַל-בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "ולא יחל בהם",
        "en": "that no pestilence may come upon them",
        "he": "וְלֹא יִהְיֶה"
      },
      {
        "ja": "ובא",
        "en": "when they approach",
        "he": "נֶגֶף"
      },
      {
        "ja": "אד' הם תקדמו אלי' אלקדס",
        "en": "the sanctuary.'",
        "he": "בְּגֶשֶׁת בְּנֵי-יִשְׂרָאֵל אֶל-הַקֹּדֶשׁ"
      }
    ],
    "20": [
      {
        "ja": "וצנע",
        "en": "And",
        "he": "וַיַּעַשׂ"
      },
      {
        "ja": "מוסי'",
        "en": "Moses",
        "he": "מֹשֶׁה"
      },
      {
        "ja": "והרון",
        "en": "and Aaron,",
        "he": "וְאַהֲרֹן"
      },
      {
        "ja": "וסאיר גמאעה'",
        "en": "and the rest of the congregation of",
        "he": "וְכָל-עֲדַת"
      },
      {
        "ja": "בני אסראיל",
        "en": "the sons of Israel,",
        "he": "בְּנֵי-יִשְׂרָאֵל"
      },
      {
        "ja": "לאלליוניין",
        "en": "did for the Levites",
        "he": "לַלְוִיִּם"
      },
      {
        "ja": "כגמיע מא אמר",
        "en": "according to all that",
        "he": "כְּכֹל אֲשֶׁר-צִוָּה"
      },
      {
        "ja": "אללה",
        "en": "God had commanded",
        "he": "יְהוָה"
      },
      {
        "ja": "מוסי'",
        "en": "Moses",
        "he": "אֶת-מֹשֶׁה"
      },
      {
        "ja": "פי סבבהם",
        "en": "concerning them —",
        "he": "לַלְוִיִּם"
      },
      {
        "ja": "כד'אך צנעו להם",
        "en": "so they did for them.",
        "he": "כֵּן-עָשׂוּ לָהֶם בְּנֵי יִשְׂרָאֵל"
      }
    ],
    "21": [
      {
        "ja": "פתד'כו",
        "en": "And they were purified",
        "he": "וַיִּתְחַטְּאוּ הַלְוִיִּם"
      },
      {
        "ja": "וג'סלו",
        "en": "and washed",
        "he": "וַיְכַבְּסוּ"
      },
      {
        "ja": "ת'יאבהם",
        "en": "their garments;",
        "he": "בִּגְדֵיהֶם"
      },
      {
        "ja": "וזפהם",
        "en": "and Aaron presented them",
        "he": "וַיָּנֶף"
      },
      {
        "ja": "הרון",
        "en": "as a presentation",
        "he": "אַהֲרֹן"
      },
      {
        "ja": "זפא",
        "en": "before",
        "he": "תְּנוּפָה"
      },
      {
        "ja": "בין ידי אללה",
        "en": "God,",
        "he": "לִפְנֵי יְהוָה"
      },
      {
        "ja": "ואסתג'פר ענהם",
        "en": "and sought forgiveness for them",
        "he": "וַיְכַפֵּר עֲלֵיהֶם"
      },
      {
        "ja": "וטהרהם",
        "en": "and purified them.",
        "he": "אַהֲרֹן לְטַהֲרָם"
      }
    ],
    "22": [
      {
        "ja": "ובעד ד'אלך",
        "en": "And after that",
        "he": "וְאַחֲרֵי-כֵן"
      },
      {
