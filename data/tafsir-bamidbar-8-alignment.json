        "he": "לִצְבֹא צָבָא"
      },
      {
        "ja": "לכ'דמה' כ'בא אלמחצ'ר",
        "en": "for the service of the tent of meeting.'",
        "he": "בַּעֲבֹדַת אֹהֶל מוֹעֵד"
      }
    ],
    "25": [
      {
        "ja": "ומן אבן",
        "en": "'And from",
        "he": "וּמִבֶּן"
