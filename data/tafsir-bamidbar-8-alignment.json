        "en": "he shall retire",
        "he": "יָשׁוּב"
      },
      {
        "ja": "ענה",
        "en": "from it,",
        "he": "מִצְּבָא הָעֲבֹדָה"
      },
      {
        "ja": "ולא יכ'דם",
        "en": "and shall serve no more",
        "he": "וְלֹא יַעֲבֹד"
      },
      {
        "ja": "אבדא",
        "en": "at all.'",
        "he": "עוֹד"
      }
    ],
    "26": [
      {
        "ja": "לכן",
        "en": "'But"
      },
      {
        "ja": "יכ'דם",
        "en": "he may serve",
        "he": "וְשֵׁרֵת"
      },
      {
        "ja": "מע אכ'ותה",
        "en": "alongside his brothers",
        "he": "אֶת-אֶחָיו"
      },
      {
        "ja": "פי חפץ' כ'בא אלמחצ'ר",
        "en": "in guarding the tent of meeting;",
        "he": "בְּאֹהֶל מוֹעֵד"
      },
      {
        "ja": "ואמא כ'דמתה אלאוולא",
        "en": "as for his former service,",
        "he": "לִשְׁמֹר מִשְׁמֶרֶת"
      },
      {
        "ja": "פלא יכ'דם",
        "en": "he shall not serve.",
        "he": "וַעֲבֹדָה לֹא יַעֲבֹד"
      },
      {
        "ja": "כד'אך אצנע בהם",
        "en": "Thus shall you do for them",
        "he": "כָּכָה תַּעֲשֶׂה לַלְוִיִּם"
      },
      {
        "ja": "פי מחפצ'הם",
        "en": "in their charge.'",
        "he": "בְּמִשְׁמְרֹתָם"
      }
    ]
  }
