      },
      {
        "ja": "פצאעדא",
        "en": "and upward,",
        "he": "וָמַעְלָה"
      },
      {
        "ja": "ידכל",
        "en": "one shall enter",
        "he": "יָבוֹא"
      },
      {
        "ja": "לאלגיש",
