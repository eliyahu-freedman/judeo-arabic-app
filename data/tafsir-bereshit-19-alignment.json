      }
    ],
    "30": [
      {
        "ja": "פצעד לוט",
        "en": "And Lot went up"
      },
      {
        "ja": "מן זג'ר",
        "en": "from Zoar"
      },
      {
        "ja": "ואקאם פי אלגבל",
        "en": "and settled in the mountain"
      },
      {
        "ja": "ואבנתיה מעה",
        "en": "and his two daughters were with him"
      },
      {
        "ja": "אד' כ'אף",
        "en": "for he was afraid"
      },
      {
        "ja": "אן יקים פי זג'ר",
        "en": "to dwell in Zoar"
      },
      {
        "ja": "פאקאם פי אלמג'ארה",
        "en": "And he dwelt in the cave"
      },
      {
        "ja": "הו ואבנתיה",
        "en": "he and his two daughters"
      }
    ],
    "31": [
      {
        "ja": "פקאלת אלכברי'",
        "en": "And the elder said"
      },
      {
        "ja": "לאלצג'רי'",
        "en": "to the younger"
      },
      {
        "ja": "אן אבינא שיך",
        "en": "Our father is old"
      },
      {
        "ja": "וליס רג'ל פי אלבלד",
        "en": "and there is no man in the land"
      },
      {
        "ja": "אן ידכ'ל עלינא",
        "en": "to come to us"
      },
      {
        "ja": "כסביל אלנסא",
        "en": "in the way of all the earth"
      }
    ],
    "32": [
      {
        "ja": "תעאלי",
        "en": "Come"
      },
      {
        "ja": "נסקי אבינא",
        "en": "let us make our father drink"
      },
      {
        "ja": "כ'מרא",
        "en": "wine"
      },
      {
        "ja": "ו'נצ'אגעה",
        "en": "and lie with him"
      },
      {
        "ja": "ונסתבקי מנה",
        "en": "and let us preserve from"
      },
      {
        "ja": "נסלא",
        "en": "offspring"
      }
    ],
    "33": [
      {
        "ja": "פסקתא אביהמא",
        "en": "And they made their father drink"
      },
      {
        "ja": "כ'מרא",
        "en": "wine"
      },
      {
        "ja": "פי תלך אללילה",
        "en": "that night"
      },
      {
        "ja": "פקאמת אלכברי'",
        "en": "and the elder rose"
      },
      {
        "ja": "וצ'אגעתה",
        "en": "and lay with him"
      },
      {
        "ja": "ולם יעלם",
        "en": "and he did not know"
      },
      {
        "ja": "בניאמהא וקיאמהא",
        "en": "of her lying down or her rising"
      }
    ],
    "34": [
      {
        "ja": "ולמא כאן מן ג'ד",
        "en": "And on the morrow"
      },
      {
        "ja": "קאלת אלכברי' ללצג'רי'",
        "en": "the elder said to the younger"
      },
      {
        "ja": "הוד'א קד צ'אגעת אמס אבי",
        "en": "Behold, I lay last night with my father"
      },
      {
        "ja": "תעאלי נסקיה כ'מרא",
        "en": "Let us make him drink wine"
      },
      {
        "ja": "אללילה",
        "en": "tonight as well"
      },
      {
        "ja": "וצ'אגעיה",
        "en": "and you go in, lie with him"
      },
      {
        "ja": "ונסתבקי מנה נסלא",
        "en": "that we may preserve from our father offspring"
      }
    ],
    "35": [
      {
        "ja": "פסקתא פי תלך אללילה. אביהמא כ'מרא",
        "en": "And they made their father drink wine that night also"
      },
      {
        "ja": "וקאמת אלצג'רי'",
        "en": "and the younger rose"
      },
      {
        "ja": "וצ'אגעתה",
        "en": "and lay with him"
      },
      {
        "ja": "ולם יעלם",
        "en": "and he did not know"
      },
      {
        "ja": "בניאמהא וקיאמהא",
        "en": "of her lying down or her rising"
      }
    ],
    "36": [
      {
        "ja": "פחמלתא. אבנתא לוט",
        "en": "the two daughters of Lot conceived"
      },
      {
        "ja": "מן אביהמא",
        "en": "from their father"
      }
    ],
    "37": [
      {
        "ja": "פולדת אלכברי'",
        "en": "And the elder bore"
      },
      {
        "ja": "אבנא",
        "en": "a son"
      },
      {
        "ja": "ואסמתה מואב",
        "en": "and named him Moab"
      },
      {
        "ja": "הו אבו אלמואביין",
        "en": "he is the father of the Moabites"
      },
      {
        "ja": "אלי' אליום",
        "en": "to this day"
      }
    ],
    "38": [
      {
        "ja": "ואלצג'רי'",
        "en": "And the younger"
      },
      {
        "ja": "הי איצ'א",
        "en": "she too"
      },
      {
        "ja": "ולדת אבנא",
        "en": "bore a son"
      },
      {
        "ja": "ואסמתה אבן עמי",
        "en": "and named him Ben-Ammi"
      },
      {
        "ja": "הו אבי בני עמון",
        "en": "he is the father of the children of Ammon"
      },
      {
        "ja": "אלי' אליום",
        "en": "to this day"
      }
    ]
  }
}