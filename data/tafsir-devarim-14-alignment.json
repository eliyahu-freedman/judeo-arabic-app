        "he": "לִפְנֵי יְהוָה"
      },
      {
        "ja": "רבך",
        "en": "your Lord",
        "he": "אֱלֹהֶיךָ"
      },
      {
        "ja": "פי אלמוצ'ע",
        "en": "in the place",
        "he": "בַּמָּקוֹם"
      },
      {
        "ja": "אלד'י יכ'תארה",
        "en": "which He shall choose",
        "he": "אֲשֶׁר-יִבְחַר"
      },
      {
        "ja": "ליחל נורה פיה",
        "en": "for His light to dwell therein",
        "he": "לְשַׁכֵּן שְׁמוֹ שָׁם"
      },
      {
        "ja": "עשור ברך",
        "en": "the tithes of your grain",
        "he": "מַעְשַׂר דְּגָנְךָ"
      },
      {
        "ja": "ועצירך",
        "en": "and your press-produce",
        "he": "תִּירֹשְׁךָ"
      },
      {
        "ja": "ודהנך",
        "en": "and your oil",
        "he": "וְיִצְהָרֶךָ"
      },
      {
        "ja": "ובכור בקרך",
        "en": "and the firstlings of your cattle",
        "he": "וּבְכֹרֹת בְּקָרְךָ"
      },
      {
        "ja": "וג'נמך",
        "en": "and your flock",
        "he": "וְצֹאנֶךָ"
      },
      {
        "ja": "לכי תתעלם",
        "en": "so that you may learn",
        "he": "לְמַעַן תִּלְמַד"
      },
      {
        "ja": "כיף תעבדה",
        "en": "how to serve Him",
        "he": "לְיִרְאָה אֶת-יְהוָה"
      },
      {
        "ja": "טול אלזמאן",
        "en": "all the length of time",
        "he": "כָּל-הַיָּמִים"
      }
    ],
    "24": [
      {
        "ja": "ואן טאל עליך אלטריק",
        "en": "And if the way be too long for you",
        "he": "וְכִי-יִרְבֶּה מִמְּךָ הַדֶּרֶךְ"
      },
      {
        "ja": "ולם תטיק אן תחמלה",
        "en": "and you are unable to carry it",
        "he": "כִּי לֹא תוּכַל שְׂאֵתוֹ"
      },
      {
        "ja": "ובעד ענך אלמוצ'ע",
        "en": "and the place is far from you",
        "he": "כִּי-יִרְחַק מִמְּךָ הַמָּקוֹם"
      },
      {
        "ja": "אלד'י יכ'תארה אללה",
        "en": "the place which God",
        "he": "אֲשֶׁר יִבְחַר יְהוָה"
      },
      {
        "ja": "רבך",
        "en": "your Lord shall choose",
        "he": "אֱלֹהֶיךָ"
      },
      {
        "ja": "אן יחל נורה פיה",
        "en": "for His light to dwell therein",
        "he": "לָשׂוּם שְׁמוֹ שָׁם"
      },
      {
        "ja": "ובארך לך מע ד'אלך",
        "en": "and He has blessed you through all of this",
        "he": "כִּי יְבָרֶכְךָ יְהוָה אֱלֹהֶיךָ"
      }
    ],
    "25": [
      {
        "ja": "פבעה בת'מן",
        "en": "then sell it for a price",
        "he": "וְנָתַתָּה בַּכָּסֶף"
      },
      {
        "ja": "וצרה",
        "en": "and tie it up",
        "he": "וְצַרְתָּ הַכֶּסֶף"
      },
      {
        "ja": "וכ'ד'ה פי ידך",
        "en": "and take it in your hand",
        "he": "בְּיָדְךָ"
      },
      {
        "ja": "ואמץ' אלי'",
        "en": "and go to",
        "he": "וְהָלַכְתָּ"
      },
      {
        "ja": "אלמוצ'ע",
        "en": "the place",
        "he": "אֶל-הַמָּקוֹם"
      },
      {
        "ja": "אלד'י יכ'תארה אללה",
        "en": "which God",
        "he": "אֲשֶׁר יִבְחַר יְהוָה"
      },
      {
        "ja": "רבך",
        "en": "your Lord shall choose",
        "he": "אֱלֹהֶיךָ"
      }
    ],
    "26": [
      {
        "ja": "ואצרפה",
        "en": "And spend it",
        "he": "וְנָתַתָּה הַכֶּסֶף"
      },
      {
        "ja": "פי גמיע מא תשתהי נפסך",
        "en": "on whatever your soul desires",
        "he": "בְּכֹל אֲשֶׁר-תְּאַוֶּה נַפְשְׁךָ"
      },
      {
        "ja": "מן בקר",
        "en": "cattle",
        "he": "בַּבָּקָר"
      },
      {
        "ja": "וג'נם",
        "en": "and flock",
        "he": "וּבַצֹּאן"
      },
      {
        "ja": "וכ'מר",
        "en": "and wine",
        "he": "וּבַיַּיִן"
      },
      {
        "ja": "ונביד'",
        "en": "and strong drink",
        "he": "וּבַשֵּׁכָר"
      },
      {
        "ja": "וגמיע מא תחבה נפסך",
        "en": "and whatever your soul wishes",
        "he": "וּבְכֹל אֲשֶׁר תִּשְׁאָלְךָ נַפְשֶׁךָ"
      },
      {
        "ja": "וכלה הנאך",
        "en": "and eat it there",
        "he": "וְאָכַלְתָּ שָּׁם"
      },
      {
        "ja": "בין ידי אללה",
        "en": "before God",
        "he": "לִפְנֵי יְהוָה"
      },
      {
        "ja": "רבך",
        "en": "your Lord",
        "he": "אֱלֹהֶיךָ"
      },
      {
        "ja": "ואפרח",
        "en": "and rejoice",
        "he": "וְשָׂמַחְתָּ"
      },
      {
        "ja": "אנת",
        "en": "you",
        "he": "אַתָּה"
      },
      {
        "ja": "ואלך",
        "en": "and your household",
        "he": "וּבֵיתֶךָ"
      }
    ],
    "27": [
      {
        "ja": "ואללוי",
        "en": "And the Levite",
        "he": "וְהַלֵּוִי"
      },
      {
        "ja": "אלד'י פי מחלך",
        "en": "who is in your localities",
        "he": "אֲשֶׁר-בִּשְׁעָרֶיךָ"
      },
      {
        "ja": "לא תתרכה",
        "en": "do not forsake him",
        "he": "לֹא תַעַזְבֶנּוּ"
      },
      {
        "ja": "אד' ליס לה",
        "en": "since he has no",
        "he": "כִּי אֵין לוֹ"
      },
      {
        "ja": "נציב",
        "en": "portion",
        "he": "חֵלֶק"
      },
      {
