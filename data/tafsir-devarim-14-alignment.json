      },
      {
        "ja": "מעך",
        "en": "with you",
        "he": "עִמָּךְ"
      }
    ],
    "28": [
      {
        "ja": "ופי כל ת'לאת' סנין",
        "en": "And at the end of every three years",
        "he": "מִקְצֵה שָׁלֹשׁ שָׁנִים"
      },
      {
        "ja": "תכ'רג",
