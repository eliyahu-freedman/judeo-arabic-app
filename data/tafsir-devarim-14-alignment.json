      },
      {
        "ja": "ולא נחלה",
        "en": "nor inheritance",
        "he": "וְנַחֲלָה"
      },
      {
        "ja": "מעך",
        "en": "with you",
        "he": "עִמָּךְ"
      },
      {
        "ja": "ואלג'ריב",
        "en": "and the stranger",
        "he": "וְהַגֵּר"
      },
      {
        "ja": "ואליתים",
        "en": "and the orphan",
        "he": "וְהַיָּתוֹם"
      },
      {
        "ja": "ואלארמלה",
        "en": "and the widow",
        "he": "וְהָאַלְמָנָה"
      },
      {
        "ja": "אלד'י' פי מחלך",
        "en": "who are in your localities",
        "he": "אֲשֶׁר בִּשְׁעָרֶיךָ"
      },
      {
        "ja": "פיאכלון",
        "en": "and they shall eat",
        "he": "וְאָכְלוּ"
      },
      {
        "ja": "וישבעון",
        "en": "and be satisfied",
        "he": "וְשָׂבֵעוּ"
      },
      {
        "ja": "לכי יבארך לך",
        "en": "so that",
        "he": "לְמַעַן יְבָרֶכְךָ"
      },
      {
        "ja": "אללה",
        "en": "God",
        "he": "יְהוָה"
      },
      {
        "ja": "רבך",
        "en": "your Lord may bless you",
        "he": "אֱלֹהֶיךָ"
      },
      {
        "ja": "פי גמיע מא תצנעה",
        "en": "in all that you do",
        "he": "בְּכָל-מַעֲשֵׂה יָדְךָ אֲשֶׁר תַּעֲשֶׂה"
      }
    ]
  }
