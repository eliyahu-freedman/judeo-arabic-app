        "en": "he was sold to him",
        "he": "מִשְּׁנַת הִמָּכְרוֹ לוֹ"
      },
      {
        "ja": "אלי' סנה' אלאטלאק",
        "en": "until the year of release",
        "he": "עַד שְׁנַת הַיֹּבֵל"
      },
      {
        "ja": "פיסקט",
        "en": "shall be apportioned"
      },
      {
        "ja": "ת'מן ביעה",
        "en": "the price of his sale",
        "he": "וְהָיָה כֶּסֶף מִמְכָּרוֹ"
      },
      {
        "ja": "עלי'",
        "en": "according to"
      },
      {
        "ja": "אחצא אלסנין",
        "en": "the count of the years",
        "he": "בְּמִסְפַּר שָׁנִים"
      },
      {
        "ja": "וליכון",
        "en": "and he shall be"
      },
      {
        "ja": "מעה",
        "en": "with him"
      },
      {
        "ja": "פיהא",
        "en": "in those years"
      },
      {
        "ja": "כאייאם אלאגיר",
        "en": "as the days of a hired worker",
        "he": "כִּימֵי שָׂכִיר יִהְיֶה עִמּוֹ"
      }
    ],
    "51": [
      {
        "ja": "פאן",
        "en": "If"
      },
      {
        "ja": "בקי מן אלסנין כתיר",
