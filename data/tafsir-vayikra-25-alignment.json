        "he": "בְּפֶרֶךְ"
      },
      {
        "ja": "בחצ'רתך",
        "en": "in your presence",
        "he": "לְעֵינֶיךָ"
      }
    ],
    "54": [
      {
        "ja": "ואן",
        "en": "And if"
      },
      {
        "ja": "לם יפתך בהד'א אלאמור",
