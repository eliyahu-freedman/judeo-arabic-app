      },
      {
        "ja": "ועלי'",
        "en": "according to"
      },
      {
        "ja": "קדרהא",
        "en": "their measure",
        "he": "וְחִשַּׁב-לוֹ כְּפִי שָׁנָיו"
      },
      {
        "ja": "ירד פכאכה",
        "en": "he shall return his redemption",
        "he": "יָשִׁיב אֶת-גְּאֻלָּתוֹ"
      }
    ],
    "53": [
      {
        "ja": "ובאלגמלה",
        "en": "In sum"
      },
      {
        "ja": "כאגיר סנה בסנה",
        "en": "as a hired worker year by year",
