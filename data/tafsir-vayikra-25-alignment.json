      {
        "ja": "רבך",
        "en": "your Lord",
        "he": "וְיָרֵאתָ מֵאֱלֹהֶיךָ"
      },
      {
        "ja": "חתי",
        "en": "so that"
      },
      {
        "ja": "יעיש אכ'יך",
        "en": "your brother may live",
        "he": "וְחֵי אָחִיךָ"
      },
      {
        "ja": "מעך",
        "en": "with you",
        "he": "עִמָּךְ"
      }
    ],
    "37": [
      {
        "ja": "ולא תדפע",
        "en": "And do not advance"
      },
      {
        "ja": "אליה",
