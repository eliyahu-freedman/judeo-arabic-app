        "he": "מֵאִתּוֹ"
      },
      {
        "ja": "עיינה",
        "en": "a sample-interest",
        "he": "נֶשֶׁךְ"
      },
      {
        "ja": "ולא רבא",
        "en": "nor usury",
        "he": "וְתַרְבִּית"
      },
      {
        "ja": "וכ'ף",
        "en": "and fear"
