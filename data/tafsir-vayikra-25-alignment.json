        "en": "for",
        "he": "כִּי"
      },
      {
        "ja": "ביותהם וקראהם",
        "en": "their houses and their towns",
        "he": "בָתֵּי עָרֵי הַלְוִיִּם"
      },
      {
        "ja": "הי חוזהם",
        "en": "are their holding",
        "he": "הִוא אֲחֻזָּתָם"
      },
      {
        "ja": "פי מא בין בני אסראיל",
        "en": "among the sons of Israel",
        "he": "בְּתוֹךְ בְּנֵי יִשְׂרָאֵל"
      }
