    "34": [
      {
        "ja": "ואמא",
        "en": "But"
      },
      {
        "ja": "צ'יאע פנא קראהם",
        "en": "the estates of the open ground around their towns",
        "he": "וּשְׂדֵה מִגְרַשׁ עָרֵיהֶם"
      },
      {
        "ja": "לא תבאע",
        "en": "shall not be sold",
        "he": "לֹא יִמָּכֵר"
      },
      {
        "ja": "לאנהא חוז אלדהר",
        "en": "for it is their holding",
        "he": "כִּי-אֲחֻזַּת עוֹלָם"
      },
      {
        "ja": "להם",
        "en": "forever",
        "he": "הוּא לָהֶם"
      }
    ],
    "35": [
      {
        "ja": "ואד'א",
        "en": "And if"
      },
      {
        "ja": "תמאהן",
        "en": "becomes impoverished",
        "he": "וְכִי-יָמוּךְ"
      },
      {
        "ja": "אכ'יך",
        "en": "your brother",
        "he": "אָחִיךָ"
      },
      {
        "ja": "פמאלת ידה",
        "en": "and his hand falters",
        "he": "וּמָטָה יָדוֹ"
      },
      {
        "ja": "מעך",
        "en": "with you",
        "he": "עִמָּךְ"
      },
      {
        "ja": "פאשדדה",
        "en": "then strengthen him"
      },
      {
        "ja": "באן יכון לך",
        "en": "that he be as",
        "he": "וְהֶחֱזַקְתָּ בּוֹ"
