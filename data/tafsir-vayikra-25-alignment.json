      {
        "ja": "סאכנא",
        "en": "a resident",
        "he": "גֵּר"
      },
      {
        "ja": "וצ'יפא",
        "en": "and a guest",
        "he": "וְתוֹשָׁב"
      },
      {
        "ja": "פיעיש מעך",
        "en": "and let him live with you",
        "he": "וָחַי עִמָּךְ"
      }
    ],
    "36": [
      {
        "ja": "לא תאכ'ד'",
        "en": "Do not take",
        "he": "אַל-תִּקַּח"
      },
      {
        "ja": "מנה",
