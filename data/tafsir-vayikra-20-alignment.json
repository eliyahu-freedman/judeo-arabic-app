        "he": "בָּאֶבֶן יִרְגְּמוּ אֹתָם"
      },
      {
        "ja": "פקד חלת דמאהמא",
        "en": "their blood is thereby made forfeit",
        "he": "דְּמֵיהֶם בָּם"
      }
    ]
  }
}