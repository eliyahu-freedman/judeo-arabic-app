        "he": "מַעֲשֵׂר מִן-הַמַּעֲשֵׂר"
      }
    ],
    "27": [
      {
        "ja": "וד'אלך אן תחסב",
        "en": "And this shall be reckoned",
        "he": "וְנֶחְשַׁב"
      },
      {
        "ja": "לכם",
        "en": "for you",
        "he": "לָכֶם"
      },
      {
        "ja": "רפאיעכם",
        "en": "as your raised-offerings —",
        "he": "תְּרוּמַתְכֶם"
      },
      {
        "ja": "כאלבר",
        "en": "like the grain",
        "he": "כַּדָּגָן"
      },
      {
        "ja": "לבני אסראיל",
        "en": "of the sons of Israel"
      },
      {
        "ja": "מן אלבד'אר",
        "en": "from the threshing-seed,",
        "he": "מִן-הַגֹּרֶן"
      },
      {
        "ja": "וכאלסלאפה",
        "en": "and like the first-pressing",
        "he": "וְכַמְלֵאָה"
      },
      {
        "ja": "מן אלת'ג'אר",
        "en": "from the vats.",
        "he": "מִן-הַיָּקֶב"
      }
    ],
    "28": [
      {
        "ja": "כד'אך",
