        "he": "אֶת-חֶלְבּוֹ"
      },
      {
        "ja": "מנה",
        "en": "the remainder",
        "he": "מִמֶּנּוּ"
      },
      {
        "ja": "צאר אלבאקי לכם יא ליואניין",
        "en": "shall count as yours, O Levites,",
        "he": "וְנֶחְשַׁב לַלְוִיִּם"
      },
      {
        "ja": "כג'לה' בני אסראיל מן אלבד'אר",
        "en": "as the yield of the sons of Israel from threshing-seed",
        "he": "כִּתְבוּאַת גֹּרֶן"
      },
      {
        "ja": "ואלת'ג'אר",
        "en": "and from the vats.",
        "he": "וְכִתְבוּאַת יָקֶב"
      }
    ],
    "31": [
      {
        "ja": "וגאיז אן תאכלוה",
        "en": "And it is permitted that you eat it",
        "he": "וַאֲכַלְתֶּם"
      },
      {
        "ja": "פי כל מוצ'ע",
        "en": "in every place —",
        "he": "בְּכָל-מָקוֹם"
      },
      {
        "ja": "אנתם",
        "en": "you",
        "he": "אַתֶּם"
      },
      {
        "ja": "ואלכם",
        "en": "and your households —",
        "he": "וּבֵיתְכֶם"
      },
      {
        "ja": "לאנה אגרתכם",
