        "he": "כֵּן תָּרִימוּ"
      },
      {
        "ja": "אנתם איצ'א",
        "en": "also raise up",
        "he": "גַם-אַתֶּם"
      },
      {
        "ja": "רפיעה ללה",
        "en": "a raised-offering for God",
        "he": "תְּרוּמַת יְהוָה"
      },
      {
        "ja": "מן גמיע עשורכם",
        "en": "from all your tithes",
        "he": "מִכֹּל מַעְשְׂרֹתֵיכֶם"
      },
      {
        "ja": "אלתי תאכ'ד'והא",
        "en": "which you take",
        "he": "אֲשֶׁר תִּקְחוּ"
      },
      {
        "ja": "מן בני אסראיל",
        "en": "from the sons of Israel,",
        "he": "מֵאֵת בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "ואעטו ד'אלך",
        "en": "and give that",
        "he": "וּנְתַתֶּם מִמֶּנּוּ"
      },
      {
        "ja": "להרון",
        "en": "to Aaron",
        "he": "אֶת-תְּרוּמַת יְהוָה לְאַהֲרֹן"
      },
      {
        "ja": "אלאמאם",
        "en": "the imām.",
        "he": "הַכֹּהֵן"
      }
    ],
    "29": [
      {
        "ja": "וליכון",
        "en": "And let"
      },
      {
        "ja": "מא תרפעונה",
        "en": "what you raise up",
        "he": "מִכֹּל מַתְּנֹתֵיכֶם תָּרִימוּ"
      },
      {
        "ja": "מן גמיע עטאיאכם ללה",
        "en": "from all your gifts for God",
        "he": "אֵת כָּל-תְּרוּמַת יְהוָה"
      },
      {
        "ja": "אגודהא",
        "en": "be the choicest",
        "he": "מִכָּל-חֶלְבּוֹ"
      },
      {
        "ja": "ואכ'צהא מנהא",
        "en": "and most select of them.",
        "he": "אֶת-מִקְדְּשׁוֹ מִמֶּנּוּ"
      }
    ],
    "30": [
      {
        "ja": "וקל",
