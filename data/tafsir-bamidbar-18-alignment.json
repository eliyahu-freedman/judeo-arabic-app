        "en": "in exchange for",
        "he": "חֵלֶף"
      },
      {
        "ja": "כ'דמתכם",
        "en": "your service",
        "he": "עֲבֹדַתְכֶם"
      },
      {
        "ja": "פי כ'בא אלמחצ'ר",
        "en": "in the tent of assembly.",
        "he": "בְּאֹהֶל מוֹעֵד"
      }
    ],
    "32": [
      {
        "ja": "ולא תחמלון",
        "en": "And you shall bear",
        "he": "וְלֹא-תִשְׂאוּ"
      },
      {
        "ja": "עליה",
        "en": "no burden on account of it",
        "he": "עָלָיו"
      },
      {
        "ja": "וזרא",
        "en": "when",
        "he": "חֵטְא"
      },
      {
        "ja": "ענד רפעכם",
        "en": "you raise up",
        "he": "בַּהֲרִימְכֶם"
      },
      {
        "ja": "אגודה",
        "en": "the choicest of it;",
        "he": "אֶת-חֶלְבּוֹ"
      },
      {
        "ja": "מנה",
        "en": "and",
        "he": "מִמֶּנּוּ"
      },
      {
        "ja": "ואקדאס",
        "en": "the holy things of",
        "he": "וְאֶת-קָדְשֵׁי"
