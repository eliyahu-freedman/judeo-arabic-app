      {
        "ja": "בני אסראיל",
        "en": "the sons of Israel",
        "he": "בְנֵי-יִשְׂרָאֵל"
      },
      {
        "ja": "לא תבד'לוהא",
        "en": "you shall not treat lightly,",
        "he": "לֹא תְחַלְּלוּ"
      },
      {
        "ja": "ולא תהלכון",
        "en": "lest you perish.'",
        "he": "וְלֹא תָמוּתוּ"
