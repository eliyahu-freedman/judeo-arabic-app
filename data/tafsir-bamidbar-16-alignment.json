        "he": "וְאֵת כָּל-הָאָדָם אֲשֶׁר לְקֹרַח"
      },
      {
        "ja": "וגמיע אלסרח",
        "en": "and all the livestock.",
        "he": "וְאֵת כָּל-הָרְכוּשׁ"
      }
    ],
    "33": [
