      },
      {
        "ja": "אלי' הד'א אליום",
        "en": "until this day?",
        "he": "עַד-הַיּוֹם הַזֶּה"
      },
      {
        "ja": "הל עוודתך",
        "en": "Have I been accustomed",
        "he": "הַהַסְכֵּן הִסְכַּנְתִּי"
      },
      {
        "ja": "אן אצנע בך כד'א",
        "en": "to doing such a thing to you?'",
        "he": "לַעֲשׂוֹת לְךָ כֹּה"
      },
      {
        "ja": "קאל לא",
        "en": "He said: 'No.'",
        "he": "וַיֹּאמֶר לֹא"
      }
    ],
    "31": [
      {
        "ja": "ת'ם",
        "en": "Then"
      },
      {
        "ja": "כשף אללה",
        "en": "God uncovered",
        "he": "וַיְגַל יְהוָה"
      },
      {
        "ja": "ען בצר בלעם",
        "en": "Balaam's sight,",
        "he": "אֶת-עֵינֵי בִלְעָם"
      },
      {
        "ja": "פראא",
        "en": "and he saw",
        "he": "וַיַּרְא"
      },
      {
        "ja": "מלך אללה",
        "en": "the angel of God",
        "he": "אֶת-מַלְאַךְ יְהוָה"
      },
      {
        "ja": "ואקפא פי אלטריק",
        "en": "standing in the road,",
        "he": "נִצָּב בַּדֶּרֶךְ"
      },
      {
        "ja": "וסיפה מצלת",
        "en": "with his sword drawn",
        "he": "וְחַרְבּוֹ שְׁלֻפָה"
      },
      {
        "ja": "פי ידה",
        "en": "in his hand;",
        "he": "בְּיָדוֹ"
      },
      {
        "ja": "פכ'ר בין ידיה",
        "en": "and he fell down before him",
        "he": "וַיִּקֹּד וַיִּשְׁתַּחוּ"
      },
      {
        "ja": "סאגדא",
        "en": "prostrating.",
        "he": "לְאַפָּיו"
      }
    ],
    "32": [
      {
        "ja": "פקאל לה",
        "en": "And",
        "he": "וַיֹּאמֶר אֵלָיו"
      },
      {
        "ja": "מלך אללה",
        "en": "the angel of God said to him:",
        "he": "מַלְאַךְ יְהוָה"
      },
      {
        "ja": "לם צ'רבת",
        "en": "'Why have you struck",
        "he": "עַל-מָה הִכִּיתָ"
      },
      {
        "ja": "אתאנך",
        "en": "your she-donkey",
        "he": "אֶת-אֲתֹנְךָ"
      },
      {
        "ja": "הד'ה אלמרה אלת'אלת'ה",
        "en": "this third time?",
        "he": "זֶה שָׁלוֹשׁ רְגָלִים"
      },
      {
        "ja": "ואנא כ'רגת",
        "en": "I have come out",
        "he": "הִנֵּה אָנֹכִי יָצָאתִי"
      },
      {
        "ja": "אן אחידך",
        "en": "to turn you aside —",
        "he": "לְשָׂטָן"
      },
      {
        "ja": "אד' תורטת אלטריק",
        "en": "for the road",
        "he": "כִּי-יָרַט הַדֶּרֶךְ"
      },
      {
        "ja": "חד'אי",
        "en": "before me has become an entanglement.'",
        "he": "לְנֶגְדִּי"
      }
    ],
    "33": [
      {
        "ja": "חתי' ראתני",
        "en": "Until she saw me",
        "he": "וַתִּרְאַנִי הָאָתוֹן"
      },
      {
        "ja": "פמאלת עני",
        "en": "and turned aside from me —",
        "he": "וַתֵּט לְפָנַי"
      },
      {
        "ja": "הד'ה אלמרה אלת'אלת'ה",
        "en": "this third time.",
        "he": "זֶה שָׁלֹשׁ רְגָלִים"
      },
      {
        "ja": "פלו לם תמיל עני",
        "en": "Had she not turned aside from me,",
        "he": "אוּלַי נָטְתָה מִפָּנַי"
      },
      {
        "ja": "לקתלתך אלאן",
        "en": "I would have killed you now",
        "he": "כִּי עַתָּה גַּם-אֹתְכָה הָרַגְתִּי"
      },
      {
        "ja": "ובקיתהא",
        "en": "and let her live.'",
        "he": "וְאוֹתָהּ הֶחֱיֵיתִי"
      }
    ],
    "34": [
      {
        "ja": "קאל לה",
        "en": "He said to him:",
        "he": "וַיֹּאמֶר בִּלְעָם"
      },
      {
        "ja": "קד אכ'טית",
        "en": "'I have erred,",
        "he": "חָטָאתִי"
      },
      {
        "ja": "אד' לם אעלם",
        "en": "for I did not know",
        "he": "כִּי לֹא יָדַעְתִּי"
      },
      {
        "ja": "אנך ואקף",
        "en": "that you were standing",
        "he": "כִּי אַתָּה נִצָּב"
      },
      {
        "ja": "תלקאי",
        "en": "to meet me",
        "he": "לִקְרָאתִי"
      },
      {
        "ja": "פי אלטריק",
        "en": "in the road.",
        "he": "בַּדָּרֶךְ"
      },
      {
        "ja": "ואלאן",
        "en": "And now,",
        "he": "וְעַתָּה"
      },
      {
        "ja": "פאן סאך",
        "en": "if my going is displeasing to you,",
        "he": "אִם-רַע בְּעֵינֶיךָ"
      },
      {
        "ja": "מצ'יי רגעת",
        "en": "I shall turn back.'",
        "he": "אָשׁוּבָה לִּי"
      }
    ],
    "35": [
      {
        "ja": "קאל לה",
        "en": "He said to him:",
        "he": "וַיֹּאמֶר מַלְאַךְ יְהוָה"
      },
      {
        "ja": "אמץ'",
        "en": "'Go",
        "he": "לֵךְ"
      },
      {
        "ja": "מע אלקום",
        "en": "with the people —",
        "he": "עִם-הָאֲנָשִׁים"
      },
      {
        "ja": "ועדא",
        "en": "but only",
        "he": "וְאֶפֶס"
      },
      {
        "ja": "אלקול",
        "en": "the word",
        "he": "אֶת-הַדָּבָר"
      },
      {
        "ja": "אלד'י אקולה לך",
        "en": "that I shall tell you,",
        "he": "אֲשֶׁר-אֲדַבֵּר אֵלֶיךָ"
      },
      {
        "ja": "קולה פקט",
        "en": "speak that alone.'",
        "he": "אֹתוֹ תְדַבֵּר"
      },
      {
        "ja": "פמצ'א",
        "en": "And he went",
        "he": "וַיֵּלֶךְ בִּלְעָם"
      },
      {
        "ja": "מעהם",
        "en": "with them.",
        "he": "עִם-שָׂרֵי בָלָק"
      }
    ],
    "36": [
      {
        "ja": "פלמא סמע בלק",
        "en": "And when Balak heard",
        "he": "וַיִּשְׁמַע בָּלָק"
      },
      {
        "ja": "במגי בלעם",
        "en": "of the coming of Balaam,",
        "he": "כִּי בָא בִלְעָם"
      },
      {
        "ja": "כ'רג",
        "en": "he went out",
        "he": "וַיֵּצֵא"
      },
      {
        "ja": "תלקאה",
        "en": "to meet him",
        "he": "לִקְרָאתוֹ"
      },
      {
        "ja": "אלי' קריה' מואב",
        "en": "at the town of Moab,",
        "he": "אֶל-עִיר מוֹאָב"
      },
      {
        "ja": "אלד'י עלי' תכ'ם",
        "en": "which is on the border of",
        "he": "אֲשֶׁר עַל-גְּבוּל"
      },
      {
        "ja": "ארנון",
        "en": "the Arnon,",
        "he": "אַרְנֹן"
      },
      {
        "ja": "אלד'י פי טרפה",
        "en": "which is at its edge.",
        "he": "אֲשֶׁר בִּקְצֵה הַגְּבוּל"
      }
    ],
    "37": [
      {
        "ja": "קאל בלק",
        "en": "Balak said",
        "he": "וַיֹּאמֶר בָּלָק"
      },
      {
        "ja": "לבלעם",
        "en": "to Balaam:",
        "he": "אֶל-בִּלְעָם"
      },
      {
        "ja": "אלי'ס ארסלת אלי'ך",
        "en": "'Did I not send to you",
        "he": "הֲלֹא שָׁלֹחַ שָׁלַחְתִּי אֵלֶיךָ"
      },
      {
        "ja": "מרה קבל הד'ה לאדעוך",
        "en": "once before this to invite you?",
        "he": "לִקְרֹא-לָךְ"
      },
      {
        "ja": "לם לם תצאל אליי",
        "en": "Why did you not come to me?",
        "he": "לָמָּה לֹא-הָלַכְתָּ אֵלָי"
      },
      {
        "ja": "אתרא",
        "en": "Do you suppose",
        "he": "הַאֻמְנָם"
      },
      {
        "ja": "ליס אקדר אן אכרמך",
        "en": "I am unable to honor you?'",
        "he": "לֹא אוּכַל כַּבְּדֶךָ"
      }
    ],
    "38": [
      {
        "ja": "קאל",
        "en": "He said:",
        "he": "וַיֹּאמֶר בִּלְעָם"
      },
      {
        "ja": "ואלאן קד צרת",
        "en": "'And now I have indeed come",
        "he": "הִנֵּה-בָאתִי"
      },
      {
        "ja": "אלי'ך",
        "en": "to you —",
        "he": "אֵלֶיךָ"
      },
      {
        "ja": "אתראני אסתטיע",
        "en": "but do you suppose I am able",
        "he": "עַתָּה הֲיָכֹל אוּכַל"
      },
      {
        "ja": "אן אקול שייא",
        "en": "to say anything,",
        "he": "דַּבֵּר מְאוּמָה"
      },
      {
        "ja": "אלא מא ילקנניה",
        "en": "except only what",
        "he": "הַדָּבָר אֲשֶׁר יָשִׂים"
      },
      {
        "ja": "אללה",
        "en": "God",
        "he": "אֱלֹהִים"
      },
      {
        "ja": "פקט",
        "en": "will prompt me with?'",
        "he": "בְּפִי--אֹתוֹ אֲדַבֵּר"
      }
    ],
    "39": [
      {
        "ja": "ומצ'יא",
        "en": "And the two of them went",
        "he": "וַיֵּלֶךְ בִּלְעָם"
      },
      {
        "ja": "גמיעא",
        "en": "together,",
        "he": "עִם-בָּלָק"
      },
      {
        "ja": "אלי' אן גאא",
        "en": "until they came"
      },
      {
        "ja": "אלי'",
        "en": "to",
        "he": "וַיָּבֹאוּ"
      },
      {
        "ja": "קריה' חוצות",
        "en": "the town of Hutzoth.",
        "he": "קִרְיַת חֻצוֹת"
      }
    ],
    "40": [
      {
        "ja": "פד'בח",
        "en": "And Balak slaughtered",
        "he": "וַיִּזְבַּח"
      },
      {
        "ja": "בלק",
        "en": "cattle",
        "he": "בָּלָק"
      },
      {
        "ja": "בקרא",
        "en": "and sheep,",
        "he": "בָּקָר"
      },
      {
        "ja": "וג'נמא",
        "en": "and sent",
        "he": "וָצֹאן"
      },
      {
        "ja": "ובעת'",
        "en": "of that",
        "he": "וַיְשַׁלַּח"
      },
      {
        "ja": "בד'אלך",
        "en": "to Balaam"
      },
      {
        "ja": "אלי' בלעם",
        "en": "and to the officers",
        "he": "לְבִלְעָם"
      },
      {
        "ja": "ואלי' אלרויסא",
        "en": "who were",
        "he": "וְלַשָּׂרִים"
      },
      {
        "ja": "אלד'ין מעה",
        "en": "with him.",
        "he": "אֲשֶׁר אִתּוֹ"
      }
    ],
    "41": [
      {
        "ja": "פלמא כאן באלג'דאה",
        "en": "And it was in the morning:",
        "he": "וַיְהִי בַבֹּקֶר"
      },
      {
        "ja": "אכ'ד בלק",
        "en": "Balak took",
        "he": "וַיִּקַּח בָּלָק"
      },
      {
        "ja": "בלעם",
        "en": "Balaam",
        "he": "אֶת-בִּלְעָם"
      },
      {
        "ja": "פאצעדה",
        "en": "and brought him up",
        "he": "וַיַּעֲלֵהוּ"
      },
      {
        "ja": "אלי' בעץ' ביאע מעבודה",
        "en": "to some of the high-places of his deity,",
        "he": "בָּמוֹת בָּעַל"
      },
      {
        "ja": "פנצ'ר",
        "en": "and from there he saw",
        "he": "וַיַּרְא"
      },
      {
        "ja": "מן ת'ם",
        "en": "a portion of",
        "he": "מִשָּׁם"
      },
      {
        "ja": "בעץ' אלקום",
        "en": "the people.",
        "he": "קְצֵה הָעָם"
      }
    ]
  }
}