        "ja": "ובאבאינא",
        "en": "and with our fathers.",
        "he": "וְלַאֲבֹתֵינוּ"
      }
    ],
    "16": [
      {
        "ja": "פדעינא",
        "en": "And we cried out",
        "he": "וַנִּצְעַק"
      },
      {
        "ja": "אלי' אללה",
        "en": "to God,",
        "he": "אֶל-יְהוָה"
      },
      {
        "ja": "פסמע",
        "en": "and He heard",
        "he": "וַיִּשְׁמַע"
      },
      {
        "ja": "צותנא",
        "en": "our voice;",
        "he": "קֹלֵנוּ"
      },
      {
        "ja": "ובעת' ברסול",
        "en": "and He sent a messenger,",
        "he": "וַיִּשְׁלַח מַלְאָךְ"
      },
      {
        "ja": "ואכ'רגנא מן מצר",
        "en": "and brought us out of Egypt.",
        "he": "וַיֹּצִאֵנוּ מִמִּצְרָיִם"
      },
      {
        "ja": "והוד'א נחן",
        "en": "And behold, we are now",
        "he": "וְהִנֵּה אֲנַחְנוּ"
      },
      {
        "ja": "פי קריה' רקים",
        "en": "in the town of Raqim,",
        "he": "בְקָדֵשׁ עִיר"
      },
      {
        "ja": "פי טרף תכ'מך",
        "en": "at the edge of your border.",
        "he": "קְצֵה גְבוּלֶךָ"
      }
    ],
    "17": [
      {
        "ja": "נריד אן נגוז",
        "en": "We wish to pass",
        "he": "נַעְבְּרָה-נָּא"
      },
      {
        "ja": "פי בלדך",
        "en": "through your land;",
        "he": "בְאַרְצֶךָ"
      },
      {
        "ja": "וליסנא נמיל",
        "en": "we will not turn aside",
        "he": "לֹא נַעֲבֹר"
      },
      {
        "ja": "אלי' צ'יעה",
        "en": "to any farmstead",
        "he": "בְּשָׂדֶה"
      },
      {
        "ja": "ולא כרם",
        "en": "or vineyard,",
        "he": "וּבְכֶרֶם"
      },
      {
        "ja": "ולא נשרב",
        "en": "nor will we drink",
        "he": "וְלֹא נִשְׁתֶּה"
      },
      {
        "ja": "מא צהריג",
        "en": "cistern water —",
        "he": "מֵי בְאֵר"
      },
      {
        "ja": "לכנא נסיר פי אלטריק אלגאדה",
        "en": "but we will travel along the main road,",
        "he": "דֶּרֶךְ הַמֶּלֶךְ נֵלֵךְ"
      },
      {
        "ja": "לא נמיל ימנה",
        "en": "turning neither right",
        "he": "לֹא נִטֶּה יָמִין"
      },
      {
        "ja": "ולא יסרה",
        "en": "nor left,",
        "he": "וּשְׂמֹאול"
      },
      {
        "ja": "אלי' אן נגוז תכ'מך",
        "en": "until we have passed through your territory.'",
        "he": "עַד אֲשֶׁר-נַעֲבֹר גְּבֻלֶךָ"
      }
    ],
    "18": [
      {
        "ja": "קאל לה",
        "en": "The Red One (Edom) said to him:",
        "he": "וַיֹּאמֶר"
      },
      {
        "ja": "אלאחמרי",
        "en": "'You shall not pass",
        "he": "אֱדוֹם"
      },
      {
        "ja": "לא תגוז בי",
        "en": "through me —",
        "he": "לֹא תַעֲבֹר בִּי"
      },
      {
        "ja": "כלא באלסיף",
        "en": "lest I come out",
        "he": "פֶּן-בַּחֶרֶב"
      },
      {
        "ja": "אכ'ר'ג תלקאך",
        "en": "against you with the sword.'",
        "he": "אֵצֵא לִקְרָאתֶךָ"
      }
    ],
    "19": [
      {
        "ja": "וקאלו לה",
        "en": "And the sons of Israel said to him:",
        "he": "וַיֹּאמְרוּ"
      },
      {
        "ja": "בני אסראיל",
        "en": "'We will go up",
        "he": "בְּנֵי-יִשְׂרָאֵל"
      },
      {
        "ja": "נצעד פי אלמחגה",
        "en": "by the highway;",
        "he": "בַּמְסִלָּה נַעֲלֶה"
      },
      {
        "ja": "ואן שרבנא לך מא",
        "en": "and if we or our livestock drink any of your water,",
        "he": "וְאִם-מֵימֶיךָ נִשְׁתֶּה"
      },
      {
        "ja": "נחן ומאשיתנא",
        "en": "we will pay its price.",
        "he": "אֲנִי וּמִקְנַי"
      },
      {
        "ja": "דפענא ת'מנה",
        "en": "There is no matter at all —",
        "he": "וְנָתַתִּי מִכְרָם"
      },
      {
        "ja": "וליס אמר",
        "en": "only let us",
        "he": "רַק אֵין-דָּבָר"
      },
      {
        "ja": "אלא נגוז פקט",
        "en": "pass through.'",
        "he": "בְּרַגְלַי אֶעֱבֹרָה"
      }
    ],
    "20": [
      {
        "ja": "קאל",
        "en": "He said:",
        "he": "וַיֹּאמֶר"
      },
      {
        "ja": "לא תגוז",
        "en": "'You shall not pass,",
        "he": "לֹא תַעֲבֹר"
      },
      {
        "ja": "כד'אך",
        "en": "not even so.'"
      },
      {
        "ja": "פכ'רג אדום",
        "en": "And Edom came out",
        "he": "וַיֵּצֵא אֱדוֹם"
      },
      {
        "ja": "תלקאהם",
        "en": "to meet them",
        "he": "לִקְרָאתוֹ"
      },
      {
        "ja": "בשעב עצ'ים",
        "en": "with a great host",
        "he": "בְּעַם כָּבֵד"
      },
      {
        "ja": "ויד שדידה",
        "en": "and a mighty hand.",
        "he": "וּבְיָד חֲזָקָה"
      }
    ],
    "21": [
      {
        "ja": "פלמא אבא",
        "en": "And when Edom refused",
        "he": "וַיְמָאֵן"
      },
      {
        "ja": "אדום",
        "en": "to allow",
        "he": "אֱדוֹם"
      },
      {
        "ja": "אן יתרך",
        "en": "the house of Israel",
        "he": "נְתֹן"
      },
      {
        "ja": "אל אסראיל",
        "en": "to pass through",
        "he": "אֶת-יִשְׂרָאֵל"
      },
      {
        "ja": "אן יגוזו פי תכ'מה",
        "en": "his territory,",
        "he": "עֲבֹר בִּגְבֻלוֹ"
      },
      {
        "ja": "פמלו ענה",
        "en": "they turned away from him.",
        "he": "וַיֵּט יִשְׂרָאֵל מֵעָלָיו"
      }
    ],
    "22": [
      {
        "ja": "פרחלו",
        "en": "And they departed",
        "he": "וַיִּסְעוּ"
      },
      {
        "ja": "מן רקים",
        "en": "from Raqim,",
        "he": "מִקָּדֵשׁ"
      },
      {
        "ja": "וגאת",
        "en": "and the whole of their",
        "he": "וַיָּבֹאוּ"
      },
      {
        "ja": "גמאעתהם",
        "en": "congregation came",
        "he": "כָּל-הָעֵדָה"
      },
      {
        "ja": "אלי' גבל הור",
        "en": "to Mount Hor.",
        "he": "הֹר הָהָר"
      }
    ],
    "23": [
      {
        "ja": "פקאל אללה",
        "en": "And God said",
        "he": "וַיֹּאמֶר יְהוָה"
      },
      {
        "ja": "למוסי'",
        "en": "to Moses",
        "he": "אֶל-מֹשֶׁה"
      },
      {
        "ja": "והרון",
        "en": "and Aaron",
        "he": "וְאֶל-אַהֲרֹן"
      },
      {
        "ja": "פי גבל הור",
        "en": "at Mount Hor,",
        "he": "בְּהֹר הָהָר"
      },
      {
        "ja": "ענד תכ'ם בלד אדום",
        "en": "at the border of the land of Edom,",
        "he": "עַל-גְּבוּל אֶרֶץ-אֱדוֹם"
      },
      {
        "ja": "קאילא",
        "en": "saying:",
        "he": "לֵאמֹר"
      }
    ],
    "24": [
      {
        "ja": "ינצ'ם הרון",
        "en": "'Aaron shall be gathered",
        "he": "יֵאָסֵף אַהֲרֹן"
      },
      {
        "ja": "אלי' קומה",
        "en": "to his people;",
        "he": "אֶל-עַמָּיו"
      },
      {
        "ja": "פאנה לא יד'כל",
        "en": "for he shall not enter",
        "he": "כִּי לֹא יָבֹא"
      },
      {
        "ja": "אלבלד",
        "en": "the land",
        "he": "אֶל-הָאָרֶץ"
      },
      {
        "ja": "אלד'י אעטיתה",
        "en": "which I have given",
        "he": "אֲשֶׁר נָתַתִּי"
      },
      {
        "ja": "לבני אסראיל",
        "en": "to the sons of Israel —",
        "he": "לִבְנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "כמא קלת חין כ'אלפתמא",
        "en": "as I said when the two of you transgressed",
        "he": "עַל אֲשֶׁר-מְרִיתֶם"
      },
      {
        "ja": "אמרי",
        "en": "My command",
        "he": "אֶת-פִּי"
      },
      {
        "ja": "פי מא אלכ'צומה",
        "en": "at the water of strife.'",
        "he": "לְמֵי מְרִיבָה"
      }
    ],
    "25": [
      {
        "ja": "כ'ד'",
        "en": "'Take",
        "he": "קַח"
      },
      {
        "ja": "הרון",
        "en": "Aaron",
        "he": "אֶת-אַהֲרֹן"
      },
      {
        "ja": "ואלעזר",
        "en": "and Eleazar",
        "he": "וְאֶת-אֶלְעָזָר"
      },
      {
        "ja": "אבנה",
        "en": "his son,",
        "he": "בְּנוֹ"
      },
      {
        "ja": "ואצעדהמא",
        "en": "and bring the two of them up",
        "he": "וְהַעַל אֹתָם"
      },
      {
        "ja": "אלי' גבל הור",
        "en": "to Mount Hor.'",
        "he": "הֹר הָהָר"
      }
    ],
    "26": [
      {
        "ja": "ואסלך'",
        "en": "'And strip",
        "he": "וְהַפְשֵׁט"
      },
      {
        "ja": "הרון",
        "en": "Aaron",
        "he": "אֶת-אַהֲרֹן"
      },
      {
        "ja": "ת'יאבה",
        "en": "of his garments,",
        "he": "אֶת-בְּגָדָיו"
      },
      {
        "ja": "ואלבסהא",
        "en": "and put them upon",
        "he": "וְהִלְבַּשְׁתָּם"
      },
      {
        "ja": "אלעזר אבנה",
        "en": "Eleazar his son;",
        "he": "אֶת-אֶלְעָזָר בְּנוֹ"
      },
      {
        "ja": "והרון ינצ'ם",
        "en": "and Aaron shall be gathered",
        "he": "וְאַהֲרֹן יֵאָסֵף"
      },
      {
        "ja": "וימות הנאך",
        "en": "and shall die there.'",
        "he": "וּמֵת שָׁם"
      }
    ],
    "27": [
      {
        "ja": "פצנע מוסי'",
        "en": "And Moses did",
        "he": "וַיַּעַשׂ מֹשֶׁה"
      },
      {
        "ja": "כמא אמרה אללה",
        "en": "as God had commanded him;",
        "he": "כַּאֲשֶׁר צִוָּה יְהוָה"
      },
      {
        "ja": "וצעדוא אלי' גבל הור",
        "en": "and they went up to Mount Hor",
        "he": "וַיַּעֲלוּ אֶל-הֹר הָהָר"
      },
      {
        "ja": "בחצ'רה' אלגמאעה",
        "en": "in the presence of the congregation.",
        "he": "לְעֵינֵי כָּל-הָעֵדָה"
      }
    ],
    "28": [
      {
        "ja": "וסלך' מוסי'",
        "en": "And Moses stripped",
        "he": "וַיַּפְשֵׁט מֹשֶׁה"
      },
      {
        "ja": "ת'יאב הרון",
        "en": "Aaron of his garments,",
        "he": "אֶת-אַהֲרֹן אֶת-בְּגָדָיו"
      },
      {
        "ja": "ואלבסהא",
        "en": "and put them upon",
        "he": "וַיַּלְבֵּשׁ אֹתָם"
      },
      {
        "ja": "אלעזר אבנה",
        "en": "Eleazar his son;",
        "he": "אֶת-אֶלְעָזָר בְּנוֹ"
      },
      {
        "ja": "ומאת הרון",
        "en": "and Aaron died",
        "he": "וַיָּמָת אַהֲרֹן"
      },
      {
        "ja": "הנאך",
        "en": "there",
        "he": "שָׁם"
      },
      {
        "ja": "פי ראס אלגבל",
        "en": "at the summit of the mountain.",
        "he": "בְּרֹאשׁ הָהָר"
      },
      {
        "ja": "ונזל מוסי'",
        "en": "And Moses",
        "he": "וַיֵּרֶד מֹשֶׁה"
      },
      {
        "ja": "ואלעזר",
        "en": "and Eleazar",
        "he": "וְאֶלְעָזָר"
      },
      {
        "ja": "מן אלגבל",
        "en": "came down from the mountain.",
        "he": "מִן-הָהָר"
      }
    ],
    "29": [
      {
        "ja": "פלמא ראת",
        "en": "And when the congregation",
        "he": "וַיִּרְאוּ"
      },
      {
        "ja": "אלגמאעה",
        "en": "saw that Aaron",
        "he": "כָּל-הָעֵדָה"
      },
      {
        "ja": "אן הרון קד מאת",
        "en": "had indeed died,",
        "he": "כִּי גָוַע אַהֲרֹן"
      },
      {
        "ja": "בכא עלי'ה",
        "en": "wept for him",
        "he": "וַיִּבְכּוּ"
      },
      {
        "ja": "ת'לאתין יומא",
        "en": "thirty days.",
        "he": "שְׁלֹשִׁים יוֹם"
      },
      {
        "ja": "גמיע אל אסראיל",
        "en": "all the house of Israel",
        "he": "כֹּל בֵּית יִשְׂרָאֵל"
      }
    ]
  }
}