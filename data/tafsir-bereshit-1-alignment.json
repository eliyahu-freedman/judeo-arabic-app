        "en": "the two of them"
      },
      {
        "ja": "וקאל להמא",
        "en": "and said to them"
      },
      {
        "ja": "את'מרו",
        "en": "Bear fruit"
      },
      {
        "ja": "ואכת'רו",
        "en": "and multiply"
      },
      {
        "ja": "ועמו אלארץ'",
        "en": "and fill the earth"
      },
      {
        "ja": "ואמלכוהא",
        "en": "and master it"
      },
      {
        "ja": "ואסתולו",
        "en": "and rule"
      },
      {
        "ja": "עלא סמך אלבחר",
        "en": "over the fish of the sea"
      },
      {
        "ja": "וטאיר אלסמא",
        "en": "and the bird of the sky"
      },
      {
        "ja": "וסאיר אלחיואן",
        "en": "and every living thing"
      },
      {
        "ja": "אלדאב",
        "en": "that creeps"
      },
      {
        "ja": "עלי' אלארץ'",
        "en": "upon the earth"
      }
    ],
    "29": [
      {
        "ja": "וקאל אללה",
        "en": "And God said"
      },
      {
        "ja": "הוד'א",
        "en": "Behold"
      },
      {
        "ja": "קד אעטיתכם",
        "en": "I have given you"
      },
      {
        "ja": "כל עשב",
        "en": "every herb"
      },
      {
        "ja": "ד'ו חב",
        "en": "bearing seed"
      },
      {
        "ja": "אלד'י עלי' וגה",
        "en": "which is upon the face of"
      },
      {
        "ja": "גמיע אלארץ'",
        "en": "the whole earth"
      },
      {
        "ja": "וכל שגר",
        "en": "and every tree"
      },
      {
        "ja": "פיה ת'מר",
        "en": "wherein is fruit"
      },
      {
        "ja": "ד'ו חב",
        "en": "bearing seed"
      },
      {
        "ja": "יכון לכם",
        "en": "these shall be for you"
      },
      {
        "ja": "מאכלא",
        "en": "as food"
      }
    ],
    "30": [
      {
        "ja": "ולגמיע וחש אלארץ'",
        "en": "And to every wild creature of the earth"
      },
      {
        "ja": "וטאיר אלסמא",
        "en": "and bird of the sky"
      },
      {
        "ja": "וסאיר מא ידב",
        "en": "and all that creeps"
      },
      {
        "ja": "עלי' אלארץ'",
        "en": "upon the earth"
      },
      {
        "ja": "אלד'י פיה",
        "en": "in which is"
      },
      {
        "ja": "נפס חייה",
        "en": "a living soul"
      },
      {
        "ja": "גמיע עשב אלכ'צ'ר",
        "en": "all green herbage"
      },
      {
        "ja": "מאכלאן",
        "en": "shall be for food"
      },
      {
        "ja": "פכאן כד'אך",
        "en": "And so it was"
      }
    ],
    "31": [
      {
        "ja": "לִמא",
        "en": "For"
      },
      {
        "ja": "עלם אללה",
        "en": "God knew"
      },
      {
        "ja": "אן גמיע מא צנעה",
        "en": "that all that He had made"
      },
      {
        "ja": "גייד גדא",
        "en": "was very good"
      },
      {
        "ja": "וַלַמּא מצ'י' מן אלליל ואלנהאר",
        "en": "And there passed of night and daytime"
      },
      {
        "ja": "יום סאדס",
        "en": "a sixth day"
      }
    ]
  }
}