        "he": "אָקִים לָהֶם"
      },
      {
        "ja": "מן בעץ' אכ'ותהם",
        "en": "from some of their brothers",
        "he": "מִקֶּרֶב אֲחֵיהֶם"
      },
      {
        "ja": "מת'לך",
        "en": "like you",
        "he": "כָּמוֹךָ"
      },
      {
        "ja": "אלקנה כלאמי",
        "en": "I shall teach him My word",
        "he": "וְנָתַתִּי דְבָרַי בְּפִיו"
      },
      {
        "ja": "פיכ'אטבהם",
        "en": "and he shall address them",
        "he": "וְדִבֶּר אֲלֵיהֶם"
      },
      {
        "ja": "בגמיע מא אמרה בה",
        "en": "with all that I command him",
        "he": "אֵת כָּל-אֲשֶׁר אֲצַוֶּנּוּ"
      }
    ],
    "19": [
      {
        "ja": "ואי אנסאן",
        "en": "And whatever person",
        "he": "וְהָיָה הָאִישׁ"
      },
      {
        "ja": "לם יקבל",
        "en": "does not accept",
        "he": "אֲשֶׁר לֹא-יִשְׁמַע"
      },
      {
        "ja": "כלאמי",
        "en": "My word",
        "he": "אֶל-דְּבָרַי"
      },
      {
        "ja": "אלד'י י'ודי עני",
        "en": "which he conveys on My behalf",
        "he": "אֲשֶׁר יְדַבֵּר בִּשְׁמִי"
      },
      {
        "ja": "פאני אטאלבה",
        "en": "I shall call him to account",
        "he": "אָנֹכִי אֶדְרֹשׁ מֵעִמּוֹ"
      }
    ],
    "20": [
      {
        "ja": "ואי מתנבי",
        "en": "But whatever false prophet",
        "he": "אַךְ הַנָּבִיא"
      },
      {
        "ja": "תווקח פתקוול",
        "en": "has been brazen and has fabricated",
        "he": "אֲשֶׁר יָזִיד לְדַבֵּר"
      },
      {
        "ja": "קולא עני",
        "en": "a saying on My behalf",
        "he": "דָּבָר בִּשְׁמִי"
      },
      {
        "ja": "מא לם אמרה אן יקולה",
        "en": "what I have not commanded him to say",
        "he": "אֵת אֲשֶׁר לֹא-צִוִּיתִיו לְדַבֵּר"
      },
      {
        "ja": "ומן יתנבא למעבודאת אכ'ר",
        "en": "and whoever prophesies in the name of other objects of worship",
        "he": "וַאֲשֶׁר יְדַבֵּר בְּשֵׁם אֱלֹהִים אֲחֵרִים"
      },
      {
        "ja": "פליקתל ד'אלך אלמתנבי",
        "en": "that false prophet shall be put to death",
        "he": "וּמֵת הַנָּבִיא הַהוּא"
      }
    ],
    "21": [
      {
        "ja": "ואן קלת",
        "en": "And if you say",
        "he": "וְכִי תֹאמַר"
      },
      {
        "ja": "פי נפסך",
        "en": "to yourself",
        "he": "בִּלְבָבֶךָ"
      },
      {
        "ja": "כיף נעלם",
        "en": "How shall we know",
        "he": "אֵיכָה נֵדַע"
      },
      {
        "ja": "אלקול",
        "en": "the saying",
        "he": "אֶת-הַדָּבָר"
      },
      {
        "ja": "אלד'י לם יקולה אללה",
        "en": "which God has not spoken",
        "he": "אֲשֶׁר לֹא-דִבְּרוֹ יְהוָה"
      }
    ],
    "22": [
      {
        "ja": "פאנה",
        "en": "Then:"
      },
      {
        "ja": "מא יקולה אלמתנבי",
        "en": "that which the false prophet speaks",
        "he": "אֲשֶׁר יְדַבֵּר הַנָּבִיא"
      },
      {
        "ja": "ען אללה",
        "en": "in the name of God",
        "he": "בְּשֵׁם יְהוָה"
      },
      {
        "ja": "ולא יגוז ד'אלך אלקול",
        "en": "if that saying neither comes to pass",
        "he": "וְלֹא-יִהְיֶה הַדָּבָר"
      },
      {
        "ja": "ולא יגב",
        "en": "nor proves necessary",
        "he": "וְלֹא יָבֹא"
      },
      {
        "ja": "פהו אלקול אלד'י לם יקולה אללה",
        "en": "it is the saying which God has not spoken",
        "he": "הוּא הַדָּבָר אֲשֶׁר לֹא-דִבְּרוֹ יְהוָה"
      },
      {
        "ja": "ואנמא קאלה אלמתנבי בקחה",
        "en": "the false prophet has said it out of brazenness",
        "he": "בְּזָדוֹן דִּבְּרוֹ הַנָּבִיא"
      },
      {
        "ja": "פלא תחד'רה",
        "en": "Do not be wary of him",
        "he": "לֹא תָגוּר מִמֶּנּוּ"
      }
    ]
  }
}