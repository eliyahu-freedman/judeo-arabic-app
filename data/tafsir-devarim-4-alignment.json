        "he": "בִּבְלִי-דַעַת"
      },
      {
        "ja": "והוא ג'יר שאני לה",
        "en": "he not having been hostile to him",
        "he": "וְהוּא לֹא-שֹׂנֵא לוֹ"
      },
      {
        "ja": "מן אמס ומא קבלה",
        "en": "from yesterday and before",
        "he": "מִתְּמֹל שִׁלְשֹׁם"
      },
      {
        "ja": "פיהרב אלי' ואחדה מנהא",
        "en": "might flee to one of them",
        "he": "וְנָס אֶל-אַחַת מִן-הֶעָרִים הָאֵל"
      },
      {
        "ja": "פיחיא",
        "en": "and live",
        "he": "וָחָי"
      }
    ],
    "43": [
      {
        "ja": "פבצר פי אלבר",
        "en": "Bostra in the wilderness",
        "he": "אֶת-בֶּצֶר בַּמִּדְבָּר"
      },
      {
        "ja": "פי בלד אלסהל",
        "en": "in the land of the plain",
        "he": "בְּאֶרֶץ הַמִּישֹׁר"
      },
      {
        "ja": "מן בלד ראובן",
        "en": "from the land of Reuben",
        "he": "לָראוּבֵנִי"
      },
      {
        "ja": "ורמות פי גרש",
        "en": "and Ramoth in Gerash",
        "he": "וְאֶת-רָאמֹת בַּגִּלְעָד"
      },
      {
        "ja": "מן בלד גד",
        "en": "from the land of Gad",
        "he": "לַגָּדִי"
      },
      {
        "ja": "וגולן פי אלבת'נייה",
        "en": "and Golan in Bathaniyya",
        "he": "וְאֶת-גּוֹלָן בַּבָּשָׁן"
      },
      {
        "ja": "מן בלד מנשה",
        "en": "from the land of Manasseh",
        "he": "לַמְנַשִּׁי"
      }
    ],
    "44": [
      {
        "ja": "והזה אלשריעה",
        "en": "And this is the teaching",
        "he": "וְזֹאת הַתּוֹרָה"
      },
      {
        "ja": "אלתי תלאהא מוסי'",
        "en": "which Moses recited",
        "he": "אֲשֶׁר-שָׂם מֹשֶׁה"
      },
      {
        "ja": "בחצ'רה' בני אסראיל",
        "en": "before the sons of Israel",
        "he": "לִפְנֵי בְּנֵי יִשְׂרָאֵל"
      }
    ],
    "45": [
      {
        "ja": "והזה אלשואהד",
        "en": "These are the testimonies",
        "he": "אֵלֶּה הָעֵדֹת"
      },
      {
        "ja": "ואלרסום",
        "en": "and the statutes",
        "he": "וְהַחֻקִּים"
      },
      {
        "ja": "ואלאחכאמ",
        "en": "and the ordinances",
        "he": "וְהַמִּשְׁפָּטִים"
      },
      {
        "ja": "אלזי אמר בהא מוסי'",
        "en": "which Moses commanded",
        "he": "אֲשֶׁר דִּבֶּר מֹשֶׁה"
      },
      {
        "ja": "בני אסראיל",
        "en": "to the sons of Israel",
        "he": "אֶל-בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "פי כ'רוגהם מן מצר",
        "en": "at their going forth from Egypt",
        "he": "בְּצֵאתָם מִמִּצְרָיִם"
      }
    ],
    "46": [
      {
        "ja": "פי זאך גאנב אלארדן",
        "en": "on that side of the Jordan",
        "he": "בְּעֵבֶר הַיַּרְדֵּן"
      },
      {
        "ja": "פי אלואד",
        "en": "in the valley",
        "he": "בַּגַּיְא"
      },
      {
        "ja": "ממא ילי בית פעור",
        "en": "facing Beth Peor",
        "he": "מוּל בֵּית פְּעוֹר"
      },
      {
        "ja": "פי בלד סיחון",
        "en": "in the land of Sihon",
        "he": "בְּאֶרֶץ סִיחֹן"
      },
      {
        "ja": "מלך אלאמוריין",
        "en": "king of the Amorites",
        "he": "מֶלֶךְ הָאֱמֹרִי"
      },
      {
        "ja": "אלמקים",
        "en": "who dwelt",
        "he": "אֲשֶׁר יוֹשֵׁב"
      },
      {
        "ja": "פי חשבון",
        "en": "in Heshbon",
        "he": "בְּחֶשְׁבּוֹן"
      },
      {
        "ja": "אלזי קתלה מוסי'",
        "en": "whom Moses",
        "he": "אֲשֶׁר הִכָּה מֹשֶׁה"
      },
      {
        "ja": "ובני אסראיל",
        "en": "and the sons of Israel struck down",
        "he": "וּבְנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "פי כ'רוגהם מן מצר",
        "en": "at their going forth from Egypt",
        "he": "בְּצֵאתָם מִמִּצְרָיִם"
      }
    ],
    "47": [
      {
        "ja": "פחאזו בלדה",
        "en": "And they took possession of his land",
        "he": "וַיִּירְשׁוּ אֶת-אַרְצוֹ"
      },
      {
        "ja": "ובלד עוג",
        "en": "and the land of Og",
        "he": "וְאֶת-אֶרֶץ עוֹג"
      },
      {
        "ja": "מלך אלבת'נייה",
        "en": "king of Bathaniyya",
        "he": "מֶלֶךְ-הַבָּשָׁן"
      },
      {
        "ja": "והמא מלכי אלאמוריין",
        "en": "the two kings of the Amorites",
        "he": "שְׁנֵי מַלְכֵי הָאֱמֹרִי"
      },
      {
        "ja": "אלזי פי גאנב אלארדן אלשרקי",
        "en": "who were on the eastern side of the Jordan",
        "he": "אֲשֶׁר בְּעֵבֶר הַיַּרְדֵּן--מִזְרַח שָׁמֶשׁ"
      }
    ],
    "48": [
      {
        "ja": "מן ערוער",
        "en": "From Aroer",
        "he": "מֵעֲרֹעֵר"
      },
      {
        "ja": "אלזי עלי' שאט ואד ארנון",
        "en": "which is on the bank of the valley of Arnon",
        "he": "אֲשֶׁר עַל-שְׂפַת-נַחַל אַרְנֹן"
      },
      {
        "ja": "ואלי' גבל שיאון",
        "en": "as far as Mount Sion",
        "he": "וְעַד-הַר שִׂיאֹן"
      },
      {
        "ja": "הו חרמון",
        "en": "that is Hermon",
        "he": "הוּא חֶרְמוֹן"
      }
    ],
    "49": [
      {
        "ja": "וגמיע אלג'ור",
        "en": "and all the Ghor",
        "he": "וְכָל-הָעֲרָבָה"
      },
      {
        "ja": "גאנב אלארדן אלשרקי",
        "en": "on the eastern side of the Jordan",
        "he": "עֵבֶר הַיַּרְדֵּן מִזְרָחָה"
      },
      {
        "ja": "ואלי' בחירה' טבריה",
        "en": "as far as the Sea of Tiberias",
        "he": "וְעַד יָם הָעֲרָבָה"
      },
      {
        "ja": "תחת מצב אלקלעה",
        "en": "below the outlet of the fortress",
        "he": "תַּחַת אַשְׁדֹּת הַפִּסְגָּה"
      }
    ]
  }
