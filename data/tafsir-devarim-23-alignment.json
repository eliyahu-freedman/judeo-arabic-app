        "ja": "פי שי מן גמיע אלנד'ור",
        "en": "for any of all vows",
        "he": "לְכָל-נֶדֶר"
      },
      {
        "ja": "לאן אללה רבך יכרה",
        "en": "for God your Lord loathes",
        "he": "כִּי תוֹעֲבַת יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "המא גמיעא",
        "en": "them both",
        "he": "גַּם-שְׁנֵיהֶם"
      }
    ],
    "20": [
      {
        "ja": "ולא תעיין",
        "en": "You shall not charge",
        "he": "לֹא-תַשִּׁיךְ"
      },
      {
        "ja": "אכי'ך",
        "en": "your brother",
        "he": "לְאָחִיךָ"
      },
      {
        "ja": "עיינה'",
        "en": "interest"
      },
      {
        "ja": "דראהם",
        "en": "interest of money",
        "he": "נֶשֶׁךְ כֶּסֶף"
      },
      {
        "ja": "ולא טעאם",
        "en": "nor of food",
        "he": "נֶשֶׁךְ אֹכֶל"
      },
      {
        "ja": "ולא כל אמר יעיין",
        "en": "nor of any matter that may bear interest",
        "he": "נֶשֶׁךְ כָּל-דָּבָר אֲשֶׁר יִשָּׁךְ"
      }
    ],
    "21": [
      {
        "ja": "בל אלג'ריב תעאיין",
        "en": "From the stranger you may charge interest",
        "he": "לַנָּכְרִי תַשִּׁיךְ"
      },
      {
        "ja": "ואכי'ך לא תעאיין",
        "en": "but from your brother you shall not charge interest",
        "he": "וּלְאָחִיךָ לֹא תַשִּׁיךְ"
      },
      {
        "ja": "לכי יבארך לך",
        "en": "so that",
        "he": "לְמַעַן יְבָרֶכְךָ"
      },
      {
        "ja": "אללה",
        "en": "God",
        "he": "יְהוָה"
      },
      {
        "ja": "רבך",
        "en": "your Lord may bless you",
        "he": "אֱלֹהֶיךָ"
      },
      {
        "ja": "פי גמיע ממד ידך",
        "en": "in all the reach of your hand",
        "he": "בְּכֹל מִשְׁלַח יָדֶךָ"
      },
      {
        "ja": "פי אלבלד",
        "en": "in the land",
        "he": "עַל-הָאָרֶץ"
      },
      {
        "ja": "אלד'י אנת דאכ'ל אליה לתחוזה",
        "en": "which you are entering to take possession of it",
        "he": "אֲשֶׁר-אַתָּה בָא-שָׁמָּה לְרִשְׁתָּהּ"
      }
    ],
    "22": [
      {
        "ja": "ואן נד'רת נד'רא",
        "en": "And if you vow a vow",
        "he": "כִּי-תִדֹּר נֶדֶר"
      },
      {
        "ja": "ללה רבך",
        "en": "to God your Lord",
        "he": "לַיהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "לא ת'ווכ'ר",
        "en": "do not delay",
        "he": "לֹא תְאַחֵר"
      },
      {
        "ja": "אלופא בה",
        "en": "fulfilling it",
        "he": "לְשַׁלְּמוֹ"
      },
      {
        "ja": "פאנה יטאלבך בה מטאלבה",
        "en": "for He will demand it of you with demand",
        "he": "כִּי-דָרֹשׁ יִדְרְשֶׁנּוּ"
      },
      {
        "ja": "פתחל בך",
        "en": "and a punishment shall befall",
        "he": "יְהוָה אֱלֹהֶיךָ מֵעִמָּךְ"
      },
      {
        "ja": "עקובה",
        "en": "you",
        "he": "וְהָיָה בְךָ חֵטְא"
      }
    ],
    "23": [
      {
        "ja": "מא לו אנתהית אוולא מנה",
        "en": "Whereas had you refrained from it at the outset",
        "he": "וְכִי תֶחְדַּל לִנְדֹּר"
      },
      {
        "ja": "לם תחל בך עקובה",
        "en": "no punishment would have befallen you",
        "he": "לֹא-יִהְיֶה בְךָ חֵטְא"
      }
    ],
    "24": [
      {
        "ja": "בל מא כ'רג מן שפתיך",
        "en": "Rather, what has gone forth from your lips",
        "he": "מוֹצָא שְׂפָתֶיךָ"
      },
      {
        "ja": "אחפצה",
        "en": "guard it",
        "he": "תִּשְׁמֹר"
      },
      {
        "ja": "ואעמל בה",
        "en": "and act upon it",
        "he": "וְעָשִׂיתָ"
      },
      {
        "ja": "כמא נד'רת",
        "en": "as you vowed",
        "he": "כַּאֲשֶׁר נָדַרְתָּ"
      },
      {
        "ja": "ללה רבך",
        "en": "to God your Lord",
        "he": "לַיהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "מתברעא",
        "en": "voluntarily",
        "he": "נְדָבָה"
      },
      {
        "ja": "כמא קלתאה בפאך",
        "en": "as you spoke it with your mouth",
        "he": "אֲשֶׁר דִּבַּרְתָּ בְּפִיךָ"
      }
    ],
    "25": [
      {
        "ja": "ואד'א אסתאגרת",
        "en": "And when you are hired",
        "he": "כִּי תָבֹא"
      },
      {
        "ja": "פי כרם צאחבך",
        "en": "in your fellow's vineyard",
        "he": "בְּכֶרֶם רֵעֶךָ"
      },
      {
        "ja": "פכל מן אלענב",
        "en": "you may eat of the grapes",
        "he": "וְאָכַלְתָּ עֲנָבִים"
      },
      {
        "ja": "כשהותך שבעך",
        "en": "as your appetite satisfies you",
        "he": "כְּנַפְשְׁךָ שָׂבְעֶךָ"
      },
      {
        "ja": "ולא תצ'ע מנה שי פי אניתך",
        "en": "but you shall not place anything from them into your vessel",
        "he": "וְאֶל-כֶּלְיְךָ לֹא תִתֵּן"
      }
    ],
    "26": [
      {
        "ja": "ואד'א אסתאגרת",
        "en": "And when you are hired",
        "he": "כִּי תָבֹא"
      },
      {
        "ja": "פי סנבל צאחבך",
        "en": "among your fellow's standing grain",
        "he": "בְּקָמַת רֵעֶךָ"
      },
      {
        "ja": "פאקטף מא תפרכה בידך",
        "en": "you may pluck what you can rub with your hand",
        "he": "וְקָטַפְתָּ מְלִילֹת בְּיָדֶךָ"
      },
      {
        "ja": "ולא תחרך אלמנגל",
        "en": "but you shall not swing the sickle",
        "he": "וְחֶרְמֵשׁ לֹא תָנִיף"
      },
      {
        "ja": "עלי' סנבל צאחבך",
        "en": "over your fellow's standing grain",
        "he": "עַל קָמַת רֵעֶךָ"
      },
      {
        "ja": "לנפסך",
        "en": "for yourself"
      }
    ]
  }
}