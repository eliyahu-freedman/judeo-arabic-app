        "en": "he found nothing"
      },
      {
        "ja": "ת'ם כ'רג",
        "en": "Then he came out"
      },
      {
        "ja": "מן כ'בא לאה",
        "en": "from Leah's tent"
      },
      {
        "ja": "ודכ'ל אלי' כ'בא רחל",
        "en": "entered Rachel's tent"
      }
    ],
    "34": [
      {
        "ja": "והי קד אכ'ד'ת",
        "en": "she had taken"
      },
      {
        "ja": "אלתמת'אל",
        "en": "the image-figurine"
      },
      {
        "ja": "וציירתה",
        "en": "placed it"
      },
      {
        "ja": "פי קתב אלגמל",
        "en": "in the camel's saddle"
      },
      {
        "ja": "וגלסת עליה",
        "en": "sat upon it"
      },
      {
        "ja": "פגסס לבן",
        "en": "Laban felt"
      },
      {
        "ja": "גמיע אלכ'בא",
        "en": "all over the tent"
      },
      {
        "ja": "ולם יגד שי",
        "en": "did not find anything"
      }
    ],
    "35": [
      {
        "ja": "וקאלת לה",
        "en": "she said to him"
      },
      {
        "ja": "לא ישתד עלי' סיידי",
        "en": "Let it not press upon my lord"
      },
      {
        "ja": "פאני לא אטיק",
        "en": "for I cannot"
      },
      {
        "ja": "אן אקום",
        "en": "rise"
      },
      {
        "ja": "מן בין ידיך",
        "en": "from before you"
      },
      {
        "ja": "אד' סביל אלנסא",
        "en": "since the way of women"
      },
      {
        "ja": "קד ערץ' לי",
        "en": "has come upon me"
      },
      {
        "ja": "פפתש",
        "en": "he searched"
      },
      {
        "ja": "ולם יגד אלתמת'אל",
        "en": "did not find the image-figurine"
      }
    ],
    "36": [
      {
        "ja": "פאשתד ד'אלך עלי' יעקוב",
        "en": "it grew hard upon Jacob"
      },
      {
        "ja": "וכ'אצמה",
        "en": "he quarreled with him"
      },
      {
        "ja": "ואגאבה וקאל",
        "en": "answered, and said"
      },
      {
        "ja": "מא גרמי",
        "en": "What is my crime"
      },
      {
        "ja": "מא כ'טאי",
        "en": "What is my offense"
      },
      {
        "ja": "אד' דהקתני",
        "en": "that you have pursued me"
      }
    ],
    "37": [
      {
        "ja": "וקד גססת",
        "en": "you have felt"
      },
      {
        "ja": "גמיע אניתי",
        "en": "all my vessels"
      },
      {
        "ja": "מא וגדת",
        "en": "what have you found"
      },
      {
        "ja": "מן גמיע אניה' ביתך",
        "en": "of all the vessels of your house"
      },
      {
        "ja": "ציירה ההנא",
        "en": "Set it here"
      },
      {
        "ja": "חד'א אצחבי ואצחאבך",
        "en": "before my kinsmen and your kinsmen"
      },
      {
        "ja": "ויובכ'ונא",
        "en": "that they may judge"
      },
      {
        "ja": "עלי' אלבד'ל",
        "en": "between the two of us"
      }
    ],
    "38": [
      {
        "ja": "הוד'א לי עשרין סנה מעך",
        "en": "Behold, twenty years have I been with you"
      },
      {
        "ja": "רכ'אלך ומועזך",
        "en": "your ewes and your she-goats"
      },
      {
        "ja": "לם תת'כל",
        "en": "have not miscarried"
      },
      {
        "ja": "וכבאש ג'נמך",
        "en": "the rams of your flock"
      },
      {
        "ja": "לם אכל",
        "en": "I have not eaten"
      }
    ],
    "39": [
      {
        "ja": "ופריסה",
        "en": "A torn beast"
      },
      {
        "ja": "לא אדפעהא אליך",
        "en": "I did not bring it to you"
      },
      {
        "ja": "ומא אסתהלכתהא מן ידי תטלבהא",
        "en": "from my own hand you would demand it"
      },
      {
        "ja": "נהארא ולילא",
        "en": "by day or by night"
      }
    ],
    "41": [
      {
        "ja": "הוד'א לי עשרין סנה",
        "en": "Behold, twenty years have I been"
      },
      {
        "ja": "פי ביתך",
        "en": "in your house"
      },
      {
        "ja": "כ'דמתך",
        "en": "I served you"
      },
      {
        "ja": "ארבעה' עשר סנה",
        "en": "fourteen years"
      },
      {
        "ja": "באבנתיך",
        "en": "for your two daughters"
      },
      {
        "ja": "וסת סנין",
        "en": "six years"
      },
      {
        "ja": "בג'נמך",
        "en": "for your flocks"
      },
      {
        "ja": "ובדלת אגרתי",
        "en": "you changed my wage"
      },
      {
        "ja": "עשרה' אעדאד",
        "en": "ten times"
      }
    ],
    "42": [
      {
        "ja": "לולא אלאה אבי",
        "en": "Had not the God of my father"
      },
      {
        "ja": "אלאה אברהים",
        "en": "the God of Abraham"
      },
      {
        "ja": "ופזע יצחק",
        "en": "and the Fear of Isaac"
      },
      {
        "ja": "כאן לי עונא",
        "en": "been my helper"
      },
      {
        "ja": "לכנת אלאן אטלקתני",
        "en": "by now you would have sent me away"
      },
      {
        "ja": "פארג'א",
        "en": "empty"
      },
      {
        "ja": "לצ'עפי",
        "en": "My weakness"
      },
      {
        "ja": "ותעב כפי",
        "en": "and the toil of my hands"
      },
      {
        "ja": "נצ'ר אללה",
        "en": "God saw"
      },
      {
        "ja": "וובך'",
        "en": "reproved you"
      },
      {
        "ja": "אלבארחה",
        "en": "last night"
      }
    ],
    "43": [
      {
        "ja": "פאגאבה לבן וקאל לה",
        "en": "Laban answered him, and said to him"
      },
      {
        "ja": "אלבנאת בנאתי",
        "en": "The daughters are my daughters"
      },
      {
        "ja": "ואלאולאד אולאדי",
        "en": "the children are my children"
      },
      {
        "ja": "ואלג'נם ג'נמי",
        "en": "the flock is my flock"
      },
      {
        "ja": "וגמיע מא תראה הו לי",
        "en": "all that you see is mine"
      },
      {
        "ja": "פמא עסי' אן אצנע",
        "en": "what would I do"
      },
      {
        "ja": "בבנאתי אליום",
        "en": "this day to my daughters"
      },
      {
        "ja": "ובאולאדהן",
        "en": "or to their children"
      },
      {
        "ja": "אלד'ין ולדן",
        "en": "whom they have borne"
      }
    ],
    "44": [
      {
        "ja": "ואלאן",
        "en": "Now"
      },
      {
        "ja": "תעאל",
        "en": "come"
      },
      {
        "ja": "נעהד עהדא",
        "en": "let us make a covenant"
      },
      {
        "ja": "אנא ואנת",
        "en": "I and you"
      },
      {
        "ja": "ויכון שאהד",
        "en": "let it be a witness"
      },
      {
        "ja": "ביני ובינך",
        "en": "between me and you"
      }
    ],
    "45": [
      {
        "ja": "פאכ'ד' יעקוב חגר",
        "en": "Jacob took a stone"
      },
      {
        "ja": "ונצבהא דכה",
        "en": "set it up as a pillar"
      }
    ],
    "46": [
      {
        "ja": "פקאל יעקוב לאצחאבה",
        "en": "Jacob said to his kinsmen"
      },
      {
        "ja": "אלקטו חגארה",
        "en": "Gather stones"
      },
      {
        "ja": "וגמעו חגארה",
        "en": "they gathered stones"
      },
      {
        "ja": "וצנעו רגמא",
        "en": "made a cairn"
      },
      {
        "ja": "ואכלו ת'ם",
        "en": "they ate there"
      },
      {
        "ja": "עלי' אלרגם",
        "en": "upon the cairn"
      }
    ],
    "47": [
      {
        "ja": "פסמאה לבן",
        "en": "Laban named it"
      },
      {
        "ja": "רגם אלשהאדה",
        "en": "Cairn-of-Witness"
      },
      {
        "ja": "ויעקוב סמאה",
        "en": "Jacob named it"
      },
      {
        "ja": "באלעבראנייה",
        "en": "in Hebrew"
      },
      {
        "ja": "גלעד",
        "en": "Gal-Ed"
      }
    ],
    "48": [
      {
        "ja": "פקאל לבן",
        "en": "Laban said"
      },
      {
        "ja": "הד'א אלרגם שאהד",
        "en": "This cairn is witness"
      },
      {
        "ja": "ביני ובינך אליום",
        "en": "between me and you this day"
      },
      {
        "ja": "לד'אלך סמאה",
        "en": "Therefore he named it"
      },
      {
        "ja": "גלעד",
        "en": "Gal-Ed"
      }
    ],
    "49": [
      {
        "ja": "ואלמטלע",
        "en": "the Watcher"
      },
      {
        "ja": "אד קאל",
        "en": "for he said"
      },
      {
        "ja": "יטלע אללה",
        "en": "May God watch"
      },
      {
        "ja": "ביני ובינך",
        "en": "between me and you"
      },
      {
        "ja": "אד ננסתר",
        "en": "when we are concealed"
      },
      {
        "ja": "כל אמר ען צאחבה",
        "en": "each one from his fellow"
      }
    ],
    "50": [
      {
        "ja": "אן לא תעד'ב בנאתי",
        "en": "that you shall not afflict my daughters"
      },
      {
        "ja": "ולא תאכ'ד עליהן נסאא",
        "en": "shall not take wives in addition to them"
      },
      {
        "ja": "ליס מענא אנסאן ג'ריב",
        "en": "no human stranger is with us"
      },
      {
        "ja": "אנצ'ר",
        "en": "look"
      },
      {
        "ja": "אללה שאהד",
        "en": "God is witness"
      },
      {
        "ja": "ביני ובינך",
        "en": "between me and you"
      }
    ],
    "51": [
      {
        "ja": "וקאל לה איצ'א",
        "en": "he said to him also"
      },
      {
        "ja": "הד'א אלרגם",
        "en": "Behold this cairn"
      },
      {
        "ja": "והד'א אלנצבה",
        "en": "and this pillar"
      },
      {
        "ja": "אלתי זדותהא",
        "en": "which I have set up"
      },
      {
        "ja": "ביני ובינך",
        "en": "between me and you"
      }
    ],
    "52": [
      {
        "ja": "הד'א אלרגם שאהד",
        "en": "This cairn is witness"
      },
      {
        "ja": "והד'א אלנצבה",
        "en": "and the pillar"
      },
      {
        "ja": "עליא אן לא אגוזהמא אליך",
        "en": "that I shall not pass over them to you"
      },
      {
        "ja": "ועליך אן לא תגוזהמא אליי",
        "en": "that you shall not pass over them to me"
      },
      {
        "ja": "לשר",
        "en": "for evil"
      }
    ],
    "53": [
      {
        "ja": "אלאה אברהים",
        "en": "the God of Abraham"
      },
      {
        "ja": "ואלאה נחור",
        "en": "the God of Nahor"
      },
      {
        "ja": "יחכמו ביננא",
        "en": "judge between us"
      },
      {
        "ja": "אלאה אביהמא",
        "en": "the God of their father"
      },
      {
        "ja": "וחלף יעקוב",
        "en": "Jacob swore"
      },
      {
        "ja": "בפזע אביה יצחק",
        "en": "by the Fear of his father Isaac"
      }
    ],
    "54": [
      {
        "ja": "פד'בח יעקוב",
        "en": "Jacob offered"
      },
      {
        "ja": "ד'בחא",
        "en": "a sacrifice"
      },
      {
        "ja": "פי אלגבל",
        "en": "on the mountain"
      },
      {
        "ja": "ודעי באצחאב'ה",
        "en": "called his kinsmen"
      },
      {
        "ja": "ליאכלו טעאמא",
        "en": "to eat bread"
      },
      {
        "ja": "פאכלו טעאמא",
        "en": "they ate bread"
      },
      {
        "ja": "ובאתו פי אלגבל",
        "en": "lodged on the mountain"
      }
    ]
  }
}