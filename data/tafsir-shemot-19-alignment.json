      },
      {
        "ja": "ויקע מנהם כת'ירין",
        "en": "and many of them fall",
        "he": "וְנָפַל מִמֶּנּוּ רָב"
      }
    ],
    "22": [
      {
        "ja": "ואיצ'א אלאימה. אלמקרבון אלי' אללה",
        "en": "And also the imāms who are brought near to the light of God",
        "he": "וְגַם הַכֹּהֲנִים הַנִּגָּשִׁים אֶל-יְהוָה"
      },
      {
        "ja": "יתקדסון",
        "en": "shall sanctify themselves",
        "he": "יִתְקַדָּשׁוּ"
      },
      {
        "ja": "ללא ית'לם אללה מנהם",
        "en": "lest God cut them down",
        "he": "פֶּן-יִפְרֹץ בָּהֶם יְהוָה"
      }
    ],
    "23": [
      {
        "ja": "פקאל מוסי' ללה",
        "en": "And Moses said to God",
        "he": "וַיֹּאמֶר מֹשֶׁה אֶל-יְהוָה"
      },
      {
        "ja": "לא יטיק אלקום. אלצעוד אלי' גבל סיני",
        "en": "The people are not able to ascend Mount Sinai",
        "he": "לֹא-יוּכַל הָעָם לַעֲלֹת אֶל-הַר סִינָי"
      },
      {
        "ja": "לאנך נאשדתנא וקלת",
        "en": "for You implored us, saying",
        "he": "כִּי-אַתָּה הַעֵדֹתָה בָּנוּ לֵאמֹר"
      },
      {
        "ja": "תכ'ם אלגבל וקדסה",
        "en": "Set a boundary around the mountain and consecrate it",
        "he": "הַגְבֵּל אֶת-הָהָר וְקִדַּשְׁתּוֹ"
      }
    ],
    "24": [
      {
        "ja": "קאל לה אמץ' אנזל",
        "en": "Go, descend",
        "he": "וַיֹּאמֶר אֵלָיו יְהוָה לֶךְ-רֵד"
      },
      {
        "ja": "ת'ם אצעד אנת והרון מעך",
        "en": "then ascend — you and Aaron with you",
        "he": "וְעָלִיתָ אַתָּה וְאַהֲרֹן עִמָּךְ"
      },
      {
        "ja": "ואלאימה וסאיר אלקום. לא יהגמו. לאלצעוד אלי' נור אללה",
        "en": "but the imāms and the rest of the people shall not press forward to ascend toward the light of God",
        "he": "וְהַכֹּהֲנִים וְהָעָם אַל-יֶהֶרְסוּ לַעֲלֹת אֶל-יְהוָה"
      },
      {
        "ja": "ללא ית'לם מנהם",
        "en": "lest He cut down from among them",
        "he": "פֶּן-יִפְרָץ-בָּם"
      }
    ],
    "25": [
      {
        "ja": "פנזל מוסי' אלי' אלקום",
        "en": "And Moses descended to the people",
        "he": "וַיֵּרֶד מֹשֶׁה אֶל-הָעָם"
      },
      {
        "ja": "וקאל להם ד'אלך",
        "en": "and told them that",
        "he": "וַיֹּאמֶר אֲלֵהֶם"
      }
    ]
  }
}