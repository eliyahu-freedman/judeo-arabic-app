        "he": "דִּבֶּר יְהוָה אֶל-מֹשֶׁה"
      },
      {
        "ja": "פי בלד מצר",
        "en": "in the land of Egypt",
        "he": "בְּאֶרֶץ מִצְרָיִם"
      }
    ],
    "29": [
      {
        "ja": "קאל אללה למוסי",
        "en": "God said to Moses",
        "he": "וַיְדַבֵּר יְהוָה אֶל-מֹשֶׁה לֵּאמֹר"
      },
      {
        "ja": "אנא אללה",
        "en": "I am God",
        "he": "אֲנִי יְהוָה"
      },
      {
        "ja": "כלם פרעון מלך מצר",
        "en": "speak to Pharaoh, king of Egypt",
        "he": "דַּבֵּר אֶל-פַּרְעֹה מֶלֶךְ מִצְרַיִם"
      },
      {
        "ja": "בגמיע מא אמרה בה",
        "en": "all that I command you",
        "he": "אֵת כָּל-אֲשֶׁר אֲנִי דֹּבֵר אֵלֶיךָ"
      }
    ],
    "30": [
      {
        "ja": "פקאל בין ידיה",
        "en": "And he said before Him",
        "he": "וַיֹּאמֶר מֹשֶׁה לִפְנֵי יְהוָה"
      },
      {
        "ja": "הוד'א אנא אלתג' אלפם",
        "en": "Behold, I am thick of speech",
        "he": "הֵן אֲנִי עֲרַל שְׂפָתַיִם"
