        "he": "וְאֶלְעָזָר בֶּן-אַהֲרֹן"
      },
      {
        "ja": "תזווג באמראה מן בנאת פוטיאל",
        "en": "married a woman from the daughters of Putiel",
        "he": "לָקַח-לוֹ מִבְּנוֹת פּוּטִיאֵל לוֹ לְאִשָּׁה"
      },
      {
        "ja": "פולדת לה פינחס",
        "en": "and she bore him Phinehas",
        "he": "וַתֵּלֶד לוֹ אֶת-פִּינְחָס"
      },
      {
        "ja": "הולאי רויסא אבא אלליואניין לעשאירהם",
        "en": "These are the heads of the fathers of the Levites according to their clans",
        "he": "אֵלֶּה רָאשֵׁי אֲבוֹת הַלְוִיִּם--לְמִשְׁפְּחֹתָם"
      }
    ],
    "26": [
      {
        "ja": "המא הרון ומוסי",
        "en": "They are Aaron and Moses",
        "he": "הוּא אַהֲרֹן וּמֹשֶׁה"
      },
      {
        "ja": "אלד'י קאל אללה להמא",
        "en": "those to whom God said",
        "he": "אֲשֶׁר אָמַר יְהוָה לָהֶם"
      },
      {
        "ja": "אכ'רגא בני אסראיל",
        "en": "Bring out the sons of Israel",
        "he": "הוֹצִיאוּ אֶת-בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "מן בלד מצר עלי' גיושהם",
