    "24": [
      {
        "ja": "ובני קרח",
        "en": "And the sons of Korah",
        "he": "וּבְנֵי קֹרַח"
      },
      {
        "ja": "אסיר ואלקנה ואביאסף",
        "en": "Assir and Elkanah and Abiasaph",
        "he": "אַסִּיר וְאֶלְקָנָה וַאֲבִיאָסָף"
      },
      {
        "ja": "הולאי עשאיר קרח",
        "en": "these are the clans of Korah",
        "he": "אֵלֶּה מִשְׁפְּחֹת הַקָּרְחִי"
      }
    ],
    "25": [
      {
        "ja": "ואלעזר אבן הרון",
