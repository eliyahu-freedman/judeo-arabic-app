        "he": "כַּאֲשֶׁר תַּעֲשֶׂינָה הַדְּבֹרִים"
      },
      {
        "ja": "וחטמוכם",
        "en": "and crushed you",
        "he": "וַיַּכְּתוּ אֶתְכֶם"
      },
      {
        "ja": "מן סעיר",
        "en": "from Seir",
        "he": "בְּשֵׂעִיר"
      },
      {
        "ja": "אלי' חרמה",
        "en": "to Hormah",
        "he": "עַד-חָרְמָה"
      }
    ],
    "45": [
      {
        "ja": "פרגעתם",
        "en": "And you returned",
        "he": "וַתָּשֻׁבוּ"
      },
      {
        "ja": "באכיין",
        "en": "weeping",
        "he": "וַתִּבְכּוּ"
      },
      {
        "ja": "בין ידי אללה",
        "en": "before God",
        "he": "לִפְנֵי יְהוָה"
      },
      {
        "ja": "ולם יסמע",
        "en": "but He did not hear",
        "he": "וְלֹא-שָׁמַע יְהוָה"
      },
      {
        "ja": "צותכם",
        "en": "your voice",
        "he": "בְּקֹלְכֶם"
      },
      {
        "ja": "ולם אגאבכם",
        "en": "and did not answer you",
        "he": "וְלֹא הֶאֱזִין אֲלֵיכֶם"
      }
    ],
    "46": [
      {
        "ja": "פאקמתם",
        "en": "So you remained",
        "he": "וַתֵּשְׁבוּ"
      },
      {
        "ja": "פי רקים",
        "en": "in Raqim (Kadesh)",
        "he": "בְקָדֵשׁ"
      },
      {
        "ja": "מדה טוילה",
        "en": "a long while",
        "he": "יָמִים רַבִּים"
      },
      {
        "ja": "שביה כסאיר מא אקמתם",
        "en": "like the rest of the time you had remained",
        "he": "כַּיָּמִים אֲשֶׁר יְשַׁבְתֶּם"
      }
    ]
  }
