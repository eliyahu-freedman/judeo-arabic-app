        "he": "וְאֵת פַּר הַחַטָּאת"
      },
      {
        "ja": "ועתוד אלד'כוה",
        "en": "and the he-goat of the purification-offering",
        "he": "וְאֵת שְׂעִיר הַחַטָּאת"
      },
      {
        "ja": "אלד'י אדכ'ל מן דמאהמא",
        "en": "whose blood was brought in",
        "he": "אֲשֶׁר הוּבָא אֶת-דָּמָם"
      },
      {
        "ja": "לאלאסתג'פאר פי אלקדס",
        "en": "to seek forgiveness in the sanctuary",
        "he": "לְכַפֵּר בַּקֹּדֶשׁ"
      },
      {
        "ja": "פליכ'רגהא",
        "en": "he shall bring them out",
        "he": "יוֹצִיא"
      },
      {
        "ja": "אלי' כ'ארג אלעסכר",
        "en": "to outside the camp",
        "he": "אֶל-מִחוּץ לַמַּחֲנֶה"
      },
      {
        "ja": "ויחרקו",
        "en": "and they shall be burned",
        "he": "וְשָׂרְפוּ"
      },
      {
        "ja": "באלנאר",
        "en": "with fire",
        "he": "בָאֵשׁ"
      },
      {
        "ja": "גלודהא",
        "en": "their hides",
        "he": "אֶת-עֹרֹתָם"
      },
      {
        "ja": "ולחומהא",
        "en": "and their flesh",
        "he": "וְאֶת-בְּשָׂרָם"
      },
      {
        "ja": "ופרת'המא",
        "en": "and their dung",
        "he": "וְאֶת-פִּרְשָׁם"
      }
