        "he": "לְחֻקַּת עוֹלָם"
      },
      {
        "ja": "פי אליום אלעאשר",
        "en": "on the tenth day",
        "he": "בֶּעָשׂוֹר לַחֹדֶשׁ"
      },
      {
        "ja": "מן אלשהר אלסאבע",
