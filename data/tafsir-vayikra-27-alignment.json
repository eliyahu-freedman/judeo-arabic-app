        "ja": "עלי' קדר אלסנין אלבאקיאת",
        "en": "according to the number of years remaining",
        "he": "עַל-פִּי הַשָּׁנִים הַנּוֹתָרֹת"
      },
      {
        "ja": "אלי' סנה' אלאטלאק",
        "en": "until the year of release",
        "he": "עַד שְׁנַת הַיֹּבֵל"
      },
      {
        "ja": "וינקץ",
        "en": "and it shall be deducted",
        "he": "וְנִגְרַע"
      },
      {
        "ja": "מן אלקימה",
        "en": "from the full valuation",
        "he": "מֵעֶרְכֶּךָ"
      }
    ],
    "19": [
      {
        "ja": "ואן שא אלרגל אלמקדס אלצ'יעה אן יפתכהא",
        "en": "And if the man who consecrated the field wishes to redeem it",
        "he": "וְאִם-גָּאֹל יִגְאַל אֶת-הַשָּׂדֶה הַמַּקְדִּישׁ אֹתוֹ"
      },
      {
        "ja": "פליזיד",
        "en": "he shall add"
      },
      {
        "ja": "עלי' אלקימה כ'מסהא",
        "en": "a fifth to the valuation",
        "he": "וְיָסַף חֲמִשִׁית כֶּסֶף-עֶרְכְּךָ עָלָיו"
      },
      {
        "ja": "ותגב לה",
        "en": "and it shall be secured to him",
        "he": "וְקָם לוֹ"
      }
    ],
    "20": [
      {
        "ja": "ואן לם יפתכהא",
        "en": "But if he does not redeem it",
        "he": "וְאִם-לֹא יִגְאַל אֶת-הַשָּׂדֶה"
      },
      {
        "ja": "ובאעהא אלאמין",
        "en": "and the trustee has sold it",
        "he": "וְאִם-מָכַר אֶת-הַשָּׂדֶה"
      },
      {
        "ja": "לרגל אכ'ר",
        "en": "to another man",
        "he": "לְאִישׁ אַחֵר"
      },
      {
        "ja": "פלא תפתך אבדא",
        "en": "it shall not be redeemed ever",
        "he": "לֹא יִגָּאֵל עוֹד"
      }
    ],
    "21": [
      {
        "ja": "ותכון",
        "en": "And it shall be",
        "he": "וְהָיָה"
      },
      {
        "ja": "ענד כ'רוגהא",
        "en": "upon its passing out",
        "he": "הַשָּׂדֶה"
      },
      {
        "ja": "מן יד אלמשתרי",
        "en": "of the purchaser's hand",
        "he": "בְּצֵאתוֹ"
      },
      {
        "ja": "פי סנה' אלאטלאק",
        "en": "in the year of release",
        "he": "בַיֹּבֵל"
      },
      {
        "ja": "קדסא",
        "en": "sacred",
        "he": "קֹדֶשׁ"
      },
      {
        "ja": "ללה",
        "en": "to God",
        "he": "לַיהוָה"
      },
      {
        "ja": "כצ'יאע אלצואפי",
