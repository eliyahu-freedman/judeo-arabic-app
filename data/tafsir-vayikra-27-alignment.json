      },
      {
        "ja": "מן סנתה אלי' סנה' אלאטלאק",
        "en": "from its year until the year of release",
        "he": "עַד שְׁנַת הַיֹּבֵל"
      },
      {
        "ja": "וידפעהא",
        "en": "and he shall pay it",
        "he": "וְנָתַן אֶת-הָעֶרְכְּךָ"
      },
      {
        "ja": "פי ד'אלך אליום",
        "en": "on that day",
        "he": "בַּיּוֹם הַהוּא"
      },
      {
        "ja": "קדסא",
        "en": "as sacred",
        "he": "קֹדֶשׁ"
      },
      {
        "ja": "ללה",
        "en": "to God",
        "he": "לַיהוָה"
      }
    ],
    "24": [
      {
