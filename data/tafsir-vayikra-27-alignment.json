        "he": "לַאֲשֶׁר קָנָהוּ מֵאִתּוֹ"
      },
      {
        "ja": "אלד'י לה רקבה' אלארץ'",
        "en": "to the one who holds title to the land",
        "he": "לַאֲשֶׁר-לוֹ אֲחֻזַּת הָאָרֶץ"
      }
