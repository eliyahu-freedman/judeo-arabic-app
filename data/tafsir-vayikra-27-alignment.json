      },
      {
        "ja": "פליפדהא",
        "en": "he shall redeem it",
        "he": "וּפָדָה"
      },
      {
        "ja": "בקימתה",
        "en": "at its valuation",
        "he": "בְעֶרְכֶּךָ"
      },
      {
        "ja": "ויזיד",
