        "he": "מִכָּל-אֲשֶׁר-לוֹ"
      },
      {
        "ja": "מן עביד",
        "en": "whether slaves",
        "he": "מֵאָדָם"
      },
      {
        "ja": "ובהאים",
        "en": "or beasts",
        "he": "וּבְהֵמָה"
      },
      {
        "ja": "וצ'יעה' חוזה",
        "en": "or the fields of his holding",
        "he": "וּמִשְּׂדֵה אֲחֻזָּתוֹ"
      },
      {
        "ja": "פלא יבאע",
