        "en": "shall not be redeemed",
        "he": "לֹא יִפָּדֶה"
      },
      {
        "ja": "בל",
        "en": "he shall be"
      },
      {
        "ja": "יקתל קתלא",
        "en": "put to death",
        "he": "מוֹת יוּמָת"
      }
    ],
