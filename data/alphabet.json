    "2": {
      "title": "Diacritic Letters",
      "subtitle": "Hebrew letters with gershayim (׳) for distinctive Arabic phonemes",
      "intro": "Arabic has phonemes that Hebrew doesn't natively have. To write them, JA scribes add a gershayim (the mark ׳) to the closest Hebrew letter. These are the letters that most distinguish JA from plain Hebrew.",
      "letters": [
        {"ja": "ג׳", "ar": "ج", "phoneme": "j", "name": "Gimel + Gershayim / Jīm", "example_ja": "ג׳נאח", "example_ar": "جناح", "example_gloss": "wing"},
        {"ja": "ד׳", "ar": "ذ", "phoneme": "ḏ (th in this)", "name": "Dalet + Gershayim / Dhāl", "example_ja": "ד׳אלך", "example_ar": "ذلك", "example_gloss": "that"},
        {"ja": "ח׳", "ar": "خ", "phoneme": "kh (German ch)", "name": "Chet + Gershayim / Khāʾ", "example_ja": "ח׳לק", "example_ar": "خلق", "example_gloss": "he created"},
        {"ja": "ט׳", "ar": "ظ", "phoneme": "ẓ (emphatic dh)", "name": "Tet + Gershayim / Ẓāʾ", "example_ja": "ט׳לאם", "example_ar": "ظلام", "example_gloss": "darkness"},
        {"ja": "ת׳", "ar": "ث", "phoneme": "th (in thin)", "name": "Tav + Gershayim / Thāʾ", "example_ja": "ת׳מר", "example_ar": "ثمر", "example_gloss": "fruit"},
        {"ja": "ע׳", "ar": "غ", "phoneme": "gh (French r)", "name": "Ayin + Gershayim / Ghayn", "example_ja": "ע׳מר", "example_ar": "غمر", "example_gloss": "depth, abyss"}
      ]
    },
    "3": {
      "title": "The Definite Article",
      "subtitle": "אל = ال",
      "intro": "The Arabic definite article ال (al-, 'the') is written in JA as אל — two letters glued to the start of a word. This is the single most common two-letter combination in any JA text. Recognizing it instantly unlocks half of your reading.",
      "letters": [
        {"ja": "אל", "ar": "ال", "phoneme": "al-", "name": "Definite article", "example_ja": "אלכתאב", "example_ar": "الكتاب", "example_gloss": "the book"},
        {"ja": "אל", "ar": "ال", "phoneme": "al-", "name": "Definite article (note: assimilation)", "example_ja": "אלשמס", "example_ar": "الشمس", "example_gloss": "the sun (pronounced ash-shams)"},
        {"ja": "ואל", "ar": "وال", "phoneme": "wa-l-", "name": "And + the (conjunction + article)", "example_ja": "ואלארץ׳", "example_ar": "والأرض", "example_gloss": "and the earth"}
      ],
      "notes": [
        "Sun-letter assimilation: when ال precedes a 'sun letter' (ت ث د ذ ر ز س ش ص ض ط ظ ل ن), the lām assimilates in pronunciation (الشمس is pronounced ash-shams, not al-shams). But the orthography stays אל — JA does not mark the assimilation."
      ]
    }
  },
