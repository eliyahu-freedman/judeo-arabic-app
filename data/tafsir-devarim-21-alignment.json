        "he": "בְּכֹל אֲשֶׁר-יִמָּצֵא לוֹ"
      },
      {
        "ja": "אד' הו אוול נילה",
        "en": "since he is the first of his begetting",
        "he": "כִּי-הוּא רֵאשִׁית אֹנוֹ"
      },
      {
        "ja": "לה חכם אלבכורייה",
        "en": "the right of the firstborn belongs to him",
        "he": "לוֹ מִשְׁפַּט הַבְּכֹרָה"
      }
    ],
    "18": [
      {
        "ja": "ואן כאן לרגל",
        "en": "And if a man has",
        "he": "כִּי-יִהְיֶה לְאִישׁ"
      },
      {
        "ja": "אבן זאיל",
        "en": "a son who is wayward",
        "he": "בֵּן סוֹרֵר"
      },
      {
        "ja": "מכ'אלף",
        "en": "and defiant",
        "he": "וּמוֹרֶה"
      },
      {
        "ja": "ליס יקבל",
        "en": "who does not accept",
        "he": "אֵינֶנּוּ שֹׁמֵעַ"
      },
      {
        "ja": "אמר אביה",
        "en": "the command of his father",
        "he": "בְּקוֹל אָבִיו"
      },
      {
        "ja": "ואמה",
        "en": "and his mother",
        "he": "וּבְקוֹל אִמּוֹ"
      },
      {
        "ja": "ויודבאנה",
        "en": "and they discipline him",
        "he": "וְיִסְּרוּ אֹתוֹ"
      },
      {
        "ja": "ולם יקבל מנהמא",
        "en": "yet he does not accept it from them",
        "he": "וְלֹא יִשְׁמַע אֲלֵיהֶם"
      }
    ],
    "19": [
      {
        "ja": "פליקבץ' עליה",
        "en": "then",
        "he": "וְתָפְשׂוּ בוֹ"
      },
      {
        "ja": "אביה",
        "en": "his father",
        "he": "אָבִיו"
      },
      {
        "ja": "ואמה",
        "en": "and his mother shall seize him",
        "he": "וְאִמּוֹ"
      },
      {
        "ja": "ויכ'רגוה",
        "en": "and bring him out",
        "he": "וְהוֹצִיאוּ אֹתוֹ"
      },
      {
        "ja": "אלי' שיוך' קריתה",
        "en": "to the elders of his town",
        "he": "אֶל-זִקְנֵי עִירוֹ"
      },
      {
        "ja": "ואלי' באב חאכם מוצ'עה",
        "en": "and to the gate of the judge of his place",
        "he": "וְאֶל-שַׁעַר מְקֹמוֹ"
      }
    ],
    "20": [
      {
        "ja": "פיקולא להם",
        "en": "and they shall say to them",
        "he": "וְאָמְרוּ אֶל-זִקְנֵי עִירוֹ"
      },
      {
        "ja": "אבננא הד'א",
        "en": "This son of ours",
        "he": "בְּנֵנוּ זֶה"
      },
      {
        "ja": "זאיל",
        "en": "is wayward",
        "he": "סוֹרֵר"
      },
      {
        "ja": "מכ'אלף",
        "en": "and defiant",
        "he": "וּמֹרֶה"
      },
      {
        "ja": "ליס יקבל אמרנא",
        "en": "he does not accept our command",
        "he": "אֵינֶנּוּ שֹׁמֵעַ בְּקֹלֵנוּ"
      },
      {
        "ja": "והו מסרף",
        "en": "and he is excessive",
        "he": "זוֹלֵל"
      },
      {
        "ja": "ומפרט פי אלחראם",
        "en": "and immoderate in what is forbidden",
        "he": "וְסֹבֵא"
      }
    ],
    "21": [
      {
        "ja": "וירגמוה",
        "en": "And",
        "he": "וּרְגָמֻהוּ"
      },
      {
        "ja": "גמיע אהל קריתה",
        "en": "all the people of his town shall stone him",
        "he": "כָּל-אַנְשֵׁי עִירוֹ"
      },
      {
        "ja": "באלחגארה",
        "en": "with stones",
        "he": "בָאֲבָנִים"
      },
      {
        "ja": "חתי' ימות",
        "en": "until he dies",
        "he": "וָמֵת"
      },
      {
        "ja": "ואנף אהל אלשר",
        "en": "and banish the people of wickedness",
        "he": "וּבִעַרְתָּ הָרָע"
      },
      {
        "ja": "מן בינכם",
        "en": "from your midst",
        "he": "מִקִּרְבֶּךָ"
      },
      {
        "ja": "וסאיר אל אסראיל יסמעון",
        "en": "and the rest of Israel shall hear",
        "he": "וְכָל-יִשְׂרָאֵל יִשְׁמְעוּ"
      },
      {
        "ja": "ויכ'אפון",
        "en": "and be afraid",
        "he": "וְיִרָאוּ"
      }
    ],
    "22": [
      {
        "ja": "ואד'א וגבת עלי' אנסאן",
        "en": "And when there is found against a person",
        "he": "וְכִי-יִהְיֶה בְאִישׁ"
      },
      {
        "ja": "כ'טייה חכמהא אלקתל",
        "en": "a sin whose judgment is death",
        "he": "חֵטְא מִשְׁפַּט-מָוֶת"
      },
      {
        "ja": "פקתל",
        "en": "and he is put to death",
        "he": "וְהוּמָת"
      },
      {
        "ja": "פאצלבה עלי' כ'שבה",
        "en": "then hang him upon a wooden post",
        "he": "וְתָלִיתָ אֹתוֹ עַל-עֵץ"
      }
    ],
    "23": [
      {
        "ja": "ולא תבית גת'תה עליה",
        "en": "But do not leave his body on it overnight",
        "he": "לֹא-תָלִין נִבְלָתוֹ עַל-הָעֵץ"
      },
      {
        "ja": "בל",
        "en": "rather"
      },
      {
        "ja": "אדפנה דפנא",
        "en": "bury him in burial",
        "he": "כִּי-קָבוֹר תִּקְבְּרֶנּוּ"
      },
      {
        "ja": "פי ד'אלך אליום",
        "en": "on that same day",
        "he": "בַּיּוֹם הַהוּא"
      },
      {
        "ja": "אד' צלב למא אפתרא עלי' אללה",
        "en": "for he was hanged because he fabricated falsehood against God",
        "he": "כִּי-קִלְלַת אֱלֹהִים תָּלוּי"
      },
      {
        "ja": "ולא תנגס",
        "en": "and do not defile",
        "he": "וְלֹא תְטַמֵּא"
      },
      {
        "ja": "בד'אלך בלדך",
        "en": "thereby your land",
        "he": "אֶת-אַדְמָתְךָ"
      },
      {
        "ja": "אלד'י אללה רבך",
        "en": "which God your Lord",
        "he": "אֲשֶׁר יְהוָה אֱלֹהֶיךָ"
      },
      {
        "ja": "מעטיך",
        "en": "is giving you",
        "he": "נֹתֵן לְךָ"
      },
      {
        "ja": "נחלה",
        "en": "as an inheritance",
        "he": "נַחֲלָה"
      }
    ]
  }
}