        "he": "לֹא-תִגְרְעוּ מִלִּבְנֵיכֶם"
      },
      {
        "ja": "אמר יום ביום",
        "en": "the matter of each day, on its day",
        "he": "דְּבַר-יוֹם בְּיוֹמוֹ"
      }
    ],
    "20": [
      {
        "ja": "פפאגו מוסי' והרון",
        "en": "And they encountered Moses and Aaron",
        "he": "וַיִּפְגְּעוּ אֶת-מֹשֶׁה וְאֶת-אַהֲרֹן"
      },
      {
        "ja": "ואקפין תלקאהם",
        "en": "standing to meet them",
        "he": "נִצָּבִים לִקְרָאתָם"
      },
      {
        "ja": "ענד כ'רוגהם מן ענד פרעון",
        "en": "at their coming out from before Pharaoh",
        "he": "בְּצֵאתָם מֵאֵת פַּרְעֹה"
      }
    ],
    "21": [
      {
        "ja": "פקאלו להמא",
        "en": "And they said to them",
        "he": "וַיֹּאמְרוּ אֲלֵהֶם"
      },
      {
        "ja": "ינצ'ר אללה עליכם",
        "en": "May God look upon you",
        "he": "יֵרֶא יְהוָה עֲלֵיכֶם"
      },
      {
        "ja": "ויחכם",
        "en": "and judge",
        "he": "וְיִשְׁפֹּט"
      },
      {
        "ja": "כמא אפסדתמא חאלנא",
        "en": "for you have ruined our condition",
        "he": "אֲשֶׁר הִבְאַשְׁתֶּם אֶת-רֵיחֵנוּ"
      },
      {
        "ja": "ענד פרעון",
        "en": "before Pharaoh",
        "he": "בְּעֵינֵי פַרְעֹה"
      },
      {
        "ja": "וענד קואדה",
        "en": "and before his officers",
        "he": "וּבְעֵינֵי עֲבָדָיו"
      },
      {
        "ja": "חתא לו אן סיפא פי אידיהם",
        "en": "so that, were a sword in their hands",
        "he": "לָתֶת-חֶרֶב בְּיָדָם"
      },
      {
        "ja": "לקתלונא",
        "en": "they would kill us",
        "he": "לְהָרְגֵנוּ"
      }
    ],
    "22": [
      {
        "ja": "פרגע מוסי'. אלי' אללה",
        "en": "And Moses returned to God",
        "he": "וַיָּשָׁב מֹשֶׁה אֶל-יְהוָה"
      },
      {
        "ja": "וקאל",
        "en": "and said",
        "he": "וַיֹּאמַר"
      },
      {
        "ja": "יא רבי",
        "en": "O my Lord",
        "he": "אֲדֹנָי"
      },
      {
        "ja": "לם אבלית הולאי אלקום",
        "en": "why have You brought trial upon this people",
        "he": "לָמָה הֲרֵעֹתָה לָעָם הַזֶּה"
      },
      {
        "ja": "ולמא ד'א בעת'ת בי",
        "en": "And to what end have You sent me",
        "he": "לָמָּה זֶּה שְׁלַחְתָּנִי"
      }
    ],
    "23": [
      {
        "ja": "ומן חין דכ'לת אלי' פרעון",
        "en": "For from the time I went in to Pharaoh",
        "he": "וּמֵאָז בָּאתִי אֶל-פַּרְעֹה"
      },
      {
        "ja": "אכ'אטבה באסמך",
        "en": "to speak with him in Your name",
        "he": "לְדַבֵּר בִּשְׁמֶךָ"
      },
      {
        "ja": "אסא אליהם",
        "en": "he has dealt evil with them",
        "he": "הֵרַע לָעָם הַזֶּה"
      },
      {
        "ja": "ולם תכ'לצהם מן ד'אלך",
        "en": "and You have not rescued them from this",
        "he": "וְהַצֵּל לֹא-הִצַּלְתָּ אֶת-עַמֶּךָ"
      }
    ]
  }
}