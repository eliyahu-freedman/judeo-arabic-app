      },
      {
        "ja": "אחגב רחמתי",
        "en": "I shall conceal My mercy",
        "he": "אַסְתִּירָה פָנַי"
      },
      {
        "ja": "ענהם",
        "en": "from them",
        "he": "מֵהֶם"
      },
      {
        "ja": "אוריהם מא עאקבתהם",
        "en": "I shall show them what their end shall be",
        "he": "אֶרְאֶה מָה אַחֲרִיתָם"
      },
      {
        "ja": "לאנהם גיל מתקלב",
        "en": "for they are a generation of reversals",
        "he": "כִּי דוֹר תַּהְפֻּכֹת הֵמָּה"
      },
      {
        "ja": "בנין לא אמאנה פיהם",
        "en": "sons in whom there is no faithfulness",
        "he": "בָּנִים לֹא-אֵמֻן בָּם"
      }
    ],
    "21": [
      {
        "ja": "וכמא אנהם אכאדוני",
        "en": "And just as they provoked Me",
        "he": "הֵם קִנְאוּנִי"
      },
      {
        "ja": "בג'יר אלאה",
        "en": "with what is no god",
        "he": "בְלֹא-אֵל"
      },
      {
        "ja": "ואג'צ'בוני",
        "en": "and angered Me",
        "he": "כִּעֲסוּנִי"
      },
      {
        "ja": "בג'רוראתהם",
        "en": "with their vanities",
        "he": "בְּהַבְלֵיהֶם"
      },
      {
        "ja": "כד'אך",
        "en": "so"
      },
      {
        "ja": "אנא אכידהם",
        "en": "I shall provoke them",
        "he": "וַאֲנִי אַקְנִיאֵם"
      },
      {
        "ja": "בלא שעב",
        "en": "with what is no people",
        "he": "בְּלֹא-עָם"
      },
      {
        "ja": "ובקביל גאהל",
        "en": "and with a clan devoid of knowledge",
        "he": "בְּגוֹי נָבָל"
      },
      {
        "ja": "אג'צ'בהם",
        "en": "I shall anger them",
        "he": "אַכְעִיסֵם"
      }
    ],
    "22": [
      {
        "ja": "לאן אלנאר",
        "en": "For fire",
        "he": "כִּי-אֵשׁ"
      },
      {
        "ja": "תנקדח מן ג'צ'בי",
        "en": "is kindled from My anger",
        "he": "קָדְחָה בְאַפִּי"
      },
      {
        "ja": "פתתוקד",
        "en": "and it burns",
        "he": "וַתִּיקַד"
      },
      {
        "ja": "אלי' אספל אלת'רי",
        "en": "down to the lowest depth of the earth",
        "he": "עַד-שְׁאוֹל תַּחְתִּית"
      },
      {
        "ja": "ותאכל אלארץ' ונבאתהא",
        "en": "and it consumes the earth and its vegetation",
        "he": "וַתֹּאכַל אֶרֶץ וִיבֻלָהּ"
      },
      {
        "ja": "חתי' תסטע אסאסאה' אלגבאל",
        "en": "until it reaches the foundations of the mountains",
        "he": "וַתְּלַהֵט מוֹסְדֵי הָרִים"
      }
    ],
    "23": [
      {
        "ja": "כדאך",
        "en": "So shall"
      },
      {
        "ja": "אזיד עליהם שרורא",
        "en": "I increase upon them evils",
        "he": "אַסְפֶּה עָלֵימוֹ רָעוֹת"
      },
      {
        "ja": "וסהאמי אפרקהא פיהם",
        "en": "and My arrows I shall scatter among them",
        "he": "חִצַּי אֲכַלֶּה-בָּם"
      }
    ],
    "24": [
      {
        "ja": "סגאר אלגוע",
        "en": "the fever of hunger",
        "he": "מְזֵי רָעָב"
      },
      {
        "ja": "וחמא אלוהג",
        "en": "and burning heat",
        "he": "וּלְחֻמֵי רֶשֶׁף"
      },
      {
        "ja": "וחתף מר",
        "en": "and bitter sudden death",
        "he": "וְקֶטֶב מְרִירִי"
      },
      {
        "ja": "ואסנאן אלבהאים",
        "en": "and the teeth of beasts",
        "he": "וְשֶׁן-בְּהֵמֹת"
      },
      {
        "ja": "אטלקהא פיהם",
        "en": "I shall loose upon them",
        "he": "אֲשַׁלַּח-בָּם"
      },
      {
        "ja": "מע חמייה' זואחל אלתראב",
        "en": "together with the venom of the crawling things of the dust",
        "he": "עִם-חֲמַת זֹחֲלֵי עָפָר"
      }
    ],
    "25": [
      {
        "ja": "וסיף מת'כל מן כ'ארג",
        "en": "And outside, the bereaving sword",
        "he": "מִחוּץ תְּשַׁכֶּל-חֶרֶב"
      },
      {
        "ja": "והיבה מן אלכ'דור",
        "en": "and dread from within the chambers",
        "he": "וּמֵחֲדָרִים אֵימָה"
      },
      {
        "ja": "חתי' אלשאב",
        "en": "striking down youth",
        "he": "גַּם-בָּחוּר"
      },
      {
        "ja": "חתי' אלעאתק",
        "en": "and maiden alike",
        "he": "גַּם-בְּתוּלָה"
      },
      {
        "ja": "ואלרצ'יע",
        "en": "the suckling",
        "he": "יוֹנֵק"
      },
      {
        "ja": "מע ד'וי אלשיבה כאפה",
        "en": "together with all those of hoary age",
        "he": "עִם-אִישׁ שֵׂיבָה"
      }
    ],
    "26": [
      {
        "ja": "ולקד קלת",
        "en": "And I had said",
        "he": "אָמַרְתִּי"
      },
      {
        "ja": "אתקצאהם",
        "en": "I shall reduce their number",
        "he": "אַפְאֵיהֶם"
      },
      {
        "ja": "באסתחקאק",
        "en": "as they deserve"
      },
      {
        "ja": "ואעטל",
        "en": "and cause",
        "he": "אַשְׁבִּיתָה"
      },
      {
        "ja": "מן בין אלנאס ד'כרהם",
        "en": "their memory to cease from among the people",
        "he": "מֵאֱנוֹשׁ זִכְרָם"
      }
    ],
    "27": [
      {
        "ja": "לולא אני",
        "en": "But for My"
      },
      {
        "ja": "אחד'ר להם כיד אלעדו",
        "en": "taking precaution against the scheming of the enemy",
        "he": "לוּלֵי כַּעַס אוֹיֵב"
      },
      {
        "ja": "ללא ינכרו ד'אלך אעדאיהם",
        "en": "lest their enemies deny this",
        "he": "פֶּן-יְנַכְּרוּ צָרֵימוֹ"
      },
      {
        "ja": "כלא יקולו",
        "en": "lest they say",
        "he": "פֶּן-יֹאמְרוּ"
      },
      {
        "ja": "ידנא קד עלת",
        "en": "Our hand has prevailed",
        "he": "יָדֵנוּ רָמָה"
      },
      {
        "ja": "וליס אללה",
        "en": "and it was not God",
        "he": "וְלֹא יְהוָה"
      },
      {
        "ja": "פעל בהם גמיע הד'ה אלאמור",
        "en": "who did all these things to them",
        "he": "פָּעַל כָּל-זֹאת"
      }
    ],
    "28": [
      {
        "ja": "לאנהם קביל",
        "en": "for they are a clan",
        "he": "כִּי-גוֹי"
      },
      {
        "ja": "מצ'ייע אלחכמה",
        "en": "that has squandered wisdom",
        "he": "אֹבַד עֵצוֹת"
      },
      {
        "ja": "וליס פיהם פהם",
        "en": "and there is no understanding in them",
        "he": "וְאֵין בָּהֶם תְּבוּנָה"
      }
    ],
    "29": [
      {
        "ja": "ולו תחכמו",
        "en": "And would that they were wise",
        "he": "לוּ חָכְמוּ"
      },
      {
        "ja": "לעקלו כ'לה",
        "en": "they would have comprehended both",
        "he": "יַשְׂכִּילוּ"
      },
      {
        "ja": "יפהמון בהא עאקבתהם",
        "en": "and by those two things would understand their fate",
        "he": "יָבִינוּ לְאַחֲרִיתָם"
      }
    ],
    "30": [
      {
        "ja": "והו אן יקולו",
        "en": "And that is for them to say"
      },
      {
        "ja": "כיף יכלב אלואחד אלפא",
        "en": "How could one pursue a thousand",
        "he": "אֵיכָה יִרְדֹּף אֶחָד אֶלֶף"
      },
      {
        "ja": "ואת'נין יהרבון רבווה",
        "en": "and two put a myriad to flight",
        "he": "וּשְׁנַיִם יָנִיסוּ רְבָבָה"
      },
      {
        "ja": "לולא אן מעתמדהם אסלמהם",
        "en": "were it not that their mainstay had delivered them over",
        "he": "אִם-לֹא כִּי-צוּרָם מְכָרָם"
      },
      {
        "ja": "ואללה אמכן מנהם",
        "en": "and God had made it possible to overpower them",
        "he": "וַיהוָה הִסְגִּירָם"
      }
    ],
    "31": [
      {
        "ja": "אנה ליס כמעתמדנא מעתמדהם",
        "en": "For their mainstay is not like our mainstay",
        "he": "כִּי לֹא כְצוּרֵנוּ צוּרָם"
      },
      {
        "ja": "ולא אעדאינא יפקהון",
        "en": "nor do our enemies comprehend this",
        "he": "וְאֹיְבֵינוּ פְּלִילִים"
      }
    ],
    "32": [
      {
        "ja": "לאנהם יעאקבון",
        "en": "For they are punished"
      },
      {
        "ja": "כאן מן גפן סדום גפנהם",
        "en": "as though their vine were from the vine of Sodom",
        "he": "כִּי-מִגֶּפֶן סְדֹם גַּפְנָם"
      },
      {
        "ja": "ומן דואלי עמורה",
        "en": "and from the tendrils of Gomorrah",
        "he": "וּמִשַּׁדְמֹת עֲמֹרָה"
      },
      {
        "ja": "כד'אך",
        "en": "so"
      },
      {
        "ja": "ענבהם ענב אלסם",
        "en": "their grapes are grapes of poison",
        "he": "עֲנָבֵמוֹ עִנְּבֵי-רוֹשׁ"
      },
      {
        "ja": "וענאקידהם מרה להם",
        "en": "and their clusters are bitter to them",
        "he": "אַשְׁכְּלֹת מְרֹרֹת לָמוֹ"
      }
    ],
    "33": [
      {
        "ja": "וכחמייה' אלתנאנין כ'מרהם",
        "en": "And like the venom of serpents is their wine",
        "he": "חֲמַת תַּנִּינִם יֵינָם"
      },
      {
        "ja": "וסם אלרקש מנהא אלצ'אריה",
        "en": "and the poison of the spotted viper — the ferocious among them",
        "he": "וְרֹאשׁ פְּתָנִים אַכְזָר"
      }
    ],
    "34": [
      {
        "ja": "אלא אן",
        "en": "Yet"
      },
      {
        "ja": "גמיע ד'אלך מכנוז ענדי",
        "en": "all that is treasured away with Me",
        "he": "הֲלֹא-הוּא כָּמֻס עִמָּדִי"
      },
      {
        "ja": "ומכ'תום פי כ'זאיני",
        "en": "and sealed in My storehouses",
        "he": "חָתוּם בְּאוֹצְרֹתָי"
      }
    ],
    "35": [
      {
        "ja": "ולי אלאנתקאם ואלתופיה",
        "en": "Mine is the vengeance and the full recompense",
        "he": "לִי נָקָם וְשִׁלֵּם"
      },
      {
        "ja": "פי וקת אן תזול קדמהם",
        "en": "at the time when their foot shall slip",
        "he": "לְעֵת תָּמוּט רַגְלָם"
      },
      {
        "ja": "אנה מא אקרב יום תעסהם",
        "en": "for how near is the day of their misery",
        "he": "כִּי קָרוֹב יוֹם אֵידָם"
      },
      {
        "ja": "ואסרע אלמעדאת להם",
        "en": "and how swiftly come are the things prepared for them",
        "he": "וְחָשׁ עֲתִדֹת לָמוֹ"
      }
    ],
    "36": [
      {
        "ja": "אד' יחכם אללה לשעבה",
        "en": "When God shall render judgment for His people",
        "he": "כִּי-יָדִין יְהוָה עַמּוֹ"
      },
      {
        "ja": "וען עבאדה יצפח",
        "en": "and grant pardon to His servants",
        "he": "וְעַל-עֲבָדָיו יִתְנֶחָם"
      },
      {
        "ja": "אד'א ראי אן אלמקדרה ד'הבת ענהם",
        "en": "when He shall see that the power has gone from them",
        "he": "כִּי יִרְאֶה כִּי-אָזְלַת יָד"
      },
      {
        "ja": "וכלא אלמחבוס ואלמתרוך גמיע מן צ'ג'טהם",
        "en": "and those left, whether confined or abandoned, are all broken under their oppression",
        "he": "וְאֶפֶס עָצוּר וְעָזוּב"
      }
    ],
    "37": [
      {
        "ja": "חין קאל אלעדו",
        "en": "When the enemy shall say",
        "he": "וְאָמַר"
      },
      {
        "ja": "אין אלאהתהם",
        "en": "Where is their God",
        "he": "אֵי אֱלֹהֵימוֹ"
      },
      {
        "ja": "אלמעתמד אלד'י אסתכנו עליה",
        "en": "the Mainstay upon whom they relied",
        "he": "צוּר חָסָיוּ בוֹ"
      }
    ],
    "38": [
      {
        "ja": "אלד'ין כאנו יאכלון שחום ד'באיחהם",
        "en": "Those who would eat the fat of their sacrifices",
        "he": "אֲשֶׁר חֵלֶב זְבָחֵימוֹ יֹאכֵלוּ"
      },
      {
        "ja": "וישרבון כ'מר מזאגהם",
        "en": "and drink the wine of their libations",
        "he": "יִשְׁתּוּ יֵין נְסִיכָם"
      },
      {
        "ja": "יקומון אלאן פיעינוכם",
        "en": "let them arise now and help you",
        "he": "יָקוּמוּ וְיַעְזְרֻכֶם"
      },
      {
        "ja": "יכונו עליכם גנה",
        "en": "let them be a shield over you",
        "he": "יְהִי עֲלֵיכֶם סִתְרָה"
      }
    ],
    "39": [
      {
        "ja": "אנצרו אלאן",
        "en": "Look now",
        "he": "רְאוּ עַתָּה"
      },
      {
        "ja": "אני הו וחדי",
        "en": "I am He alone",
        "he": "כִּי אֲנִי אֲנִי הוּא"
      },
      {
        "ja": "וליס אלאה אכ'ר מעי",
        "en": "and there is no other god with Me",
        "he": "וְאֵין אֱלֹהִים עִמָּדִי"
      },
      {
        "ja": "אנא אמית ואחיי",
        "en": "I put to death and I give life",
        "he": "אֲנִי אָמִית וַאֲחַיֶּה"
      },
      {
        "ja": "כמא טאל מא אוהנת",
        "en": "however long I have weakened",
        "he": "מָחַצְתִּי"
      },
      {
        "ja": "ולם אזאל אשפי",
        "en": "I have ever been healing",
        "he": "וַאֲנִי אֶרְפָּא"
      },
      {
        "ja": "וליס מן ידי מכ'לץ",
        "en": "and there is none who can deliver from My hand",
        "he": "וְאֵין מִיָּדִי מַצִּיל"
      }
    ],
    "40": [
      {
        "ja": "ואנא אקסם באלסמא",
        "en": "And I swear by the heavens",
        "he": "כִּי-אֶשָּׂא אֶל-שָׁמַיִם יָדִי"
      },
      {
        "ja": "ואקול",
        "en": "and I say",
        "he": "וְאָמַרְתִּי"
      },
      {
        "ja": "ובקאי אלדאים",
        "en": "by My everlasting continuance",
        "he": "חַי אָנֹכִי לְעֹלָם"
      }
    ],
    "41": [
      {
        "ja": "לאסנן בריק סיפי",
        "en": "I shall whet the gleam of My sword",
        "he": "אִם-שַׁנּוֹתִי בְּרַק חַרְבִּי"
      },
      {
        "ja": "ותמסך אלחכם ידי",
        "en": "and My hand shall hold judgment",
        "he": "וְתֹאחֵז בְּמִשְׁפָּט יָדִי"
      },
      {
        "ja": "וארד אלאנתקאם עלי' אעדאי",
        "en": "and I shall bring vengeance upon My enemies",
        "he": "אָשִׁיב נָקָם לְצָרָי"
      },
      {
        "ja": "ואלמכאפאה עלי' שאניי",
        "en": "and the dread upon those who hate Me",
        "he": "וְלִמְשַׂנְאַי אֲשַׁלֵּם"
      }
    ],
    "42": [
      {
        "ja": "פכאני אסכר סהאמי מן דמאהם",
        "en": "As if I were making My arrows drunk from their blood",
        "he": "אַשְׁכִּיר חִצַּי מִדָּם"
      },
      {
        "ja": "וסיפי יאכל לחומהם",
        "en": "and My sword were consuming their flesh",
        "he": "וְחַרְבִּי תֹּאכַל בָּשָׂר"
      },
      {
        "ja": "פירוא מן דם אלצריע ואלסבי",
        "en": "that it may be sated from the blood of the slain and the captive",
        "he": "מִדַּם חָלָל וְשִׁבְיָה"
      },
      {
        "ja": "מן רוס פראענה' אלאעדא",
        "en": "from the heads of the rulers of the enemy nations",
        "he": "מֵרֹאשׁ פַּרְעוֹת אוֹיֵב"
      }
    ],
    "43": [
      {
        "ja": "אמדחו יא איהא אלאמם",
        "en": "Praise, O you nations",
        "he": "הַרְנִינוּ גוֹיִם"
      },
      {
        "ja": "שעבה",
        "en": "His people",
        "he": "עַמּוֹ"
      },
      {
        "ja": "פאנה ינתקם דמא עבידה",
        "en": "for He shall avenge the blood of His servants",
        "he": "כִּי דַם-עֲבָדָיו יִקּוֹם"
      },
      {
        "ja": "פירד תלך אלנקמה עלי' אעדאיה",
        "en": "and shall return that vengeance upon His enemies",
        "he": "וְנָקָם יָשִׁיב לְצָרָיו"
      },
      {
        "ja": "ויג'פר לבלאדה ושעבה",
        "en": "and shall grant forgiveness to His land and His people",
        "he": "וְכִפֶּר אַדְמָתוֹ עַמּוֹ"
      }
    ],
    "44": [
      {
        "ja": "וכאן מוסי'",
        "en": "And it was Moses",
        "he": "וַיָּבֹא מֹשֶׁה"
      },
      {
        "ja": "למא כלם אלקום בהד'ה אלתסבחה",
        "en": "when he addressed the people with this hymn of praise",
        "he": "וַיְדַבֵּר אֶת-כָּל-דִּבְרֵי הַשִּׁירָה-הַזֹּאת"
      },
      {
        "ja": "הו",
        "en": "he",
        "he": "הוּא"
      },
      {
        "ja": "והושע אבן נון",
        "en": "and Hoshea son of Nun",
        "he": "וְהוֹשֵׁעַ בִּן-נוּן"
      }
    ],
    "45": [
      {
        "ja": "פלמא פרג' מוסי'",
        "en": "And when Moses had finished",
        "he": "וַיְכַל מֹשֶׁה"
      },
      {
        "ja": "מן מכ'אטבתהם בהד'א אלכלאם",
        "en": "addressing them with this speech",
        "he": "לְדַבֵּר אֶת-כָּל-הַדְּבָרִים הָאֵלֶּה"
      }
    ],
    "46": [
      {
        "ja": "קאל להם",
        "en": "he said to them",
        "he": "וַיֹּאמֶר אֲלֵהֶם"
      },
      {
        "ja": "רדו באלכם",
        "en": "Turn your minds",
        "he": "שִׂימוּ לְבַבְכֶם"
      },
      {
        "ja": "לגמיע אלכלאם",
        "en": "to all the words",
        "he": "לְכָל-הַדְּבָרִים"
      },
      {
        "ja": "אלד'י אנאשדכם בה אליום",
        "en": "by which I solemnly charge you today",
        "he": "אֲשֶׁר אָנֹכִי מֵעִיד בָּכֶם הַיּוֹם"
      },
      {
        "ja": "לתאמרון בה בניכם",
        "en": "that you command your children",
        "he": "אֲשֶׁר תְּצַוֻּם אֶת-בְּנֵיכֶם"
      },
      {
        "ja": "ליחפצו ויעמלו",
        "en": "to observe and to perform",
        "he": "לִשְׁמֹר לַעֲשׂוֹת"
      },
      {
        "ja": "גמיע אמור הד'ה אלתורייה",
        "en": "all the matters of this Torah",
        "he": "אֶת-כָּל-דִּבְרֵי הַתּוֹרָה הַזֹּאת"
      }
    ],
    "47": [
      {
        "ja": "לאנה ליס בכלאם פארג' הו ענכם",
        "en": "for it is no empty speech for you",
        "he": "כִּי לֹא-דָבָר רֵק הוּא מִכֶּם"
      },
      {
        "ja": "בל הו חיותכם",
        "en": "rather it is your very life",
        "he": "כִּי-הוּא חַיֵּיכֶם"
      },
      {
        "ja": "ובה תטול מדתכם",
        "en": "and by it your span of days shall be lengthened",
        "he": "וּבַדָּבָר הַזֶּה תַּאֲרִיכוּ יָמִים"
      },
      {
        "ja": "פי אלבלד",
        "en": "in the land",
        "he": "עַל-הָאֲדָמָה"
      },
      {
        "ja": "אלד'י אנתם גאיזין אלארדן",
        "en": "which you are crossing the Jordan",
        "he": "אֲשֶׁר אַתֶּם עֹבְרִים אֶת-הַיַּרְדֵּן"
      },
      {
        "ja": "אליה לתחוזוה",
        "en": "to possess",
        "he": "שָׁמָּה לְרִשְׁתָּהּ"
      }
    ],
    "48": [
      {
        "ja": "ת'ם כלם אללה",
        "en": "Then God spoke",
        "he": "וַיְדַבֵּר יְהוָה"
      },
      {
        "ja": "מוסי'",
        "en": "to Moses",
        "he": "אֶל-מֹשֶׁה"
      },
      {
        "ja": "פי ד'את דאלך אליום",
        "en": "on that very same day",
        "he": "בְּעֶצֶם הַיּוֹם הַזֶּה"
      },
      {
        "ja": "קאילא",
        "en": "saying",
        "he": "לֵאמֹר"
      }
    ],
    "49": [
      {
        "ja": "אצעד",
        "en": "Go up",
        "he": "עֲלֵה"
      },
      {
        "ja": "אלי' גבל אלעבריין הד'א",
        "en": "to this mountain of the Hebrews",
        "he": "אֶל-הַר הָעֲבָרִים הַזֶּה"
      },
      {
        "ja": "גבל נבו",
        "en": "Mount Nebo",
        "he": "הַר-נְבוֹ"
      },
      {
        "ja": "אלד'י פי בלד מואב",
        "en": "which is in the land of Moab",
        "he": "אֲשֶׁר בְּאֶרֶץ מוֹאָב"
      },
      {
        "ja": "אלד'י בחצ'רה' יריחו",
        "en": "which faces Jericho",
        "he": "אֲשֶׁר עַל-פְּנֵי יְרֵחוֹ"
      },
      {
        "ja": "ואנצ'ר אלבלד",
        "en": "and behold the land",
        "he": "וּרְאֵה אֶת-אֶרֶץ"
      },
      {
        "ja": "אלד'י אנא מעטיה",
        "en": "which I am giving",
        "he": "אֲשֶׁר אֲנִי נֹתֵן"
      },
      {
        "ja": "לבני אסראיל",
        "en": "to the sons of Israel",
        "he": "לִבְנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "חוזא",
        "en": "as a possession",
        "he": "לַאֲחֻזָּה"
      }
    ],
    "50": [
      {
        "ja": "ומות",
        "en": "And die",
        "he": "וּמֻת"
      },
      {
        "ja": "פי אלגבל אלד'י אנת צאעד אליה",
        "en": "on the mountain to which you are ascending",
        "he": "בָּהָר אֲשֶׁר אַתָּה עֹלֶה שָׁמָּה"
      },
      {
        "ja": "ואנצ'ם אלי' קומך",
        "en": "and be gathered to your people",
        "he": "וְהֵאָסֵף אֶל-עַמֶּיךָ"
      },
      {
        "ja": "כמא מאת הרון אכי'ך",
        "en": "just as Aaron your brother died",
        "he": "כַּאֲשֶׁר-מֵת אַהֲרֹן אָחִיךָ"
      },
      {
        "ja": "פי גבל הור",
        "en": "on Mount Hor",
        "he": "בְּהֹר הָהָר"
      },
      {
        "ja": "ואנצ'ם אלי' קומה",
        "en": "and was gathered to his people",
        "he": "וַיֵּאָסֶף אֶל-עַמָּיו"
      }
    ],
    "51": [
      {
        "ja": "עלי' מא נכת'תמא אלאמה בי",
        "en": "on account of what you two caused: the nation's breach of faith in Me",
        "he": "עַל אֲשֶׁר מְעַלְתֶּם בִּי"
      },
      {
        "ja": "פי מא בין בני אסראיל",
        "en": "in the midst of the sons of Israel",
        "he": "בְּתוֹךְ בְּנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "פי מא כ'צומה' רקים בריה' צין",
        "en": "at the contention of Raqim in the wilderness of Zin",
        "he": "בְּמֵי-מְרִיבַת קָדֵשׁ מִדְבַּר-צִן"
      },
      {
        "ja": "ולם תקדסאני",
        "en": "in that you did not sanctify Me",
        "he": "עַל אֲשֶׁר לֹא-קִדַּשְׁתֶּם אוֹתִי"
      },
      {
        "ja": "פי מא בינהם",
        "en": "in their midst",
        "he": "בְּתוֹךְ בְּנֵי יִשְׂרָאֵל"
      }
    ],
    "52": [
      {
        "ja": "לדאלך תנצר אלארץ'",
        "en": "Therefore you shall behold the land",
        "he": "כִּי מִנֶּגֶד תִּרְאֶה אֶת-הָאָרֶץ"
      },
      {
        "ja": "אלד'י אעטיתהא לבני אסראיל",
        "en": "which I am giving to the sons of Israel",
        "he": "אֲשֶׁר-אֲנִי נֹתֵן לִבְנֵי יִשְׂרָאֵל"
      },
      {
        "ja": "מן אלמקאבלה",
        "en": "from the opposite side"
      },
      {
        "ja": "ולא תדכ'ל אליהא",
        "en": "but you shall not enter it",
        "he": "וְשָׁמָּה לֹא תָבוֹא"
      }
    ]
  }
}