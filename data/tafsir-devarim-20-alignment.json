        "he": "לֹא תְחַיֶּה כָּל-נְשָׁמָה"
      }
    ],
    "17": [
      {
        "ja": "בל",
        "en": "Rather"
      },
      {
        "ja": "אתלפהם אתלאפא",
        "en": "destroy them utterly",
        "he": "כִּי-הַחֲרֵם תַּחֲרִימֵם"
      },
      {
        "ja": "אלחתיין",
        "en": "the Hittites",
        "he": "הַחִתִּי"
      },
      {
        "ja": "ואלאמוריין",
        "en": "and the Amorites",
        "he": "וְהָאֱמֹרִי"
      },
      {
        "ja": "אלכנעאניין",
        "en": "the Canaanites",
        "he": "הַכְּנַעֲנִי"
      },
      {
        "ja": "ואלפרזיין",
        "en": "and the Perizzites",
        "he": "וְהַפְּרִזִּי"
      },
      {
        "ja": "ואלחויין",
        "en": "and the Hivites",
        "he": "הַחִוִּי"
      },
      {
        "ja": "ואליבוסיין",
        "en": "and the Jebusites",
        "he": "וְהַיְבוּסִי"
      },
      {
        "ja": "כמא אמרך אללה רבך",
        "en": "as God your Lord has commanded you",
        "he": "כַּאֲשֶׁר צִוְּךָ יְהוָה אֱלֹהֶיךָ"
      }
    ],
    "18": [
      {
        "ja": "לכי לא יעלמוכם",
        "en": "So that they do not teach you",
        "he": "לְמַעַן אֲשֶׁר לֹא-יְלַמְּדוּ אֶתְכֶם"
      },
      {
        "ja": "אן תצנעו",
        "en": "to do",
        "he": "לַעֲשׂוֹת"
      },
      {
        "ja": "כגמיע מכארההם",
        "en": "according to all their abominations",
        "he": "כְּכֹל תּוֹעֲבֹתָם"
      },
      {
        "ja": "אלד'י צנעוהא",
        "en": "which they performed",
        "he": "אֲשֶׁר עָשׂוּ"
      },
      {
        "ja": "למעבודאתהם",
        "en": "for their idols",
        "he": "לֵאלֹהֵיהֶם"
      },
      {
        "ja": "פתכ'טו",
        "en": "and you would thereby sin",
        "he": "וַחֲטָאתֶם"
      },
      {
        "ja": "ללה רבכם",
        "en": "against God your Lord",
        "he": "לַיהוָה אֱלֹהֵיכֶם"
      }
    ],
    "19": [
      {
        "ja": "ואד'א חאצרת",
        "en": "And when you besiege",
        "he": "כִּי-תָצוּר"
      },
      {
        "ja": "קריה",
        "en": "a town",
        "he": "אֶל-עִיר"
      },
      {
        "ja": "אייאם כתירה",
        "en": "many days",
        "he": "יָמִים רַבִּים"
      },
      {
        "ja": "לתחארבהא",
        "en": "fighting against it",
        "he": "לְהִלָּחֵם עָלֶיהָ"
      },
      {
        "ja": "לתפתחהא",
        "en": "to open it",
        "he": "לְתָפְשָׂהּ"
      },
      {
        "ja": "פלא תפסד שגרהא",
        "en": "do not destroy its trees",
        "he": "לֹא-תַשְׁחִית אֶת-עֵצָהּ"
      },
      {
        "ja": "באן תחרך עליה אלחדיד",
        "en": "by raising an axe against them",
        "he": "לִנְדֹּחַ עָלָיו גַּרְזֶן"
      },
      {
        "ja": "אד' מנה תאכל",
        "en": "for from them you eat",
        "he": "כִּי מִמֶּנּוּ תֹאכֵל"
      },
      {
        "ja": "פלא תקטעה",
        "en": "do not cut them down",
        "he": "וְאֹתוֹ לֹא תִכְרֹת"
      },
      {
        "ja": "]ט'נא] צ'נא מנך",
        "en": "Do you suppose"
      },
      {
        "ja": "אן שגר אלצחרא כאלאנסאן",
        "en": "that the trees of the wilderness are like a man",
        "he": "כִּי הָאָדָם עֵץ הַשָּׂדֶה"
      },
      {
        "ja": "אלד'י קד אכ'תפא מן בין ידיך פי אלחצאר",
        "en": "who has taken cover before you in the siege",
        "he": "לָבֹא מִפָּנֶיךָ בַּמָּצוֹר"
      }
    ],
    "20": [
      {
        "ja": "לכן",
        "en": "However"
      },
      {
        "ja": "אי שגר",
        "en": "any tree",
        "he": "רַק עֵץ"
      },
      {
        "ja": "עלמתה",
        "en": "that you know",
        "he": "אֲשֶׁר-תֵּדַע"
      },
      {
        "ja": "אנה ליס במטעם",
        "en": "is not a food-bearing tree",
        "he": "כִּי-לֹא-עֵץ מַאֲכָל הוּא"
      },
      {
        "ja": "פאפסדה",
        "en": "that you may destroy",
        "he": "אֹתוֹ תַשְׁחִית"
      },
      {
        "ja": "ואקטעה",
        "en": "and cut down",
        "he": "וְכָרָתָּ"
      },
      {
        "ja": "ואבן אלאת אלחצאר",
        "en": "and build the siege-works",
        "he": "וּבָנִיתָ מָצוֹר"
      },
      {
        "ja": "עלי' אייה' קריה",
        "en": "against whichever town",
        "he": "עַל-הָעִיר"
      },
      {
        "ja": "חארבתך",
        "en": "has made war against you",
        "he": "אֲשֶׁר-הִוא עֹשָׂה עִמְּךָ מִלְחָמָה"
      },
      {
        "ja": "אלי' אן תהדהא",
        "en": "until you bring it down",
        "he": "עַד רִדְתָּהּ"
      }
    ]
  }
}